def prodAssocLeftEquiv (α β γ : Type*) :
    ((α × β) × γ) ≃ α × (β × γ) where
  toFun x := (x.1.1, (x.1.2, x.2))
  invFun x := ((x.1, x.2.1), x.2.2)
  left_inv := by
    intro x
    cases x with
    | mk ab c =>
        cases ab
        rfl
  right_inv := by
    intro x
    cases x with
    | mk a bc =>
        cases bc
        rfl

