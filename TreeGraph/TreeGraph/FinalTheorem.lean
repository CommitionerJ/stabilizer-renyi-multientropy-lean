          Fintype.card
            (RawNormal.NodeChildRootFieldDomain n a cs i) := by
          exact card_childRootFieldFunction_eq_two_pow_domain
            (n := n) (a := a) (cs := cs) i
    _ = (2 : ℤ) ^ (n ^ childExternalCoordinateExponentAt a cs i) := by
          rw [hfieldCard]
    _ =
        RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopyFactorAt
          n a cs i := by
          exact
            (childInternalCoordinateCopyFactorAt_leaf_child_closed
              (n := n) (a := a) (b := b) i hb hchild).symm

