      LinearMap.mem_ker.mpr
        ((childBoundaryCoefficientMap_eq_zero_iff
          (n := n) (a := a) (cs := cs) R.1).2 R.2)⟩
  invFun R :=
    ⟨R.1,
      (childBoundaryCoefficientMap_eq_zero_iff
        (n := n) (a := a) (cs := cs) R.1).1
        (LinearMap.mem_ker.mp R.2)⟩
  left_inv R := by
    exact Subtype.ext rfl
  right_inv R := by
    exact Subtype.ext rfl

theorem card_boundaryZeroRootField_eq_coefficientKernel
