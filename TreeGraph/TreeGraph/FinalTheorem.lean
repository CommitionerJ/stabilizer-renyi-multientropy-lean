theorem rootBoundaryChildMessageSumAt_shift_eq_firstCoordinateShift_zero
    {n b : Nat} [NeZero n] (ds : List RTree)
    (j : ChildIdx ds)
    (φ : RawNormal.NodeChildRootFieldDomain n b ds j → F2)
    (rd : RawNormal.RootFieldDomain n (RTree.node b ds))
