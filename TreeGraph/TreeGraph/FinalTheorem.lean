noncomputable def gaugeTransformExternalNormalAssignmentsWithEquiv
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs)
    (σ : NonRootVertex (childAt cs i) → ZMod n) :
    (ChildExternalCoordinate n a cs i →
      RawNormal.NormalAssignment n (childAt cs i)) ≃
    (ChildExternalCoordinate n a cs i →
      RawNormal.NormalAssignment n (childAt cs i)) where
  toFun :=
    gaugeTransformExternalNormalAssignmentsWith
      (n := n) (a := a) (cs := cs) i σ
  invFun :=
    gaugeTransformExternalNormalAssignmentsWith
      (n := n) (a := a) (cs := cs) i (fun v => -σ v)
  left_inv := by
    intro Aext
    funext ext
    rw [RawNormal.NormalAssignment.mk.injEq]
    constructor
    · funext rd
      rfl
    · funext v d
      simp [gaugeTransformExternalNormalAssignmentsWith,
        childExternalCoordinateShift, sub_eq_add_neg, add_assoc]
  right_inv := by
    intro Aext
    funext ext
    rw [RawNormal.NormalAssignment.mk.injEq]
    constructor
    · funext rd
      rfl
    · funext v d
      simp [gaugeTransformExternalNormalAssignmentsWith,
        childExternalCoordinateShift, sub_eq_add_neg, add_assoc]

