theorem cyclicPrevDiff_range_eq_totalSum_ker
    {n : Nat} [NeZero n] (M : Type)
    [AddCommGroup M] [Module F2 M] :
    LinearMap.range (cyclicPrevDiff n M) =
      LinearMap.ker (RawLinearAlgebra.totalSumLinear n M) := by
  classical
