                  (n := n) (a := b) (cs := ds)
                  (RawNormal.childDataFamilyWithAt
                    (n := n) (a := b) (cs := ds) i (H d i)) })
          d site (RawNormal.childNonRootVertexAtInNode (a := b) i u).1
