theorem boundaryInternalFactorization_of_childLocalCopyFactorEmbeddingIndicators
    {a : Nat} {cs : List RTree} {n : Nat} [NeZero n]
    (_ha : 0 < a)
    (hchildren : ∀ C ∈ cs, RawExpandedOpenRootSubtreeCert C)
    (e :
      OpenRootMessageSpace n cs ↪
        RawNormal.NodeRootFieldAssignment n a cs)
    (hchild :
      ∀ (R : RawNormal.NodeRootFieldAssignment n a cs) (i : ChildIdx cs),
        (∑ h : RawNormal.NodeChildDataAt n a cs i,
          RawNormal.childBoundaryInternalContributionGivenRootDataAt
            (n := n) (a := a) cs R i h) =
          RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopyFactorAt
            n a cs i *
            indicatorZ (∃ M : OpenRootMessageSpace n cs, e M = R)) :
    (∑ A : RawNormal.NormalAssignment n (RTree.node a cs),
      bitSign (RawNormal.nodeBoundaryPhase a cs A) *
        bitSign (RawNormal.nodeInternalPhase a cs A)) =
      (2 : ℤ) ^ Int.toNat
        (localCombinatorialNodeExponent n a cs) := by
  classical
  cases cs with
  | nil =>
      calc
        (∑ A : RawNormal.NormalAssignment n (RTree.node a []),
          bitSign (RawNormal.nodeBoundaryPhase a [] A) *
            bitSign (RawNormal.nodeInternalPhase a [] A)) =
            (2 : ℤ) := by
              simp [RawNormal.nodeBoundaryPhase, RawNormal.nodeInternalPhase,
                RawNormal.card_normalAssignment_leaf n a]
        _ = (2 : ℤ) ^ Int.toNat
            (localCombinatorialNodeExponent n a []) := by
              simp [localCombinatorialNodeExponent, independentBranchDimension,
                childContribSumWith]
  | cons C rest =>
      let Q :
          RawNormal.NodeRootFieldAssignment n a (C :: rest) →
            (i : ChildIdx (C :: rest)) → Prop :=
        fun R _ => ∃ M : OpenRootMessageSpace n (C :: rest), e M = R
      haveI : Nonempty (ChildIdx (C :: rest)) := ⟨0⟩
      have hcard :
          Fintype.card
              { R : RawNormal.NodeRootFieldAssignment n a (C :: rest) //
                ∀ i, Q R i } =
            Fintype.card (OpenRootMessageSpace n (C :: rest)) := by
        calc
          Fintype.card
              { R : RawNormal.NodeRootFieldAssignment n a (C :: rest) //
                ∀ i, Q R i } =
              Fintype.card
                { R : RawNormal.NodeRootFieldAssignment n a (C :: rest) //
                  ∃ M : OpenRootMessageSpace n (C :: rest), e M = R } := by
                exact card_subtype_forall_const
                  (α := RawNormal.NodeRootFieldAssignment n a (C :: rest))
                  (ι := ChildIdx (C :: rest))
                  (fun R =>
                    ∃ M : OpenRootMessageSpace n (C :: rest), e M = R)
          _ = Fintype.card (OpenRootMessageSpace n (C :: rest)) := by
                exact card_subtype_embeddingRange e
      exact
        boundaryInternalFactorization_of_childLocalCopyFactorIndicators
          (n := n) (a := a) (cs := C :: rest) hchildren Q
          (by
            intro R i
            simpa [Q] using hchild R i)
          hcard

