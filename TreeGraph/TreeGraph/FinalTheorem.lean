theorem nodeChildRootFieldDomainDecompose_injective
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs) :
    Function.Injective
      (nodeChildRootFieldDomainDecompose (n := n) (a := a) (cs := cs) i) := by
  classical
  intro d e h
  cases d with
  | mk droot ddiag dother =>
  cases e with
  | mk eroot ediag eother =>
  have hroot : droot = eroot :=
    congrArg (fun x => x.1.rootCoord) h
  have hdiag : ddiag = ediag :=
    congrArg (fun x => x.1.childRootDiagonal) h
  subst eroot
  subst ediag
  congr
  funext u j
  exact
    (childRootOther_cases (a := a) (cs := cs) i u
      (P := fun u => ∀ j, dother u j = eother u j)
      (by
        intro p j
        have hsj :=
          congrArg
            (fun x =>
              x.1.siblingCoord p
                (by
                  simpa [childRootOtherSplitToOtherNonRootVertex] using j))
            h
        simpa [nodeChildRootFieldDomainDecompose,
          childRootOtherSplitToOtherNonRootVertex] using hsj)
      (by
        intro v j
        have hvj :=
          congrArg
            (fun x =>
              x.2 v
                (by
                  simpa [childRootOtherSplitToOtherNonRootVertex] using j))
            h
        simpa [nodeChildRootFieldDomainDecompose,
          childRootOtherSplitToOtherNonRootVertex] using hvj)) j

noncomputable def childExternalRootFieldDomainEquivSplit
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs) :
    ChildExternalCoordinate n a cs i ×
        RawNormal.RootFieldDomain n (childAt cs i) ≃
      ((Fin (a - 1) → ZMod n) × ZMod n ×
        ((s : ChildRootOtherSplit cs i) →
          Fin (ChildRootOtherSplit.weight s) → ZMod n)) where
  toFun x :=
    (x.1.rootCoord, x.1.childRootDiagonal, fun s =>
      match s with
      | ChildRootOtherSplit.sibling p => x.1.siblingCoord p
      | ChildRootOtherSplit.childNonRoot v => x.2 v)
  invFun y :=
    ({ rootCoord := y.1
       childRootDiagonal := y.2.1
       siblingCoord := fun p => y.2.2 (ChildRootOtherSplit.sibling p) },
      fun v => y.2.2 (ChildRootOtherSplit.childNonRoot v))
  left_inv := by
    intro x
    cases x with
    | mk ext loc =>
      cases ext
      rfl
  right_inv := by
    intro y
    cases y with
    | mk root rest =>
      cases rest with
      | mk diagonal other =>
        dsimp
        congr
        funext s j
        cases s <;> rfl

noncomputable def nodeChildRootFieldDomainEquivOther
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs) :
    RawNormal.NodeChildRootFieldDomain n a cs i ≃
      ((Fin (a - 1) → ZMod n) × ZMod n ×
        ((u : RawNormal.OtherNonRootVertex (RTree.node a cs)
          (RawNormal.childRootAtAsNonRootInNode (a := a) i)) →
          Fin (NonRootVertex.weight u.1) → ZMod n)) where
  toFun x := (x.rootCoord, x.diagonal, x.otherCoord)
  invFun y := { rootCoord := y.1, diagonal := y.2.1, otherCoord := y.2.2 }
  left_inv := by
    intro x
    cases x
    rfl
  right_inv := by
    intro y
    cases y with
    | mk root rest =>
      cases rest
      rfl

noncomputable def childRootOtherSplitCoordEquivOther
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs) :
    ((s : ChildRootOtherSplit cs i) →
        Fin (ChildRootOtherSplit.weight s) → ZMod n) ≃
      ((u : RawNormal.OtherNonRootVertex (RTree.node a cs)
          (RawNormal.childRootAtAsNonRootInNode (a := a) i)) →
        Fin (NonRootVertex.weight u.1) → ZMod n) :=
  Equiv.piCongr (otherRootSplitEquiv (a := a) (cs := cs) i).symm
    (fun s =>
      Equiv.arrowCongr
        (finCongr (by
          show ChildRootOtherSplit.weight s =
            NonRootVertex.weight
              ((childRootOtherSplitToOtherNonRootVertex
                (a := a) (cs := cs) i s).1)
          exact
            (childRootOtherSplitToOtherNonRootVertex_weight
              (a := a) (cs := cs) i s).symm))
        (Equiv.refl (ZMod n)))

noncomputable def nodeChildRootFieldDomainStructuredCardEquiv
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs) :
    RawNormal.NodeChildRootFieldDomain n a cs i ≃
      ChildExternalCoordinate n a cs i ×
        RawNormal.RootFieldDomain n (childAt cs i) :=
  (nodeChildRootFieldDomainEquivOther (n := n) (a := a) (cs := cs) i).trans
    ((Equiv.prodCongr (Equiv.refl _)
      (Equiv.prodCongr (Equiv.refl _)
        (childRootOtherSplitCoordEquivOther
          (n := n) (a := a) (cs := cs) i).symm)).trans
      (childExternalRootFieldDomainEquivSplit
        (n := n) (a := a) (cs := cs) i).symm)

theorem card_nodeChildRootFieldDomain_eq_childExternal_mul_rootFieldDomain
    {n a : Nat} [NeZero n] {cs : List RTree}
