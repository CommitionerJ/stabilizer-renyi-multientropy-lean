theorem childBoundaryCoefficientMap_eq_zero_iff
    {n a : Nat} [NeZero n] {cs : List RTree}
    (R : RawNormal.NodeRootFieldAssignment n a cs) :
    childBoundaryCoefficientMap (n := n) (a := a) cs R = 0 ↔
