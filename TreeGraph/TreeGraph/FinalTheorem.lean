theorem rawExpandedOpenRootSubtreeCert_of_positive_leaf_children_length_le_two
    {a : Nat} {cs : List RTree}
    (ha : 0 < a)
    (hleaf :
      ∀ i : ChildIdx cs,
        ∃ b : Nat, 0 < b ∧ childAt cs i = RTree.node b [])
    (hlen : cs.length ≤ 2) :
    RawExpandedOpenRootSubtreeCert (RTree.node a cs) := by
  cases cs with
  | nil =>
      simpa using RawExpandedOpenRootSubtreeCert.leaf ha
  | cons C rest =>
      cases rest with
      | nil =>
          rcases hleaf (0 : ChildIdx [C]) with ⟨b, hb, hC⟩
          have hCeq : C = RTree.node b [] := by
            simpa [childAt] using hC
          subst C
          simpa using RawExpandedOpenRootSubtreeCert.edge ha hb
      | cons D rest' =>
          cases rest' with
          | nil =>
              rcases hleaf (0 : ChildIdx [C, D]) with ⟨b, hb, hC⟩
              rcases hleaf (1 : ChildIdx [C, D]) with ⟨c, hc, hD⟩
              have hCeq : C = RTree.node b [] := by
                simpa [childAt] using hC
              have hDeq : D = RTree.node c [] := by
                simpa [childAt] using hD
              subst C
              subst D
              simpa [StarTree] using
                RawExpandedOpenRootSubtreeCert.star ha hb hc
          | cons E rest'' =>
              have hfalse : False := by
                simpa using hlen
              exact False.elim hfalse

