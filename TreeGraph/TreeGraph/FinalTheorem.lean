theorem nodeChildNonRootFieldDomainDecompose_injective
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs) (hchildRoot : 0 < (childAt cs i).rootWeight)
    (v : NonRootVertex (childAt cs i)) :
    Function.Injective
      (nodeChildNonRootFieldDomainDecompose
        (n := n) (a := a) (cs := cs) i hchildRoot v) := by
  classical
  intro d e h
  cases d with
  | mk droot ddiag dother =>
  cases e with
  | mk eroot ediag eother =>
  have hroot : droot = eroot :=
    congrArg (fun x => x.1.rootCoord) h
  have hdiag : ddiag = ediag :=
    congrArg (fun x => x.2.diagonal) h
  subst eroot
  subst ediag
  congr
  funext u j
  exact
    (childNonRootOther_cases (a := a) (cs := cs) i v u
      (P := fun u => ∀ j, dother u j = eother u j)
      (by
        intro p j
        have hsj :=
          congrArg
            (fun x =>
              x.1.siblingCoord p
                (by
                  simpa [childNonRootOtherSplitToOtherNonRootVertex] using j))
            h
        simpa [nodeChildNonRootFieldDomainDecompose,
          childNonRootOtherSplitToOtherNonRootVertex] using hsj)
      (by
        intro j
        let drootFull : Fin (childAt cs i).rootWeight → ZMod n :=
          fun k =>
            dother (childRootAsOtherNonRoot (a := a) i v)
              (by simpa using k)
        let erootFull : Fin (childAt cs i).rootWeight → ZMod n :=
          fun k =>
            eother (childRootAsOtherNonRoot (a := a) i v)
              (by simpa using k)
        have hpair :
            fullCoordinateWithDiagonalEquivOfPos
                (childAt cs i).rootWeight n hchildRoot drootFull =
              fullCoordinateWithDiagonalEquivOfPos
                (childAt cs i).rootWeight n hchildRoot erootFull := by
          ext k
          · have hk :=
              congrArg
                (fun x => x.2.rootCoord k)
                h
            simpa [nodeChildNonRootFieldDomainDecompose,
              drootFull, erootFull] using hk
          · have hk :=
              congrArg
                (fun x => x.1.childRootDiagonal)
                h
            simpa [nodeChildNonRootFieldDomainDecompose,
              drootFull, erootFull] using hk
        have hfull : drootFull = erootFull :=
          (fullCoordinateWithDiagonalEquivOfPos
            (childAt cs i).rootWeight n hchildRoot).injective hpair
        have hj := congrFun hfull (by simpa using j)
        simpa [drootFull, erootFull] using hj)
      (by
        intro u j
        have huj :=
          congrArg
            (fun x =>
              x.2.otherCoord u
                (by
                  simpa [childNonRootOtherSplitToOtherNonRootVertex] using j))
            h
        simpa [nodeChildNonRootFieldDomainDecompose,
          childNonRootOtherSplitToOtherNonRootVertex] using huj)) j

noncomputable def childExternalNonRootFieldDomainEquivSplit
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs) (hchildRoot : 0 < (childAt cs i).rootWeight)
    (v : NonRootVertex (childAt cs i)) :
    ChildExternalCoordinate n a cs i ×
        RawNormal.NonRootFieldDomain n (childAt cs i) v ≃
      ((Fin (a - 1) → ZMod n) × ZMod n ×
        ((s : ChildNonRootOtherSplit cs i v) →
          Fin (ChildNonRootOtherSplit.weight s) → ZMod n)) where
  toFun x :=
    (x.1.rootCoord, x.2.diagonal, fun s =>
      match s with
      | ChildNonRootOtherSplit.sibling p => x.1.siblingCoord p
      | ChildNonRootOtherSplit.childRoot =>
          (fullCoordinateWithDiagonalEquivOfPos
            (childAt cs i).rootWeight n hchildRoot).symm
            (x.2.rootCoord, x.1.childRootDiagonal)
      | ChildNonRootOtherSplit.childNonRoot u => x.2.otherCoord u)
  invFun y :=
    let rootSplit :=
      fullCoordinateWithDiagonalEquivOfPos
        (childAt cs i).rootWeight n hchildRoot
        (y.2.2 ChildNonRootOtherSplit.childRoot)
    ({ rootCoord := y.1
       childRootDiagonal := rootSplit.2
       siblingCoord := fun p => y.2.2 (ChildNonRootOtherSplit.sibling p) },
      { rootCoord := rootSplit.1
        diagonal := y.2.1
        otherCoord := fun u => y.2.2 (ChildNonRootOtherSplit.childNonRoot u) })
  left_inv := by
    intro x
    cases x with
    | mk ext loc =>
      cases ext with
      | mk eroot ediag esib =>
      cases loc with
      | mk lroot ldiag lother =>
        dsimp
        have hright :=
          (fullCoordinateWithDiagonalEquivOfPos
            (childAt cs i).rootWeight n hchildRoot).right_inv
            (lroot, ediag)
        have hroot := congrArg Prod.fst hright
        have hdiag := congrArg Prod.snd hright
        ext <;> simp [hroot, hdiag]
  right_inv := by
    intro y
    cases y with
    | mk root rest =>
      cases rest with
      | mk diagonal other =>
        dsimp
        congr
        funext s j
        cases s with
        | sibling p => rfl
        | childRoot =>
            have hleft :=
              (fullCoordinateWithDiagonalEquivOfPos
                (childAt cs i).rootWeight n hchildRoot).left_inv
                (other ChildNonRootOtherSplit.childRoot)
            exact congrFun hleft j
        | childNonRoot u => rfl

