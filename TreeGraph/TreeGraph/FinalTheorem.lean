            (n := n) (a := a) (cs := cs) i).symm Acyc)) =
        ∑ base : ChildExternalBaseCoordinate n a cs i,
          cyclicRootTwistedPhaseForBase
            (n := n) (a := a) (cs := cs) i (Acyc base)) :
    childParentEmbeddedInternalWeight
