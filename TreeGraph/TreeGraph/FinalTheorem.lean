theorem finrank_ker_comp_eq_finrank_ker_add_finrank_range_inf_ker
    {V W Z : Type}
    [AddCommGroup V] [Module F2 V] [FiniteDimensional F2 V]
    [AddCommGroup W] [Module F2 W]
    [AddCommGroup Z] [Module F2 Z]
    (L : V →ₗ[F2] W) (P : W →ₗ[F2] Z) :
    Module.finrank F2 (LinearMap.ker (P.comp L)) =
      Module.finrank F2 (LinearMap.ker L) +
        Module.finrank F2 (↥(LinearMap.range L ⊓ LinearMap.ker P)) := by
  let R := linearMapKerCompToRangeInfKerMap L P
  have hsum := LinearMap.finrank_range_add_finrank_ker R
  have hrange :
      Module.finrank F2 (LinearMap.range R) =
        Module.finrank F2
          (↥(LinearMap.range L ⊓ LinearMap.ker P)) := by
    rw [linearMapKerCompToRangeInfKerMap_range_eq_top L P, finrank_top]
  have hker :
      Module.finrank F2 (LinearMap.ker R) =
        Module.finrank F2 (LinearMap.ker L) :=
    LinearEquiv.finrank_eq
      (linearMapKerCompToRangeInfKerMapKerEquivKer L P)
  rw [hrange, hker] at hsum
  rw [← hsum, Nat.add_comm]

