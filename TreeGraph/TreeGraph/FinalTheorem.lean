theorem ketAtVertex_childVertexAtInNode_independent_root
    {n a : Nat} [NeZero n] {cs : List RTree}
    (R R' : RawNormal.NodeRootFieldAssignment n a cs)
    (i : ChildIdx cs)
    (φ : RawNormal.NodeChildRootFieldDomain n a cs i → F2)
    (ψ :
      (v : NonRootVertex (childAt cs i)) →
        RawNormal.NodeChildNonRootFieldDomain n a cs i v → F2)
    (site : RawNormal.NormalSite n (RTree.node a cs))
    (v : Vertex (childAt cs i)) :
    RawNormal.ketAtVertex
        (RawNormal.assembleNodeAssignment (a := a) (cs := cs) R
          (RawNormal.nodeFieldFromChildDataFamily
            (n := n) (a := a) (cs := cs)
            (RawNormal.childDataFamilyWithAt
              (n := n) (a := a) (cs := cs) i ⟨φ, ψ⟩)))
        site (RawNormal.childVertexAtInNode (a := a) i v) =
      RawNormal.ketAtVertex
        (RawNormal.assembleNodeAssignment (a := a) (cs := cs) R'
          (RawNormal.nodeFieldFromChildDataFamily
            (n := n) (a := a) (cs := cs)
            (RawNormal.childDataFamilyWithAt
              (n := n) (a := a) (cs := cs) i ⟨φ, ψ⟩)))
        site (RawNormal.childVertexAtInNode (a := a) i v) := by
  classical
  by_cases hroot : v.1 = []
  · have hv : v = Vertex.root (childAt cs i) := by
      apply Subtype.ext
      exact hroot
    subst v
    unfold RawNormal.childVertexAtInNode
    rw [RawNormal.ketAtVertex_childRootInNode (a := a)
        (idx := i.1) (cs := cs) (C := childAt cs i)
        (childAt_get?_eq_some cs i),
      RawNormal.ketAtVertex_childRootInNode (a := a)
        (idx := i.1) (cs := cs) (C := childAt cs i)
        (childAt_get?_eq_some cs i)]
    simp [RawNormal.childDataFamilyWithAt]
  · let u : NonRootVertex (childAt cs i) := ⟨v, hroot⟩
    change
      RawNormal.ketAtVertex
          (RawNormal.assembleNodeAssignment R
            (RawNormal.nodeFieldFromChildDataFamily
              (RawNormal.childDataFamilyWithAt i ⟨φ, ψ⟩)))
          site (RawNormal.childVertexAtInNode i u.1) =
        RawNormal.ketAtVertex
          (RawNormal.assembleNodeAssignment R'
            (RawNormal.nodeFieldFromChildDataFamily
              (RawNormal.childDataFamilyWithAt i ⟨φ, ψ⟩)))
          site (RawNormal.childVertexAtInNode i u.1)
    unfold RawNormal.childVertexAtInNode
    rw [RawNormal.ketAtVertex_childNonRootInNode (a := a)
        (idx := i.1) (cs := cs) (C := childAt cs i)
        (childAt_get?_eq_some cs i),
      RawNormal.ketAtVertex_childNonRootInNode (a := a)
        (idx := i.1) (cs := cs) (C := childAt cs i)
        (childAt_get?_eq_some cs i)]
    simp [RawNormal.childDataFamilyWithAt]

