theorem cyclicChildRootTwistedDiffLinearMap_range_iff_totalSum_symm_eq_zero
    {n b : Nat} [NeZero n] (ds : List RTree)
    (Η : ZMod n → CyclicNodeChildRootSliceFamily n b ds) :
    (∃ Φ : CyclicNodeChildRootFamily n b ds,
      cyclicChildRootTwistedDiffLinearMap
        (n := n) (b := b) ds Φ = Η) ↔
      RawLinearAlgebra.totalSumLinear n
        (CyclicNodeChildRootSliceFamily n b ds)
        ((cyclicChildRootTimeDiagonalShiftLinearEquiv
          (n := n) (b := b) ds).symm Η) = 0 := by
  let E := cyclicChildRootFamilyTimeSliceLinearEquiv n b ds
  let S :=
    cyclicChildRootTimeDiagonalShiftLinearEquiv
      (n := n) (b := b) ds
  constructor
  · rintro ⟨Φ, hΦ⟩
    have hprev :
        S.symm Η =
          cyclicPrevDiff n (CyclicNodeChildRootSliceFamily n b ds)
            (S.symm (E Φ)) := by
      rw [← hΦ]
      rw [
        cyclicChildRootTwistedDiffLinearMap_apply_eq_timeDiagonalShift_prevDiff
          (n := n) (b := b) ds Φ]
      simp [S, E]
    rw [hprev]
    change
      (∑ d : ZMod n,
        cyclicPrevDiff n (CyclicNodeChildRootSliceFamily n b ds)
          (S.symm (E Φ)) d) = 0
    exact
      cyclicPrevDiff_sum_zero
        (CyclicNodeChildRootSliceFamily n b ds) (S.symm (E Φ))
  · intro htotal
    have hsum :
        (∑ d : ZMod n, (S.symm Η) d) = 0 := by
      change
        RawLinearAlgebra.totalSumLinear n
          (CyclicNodeChildRootSliceFamily n b ds) (S.symm Η) = 0
      exact htotal
    rcases
        (cyclicPrevDiff_range_iff_sum_zero
          (CyclicNodeChildRootSliceFamily n b ds) (S.symm Η)).2 hsum with
      ⟨Ξ, hΞ⟩
    refine ⟨E.symm (S Ξ), ?_⟩
    rw [
      cyclicChildRootTwistedDiffLinearMap_timeDiagonalShift_eq
        (n := n) (b := b) ds Ξ]
    rw [hΞ]
    simp [S]

