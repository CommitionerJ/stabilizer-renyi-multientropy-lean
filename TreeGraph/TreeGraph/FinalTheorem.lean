@[simp] theorem rootFieldAssignmentContextTupleLinearMap_apply
    {n : Nat} [NeZero n] (T : RTree) (v : NonRootVertex T)
    (R : RawNormal.RootFieldAssignment n T)
    (c : NonRootContext n T v)
    (x : Fin (NonRootVertex.weight v) → ZMod n) :
    rootFieldAssignmentContextTupleLinearMap (n := n) T v R c x =
      R (rootFieldDomainOfNonRootContextTuple
        (n := n) (T := T) v c x) := rfl

theorem rootFieldAssignmentContextTupleLinearMap_context_rootCoord_eq
    {n : Nat} [NeZero n] (T : RTree) (v : NonRootVertex T)
    (R : RawNormal.RootFieldAssignment n T)
    (rootCoord rootCoord' : Fin (T.rootWeight - 1) → ZMod n)
    (otherCoord :
      (u : RawNormal.OtherNonRootVertex T v) →
        Fin (NonRootVertex.weight u.1) → ZMod n)
    (x : Fin (NonRootVertex.weight v) → ZMod n) :
    rootFieldAssignmentContextTupleLinearMap (n := n) T v R
        (rootCoord, otherCoord) x =
      rootFieldAssignmentContextTupleLinearMap (n := n) T v R
        (rootCoord', otherCoord) x := by
  change
    R (rootFieldDomainOfNonRootContextTuple
        (n := n) (T := T) v (rootCoord, otherCoord) x) =
      R (rootFieldDomainOfNonRootContextTuple
        (n := n) (T := T) v (rootCoord', otherCoord) x)
  rfl

theorem rootFieldAssignmentContextTupleLinearMap_injective
    {n : Nat} [NeZero n] (T : RTree) (v : NonRootVertex T) :
    Function.Injective
      (rootFieldAssignmentContextTupleLinearMap (n := n) T v) := by
  intro R S hRS
  funext rd
  let rootCoord : Fin (T.rootWeight - 1) → ZMod n := fun _ => 0
  let c : NonRootContext n T v :=
    rootBoundarySelectedNonRootContext
      (n := n) (T := T) v rootCoord rd
  have happly := congrFun (congrFun hRS c) (rd v)
  simpa [c, rootCoord] using happly

theorem rootFieldAssignmentContextTupleLinearMap_ker_eq_bot
    {n : Nat} [NeZero n] (T : RTree) (v : NonRootVertex T) :
    LinearMap.ker (rootFieldAssignmentContextTupleLinearMap (n := n) T v) =
      ⊥ := by
  exact LinearMap.ker_eq_bot.mpr
    (rootFieldAssignmentContextTupleLinearMap_injective (n := n) T v)

