      cyclicNodeRootBoundaryLayer0 (n := n) (b := b) ds
        (fun d => RawNormal.nodeFieldFromChildDataFamily
          (n := n) (a := b) (cs := ds) (H d)) d rd +
        cyclicNodeRootBoundaryLayer1 (n := n) (b := b) ds
          (fun d => RawNormal.nodeFieldFromChildDataFamily
            (n := n) (a := b) (cs := ds) (H d)) (d - 1) rd =
