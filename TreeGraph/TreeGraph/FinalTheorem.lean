  right_inv :=
    nodeChildRootFieldDomainDecompose_recompose
      (n := n) (a := a) (cs := cs) i

noncomputable def nodeChildRootFieldDomainConsZeroEquivRestSingleton
    {n a : Nat} [NeZero n] (C : RTree) (cs : List RTree) :
    RawNormal.NodeChildRootFieldDomain n a (C :: cs)
        (0 : ChildIdx (C :: cs)) ≃
      ChildVertexFieldDomainFamily n cs ×
        RawNormal.NodeChildRootFieldDomain n a [C]
          (0 : ChildIdx [C]) :=
  ((nodeChildRootFieldDomainStructuredEquiv
      (n := n) (a := a) (cs := C :: cs)
      (0 : ChildIdx (C :: cs))).trans
    ((Equiv.prodCongr
      (childExternalCoordinateConsZeroEquivRestSingleton
        (n := n) (a := a) C cs)
      (Equiv.refl _)).trans
      ((prodAssocLeftEquiv _ _ _).trans
        (Equiv.prodCongr (Equiv.refl _)
          (nodeChildRootFieldDomainStructuredEquiv
            (n := n) (a := a) (cs := [C])
            (0 : ChildIdx [C])).symm))))

@[simp] theorem nodeChildRootFieldDomainConsZeroEquivRestSingleton_apply_fst
    {n a : Nat} [NeZero n] (C : RTree) (cs : List RTree)
