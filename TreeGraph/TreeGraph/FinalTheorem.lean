theorem nonRootDomainOfSite_shift_eq_of_subsingleton_zmod
    {n : Nat} [NeZero n] [Subsingleton (ZMod n)] {T : RTree}
    (site : RawNormal.NormalSite n T) (v : NonRootVertex T)
    (s t : ZMod n) :
    RawNormal.nonRootDomainOfSite site v s =
      RawNormal.nonRootDomainOfSite site v t := by
  have hst : s = t := Subsingleton.elim s t
  subst t
  rfl

theorem childBoundaryLinearFormAt_eq_zero_of_subsingleton_zmod
    {n a : Nat} [NeZero n] [Subsingleton (ZMod n)] {cs : List RTree}
    (R : RawNormal.NodeRootFieldAssignment n a cs)
    (i : ChildIdx cs) :
    childBoundaryLinearFormAt (n := n) (a := a) cs R i = 0 := by
  apply LinearMap.ext
  intro φ
  unfold childBoundaryLinearFormAt
  apply Finset.sum_eq_zero
  intro site _hsite
  have hdomain :
      childRootDomainAsNodeChildRootDomain (n := n) (a := a) i
          (RawNormal.nonRootDomainOfSite site
            (RawNormal.childRootAtAsNonRootInNode (a := a) i) 0) =
        childRootDomainAsNodeChildRootDomain (n := n) (a := a) i
          (RawNormal.nonRootDomainOfSite site
            (RawNormal.childRootAtAsNonRootInNode (a := a) i) 1) :=
    congrArg
      (childRootDomainAsNodeChildRootDomain (n := n) (a := a) i)
      (nonRootDomainOfSite_shift_eq_of_subsingleton_zmod
        (n := n) site (RawNormal.childRootAtAsNonRootInNode (a := a) i)
        0 1)
  rw [hdomain]
  exact add_self_eq_zero_of_module_F2
    (R site.nonRootCoord *
      φ (childRootDomainAsNodeChildRootDomain (n := n) (a := a) i
        (RawNormal.nonRootDomainOfSite site
          (RawNormal.childRootAtAsNonRootInNode (a := a) i) 1)))

