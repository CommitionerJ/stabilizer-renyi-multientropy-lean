          (n := n) (T := RTree.node b ds)
          (RawNormal.childRootAtAsNonRootInNode (a := b) j)
          (rootBoundarySelectedNonRootContext
            (n := n) (T := RTree.node b ds)
            (RawNormal.childRootAtAsNonRootInNode (a := b) j)
            (fun _ => 0) rd)
          (firstCoordinateShift
            (n := n)
            (a := NonRootVertex.weight
              (RawNormal.childRootAtAsNonRootInNode (a := b) j))
            hpos shift
            (rd (RawNormal.childRootAtAsNonRootInNode (a := b) j)))) 0 := by
  let v : NonRootVertex (RTree.node b ds) :=
    RawNormal.childRootAtAsNonRootInNode (a := b) j
  let c : NonRootContext n (RTree.node b ds) v :=
    rootBoundarySelectedNonRootContext
      (n := n) (T := RTree.node b ds) v (fun _ => 0) rd
