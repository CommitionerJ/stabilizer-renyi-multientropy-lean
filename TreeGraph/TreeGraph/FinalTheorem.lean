theorem childBoundaryCoefficientKernelCard_of_finrank
    {a : Nat} {cs : List RTree} {n : Nat} [NeZero n]
    (hfin :
      Module.finrank F2
          (LinearMap.ker
            (childBoundaryCoefficientMap (n := n) (a := a) cs)) =
        independentBranchDimension n cs) :
    Nat.card
        (LinearMap.ker
          (childBoundaryCoefficientMap (n := n) (a := a) cs)) =
      Fintype.card (OpenRootMessageSpace n cs) := by
  classical
  have hker :
      Nat.card
          (LinearMap.ker
            (childBoundaryCoefficientMap (n := n) (a := a) cs)) =
        2 ^ independentBranchDimension n cs := by
    calc
      Nat.card
          (LinearMap.ker
            (childBoundaryCoefficientMap (n := n) (a := a) cs)) =
          Nat.card F2 ^
            Module.finrank F2
              (LinearMap.ker
                (childBoundaryCoefficientMap (n := n) (a := a) cs)) := by
            exact Module.natCard_eq_pow_finrank
              (K := F2)
              (V := LinearMap.ker
                (childBoundaryCoefficientMap (n := n) (a := a) cs))
      _ = 2 ^ independentBranchDimension n cs := by
            rw [hfin]
            simp [F2]
  have hopen :
      Fintype.card (OpenRootMessageSpace n cs) =
        2 ^ independentBranchDimension n cs := by
    rw [← Nat.card_eq_fintype_card]
    exact natCard_openRootMessageSpace n cs
  exact hker.trans hopen.symm

theorem childBoundaryCoefficientKernelFinrank_of_card
    {a : Nat} {cs : List RTree} {n : Nat} [NeZero n]
    (hcard :
      Nat.card
          (LinearMap.ker
            (childBoundaryCoefficientMap (n := n) (a := a) cs)) =
        Fintype.card (OpenRootMessageSpace n cs)) :
    Module.finrank F2
        (LinearMap.ker
          (childBoundaryCoefficientMap (n := n) (a := a) cs)) =
      independentBranchDimension n cs := by
  classical
  have hker :
      Nat.card
          (LinearMap.ker
            (childBoundaryCoefficientMap (n := n) (a := a) cs)) =
        2 ^
          Module.finrank F2
            (LinearMap.ker
              (childBoundaryCoefficientMap (n := n) (a := a) cs)) := by
    calc
      Nat.card
          (LinearMap.ker
            (childBoundaryCoefficientMap (n := n) (a := a) cs)) =
          Nat.card F2 ^
            Module.finrank F2
              (LinearMap.ker
                (childBoundaryCoefficientMap (n := n) (a := a) cs)) := by
            exact Module.natCard_eq_pow_finrank
              (K := F2)
              (V := LinearMap.ker
                (childBoundaryCoefficientMap (n := n) (a := a) cs))
      _ =
          2 ^
            Module.finrank F2
              (LinearMap.ker
                (childBoundaryCoefficientMap (n := n) (a := a) cs)) := by
            simp [F2]
  have hopen :
      Fintype.card (OpenRootMessageSpace n cs) =
        2 ^ independentBranchDimension n cs :=
    card_openRootMessageSpace n cs
  have hpowers :
      2 ^
          Module.finrank F2
            (LinearMap.ker
              (childBoundaryCoefficientMap (n := n) (a := a) cs)) =
        2 ^ independentBranchDimension n cs := by
    exact hker.symm.trans (hcard.trans hopen)
  exact (Nat.pow_right_injective (by norm_num : 2 ≤ 2)) hpowers

