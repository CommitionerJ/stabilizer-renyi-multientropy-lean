    intro C hmem
    exact
      RawExpandedOpenRootSubtreeCert.positiveWeights
        (hchildrenCert C hmem)
  have hYcast :
      ((independentBranchDimension n ds : Nat) : ℤ) =
        Yassign n (RTree.node b ds) :=
    independentBranchDimension_cast_eq_Yassign_node
      (n := n) hb hchildrenPos
  have hVeq :=
    finrank_cyclicNodeChildRootSliceFamily_eq_childInternalCoordinateExponentNat_leaf_children
      (n := n) (b := b) ds hb hleaf
  have hVcast :
      ((Module.finrank F2
          (CyclicNodeChildRootSliceFamily n b ds) : Nat) : ℤ) =
        childContribSumWith (Xassign n) n b ds 0 := by
    rw [hVeq]
    exact
      RawExpandedOpenRootSubtreeCert.childInternalCoordinateExponentNat_cast_eq_childContribSumWith
        n b ds 0 hchildrenCert
  have hsumCast :
      (((independentBranchDimension n ds +
          Module.finrank F2
            (CyclicNodeChildRootSliceFamily n b ds) : Nat) : ℤ)) =
        Xassign n (RTree.node b ds) := by
    rw [Nat.cast_add, hYcast, hVcast]
    rw [childContribSumWith_Xassign]
    exact (Xassign_node n b ds).symm
  have hnonneg : 0 ≤ Xassign n (RTree.node b ds) := by
    rw [← hsumCast]
    exact Int.natCast_nonneg _
  have htoNatCast :
      (((Int.toNat (Xassign n (RTree.node b ds)) : Nat) : ℤ)) =
        Xassign n (RTree.node b ds) := by
    exact Int.toNat_of_nonneg hnonneg
  have hcast :
      (((independentBranchDimension n ds +
          Module.finrank F2
            (CyclicNodeChildRootSliceFamily n b ds) : Nat) : ℤ)) =
        ((Int.toNat (Xassign n (RTree.node b ds)) : Nat) : ℤ) := by
    exact hsumCast.trans htoNatCast.symm
  exact_mod_cast hcast

noncomputable def cyclicPrevDiff (n : Nat) [NeZero n] (M : Type)
    [AddCommGroup M] [Module F2 M] :
    (ZMod n → M) →ₗ[F2] (ZMod n → M) where
  toFun f := fun d => f d + f (d - 1)
  map_add' f g := by
    ext d
    simp [Pi.add_apply, add_assoc, add_left_comm, add_comm]
  map_smul' r f := by
    ext d
    simp [Pi.smul_apply, smul_add]

@[simp] theorem cyclicPrevDiff_apply
    {n : Nat} [NeZero n] {M : Type}
    [AddCommGroup M] [Module F2 M]
    (f : ZMod n → M) (d : ZMod n) :
    cyclicPrevDiff n M f d = f d + f (d - 1) := rfl

theorem sum_childRootDiagonalFiber_firstCoordinateDiff_eq_cyclicPrevDiff_fiberSum
    {n b : Nat} [NeZero n] (ds : List RTree)
    (j : ChildIdx ds)
    (hpos :
      0 < NonRootVertex.weight
        (RawNormal.childRootAtAsNonRootInNode (a := b) j))
    (R : RawNormal.NodeRootFieldAssignment n b ds)
    (c : NonRootContext n (RTree.node b ds)
      (RawNormal.childRootAtAsNonRootInNode (a := b) j))
    (t : ZMod n) :
    (∑ x : { x : Fin (NonRootVertex.weight
          (RawNormal.childRootAtAsNonRootInNode (a := b) j)) → ZMod n //
        RawLinearAlgebra.diagSum
          (NonRootVertex.weight
            (RawNormal.childRootAtAsNonRootInNode (a := b) j)) n x = t },
      rootFieldAssignmentChildRootFirstCoordinateDiffLinearMap
        (n := n) (b := b) ds j hpos (1 : ZMod n) R
        (rootFieldDomainOfNonRootContextTuple
          (n := n) (T := RTree.node b ds)
          (RawNormal.childRootAtAsNonRootInNode (a := b) j) c x.1)) =
      cyclicPrevDiff n F2
        (RawLinearAlgebra.fiberSum
          (NonRootVertex.weight
            (RawNormal.childRootAtAsNonRootInNode (a := b) j)) n F2
          (fun x =>
            R (rootFieldDomainOfNonRootContextTuple
              (n := n) (T := RTree.node b ds)
              (RawNormal.childRootAtAsNonRootInNode (a := b) j) c x)))
        t := by
  classical
  let v := RawNormal.childRootAtAsNonRootInNode (a := b) j
  let f : (Fin (NonRootVertex.weight v) → ZMod n) → F2 :=
    fun x =>
      R (rootFieldDomainOfNonRootContextTuple
        (n := n) (T := RTree.node b ds) v c x)
  let shiftedF : (Fin (NonRootVertex.weight v) → ZMod n) → F2 :=
    fun x =>
      f (firstCoordinateShift
        (n := n) (a := NonRootVertex.weight v) hpos (-1 : ZMod n) x)
  calc
    (∑ x : { x : Fin (NonRootVertex.weight
          (RawNormal.childRootAtAsNonRootInNode (a := b) j)) → ZMod n //
        RawLinearAlgebra.diagSum
          (NonRootVertex.weight
            (RawNormal.childRootAtAsNonRootInNode (a := b) j)) n x = t },
      rootFieldAssignmentChildRootFirstCoordinateDiffLinearMap
        (n := n) (b := b) ds j hpos (1 : ZMod n) R
        (rootFieldDomainOfNonRootContextTuple
          (n := n) (T := RTree.node b ds)
          (RawNormal.childRootAtAsNonRootInNode (a := b) j) c x.1)) =
        ∑ y : { x : Fin (NonRootVertex.weight v) → ZMod n //
          RawLinearAlgebra.diagSum (NonRootVertex.weight v) n x = t },
          (f y.1 + shiftedF y.1) := by
        refine Finset.sum_congr rfl ?_
        intro x _hx
        rw [rootFieldAssignmentChildRootFirstCoordinateDiffLinearMap_apply]
        rw [rootFieldDomainChildRootFirstCoordinateShiftEquiv_symm_contextTuple
          (n := n) (b := b) ds j hpos (1 : ZMod n) c x.1]
    _ =
        (∑ y : { x : Fin (NonRootVertex.weight v) → ZMod n //
          RawLinearAlgebra.diagSum (NonRootVertex.weight v) n x = t },
          f y.1) +
        (∑ y : { x : Fin (NonRootVertex.weight v) → ZMod n //
          RawLinearAlgebra.diagSum (NonRootVertex.weight v) n x = t },
          shiftedF y.1) := by
        rw [Finset.sum_add_distrib]
    _ =
        RawLinearAlgebra.fiberSum
          (NonRootVertex.weight v) n F2 f t +
        (∑ y : { x : Fin (NonRootVertex.weight v) → ZMod n //
          RawLinearAlgebra.diagSum (NonRootVertex.weight v) n x = t },
          shiftedF y.1) := by
        simp [RawLinearAlgebra.fiberSum_apply]
    _ =
        RawLinearAlgebra.fiberSum
          (NonRootVertex.weight v) n F2 f t +
        RawLinearAlgebra.fiberSum
          (NonRootVertex.weight v) n F2 f (t - 1) := by
        congr 1
        simpa [shiftedF, sub_eq_add_neg] using
          (sum_diagFiber_firstCoordinateShift_eq_fiberSum
            (n := n) hpos (-1 : ZMod n) t f)
    _ =
      cyclicPrevDiff n F2
        (RawLinearAlgebra.fiberSum
          (NonRootVertex.weight
            (RawNormal.childRootAtAsNonRootInNode (a := b) j)) n F2
          (fun x =>
            R (rootFieldDomainOfNonRootContextTuple
              (n := n) (T := RTree.node b ds)
              (RawNormal.childRootAtAsNonRootInNode (a := b) j) c x)))
        t := by
        simp [cyclicPrevDiff_apply, f, v]

theorem childBoundaryCoefficientMap_mem_ker_iff_forall_context_fiberSum_cyclicPrevDiff
    {n b : Nat} [NeZero n] (ds : List RTree)
    (hpos :
      ∀ j : ChildIdx ds,
        0 < NonRootVertex.weight
          (RawNormal.childRootAtAsNonRootInNode (a := b) j))
    (R : RawNormal.NodeRootFieldAssignment n b ds) :
    R ∈ LinearMap.ker
        (childBoundaryCoefficientMap (n := n) (a := b) ds) ↔
      ∀ (j : ChildIdx ds)
        (c : NonRootContext n (RTree.node b ds)
          (RawNormal.childRootAtAsNonRootInNode (a := b) j))
        (t : ZMod n),
        cyclicPrevDiff n F2
          (RawLinearAlgebra.fiberSum
            (NonRootVertex.weight
              (RawNormal.childRootAtAsNonRootInNode (a := b) j)) n F2
            (fun x =>
              R (rootFieldDomainOfNonRootContextTuple
                (n := n) (T := RTree.node b ds)
                (RawNormal.childRootAtAsNonRootInNode (a := b) j) c x)))
          t = 0 := by
  rw [childBoundaryCoefficientMap_mem_ker_iff_forall_factor_childRootDiagonalFiber
    (n := n) (b := b) ds hpos R]
  constructor
  · intro hcoords j c t
    let d : RawNormal.NodeChildRootFieldDomain n b ds j :=
      { rootCoord := c.1
        diagonal := t
        otherCoord := c.2 }
    have hd :
        (∑ x : { x : Fin (NonRootVertex.weight
              (RawNormal.childRootAtAsNonRootInNode (a := b) j)) → ZMod n //
            RawLinearAlgebra.diagSum
              (NonRootVertex.weight
                (RawNormal.childRootAtAsNonRootInNode (a := b) j)) n x = t },
          rootFieldAssignmentChildRootFirstCoordinateDiffLinearMap
            (n := n) (b := b) ds j (hpos j) (1 : ZMod n) R
            (rootFieldDomainOfNonRootContextTuple
              (n := n) (T := RTree.node b ds)
              (RawNormal.childRootAtAsNonRootInNode (a := b) j)
              c x.1)) = 0 := by
      simpa [d] using hcoords j d
    have hbridge :=
      sum_childRootDiagonalFiber_firstCoordinateDiff_eq_cyclicPrevDiff_fiberSum
        (n := n) (b := b) ds j (hpos j) R c t
    exact hbridge.symm.trans hd
  · intro hcyc j d
    let c : NonRootContext n (RTree.node b ds)
        (RawNormal.childRootAtAsNonRootInNode (a := b) j) :=
      (d.rootCoord, d.otherCoord)
    have hbridge :=
      sum_childRootDiagonalFiber_firstCoordinateDiff_eq_cyclicPrevDiff_fiberSum
        (n := n) (b := b) ds j (hpos j) R c d.diagonal
    have hzero :
        cyclicPrevDiff n F2
          (RawLinearAlgebra.fiberSum
            (NonRootVertex.weight
              (RawNormal.childRootAtAsNonRootInNode (a := b) j)) n F2
            (fun x =>
              R (rootFieldDomainOfNonRootContextTuple
                (n := n) (T := RTree.node b ds)
                (RawNormal.childRootAtAsNonRootInNode (a := b) j) c x)))
          d.diagonal = 0 := by
      simpa [c] using hcyc j c d.diagonal
    exact hbridge.trans hzero

noncomputable def zmodPredTimeLinearEquiv
    (n : Nat) [NeZero n] (M : Type)
    [AddCommGroup M] [Module F2 M] :
    (ZMod n → M) ≃ₗ[F2] (ZMod n → M) where
  toFun f := fun d => f (d - 1)
  invFun f := fun d => f (d + 1)
  left_inv f := by
    funext d
    simp [sub_eq_add_neg, add_assoc]
  right_inv f := by
    funext d
    simp [sub_eq_add_neg, add_assoc]
  map_add' f g := by
    funext d
    rfl
  map_smul' r f := by
    funext d
    rfl

@[simp] theorem zmodPredTimeLinearEquiv_apply
    {n : Nat} [NeZero n] {M : Type}
    [AddCommGroup M] [Module F2 M]
    (f : ZMod n → M) (d : ZMod n) :
    zmodPredTimeLinearEquiv n M f d = f (d - 1) := rfl

@[simp] theorem zmodPredTimeLinearEquiv_symm_apply
    {n : Nat} [NeZero n] {M : Type}
    [AddCommGroup M] [Module F2 M]
    (f : ZMod n → M) (d : ZMod n) :
    (zmodPredTimeLinearEquiv n M).symm f d = f (d + 1) := rfl

theorem cyclicPrevDiff_eq_predTime_comp_cyclicDiff
    (n : Nat) [NeZero n] (M : Type)
    [AddCommGroup M] [Module F2 M] :
    cyclicPrevDiff n M =
      (zmodPredTimeLinearEquiv n M).toLinearMap.comp
        (RawLinearAlgebra.cyclicDiff n M) := by
  apply LinearMap.ext
  intro f
  funext d
  simp [cyclicPrevDiff, RawLinearAlgebra.cyclicDiff,
    sub_eq_add_neg, add_assoc, add_comm]

theorem cyclicPrevDiff_eq_zero_iff_cyclicDiff_eq_zero
    {n : Nat} [NeZero n] (M : Type)
    [AddCommGroup M] [Module F2 M]
    (f : ZMod n → M) :
    cyclicPrevDiff n M f = 0 ↔
      RawLinearAlgebra.cyclicDiff n M f = 0 := by
  constructor
  · intro hzero
    ext d
    have hd := congrFun hzero (d + 1)
    simpa [cyclicPrevDiff, RawLinearAlgebra.cyclicDiff,
      sub_eq_add_neg, add_assoc, add_comm] using hd
  · intro hzero
    ext d
    have hd := congrFun hzero (d - 1)
    simpa [cyclicPrevDiff, RawLinearAlgebra.cyclicDiff,
      sub_eq_add_neg, add_assoc, add_comm] using hd

theorem childBoundaryCoefficientMap_mem_ker_iff_forall_context_fiberSum_cyclicDiff
    {n b : Nat} [NeZero n] (ds : List RTree)
    (hpos :
      ∀ j : ChildIdx ds,
        0 < NonRootVertex.weight
          (RawNormal.childRootAtAsNonRootInNode (a := b) j))
    (R : RawNormal.NodeRootFieldAssignment n b ds) :
    R ∈ LinearMap.ker
