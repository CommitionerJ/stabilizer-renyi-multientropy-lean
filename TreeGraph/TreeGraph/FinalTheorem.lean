        (assignmentFactorProductExponent n (RTree.node a cs))

theorem rootFactorKernelFinrank_of_childCerts
    {a n : Nat} [NeZero n] {cs : List RTree}
    (ha : 0 < a)
    (hchildren : ∀ C ∈ cs, RawExpandedOpenRootSubtreeCert C) :
    ((Module.finrank F2 (OpenRootMessageSpace n cs) : Nat) : ℤ) =
      Yassign n (RTree.node a cs) := by
  have hchildPos : ∀ C ∈ cs, RTree.PositiveWeights C := by
    intro C hC
    exact RawExpandedOpenRootSubtreeCert.positiveWeights
      (hchildren C hC)
  exact finrank_openRootMessageSpace_cast_eq_Yassign_node
    (n := n) ha hchildPos

theorem rootFactorKernelCard_of_childCerts
    {a n : Nat} [NeZero n] {cs : List RTree}
    (ha : 0 < a)
    (hchildren : ∀ C ∈ cs, RawExpandedOpenRootSubtreeCert C) :
    Fintype.card (OpenRootMessageSpace n cs) =
      2 ^ Int.toNat (Yassign n (RTree.node a cs)) := by
  have hchildPos : ∀ C ∈ cs, RTree.PositiveWeights C := by
