theorem boundaryInternal_sum_singleLeaf_eq_copyFactor_mul_boundaryZeroCard
    {a b n : Nat} [NeZero n] (ha : 0 < a) (hb : 0 < b) :
    (∑ A : RawNormal.NormalAssignment n
        (RTree.node a [RTree.node b []]),
      bitSign (RawNormal.nodeBoundaryPhase a [RTree.node b []] A) *
        bitSign (RawNormal.nodeInternalPhase a [RTree.node b []] A)) =
      RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopyFactorAt
        n a [RTree.node b []] (0 : ChildIdx [RTree.node b []]) *
        (Fintype.card
          { R : RawNormal.NodeRootFieldAssignment n a [RTree.node b []] //
            childBoundaryLinearFormAt
              (n := n) (a := a) [RTree.node b []] R
                (0 : ChildIdx [RTree.node b []]) = 0 } : ℤ) := by
  classical
  let cf :=
    RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopyFactorAt
      n a [RTree.node b []] (0 : ChildIdx [RTree.node b []])
  calc
    (∑ A : RawNormal.NormalAssignment n
        (RTree.node a [RTree.node b []]),
      bitSign (RawNormal.nodeBoundaryPhase a [RTree.node b []] A) *
        bitSign (RawNormal.nodeInternalPhase a [RTree.node b []] A)) =
        ∑ R : RawNormal.NodeRootFieldAssignment n a [RTree.node b []],
          ∏ i : ChildIdx [RTree.node b []],
            ∑ h : RawNormal.NodeChildDataAt n a [RTree.node b []] i,
              RawNormal.childBoundaryInternalContributionGivenRootDataAt
                (n := n) (a := a) [RTree.node b []] R i h := by
          exact
            RawNormal.boundaryInternal_explicit_sum_eq_sum_root_product_child_sums
              (n := n) (a := a) [RTree.node b []]
    _ =
        ∑ R : RawNormal.NodeRootFieldAssignment n a [RTree.node b []],
          cf * indicatorZ
            (childBoundaryLinearFormAt
              (n := n) (a := a) [RTree.node b []] R
                (0 : ChildIdx [RTree.node b []]) = 0) := by
          refine Finset.sum_congr rfl ?_
          intro R _
          calc
            (∏ i : ChildIdx [RTree.node b []],
              ∑ h : RawNormal.NodeChildDataAt n a [RTree.node b []] i,
                RawNormal.childBoundaryInternalContributionGivenRootDataAt
                  (n := n) (a := a) [RTree.node b []] R i h) =
                ∏ i : ChildIdx [RTree.node b []],
                  childLinearizedContributionSumAt
                    (n := n) (a := a) [RTree.node b []] R i := by
                  refine Finset.prod_congr rfl ?_
                  intro i _
                  exact
                    childLocalContributionSum_eq_linearizedContributionSumAt
                      (n := n) (a := a) (cs := [RTree.node b []]) R i
            _ =
                childLinearizedContributionSumAt
                  (n := n) (a := a) [RTree.node b []] R
                  (0 : ChildIdx [RTree.node b []]) := by
                  rw [Finset.prod_eq_single
                    (0 : ChildIdx [RTree.node b []])]
                  · intro i _ hi
                    have hi0 :
                        i = (0 : ChildIdx [RTree.node b []]) := by
                      apply Fin.ext
                      change i.1 = 0
                      have hlt : i.1 < 1 := by
                        simpa using i.2
                      omega
                    exact False.elim (hi hi0)
                  · intro hnot
                    exact False.elim (hnot (by simp))
            _ =
                cf * indicatorZ
                  (childBoundaryLinearFormAt
                    (n := n) (a := a) [RTree.node b []] R
                      (0 : ChildIdx [RTree.node b []]) = 0) := by
                  simpa [cf] using
                    childLinearizedContributionSumAt_leaf_child_eq_copyFactor_mul_boundaryZero_indicator
                      (n := n) (a := a) (b := b) R
                      (0 : ChildIdx [RTree.node b []]) ha hb rfl
    _ =
        cf *
          ∑ R : RawNormal.NodeRootFieldAssignment n a [RTree.node b []],
            indicatorZ
              (childBoundaryLinearFormAt
                (n := n) (a := a) [RTree.node b []] R
                  (0 : ChildIdx [RTree.node b []]) = 0) := by
          rw [Finset.mul_sum]
    _ =
        cf *
          (Fintype.card
            { R : RawNormal.NodeRootFieldAssignment n a [RTree.node b []] //
              childBoundaryLinearFormAt
                (n := n) (a := a) [RTree.node b []] R
                  (0 : ChildIdx [RTree.node b []]) = 0 } : ℤ) := by
          rw [sum_indicatorZ_subtype]

noncomputable def boundaryZeroRootFieldSingleLeafForallEquivSingle
    (n a b : Nat) [NeZero n] :
    { R : RawNormal.NodeRootFieldAssignment n a [RTree.node b []] //
      ∀ i : ChildIdx [RTree.node b []],
        childBoundaryLinearFormAt
          (n := n) (a := a) [RTree.node b []] R i = 0 } ≃
    { R : RawNormal.NodeRootFieldAssignment n a [RTree.node b []] //
      childBoundaryLinearFormAt
        (n := n) (a := a) [RTree.node b []] R
          (0 : ChildIdx [RTree.node b []]) = 0 } where
  toFun R := ⟨R.1, R.2 (0 : ChildIdx [RTree.node b []])⟩
  invFun R :=
    ⟨R.1, by
      intro i
      have hi0 : i = (0 : ChildIdx [RTree.node b []]) := by
        apply Fin.ext
        change i.1 = 0
        have hlt : i.1 < 1 := by
          simpa using i.2
        omega
      rw [hi0]
      exact R.2⟩
  left_inv R := by
    exact Subtype.ext rfl
  right_inv R := by
    exact Subtype.ext rfl

