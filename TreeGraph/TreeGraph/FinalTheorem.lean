    subst C
    exact hnodeCert
  have hb : 0 < b := by
    have hpos := RawExpandedOpenRootSubtreeCert.positiveWeights hnodeCert
    have hparts : 0 < b ∧ ∀ C ∈ ds, RTree.PositiveWeights C := by
      simpa [RTree.PositiveWeights] using hpos
    exact hparts.1
  let i0 : ChildIdx [RTree.node b ds] := 0
  have hchild0 : childAt [RTree.node b ds] i0 = RTree.node b ds := by
    simp [i0]
  have hroot0 : 0 < (childAt [RTree.node b ds] i0).rootWeight := by
    simpa [i0, RTree.rootWeight] using hb
  have htwisted :=
    hrule (a := 1) (cs := [RTree.node b ds])
      (by norm_num) hchildren0 n i0
  have hsingle :=
    twistedExternalChildInternalSum_singleton_eq_cyclicRootTwistedSum
      (n := n) (b := b) ds hroot0
  rw [hsingle] at htwisted
  have hcard :
      Fintype.card
        (ChildExternalCoordinate n 1 [RTree.node b ds] i0) =
      Fintype.card (ZMod n) := by
    simpa [i0] using
      Fintype.card_congr
        (singletonChildExternalCoordinateEquivZMod n b ds)
  rw [hcard] at htwisted
  have hzero0 :=
    cyclicRootTwistedSum_node_child_eq_zeroBranch
      (n := n) (a := 1) (b := b) (cs := [RTree.node b ds])
      i0 (singletonChildExternalBaseCoordinate n b ds)
      hroot0 hchild0
  rw [hzero0] at htwisted
  have hzero :=
    cyclicRootTwistedSum_node_child_eq_zeroBranch
      (n := n) (a := a) (b := b) (cs := cs)
      i base hchildRoot hchild
  rw [hzero]
  simpa [hchild, hchild0, i0] using htwisted

