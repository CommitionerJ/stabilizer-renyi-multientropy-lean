theorem childBoundaryLinearFormAt_eq_sum_rootBoundaryChildMessageSums
    {n b : Nat} [NeZero n] (ds : List RTree)
    (R : RawNormal.NodeRootFieldAssignment n b ds)
    (j : ChildIdx ds)
    (φ : RawNormal.NodeChildRootFieldDomain n b ds j → F2) :
    childBoundaryLinearFormAt (n := n) (a := b) ds R j φ =
      ∑ rd : RawNormal.RootFieldDomain n (RTree.node b ds),
        R rd *
          (rootBoundaryChildMessageSumAt (n := n) (b := b) ds j φ rd 0 +
            rootBoundaryChildMessageSumAt
              (n := n) (b := b) ds j φ rd 1) := by
  classical
  let D := RawNormal.RootFieldDomain n (RTree.node b ds)
  let single : D → D → F2 :=
    fun rd =>
      Pi.single (M := fun _ : D => F2) rd (1 : F2)
  have hR : R = ∑ rd : D, R rd • single rd := by
    simpa [D, single] using function_eq_sum_single D R
  calc
    childBoundaryLinearFormAt (n := n) (a := b) ds R j φ =
        childBoundaryLinearFormAt
          (n := n) (a := b) ds (∑ rd : D, R rd • single rd) j φ := by
          exact congrArg
            (fun R' =>
              childBoundaryLinearFormAt (n := n) (a := b) ds R' j φ) hR
    _ =
        ((childBoundaryLinearMapAt (n := n) (a := b) ds j)
          (∑ rd : D, R rd • single rd)) φ := rfl
    _ =
        (∑ rd : D,
          (childBoundaryLinearMapAt (n := n) (a := b) ds j)
            (R rd • single rd)) φ := by
          rw [map_sum]
    _ =
        ∑ rd : D,
          R rd *
            childBoundaryLinearFormAt
              (n := n) (a := b) ds (single rd) j φ := by
          simp [smul_eq_mul]
    _ =
        ∑ rd : D,
          R rd *
            (rootBoundaryChildMessageSumAt
                (n := n) (b := b) ds j φ rd 0 +
              rootBoundaryChildMessageSumAt
                (n := n) (b := b) ds j φ rd 1) := by
          refine Finset.sum_congr rfl ?_
          intro rd _hrd
          rw [childBoundaryLinearFormAt_pi_single_eq_messageSums
            (n := n) (b := b) ds j rd φ]

