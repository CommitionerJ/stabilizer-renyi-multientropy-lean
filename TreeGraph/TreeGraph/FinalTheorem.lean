            ((RTree.indexedChildInternalEdgesFrom [] 0 ds).map
              (cyclicTwistedEdgePhaseAt
                (fun d => { rootField := R d, nodeField := N d })
                d site)).sum := by
          refine Finset.sum_congr rfl ?_
          intro d _
