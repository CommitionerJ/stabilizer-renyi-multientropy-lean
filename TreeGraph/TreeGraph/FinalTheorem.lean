        LinearMap.mem_ker.mp u.2
      rw [
        cyclicChildRootTwistedDiffLinearMap_timeDiagonalShift_eq
          (n := n) (b := b) ds u.1]
      simp [hprev]⟩
  left_inv u := by
    apply Subtype.ext
    simp
  right_inv u := by
    apply Subtype.ext
    simp
