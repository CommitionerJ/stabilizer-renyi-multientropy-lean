theorem sum_bitSign_cyclicNodeRootBoundaryLinearForm_add_const
    {n b : Nat} [NeZero n] (ds : List RTree)
    (N : ZMod n → RawNormal.NodeNonRootFieldAssignment n b ds)
    (C : F2) :
    (∑ R : ZMod n → RawNormal.NodeRootFieldAssignment n b ds,
      bitSign (cyclicNodeRootBoundaryLinearForm (n := n) (b := b) ds N R + C)) =
      bitSign C *
        (if cyclicNodeRootBoundaryLinearForm (n := n) (b := b) ds N = 0 then
          (Fintype.card
            (ZMod n → RawNormal.NodeRootFieldAssignment n b ds) : ℤ)
        else 0) := by
  classical
  let L :=
    cyclicNodeRootBoundaryLinearForm (n := n) (b := b) ds N
  calc
    (∑ R : ZMod n → RawNormal.NodeRootFieldAssignment n b ds,
      bitSign (cyclicNodeRootBoundaryLinearForm (n := n) (b := b) ds N R + C)) =
        ∑ R : ZMod n → RawNormal.NodeRootFieldAssignment n b ds,
          bitSign (L R) * bitSign C := by
          simp [L, bitSign_add]
    _ =
        (∑ R : ZMod n → RawNormal.NodeRootFieldAssignment n b ds,
          bitSign (L R)) * bitSign C := by
          simp [Finset.sum_mul]
    _ =
        (if L = 0 then
          (Fintype.card
            (ZMod n → RawNormal.NodeRootFieldAssignment n b ds) : ℤ)
        else 0) * bitSign C := by
          rw [sum_bitSign_linear L]
    _ =
      bitSign C *
        (if cyclicNodeRootBoundaryLinearForm (n := n) (b := b) ds N = 0 then
          (Fintype.card
            (ZMod n → RawNormal.NodeRootFieldAssignment n b ds) : ℤ)
        else 0) := by
          simp [L, mul_comm]

