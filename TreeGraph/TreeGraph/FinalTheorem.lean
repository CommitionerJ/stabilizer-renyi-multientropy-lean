      (by
        simpa [RawNormal.childNonRootVertexAtInNode_weight] using j) =
      x.2.nonRootCoord v j := by
  have hnot : ¬ v.1.1 = [] := v.2
  have hbase :=
    nodeChildRootFieldDomainRecompose_childRootField
      (n := n) (a := a) (cs := cs) i
      (x := (x.1, x.2.nonRootCoord)) v j
  simpa [nodeChildNormalSiteRecompose, hnot, childNonRootVertexAsOtherRoot]
    using hbase

@[simp] theorem diagonal_nodeChildNormalSiteRecompose_childNonRoot
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs) (hchildRoot : 0 < (childAt cs i).rootWeight)
    (ext : ChildExternalCoordinate n a cs i)
    (site : RawNormal.NormalSite n (childAt cs i))
    (v : NonRootVertex (childAt cs i)) :
    RawNormal.diagonal
        (nodeChildNormalSiteRecompose
          (n := n) (a := a) (cs := cs) i hchildRoot (ext, site))
        (RawNormal.childNonRootVertexAtInNode (a := a) i v) =
      RawNormal.diagonal site v := by
  classical
  unfold RawNormal.diagonal
  let e :
      Fin (NonRootVertex.weight v) ≃
        Fin (NonRootVertex.weight
          (RawNormal.childNonRootVertexAtInNode (a := a) i v)) :=
    Equiv.cast (by
      rw [RawNormal.childNonRootVertexAtInNode_weight (a := a) i v])
  have hreindex :
      (∑ j : Fin (NonRootVertex.weight v),
        (nodeChildNormalSiteRecompose
          (n := n) (a := a) (cs := cs) i hchildRoot
          (ext, site)).nonRootCoord
          (RawNormal.childNonRootVertexAtInNode (a := a) i v) (e j)) =
      ∑ j : Fin (NonRootVertex.weight
          (RawNormal.childNonRootVertexAtInNode (a := a) i v)),
        (nodeChildNormalSiteRecompose
          (n := n) (a := a) (cs := cs) i hchildRoot
          (ext, site)).nonRootCoord
          (RawNormal.childNonRootVertexAtInNode (a := a) i v) j := by
    refine Fintype.sum_equiv e
      (fun j : Fin (NonRootVertex.weight v) =>
        (nodeChildNormalSiteRecompose
          (n := n) (a := a) (cs := cs) i hchildRoot
          (ext, site)).nonRootCoord
          (RawNormal.childNonRootVertexAtInNode (a := a) i v) (e j))
      (fun j : Fin (NonRootVertex.weight
          (RawNormal.childNonRootVertexAtInNode (a := a) i v)) =>
        (nodeChildNormalSiteRecompose
          (n := n) (a := a) (cs := cs) i hchildRoot
          (ext, site)).nonRootCoord
          (RawNormal.childNonRootVertexAtInNode (a := a) i v) j)
      ?_
    intro j
    rfl
  calc
    (∑ j : Fin (NonRootVertex.weight
        (RawNormal.childNonRootVertexAtInNode (a := a) i v)),
      (nodeChildNormalSiteRecompose
        (n := n) (a := a) (cs := cs) i hchildRoot
        (ext, site)).nonRootCoord
        (RawNormal.childNonRootVertexAtInNode (a := a) i v) j) =
        ∑ j : Fin (NonRootVertex.weight v),
          (nodeChildNormalSiteRecompose
            (n := n) (a := a) (cs := cs) i hchildRoot
            (ext, site)).nonRootCoord
            (RawNormal.childNonRootVertexAtInNode (a := a) i v) (e j) := by
          exact hreindex.symm
    _ = ∑ j : Fin (NonRootVertex.weight v), site.nonRootCoord v j := by
          refine Finset.sum_congr rfl ?_
          intro j _
          simpa [e, Equiv.cast_apply] using
            nodeChildNormalSiteRecompose_childNonRoot_nonRootCoord
              (n := n) (a := a) (cs := cs) i hchildRoot
              (ext, site) v j

@[simp] theorem nodeChildNormalSiteDecompose_recompose
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs) (hchildRoot : 0 < (childAt cs i).rootWeight)
    (x :
      ChildExternalCoordinate n a cs i ×
        RawNormal.NormalSite n (childAt cs i)) :
    nodeChildNormalSiteDecompose
      (n := n) (a := a) (cs := cs) i hchildRoot
      (nodeChildNormalSiteRecompose
        (n := n) (a := a) (cs := cs) i hchildRoot x) = x := by
  classical
  rcases x with ⟨⟨extRoot, extDiag, extSibling⟩, ⟨siteRoot, siteNonRoot⟩⟩
  let E :=
    fullCoordinateWithDiagonalEquivOfPos
      (childAt cs i).rootWeight n hchildRoot
  have hchildRootFull :
      (fun j : Fin (childAt cs i).rootWeight =>
        (nodeChildNormalSiteRecompose
          (n := n) (a := a) (cs := cs) i hchildRoot
          ({ rootCoord := extRoot
             childRootDiagonal := extDiag
             siblingCoord := extSibling },
            { rootCoord := siteRoot
              nonRootCoord := siteNonRoot })).nonRootCoord
          (RawNormal.childRootAtAsNonRootInNode (a := a) i)
          (by
            simpa using
              (RawNormal.childRootFullCoordInNode
                (a := a) (idx := i.1) (cs := cs)
                (C := childAt cs i) (childAt_get?_eq_some cs i) j))) =
        E.symm (siteRoot, extDiag) := by
    funext j
    rw [nodeChildNormalSiteRecompose_childRoot_nonRootCoord]
    congr 1
  have hsplit :
      E
        (fun j : Fin (childAt cs i).rootWeight =>
          (nodeChildNormalSiteRecompose
            (n := n) (a := a) (cs := cs) i hchildRoot
            ({ rootCoord := extRoot
               childRootDiagonal := extDiag
               siblingCoord := extSibling },
              { rootCoord := siteRoot
                nonRootCoord := siteNonRoot })).nonRootCoord
            (RawNormal.childRootAtAsNonRootInNode (a := a) i)
            (by
              simpa using
                (RawNormal.childRootFullCoordInNode
                  (a := a) (idx := i.1) (cs := cs)
                  (C := childAt cs i) (childAt_get?_eq_some cs i) j))) =
        (siteRoot, extDiag) := by
    rw [hchildRootFull]
    exact E.right_inv (siteRoot, extDiag)
  apply Prod.ext
  · rw [ChildExternalCoordinate.mk.injEq]
    constructor
    · simp [nodeChildNormalSiteDecompose, nodeChildNormalSiteRecompose]
    constructor
    · simpa [nodeChildNormalSiteDecompose, E] using congrArg Prod.snd hsplit
    · funext p j
      simpa [nodeChildNormalSiteDecompose,
        childVertexAtAsNonRootInNode_weight] using
        nodeChildNormalSiteRecompose_sibling_nonRootCoord
          (n := n) (a := a) (cs := cs) i hchildRoot
          ({ rootCoord := extRoot
             childRootDiagonal := extDiag
             siblingCoord := extSibling },
            { rootCoord := siteRoot
              nonRootCoord := siteNonRoot }) p j
