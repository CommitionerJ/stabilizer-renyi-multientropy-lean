          (RTree.indexedChildInternalEdgesFrom [] 0 ds)
          (fun d => castRootFieldAssignment hchild (R d))
          (fun d => castNodeFieldAssignment hchild (N d)) :=
          cyclicBoundaryPhaseForEdges_eq_cast
