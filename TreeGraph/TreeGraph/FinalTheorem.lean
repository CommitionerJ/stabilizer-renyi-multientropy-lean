theorem childBoundaryRootDimension_eq_independentBranchDimension_of_mem_leaf
    {n : Nat} {cs : List RTree}
    (hleaf : ∀ C ∈ cs, ∃ b : Nat, C = RTree.node b []) :
    childBoundaryRootDimension n cs = independentBranchDimension n cs := by
  induction cs with
  | nil =>
      simp
  | cons C rest ih =>
      rcases hleaf C (by simp) with ⟨b, rfl⟩
      rw [childBoundaryRootDimension_cons, independentBranchDimension_cons,
        childBoundaryRootFactor_leaf_eq_branchFactor]
      congr 1
      exact ih (by
        intro D hD
        exact hleaf D (by simp [hD]))

