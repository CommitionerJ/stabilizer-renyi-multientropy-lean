noncomputable def nodeChildNormalSiteRecompose
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs) (hchildRoot : 0 < (childAt cs i).rootWeight)
    (x :
      ChildExternalCoordinate n a cs i ×
        RawNormal.NormalSite n (childAt cs i)) :
    RawNormal.NormalSite n (RTree.node a cs) :=
  let d :=
    nodeChildRootFieldDomainRecompose
      (n := n) (a := a) (cs := cs) i (x.1, x.2.nonRootCoord)
  let childRootFull :
      Fin (childAt cs i).rootWeight → ZMod n :=
    (fullCoordinateWithDiagonalEquivOfPos
      (childAt cs i).rootWeight n hchildRoot).symm
      (x.2.rootCoord, x.1.childRootDiagonal)
  { rootCoord := d.rootCoord
    nonRootCoord := fun v j =>
      if hv : v.1.1 = [i.1] then
        childRootFull
          (RawNormal.finCastEquivOfEq
            (by
              have hvroot :
                  v = RawNormal.childRootAtAsNonRootInNode (a := a) i := by
                apply Subtype.ext
                apply Subtype.ext
                simpa using hv
              rw [hvroot]
              exact RawNormal.childRootAtAsNonRootInNode_weight (a := a) i)
            j)
      else
        d.otherCoord ⟨v, hv⟩ j }

