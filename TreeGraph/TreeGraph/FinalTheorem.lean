    rootFieldAssignmentReducedNonRootConstraintLinearMap
        (n := n) T v F otherCoord t =
      RawLinearAlgebra.cyclicDiff n F2
        (RawLinearAlgebra.fiberSum
          (NonRootVertex.weight v) n F2
          (F otherCoord)) t := rfl

noncomputable def rootFieldDomainContextDiagonalFiberEquiv
    {n : Nat} [NeZero n] {T : RTree}
    (v : NonRootVertex T)
    (c : NonRootContext n T v)
    (t : ZMod n) :
    { rd : RawNormal.RootFieldDomain n T //
        RawLinearAlgebra.diagSum (NonRootVertex.weight v) n (rd v) = t ∧
        ∀ (u : RawNormal.OtherNonRootVertex T v)
          (k : Fin (NonRootVertex.weight u.1)),
          rd u.1 k = c.2 u k } ≃
      { x : Fin (NonRootVertex.weight v) → ZMod n //
        RawLinearAlgebra.diagSum (NonRootVertex.weight v) n x = t } where
  toFun rd := ⟨rd.1 v, rd.2.1⟩
  invFun x :=
    ⟨rootFieldDomainOfNonRootContextTuple
        (n := n) (T := T) v c x.1,
      by
        constructor
        · have hself :
              rootFieldDomainOfNonRootContextTuple
                  (n := n) (T := T) v c x.1 v = x.1 := by
            funext k
            exact rootFieldDomainOfNonRootContextTuple_self
              (n := n) (T := T) v c x.1 k
          rw [hself]
          exact x.2
        · intro u k
          simpa using
            rootFieldDomainOfNonRootContextTuple_other
              (n := n) (T := T) v c x.1 u k⟩
  left_inv rd := by
    apply Subtype.ext
    funext u k
    by_cases h : u = v
    · subst u
      simp
    · let uOther : RawNormal.OtherNonRootVertex T v :=
        ⟨u, by
          intro haddr
          exact h (nonRootVertex_eq_of_addr_eq haddr)⟩
      calc
        rootFieldDomainOfNonRootContextTuple
            (n := n) (T := T) v c (rd.1 v) u k =
          c.2 uOther k := by
            simpa [uOther] using
              rootFieldDomainOfNonRootContextTuple_other
                (n := n) (T := T) v c (rd.1 v) uOther k
        _ = rd.1 u k := (rd.2.2 uOther k).symm
  right_inv x := by
    apply Subtype.ext
    funext k
    exact rootFieldDomainOfNonRootContextTuple_self
      (n := n) (T := T) v c x.1 k

theorem sum_rootFieldDomain_indicator_contextDiagonal_eq_fiber
    {n : Nat} [NeZero n] {T : RTree}
    (v : NonRootVertex T)
    (c : NonRootContext n T v)
    (t : ZMod n)
    (S : RawNormal.RootFieldDomain n T → F2) :
    (∑ rd : RawNormal.RootFieldDomain n T,
        (if
            RawLinearAlgebra.diagSum (NonRootVertex.weight v) n (rd v) = t ∧
            ∀ (u : RawNormal.OtherNonRootVertex T v)
              (k : Fin (NonRootVertex.weight u.1)),
              rd u.1 k = c.2 u k
          then (1 : F2) else 0) * S rd) =
      ∑ x : { x : Fin (NonRootVertex.weight v) → ZMod n //
          RawLinearAlgebra.diagSum (NonRootVertex.weight v) n x = t },
        S (rootFieldDomainOfNonRootContextTuple
          (n := n) (T := T) v c x.1) := by
  classical
  let P : RawNormal.RootFieldDomain n T → Prop := fun rd =>
    RawLinearAlgebra.diagSum (NonRootVertex.weight v) n (rd v) = t ∧
      ∀ (u : RawNormal.OtherNonRootVertex T v)
        (k : Fin (NonRootVertex.weight u.1)),
        rd u.1 k = c.2 u k
  change
    (∑ rd : RawNormal.RootFieldDomain n T,
        (if P rd then (1 : F2) else 0) * S rd) =
      ∑ x : { x : Fin (NonRootVertex.weight v) → ZMod n //
          RawLinearAlgebra.diagSum (NonRootVertex.weight v) n x = t },
        S (rootFieldDomainOfNonRootContextTuple
          (n := n) (T := T) v c x.1)
  calc
    (∑ rd : RawNormal.RootFieldDomain n T,
        (if P rd then (1 : F2) else 0) * S rd) =
      ∑ rd : RawNormal.RootFieldDomain n T,
        if P rd then S rd else 0 := by
        refine Finset.sum_congr rfl ?_
        intro rd _hrd
        by_cases hP : P rd
        · simp only [if_pos hP, one_mul]
        · simp only [if_neg hP, zero_mul]
    _ = ∑ rd ∈ ((Finset.univ :
          Finset (RawNormal.RootFieldDomain n T)).filter P), S rd := by
        rw [← Finset.sum_filter]
    _ = ∑ rd : { rd : RawNormal.RootFieldDomain n T // P rd }, S rd.1 := by
        exact
          Finset.sum_subtype
            (s := ((Finset.univ :
              Finset (RawNormal.RootFieldDomain n T)).filter P))
            (p := P)
            (f := S)
            (by intro rd; simp)
    _ =
      ∑ x : { x : Fin (NonRootVertex.weight v) → ZMod n //
          RawLinearAlgebra.diagSum (NonRootVertex.weight v) n x = t },
        S (rootFieldDomainOfNonRootContextTuple
          (n := n) (T := T) v c x.1) := by
        let e := rootFieldDomainContextDiagonalFiberEquiv
          (n := n) (T := T) v c t
        exact
          (Fintype.sum_equiv
            e
            (fun rd => S rd.1)
            (fun x =>
              S (rootFieldDomainOfNonRootContextTuple
                (n := n) (T := T) v c x.1))
            (by
              intro rd
              have hval :
                  rootFieldDomainOfNonRootContextTuple
                      (n := n) (T := T) v c (e rd).1 = rd.1 :=
                congrArg Subtype.val (e.left_inv rd)
              exact congrArg S hval.symm))

noncomputable def rootBoundarySelectedNonRootFieldDomain
    {n : Nat} [NeZero n] {T : RTree}
    (v : NonRootVertex T)
    (rootCoord : Fin (T.rootWeight - 1) → ZMod n)
    (rd : RawNormal.RootFieldDomain n T)
    (shift : ZMod n) :
    RawNormal.NonRootFieldDomain n T v where
  rootCoord := rootCoord
  diagonal :=
    RawLinearAlgebra.diagSum (NonRootVertex.weight v) n (rd v) + shift
  otherCoord := fun u => rd u.1

@[simp] theorem rootBoundarySelectedNonRootFieldDomain_rootCoord
    {n : Nat} [NeZero n] {T : RTree}
    (v : NonRootVertex T)
    (rootCoord : Fin (T.rootWeight - 1) → ZMod n)
    (rd : RawNormal.RootFieldDomain n T)
    (shift : ZMod n) :
    (rootBoundarySelectedNonRootFieldDomain
      (n := n) (T := T) v rootCoord rd shift).rootCoord =
      rootCoord := rfl

@[simp] theorem rootBoundarySelectedNonRootFieldDomain_diagonal
    {n : Nat} [NeZero n] {T : RTree}
    (v : NonRootVertex T)
    (rootCoord : Fin (T.rootWeight - 1) → ZMod n)
    (rd : RawNormal.RootFieldDomain n T)
    (shift : ZMod n) :
    (rootBoundarySelectedNonRootFieldDomain
      (n := n) (T := T) v rootCoord rd shift).diagonal =
      RawLinearAlgebra.diagSum (NonRootVertex.weight v) n (rd v) +
        shift := rfl

@[simp] theorem rootBoundarySelectedNonRootFieldDomain_otherCoord
    {n : Nat} [NeZero n] {T : RTree}
    (v : NonRootVertex T)
    (rootCoord : Fin (T.rootWeight - 1) → ZMod n)
    (rd : RawNormal.RootFieldDomain n T)
    (shift : ZMod n)
    (u : RawNormal.OtherNonRootVertex T v)
    (j : Fin (NonRootVertex.weight u.1)) :
    (rootBoundarySelectedNonRootFieldDomain
      (n := n) (T := T) v rootCoord rd shift).otherCoord u j =
      rd u.1 j := rfl

@[simp] theorem nonRootFieldDomainEquivContextDiagonal_symm_contextTuple
    {n : Nat} [NeZero n] {T : RTree}
    (v : NonRootVertex T)
    (c : NonRootContext n T v)
    (x : Fin (NonRootVertex.weight v) → ZMod n)
    (shift : ZMod n) :
    (nonRootFieldDomainEquivContextDiagonal (n := n) T v).symm
        (c,
          RawLinearAlgebra.diagSum (NonRootVertex.weight v) n x + shift) =
      rootBoundarySelectedNonRootFieldDomain
        (n := n) (T := T) v c.1
        (rootFieldDomainOfNonRootContextTuple
          (n := n) (T := T) v c x)
        shift := by
  cases c with
  | mk rootCoord otherCoord =>
      change
        ({ rootCoord := rootCoord
           diagonal := RawLinearAlgebra.diagSum (NonRootVertex.weight v) n x +
             shift
           otherCoord := otherCoord } :
          RawNormal.NonRootFieldDomain n T v) =
        { rootCoord := rootCoord
          diagonal :=
            RawLinearAlgebra.diagSum (NonRootVertex.weight v) n
              (rootFieldDomainOfNonRootContextTuple
                (n := n) (T := T) v (rootCoord, otherCoord) x v) +
              shift
          otherCoord := fun u =>
            rootFieldDomainOfNonRootContextTuple
              (n := n) (T := T) v (rootCoord, otherCoord) x u.1 }
      rw [RawNormal.NonRootFieldDomain.mk.injEq]
      refine ⟨rfl, ?_, ?_⟩
      · have hxself :
            rootFieldDomainOfNonRootContextTuple
                (n := n) (T := T) v (rootCoord, otherCoord) x v =
              x := by
            funext j
            simp
        rw [hxself]
      · funext u j
        simp

@[simp] theorem nonRootFieldDomainEquivContextDiagonal_selected
    {n : Nat} [NeZero n] {T : RTree}
    (v : NonRootVertex T)
    (rootCoord : Fin (T.rootWeight - 1) → ZMod n)
    (rd : RawNormal.RootFieldDomain n T)
    (shift : ZMod n) :
    (nonRootFieldDomainEquivContextDiagonal (n := n) T v)
        (rootBoundarySelectedNonRootFieldDomain
          (n := n) (T := T) v rootCoord rd shift) =
      (rootBoundarySelectedNonRootContext
          (n := n) (T := T) v rootCoord rd,
        RawLinearAlgebra.diagSum (NonRootVertex.weight v) n (rd v) +
          shift) := rfl

theorem nonRootDomainOfSite_eq_selectedNonRootFieldDomain
    {n : Nat} [NeZero n] {T : RTree}
    (v : NonRootVertex T)
    (rootCoord : Fin (T.rootWeight - 1) → ZMod n)
    (rd : RawNormal.RootFieldDomain n T)
    (shift : ZMod n) :
    RawNormal.nonRootDomainOfSite
        ({ rootCoord := rootCoord, nonRootCoord := rd } :
          RawNormal.NormalSite n T) v shift =
      rootBoundarySelectedNonRootFieldDomain
        (n := n) (T := T) v rootCoord rd shift := by
  cases v with
  | mk vertex hv =>
      simp [RawNormal.nonRootDomainOfSite,
        rootBoundarySelectedNonRootFieldDomain,
        RawNormal.diagonal, RawLinearAlgebra.diagSum]

