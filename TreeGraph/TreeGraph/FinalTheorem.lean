theorem cyclicChildRootBoundaryAdjacentSliceProjection_single_eq_zero_of_branchConstraintMap_odd_fiberCard
    {n b : Nat} [NeZero n] (ds : List RTree)
    (j : ChildIdx ds)
    (φ : RawNormal.NodeChildRootFieldDomain n b ds j → F2)
    (rd : RawNormal.RootFieldDomain n (RTree.node b ds))
    (hpos :
      0 < NonRootVertex.weight
        (RawNormal.childRootAtAsNonRootInNode (a := b) j))
    (hodd :
      Odd
        (n ^
          (NonRootVertex.weight
            (RawNormal.childRootAtAsNonRootInNode (a := b) j) - 1)))
    (hzero :
      nonRootBranchConstraintMap (RTree.node b ds)
          (RawNormal.childRootAtAsNonRootInNode (a := b) j)
          (fun c x =>
            φ (rootBoundarySelectedNodeChildRootFieldDomain
              (n := n) (b := b) ds j c.1
              (rootFieldDomainOfNonRootContextTuple
                (n := n) (T := RTree.node b ds)
                (RawNormal.childRootAtAsNonRootInNode (a := b) j) c x)
              0)) = 0) :
    cyclicChildRootBoundaryAdjacentSliceProjectionLinearMap
        (n := n) (b := b) ds
        (Pi.single (M := fun i : ChildIdx ds =>
          RawNormal.NodeChildRootFieldDomain n b ds i → F2) j φ) rd = 0 := by
  let v := RawNormal.childRootAtAsNonRootInNode (a := b) j
  let c :=
    rootBoundarySelectedNonRootContext
      (n := n) (T := RTree.node b ds) v (fun _ => 0) rd
  let t := RawLinearAlgebra.diagSum (NonRootVertex.weight v) n (rd v)
  let rd' :=
    rootFieldDomainOfNonRootContextTuple
      (n := n) (T := RTree.node b ds) v c
      (RawLinearAlgebra.fiberRep (NonRootVertex.weight v) n hpos t)
  have hdiag :
      RawLinearAlgebra.diagSum
          (NonRootVertex.weight
            (RawNormal.childRootAtAsNonRootInNode (a := b) j)) n
          (rd (RawNormal.childRootAtAsNonRootInNode (a := b) j)) =
        RawLinearAlgebra.diagSum
          (NonRootVertex.weight
            (RawNormal.childRootAtAsNonRootInNode (a := b) j)) n
          (RawLinearAlgebra.fiberRep
            (NonRootVertex.weight
              (RawNormal.childRootAtAsNonRootInNode (a := b) j))
            n hpos t) := by
    simp [t, v, RawLinearAlgebra.diagSum_fiberRep]
  have hsum0 :
      rootBoundaryChildMessageSumAt (n := n) (b := b) ds j φ rd 0 =
        rootBoundaryChildMessageSumAt (n := n) (b := b) ds j φ rd' 0 := by
    have h :=
      rootBoundaryChildMessageSumAt_contextTuple_eq_of_diagSum_eq
        (n := n) (b := b) ds j φ c
        (x := rd v)
        (y := RawLinearAlgebra.fiberRep
          (NonRootVertex.weight
            (RawNormal.childRootAtAsNonRootInNode (a := b) j))
          n hpos t)
        (by simpa [v] using hdiag)
        0
    simpa [c, rd', v] using h
  have hsum1 :
      rootBoundaryChildMessageSumAt (n := n) (b := b) ds j φ rd 1 =
        rootBoundaryChildMessageSumAt (n := n) (b := b) ds j φ rd' 1 := by
    have h :=
      rootBoundaryChildMessageSumAt_contextTuple_eq_of_diagSum_eq
        (n := n) (b := b) ds j φ c
        (x := rd v)
        (y := RawLinearAlgebra.fiberRep
          (NonRootVertex.weight
            (RawNormal.childRootAtAsNonRootInNode (a := b) j))
          n hpos t)
        (by simpa [v] using hdiag)
        1
    simpa [c, rd', v] using h
  have hproj_rd :
      cyclicChildRootBoundaryAdjacentSliceProjectionLinearMap
          (n := n) (b := b) ds
          (Pi.single (M := fun i : ChildIdx ds =>
            RawNormal.NodeChildRootFieldDomain n b ds i → F2) j φ) rd =
        cyclicChildRootBoundaryAdjacentSliceProjectionLinearMap
          (n := n) (b := b) ds
          (Pi.single (M := fun i : ChildIdx ds =>
            RawNormal.NodeChildRootFieldDomain n b ds i → F2) j φ) rd' := by
    rw [cyclicChildRootBoundaryAdjacentSliceProjectionLinearMap_pi_single,
      cyclicChildRootBoundaryAdjacentSliceProjectionLinearMap_pi_single,
      hsum0, hsum1]
  have hfiber_zero :
      nodeChildRootBranchFiberBoundaryMessageSum
          (n := n) (b := b) ds j φ rd t = 0 :=
    nodeChildRootBranchFiberBoundaryMessageSum_eq_zero_of_branchConstraintMap
      (n := n) (b := b) ds j φ rd t hzero
  have hfiber_projection :
      nodeChildRootBranchFiberBoundaryMessageSum
          (n := n) (b := b) ds j φ rd t =
        cyclicChildRootBoundaryAdjacentSliceProjectionLinearMap
          (n := n) (b := b) ds
          (Pi.single (M := fun i : ChildIdx ds =>
            RawNormal.NodeChildRootFieldDomain n b ds i → F2) j φ) rd' := by
