                (n := n) (b := b) (ds := ds) j shift Aext) base) := by
    simpa using
      childInternalPhaseGivenRootDataAt_zero_eq_sum_base_cyclicPhase
        (n := n) (a := b) (cs := ds) j hchildRoot
        (externalAssignmentsEquivBaseCyclic
          (n := n) (a := b) (cs := ds) j
