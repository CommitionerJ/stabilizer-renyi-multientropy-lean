noncomputable def firstCoordinateShift
    {a n : Nat} [NeZero n] (ha : 0 < a)
    (shift : ZMod n) (x : Fin a → ZMod n) :
    Fin a → ZMod n :=
  fun i => if i = ⟨0, ha⟩ then x i + shift else x i

@[simp] theorem firstCoordinateShift_first
    {a n : Nat} [NeZero n] (ha : 0 < a)
    (shift : ZMod n) (x : Fin a → ZMod n) :
    firstCoordinateShift (n := n) ha shift x ⟨0, ha⟩ =
      x ⟨0, ha⟩ + shift := by
  simp [firstCoordinateShift]

theorem firstCoordinateShift_ne_first
    {a n : Nat} [NeZero n] (ha : 0 < a)
    (shift : ZMod n) (x : Fin a → ZMod n)
    {i : Fin a} (hi : i ≠ ⟨0, ha⟩) :
    firstCoordinateShift (n := n) ha shift x i = x i := by
  simp [firstCoordinateShift, hi]

theorem diagSum_firstCoordinateShift
    {a n : Nat} [NeZero n] (ha : 0 < a)
    (shift : ZMod n) (x : Fin a → ZMod n) :
    RawLinearAlgebra.diagSum a n
        (firstCoordinateShift (n := n) ha shift x) =
      RawLinearAlgebra.diagSum a n x + shift := by
  classical
  rw [RawLinearAlgebra.diagSum_eq_first_add_tail ha]
  rw [RawLinearAlgebra.diagSum_eq_first_add_tail ha]
  have htail :
      (∑ i : { i : Fin a // i ≠ ⟨0, ha⟩ },
        firstCoordinateShift (n := n) ha shift x i.1) =
      ∑ i : { i : Fin a // i ≠ ⟨0, ha⟩ }, x i.1 := by
    refine Finset.sum_congr rfl ?_
    intro i _hi
    exact firstCoordinateShift_ne_first (n := n) ha shift x i.2
  rw [htail]
  simp [add_assoc, add_left_comm, add_comm]

noncomputable def firstCoordinateShiftFiberEquiv
    {a n : Nat} [NeZero n] (ha : 0 < a)
    (shift t : ZMod n) :
    { x : Fin a → ZMod n //
        RawLinearAlgebra.diagSum a n x = t } ≃
      { x : Fin a → ZMod n //
        RawLinearAlgebra.diagSum a n x = t + shift } where
  toFun x :=
    ⟨firstCoordinateShift (n := n) ha shift x.1, by
      rw [diagSum_firstCoordinateShift]
      rw [x.2]⟩
  invFun x :=
    ⟨firstCoordinateShift (n := n) ha (-shift) x.1, by
      rw [diagSum_firstCoordinateShift]
      rw [x.2]
      simp [add_assoc]⟩
  left_inv x := by
    apply Subtype.ext
    funext i
    by_cases hi : i = ⟨0, ha⟩
    · subst i
      simp [firstCoordinateShift, add_assoc]
    · simp [firstCoordinateShift, hi]
  right_inv x := by
    apply Subtype.ext
    funext i
    by_cases hi : i = ⟨0, ha⟩
    · subst i
      simp [firstCoordinateShift, add_assoc]
    · simp [firstCoordinateShift, hi]

theorem sum_diagFiber_firstCoordinateShift_eq_fiberSum
    {a n : Nat} [NeZero n] (ha : 0 < a)
    {M : Type} [AddCommMonoid M] [Module F2 M]
    (shift t : ZMod n) (f : (Fin a → ZMod n) → M) :
    (∑ x : { x : Fin a → ZMod n //
        RawLinearAlgebra.diagSum a n x = t },
      f (firstCoordinateShift (n := n) ha shift x.1)) =
      RawLinearAlgebra.fiberSum a n M f (t + shift) := by
  classical
  let e := firstCoordinateShiftFiberEquiv (n := n) ha shift t
  simpa [e, RawLinearAlgebra.fiberSum_apply] using
    (Equiv.sum_comp e (fun x :
        { x : Fin a → ZMod n //
          RawLinearAlgebra.diagSum a n x = t + shift } =>
        f x.1))

theorem rootBoundaryChildMessageSumAt_contextTuple_eq_of_diagSum_eq
