theorem boundaryInternal_sum_leaf_children_eq_copyProduct_mul_boundaryZeroCard
    {a : Nat} {cs : List RTree} {n : Nat} [NeZero n]
    (ha : 0 < a)
    (hleaf : ∀ i : ChildIdx cs,
      ∃ b : Nat, 0 < b ∧ childAt cs i = RTree.node b []) :
    (∑ A : RawNormal.NormalAssignment n (RTree.node a cs),
      bitSign (RawNormal.nodeBoundaryPhase a cs A) *
        bitSign (RawNormal.nodeInternalPhase a cs A)) =
      RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopiesProduct
        n a cs 0 *
        (Fintype.card
          { R : RawNormal.NodeRootFieldAssignment n a cs //
            ∀ i : ChildIdx cs,
              childBoundaryLinearFormAt (n := n) (a := a) cs R i = 0 } :
          ℤ) := by
  classical
  let P : RawNormal.NodeRootFieldAssignment n a cs → Prop :=
    fun R =>
      ∀ i : ChildIdx cs,
        childBoundaryLinearFormAt (n := n) (a := a) cs R i = 0
  let childProduct :=
    RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopiesProduct
      n a cs 0
  have hprod :
      ∀ R : RawNormal.NodeRootFieldAssignment n a cs,
        (∏ i : ChildIdx cs,
          ∑ h : RawNormal.NodeChildDataAt n a cs i,
            RawNormal.childBoundaryInternalContributionGivenRootDataAt
              (n := n) (a := a) cs R i h) =
          childProduct * indicatorZ (P R) := by
    intro R
    calc
      (∏ i : ChildIdx cs,
        ∑ h : RawNormal.NodeChildDataAt n a cs i,
          RawNormal.childBoundaryInternalContributionGivenRootDataAt
            (n := n) (a := a) cs R i h) =
          ∏ i : ChildIdx cs,
            RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopyFactorAt
              n a cs i *
              indicatorZ
                (childBoundaryLinearFormAt
                  (n := n) (a := a) cs R i = 0) := by
            refine Finset.prod_congr rfl ?_
            intro i _
            rw [childLocalContributionSum_eq_linearizedContributionSumAt]
            rcases hleaf i with ⟨b, hb, hchild⟩
            exact
              childLinearizedContributionSumAt_leaf_child_eq_copyFactor_mul_boundaryZero_indicator
                (n := n) (a := a) (b := b) R i ha hb hchild
      _ =
          (∏ i : ChildIdx cs,
            RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopyFactorAt
              n a cs i) *
            ∏ i : ChildIdx cs,
              indicatorZ
                (childBoundaryLinearFormAt
                  (n := n) (a := a) cs R i = 0) := by
            rw [Finset.prod_mul_distrib]
      _ =
          childProduct * indicatorZ (P R) := by
            rw [RawExpandedOpenRootSubtreeCert.prod_copyFactorAt_eq_childInternalCoordinateCopiesProduct]
            rw [prod_indicatorZ_eq_indicatorZ_forall]
            simp [P, childProduct, indicatorZ]
  calc
    (∑ A : RawNormal.NormalAssignment n (RTree.node a cs),
      bitSign (RawNormal.nodeBoundaryPhase a cs A) *
        bitSign (RawNormal.nodeInternalPhase a cs A)) =
        ∑ R : RawNormal.NodeRootFieldAssignment n a cs,
          ∏ i : ChildIdx cs,
            ∑ h : RawNormal.NodeChildDataAt n a cs i,
              RawNormal.childBoundaryInternalContributionGivenRootDataAt
                (n := n) (a := a) cs R i h := by
          exact
            RawNormal.boundaryInternal_explicit_sum_eq_sum_root_product_child_sums
              (n := n) (a := a) cs
    _ =
        ∑ R : RawNormal.NodeRootFieldAssignment n a cs,
          childProduct * indicatorZ (P R) := by
          refine Finset.sum_congr rfl ?_
          intro R _
          exact hprod R
    _ =
        childProduct *
          ∑ R : RawNormal.NodeRootFieldAssignment n a cs,
            indicatorZ (P R) := by
          rw [Finset.mul_sum]
    _ =
        childProduct *
          (Fintype.card
            { R : RawNormal.NodeRootFieldAssignment n a cs // P R } : ℤ) := by
          rw [sum_indicatorZ_subtype]
    _ =
        RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopiesProduct
          n a cs 0 *
          (Fintype.card
            { R : RawNormal.NodeRootFieldAssignment n a cs //
              ∀ i : ChildIdx cs,
                childBoundaryLinearFormAt (n := n) (a := a) cs R i = 0 } :
            ℤ) := by
          simp [P, childProduct]

theorem boundaryZeroRootFieldCard_of_leaf_children_and_normalSignedSum_closed
    {a : Nat} {cs : List RTree} {n : Nat} [NeZero n]
    (ha : 0 < a)
    (hchildren : ∀ C ∈ cs, RawExpandedOpenRootSubtreeCert C)
    (hleaf : ∀ i : ChildIdx cs,
      ∃ b : Nat, 0 < b ∧ childAt cs i = RTree.node b [])
    (hnormal :
      RawNormal.signedSum n (RTree.node a cs) =
        (2 : ℤ) ^ Int.toNat
          (assignmentFactorProductExponent n (RTree.node a cs))) :
    Fintype.card
        { R : RawNormal.NodeRootFieldAssignment n a cs //
          ∀ i : ChildIdx cs,
            childBoundaryLinearFormAt (n := n) (a := a) cs R i = 0 } =
      Fintype.card (OpenRootMessageSpace n cs) := by
  classical
  let childProduct :=
    RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopiesProduct
      n a cs 0
  let Z :=
    { R : RawNormal.NodeRootFieldAssignment n a cs //
      ∀ i : ChildIdx cs,
        childBoundaryLinearFormAt (n := n) (a := a) cs R i = 0 }
  have hsum :=
    boundaryInternal_sum_leaf_children_eq_copyProduct_mul_boundaryZeroCard
      (n := n) (a := a) (cs := cs) ha hleaf
  have hsigned :
      (∑ A : RawNormal.NormalAssignment n (RTree.node a cs),
        bitSign (RawNormal.nodeBoundaryPhase a cs A) *
          bitSign (RawNormal.nodeInternalPhase a cs A)) =
        (2 : ℤ) ^ Int.toNat
          (assignmentFactorProductExponent n (RTree.node a cs)) := by
    rw [← RawNormal.signedSum_node_eq_boundary_mul_internal_sum]
    exact hnormal
  have hzeroProduct :
      childProduct * (Fintype.card Z : ℤ) =
        (2 : ℤ) ^ Int.toNat
          (assignmentFactorProductExponent n (RTree.node a cs)) := by
    have hsum' :
        (∑ A : RawNormal.NormalAssignment n (RTree.node a cs),
          bitSign (RawNormal.nodeBoundaryPhase a cs A) *
            bitSign (RawNormal.nodeInternalPhase a cs A)) =
          childProduct * (Fintype.card Z : ℤ) := by
      exact hsum
    exact hsum'.symm.trans hsigned
  have hopenProduct :
      childProduct *
          (Fintype.card (OpenRootMessageSpace n cs) : ℤ) =
        (2 : ℤ) ^ Int.toNat
          (assignmentFactorProductExponent n (RTree.node a cs)) := by
    have hroot :=
      rootFactorCard_mul_childInternalCopies_closed_assignmentFactor
        (n := n) (a := a) (cs := cs) hchildren
    calc
      childProduct * (Fintype.card (OpenRootMessageSpace n cs) : ℤ) =
          ((Fintype.card (OpenRootMessageSpace n cs) : Nat) : ℤ) *
            childProduct := by
            rw [mul_comm]
      _ =
          (2 : ℤ) ^ Int.toNat
            (assignmentFactorProductExponent n (RTree.node a cs)) := by
          exact hroot
  have hchildProduct_ne : childProduct ≠ 0 := by
    change
      RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopiesProduct
        n a cs 0 ≠ 0
    rw [
      RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopiesProduct_closed_childContrib
        n a cs 0 hchildren]
    exact pow_ne_zero _ (by norm_num : (2 : ℤ) ≠ 0)
  have hcast :
      (Fintype.card Z : ℤ) =
        (Fintype.card (OpenRootMessageSpace n cs) : ℤ) := by
    exact
      mul_left_cancel₀ hchildProduct_ne
        (hzeroProduct.trans hopenProduct.symm)
  have hcard :
      Fintype.card Z =
        Fintype.card (OpenRootMessageSpace n cs) := by
    exact_mod_cast hcast
  simpa [Z] using hcard

