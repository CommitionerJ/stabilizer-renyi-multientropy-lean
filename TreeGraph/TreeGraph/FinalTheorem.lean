structure PrimitiveRawBitStringClosedFormulaFor (T : RTree) : Prop where
  positiveWeights : RTree.PositiveWeights T
  rawSum :
    ∀ (n : Nat) [NeZero n],
      (∑ Araw : NormalFormRawAssignments n T, weight T Araw.1) =
        (2 : ℤ) ^ Int.toNat (assignmentFactorProductExponent n T)

def PrimitiveRawBitStringClosedFormula : Prop :=
  ∀ {T : RTree}, RTree.PositiveWeights T →
    ∀ (n : Nat) [NeZero n],
      (∑ Araw : NormalFormRawAssignments n T, weight T Araw.1) =
        (2 : ℤ) ^ Int.toNat (assignmentFactorProductExponent n T)

theorem primitiveRawBitStringClosedFormulaFor_of_finalClosedFormulaFor
    {T : RTree} (h : FinalClosedFormulaFor T) :
    PrimitiveRawBitStringClosedFormulaFor T where
  positiveWeights := h.positiveWeights
  rawSum := by
    intro n _
    simpa [rawBitStringSignedSum] using h.raw n

theorem finalClosedFormulaFor_of_primitiveRawBitStringClosedFormulaFor
    {T : RTree} (h : PrimitiveRawBitStringClosedFormulaFor T) :
    FinalClosedFormulaFor T where
  positiveWeights := h.positiveWeights
  delta := by
    intro n _
    exact
      DeltaTreeModel_closed_assignmentFactorProductExponent
        (n := n) h.positiveWeights
  signed := by
    intro n _
    have hraw :
        rawBitStringSignedSum n T =
          (2 : ℤ) ^ Int.toNat (assignmentFactorProductExponent n T) := by
      simpa [rawBitStringSignedSum] using h.rawSum n
    have hrawSigned :
        rawBitStringSignedSum n T = RawNormal.signedSum n T :=
      rawBitStringSignedSum_eq_signedSum_of_positiveWeights
        (n := n) (T := T) h.positiveWeights
    exact hrawSigned.symm.trans hraw
  raw := by
    intro n _
    simpa [rawBitStringSignedSum] using h.rawSum n
  normal := by
    intro n _
    simpa [normalFormSignedSum] using h.rawSum n

theorem primitiveRawBitStringClosedFormulaFor_iff_finalClosedFormulaFor
    {T : RTree} :
    PrimitiveRawBitStringClosedFormulaFor T ↔ FinalClosedFormulaFor T :=
  ⟨finalClosedFormulaFor_of_primitiveRawBitStringClosedFormulaFor,
    primitiveRawBitStringClosedFormulaFor_of_finalClosedFormulaFor⟩

theorem finalClosedFormulaFor_iff_primitiveRawBitStringClosedFormulaFor
    {T : RTree} :
