    (d : ZMod n)
    (site : RawNormal.NormalSite n (childAt cs i))
    (u v : Vertex (childAt cs i)) :
    cyclicRootTwistedEdgePhaseAt
        (n := n) (a := a) (cs := cs) i B d site (u.1, v.1) =
      cyclicRootTwistedKetAtVertex
          (n := n) (a := a) (cs := cs) i B d site u *
        cyclicRootTwistedKetAtVertex
          (n := n) (a := a) (cs := cs) i B d site v +
      cyclicRootTwistedBraAtVertex
          (n := n) (a := a) (cs := cs) i B d site u *
        cyclicRootTwistedBraAtVertex
          (n := n) (a := a) (cs := cs) i B d site v := by
  simp [cyclicRootTwistedEdgePhaseAt]

