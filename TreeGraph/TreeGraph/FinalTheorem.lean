            bitSign
              (childInternalPhaseGivenRootFieldsAt
                (n := n) (a := a) cs R i φ ψ) := by
  classical
  unfold childLinearizedContributionSumAt
    childLinearizedContributionGivenRootDataAt
    childInternalPhaseGivenRootFieldsAt
  rw [Fintype.sum_prod_type]

