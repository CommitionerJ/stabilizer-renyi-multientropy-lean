theorem boundaryInternalFactorization_of_childLocalProductIndicator
    {a : Nat} {cs : List RTree} {n : Nat} [NeZero n]
    (hchildren : ∀ C ∈ cs, RawExpandedOpenRootSubtreeCert C)
    (P : RawNormal.NodeRootFieldAssignment n a cs → Prop)
    [DecidablePred P]
    (hprod :
      ∀ R : RawNormal.NodeRootFieldAssignment n a cs,
        (∏ i : ChildIdx cs,
          ∑ h : RawNormal.NodeChildDataAt n a cs i,
            RawNormal.childBoundaryInternalContributionGivenRootDataAt
              (n := n) (a := a) cs R i h) =
          RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopiesProduct
            n a cs 0 * indicatorZ (P R))
    (hcard :
      Fintype.card { R : RawNormal.NodeRootFieldAssignment n a cs // P R } =
        Fintype.card (OpenRootMessageSpace n cs)) :
    (∑ A : RawNormal.NormalAssignment n (RTree.node a cs),
      bitSign (RawNormal.nodeBoundaryPhase a cs A) *
        bitSign (RawNormal.nodeInternalPhase a cs A)) =
      (2 : ℤ) ^ Int.toNat
        (localCombinatorialNodeExponent n a cs) := by
  classical
  let childProduct :=
    RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopiesProduct
      n a cs 0
  calc
    (∑ A : RawNormal.NormalAssignment n (RTree.node a cs),
      bitSign (RawNormal.nodeBoundaryPhase a cs A) *
        bitSign (RawNormal.nodeInternalPhase a cs A)) =
        ∑ R : RawNormal.NodeRootFieldAssignment n a cs,
          ∏ i : ChildIdx cs,
            ∑ h : RawNormal.NodeChildDataAt n a cs i,
              RawNormal.childBoundaryInternalContributionGivenRootDataAt
                (n := n) (a := a) cs R i h := by
          exact
            RawNormal.boundaryInternal_explicit_sum_eq_sum_root_product_child_sums
              (n := n) (a := a) cs
    _ =
        ∑ R : RawNormal.NodeRootFieldAssignment n a cs,
          childProduct * indicatorZ (P R) := by
          refine Finset.sum_congr rfl ?_
          intro R _
          simpa [childProduct] using hprod R
    _ =
        childProduct *
          ∑ R : RawNormal.NodeRootFieldAssignment n a cs,
            indicatorZ (P R) := by
          rw [Finset.mul_sum]
    _ =
        childProduct *
          (Fintype.card
            { R : RawNormal.NodeRootFieldAssignment n a cs // P R } : ℤ) := by
          rw [sum_indicatorZ_subtype (α :=
            RawNormal.NodeRootFieldAssignment n a cs) P]
    _ =
        childProduct *
          (Fintype.card (OpenRootMessageSpace n cs) : ℤ) := by
          rw [hcard]
    _ =
        ((Fintype.card (OpenRootMessageSpace n cs) : Nat) : ℤ) *
          RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopiesProduct
            n a cs 0 := by
          rw [mul_comm]
    _ =
        (2 : ℤ) ^ Int.toNat
          (localCombinatorialNodeExponent n a cs) := by
          exact
            rootFactorCard_mul_childInternalCopies_closed_localCombinatorial
              (n := n) (a := a) (cs := cs) hchildren

theorem boundaryInternalFactorization_of_childLocalSumIndicators
    {a : Nat} {cs : List RTree} {n : Nat} [NeZero n]
    (hchildren : ∀ C ∈ cs, RawExpandedOpenRootSubtreeCert C)
    (childFactor : (i : ChildIdx cs) → ℤ)
    (Q : RawNormal.NodeRootFieldAssignment n a cs → (i : ChildIdx cs) → Prop)
    [∀ R i, Decidable (Q R i)]
    (hchild :
      ∀ (R : RawNormal.NodeRootFieldAssignment n a cs) (i : ChildIdx cs),
        (∑ h : RawNormal.NodeChildDataAt n a cs i,
          RawNormal.childBoundaryInternalContributionGivenRootDataAt
            (n := n) (a := a) cs R i h) =
          childFactor i * indicatorZ (Q R i))
    (hfactor :
      (∏ i : ChildIdx cs, childFactor i) =
        RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopiesProduct
          n a cs 0)
    (hcard :
      Fintype.card
          { R : RawNormal.NodeRootFieldAssignment n a cs // ∀ i, Q R i } =
        Fintype.card (OpenRootMessageSpace n cs)) :
    (∑ A : RawNormal.NormalAssignment n (RTree.node a cs),
      bitSign (RawNormal.nodeBoundaryPhase a cs A) *
        bitSign (RawNormal.nodeInternalPhase a cs A)) =
      (2 : ℤ) ^ Int.toNat
        (localCombinatorialNodeExponent n a cs) := by
  classical
  let P : RawNormal.NodeRootFieldAssignment n a cs → Prop :=
    fun R => ∀ i : ChildIdx cs, Q R i
  have hprod :
      ∀ R : RawNormal.NodeRootFieldAssignment n a cs,
        (∏ i : ChildIdx cs,
          ∑ h : RawNormal.NodeChildDataAt n a cs i,
            RawNormal.childBoundaryInternalContributionGivenRootDataAt
              (n := n) (a := a) cs R i h) =
          RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopiesProduct
            n a cs 0 * indicatorZ (P R) := by
    intro R
    calc
      (∏ i : ChildIdx cs,
        ∑ h : RawNormal.NodeChildDataAt n a cs i,
          RawNormal.childBoundaryInternalContributionGivenRootDataAt
            (n := n) (a := a) cs R i h) =
          ∏ i : ChildIdx cs, childFactor i * indicatorZ (Q R i) := by
            refine Finset.prod_congr rfl ?_
            intro i _
            exact hchild R i
      _ =
          (∏ i : ChildIdx cs, childFactor i) *
            ∏ i : ChildIdx cs, indicatorZ (Q R i) := by
            rw [Finset.prod_mul_distrib]
      _ =
          RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopiesProduct
              n a cs 0 *
            indicatorZ (∀ i : ChildIdx cs, Q R i) := by
            rw [hfactor]
            rw [prod_indicatorZ_eq_indicatorZ_forall]
            simp [indicatorZ]
      _ =
          RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopiesProduct
            n a cs 0 * indicatorZ (P R) := by
            simp [P, indicatorZ]
  exact
    boundaryInternalFactorization_of_childLocalProductIndicator
      (n := n) (a := a) (cs := cs) hchildren P hprod (by
        simpa [P] using hcard)

