theorem externalCopies_rawEdgePhaseSign_eq_normalWeight
    {n : Nat} [NeZero n] {T : RTree}
    (hT : RTree.PositiveWeights T)
    {ι : Type} [Fintype ι] [DecidableEq ι] :
    (∑ Aext :
      ι → { Araw : RawAssignment n T // RealizedByNormal T Araw },
      ∏ i, rawEdgePhaseSign n T (Aext i)) =
      ∑ Aext : ι → RawNormal.NormalAssignment n T,
        ∏ i, RawNormal.weight T (Aext i) := by
  classical
  exact
    (Fintype.sum_equiv
      (externalNormalAssignmentsEquivRaw (n := n) (T := T) hT ι)
      (fun Aext : ι → RawNormal.NormalAssignment n T =>
        ∏ i, RawNormal.weight T (Aext i))
      (fun Aext :
        ι → { Araw : RawAssignment n T // RealizedByNormal T Araw } =>
        ∏ i, rawEdgePhaseSign n T (Aext i))
      (by
        intro Aext
        refine Finset.prod_congr rfl ?_
        intro i _
        exact (rawEdgePhaseSign_normalToNormalFormRaw T (Aext i)).symm)).symm

theorem childOpenRootInternalKernelAt_leaf_child
    {n a b : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs)
    (hchild : childAt cs i = RTree.node b [])
    (φ : RawNormal.NodeChildRootFieldDomain n a cs i → F2) :
    childOpenRootInternalKernelAt (n := n) (a := a) cs i φ = 1 := by
  classical
  unfold childOpenRootInternalKernelAt childOpenRootInternalSumAt
    childInternalPhaseGivenRootFieldsAt childInternalPhaseGivenRootDataAt
    RawNormal.childInternalPhaseAt RawNormal.indexedChildInternalPhaseAt
  simp [hchild]
  apply Finset.prod_eq_one
  intro v _hv
  exfalso
  have haddr : v.1.1 ∈ RTree.addresses (childAt cs i) := v.1.2
  have haddrLeaf : v.1.1 ∈ RTree.addresses (RTree.node b []) := by
    simpa [hchild] using haddr
  rw [RTree.addresses_node_nil] at haddrLeaf
  exact v.2 (by simpa using haddrLeaf)

