          (ChildExternalCoordinate n 1 [RTree.node b ds] i0) =
        Fintype.card (ZMod n) := by
    simpa [i0] using
      Fintype.card_congr
        (singletonChildExternalCoordinateEquivZMod n b ds)
  have hpow :
      n ^ childExternalCoordinateExponentAt 1 [RTree.node b ds] i0 =
        Fintype.card (ZMod n) := by
    have hcoordPow :
        Fintype.card
            (ChildExternalCoordinate n 1 [RTree.node b ds] i0) =
          n ^ childExternalCoordinateExponentAt 1 [RTree.node b ds] i0 := by
      simpa [i0] using
        card_childExternalCoordinate_eq_pow
          (n := n) (a := 1) (cs := [RTree.node b ds])
          (by norm_num) (0 : ChildIdx [RTree.node b ds])
    rw [← hcoordPow]
    exact hcoordCard
  have hsingle :
      (∑ Aext :
        ChildExternalCoordinate n 1 [RTree.node b ds] i0 →
          RawNormal.NormalAssignment n (childAt [RTree.node b ds] i0),
        childParentEmbeddedInternalWeight
          (n := n) (a := 1) (cs := [RTree.node b ds])
