noncomputable def cyclicRootTwistedEdgePhaseAt
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs)
    (B :
      ZMod n → RawNormal.NormalAssignment n (childAt cs i))
    (d : ZMod n)
    (site : RawNormal.NormalSite n (childAt cs i))
    (e : List Nat × List Nat) : F2 :=
  cyclicRootTwistedKetAtPath
      (n := n) (a := a) (cs := cs) i B d site e.1 *
    cyclicRootTwistedKetAtPath
      (n := n) (a := a) (cs := cs) i B d site e.2 +
  cyclicRootTwistedBraAtPath
      (n := n) (a := a) (cs := cs) i B d site e.1 *
    cyclicRootTwistedBraAtPath
      (n := n) (a := a) (cs := cs) i B d site e.2

@[simp] theorem cyclicRootTwistedEdgePhaseAt_vertices
    {n a : Nat} [NeZero n] {cs : List RTree}
