        (n := n) (b := a) (C :: cs) (0 : ChildIdx (C :: cs))
        S
        (Pi.single
          (M := fun _ :
            RawNormal.NodeChildRootFieldDomain n a (C :: cs)
              (0 : ChildIdx (C :: cs)) => F2)
          d (1 : F2)) := by
        rw [rootBoundaryChildMessageZeroDualLinearMap_apply]
        rw [← rootBoundaryChildMessageZeroDualSingleCoeff_eq_dot]
    _ =
      ∑ rest' : ChildVertexFieldDomainFamily n cs,
        rootBoundaryChildMessageZeroDualLinearMap
          (n := n) (b := a) [C] (0 : ChildIdx [C])
          (fun rdSingle =>
            nodeRootFieldAssignmentConsChildPiLinearEquiv
              n a C cs S rest'
              (singletonNodeRootFieldDomainVertexEquiv n a C rdSingle))
          (firstChildCoefficientOutputConsZeroLinearEquiv
            (n := n) (a := a) C cs ha
            (Pi.single
              (M := fun _ :
                RawNormal.NodeChildRootFieldDomain n a (C :: cs)
                  (0 : ChildIdx (C :: cs)) => F2)
              d (1 : F2)) rest') := by
        rw [rootBoundaryChildMessageZeroDualLinearMap_consZero_apply]
    _ =
      rootBoundaryChildMessageZeroDualLinearMap
        (n := n) (b := a) [C] (0 : ChildIdx [C])
        (fun rdSingle =>
          nodeRootFieldAssignmentConsChildPiLinearEquiv
            n a C cs S rest
            (singletonNodeRootFieldDomainVertexEquiv n a C rdSingle))
        (Pi.single
          (M := fun _ :
            RawNormal.NodeChildRootFieldDomain n a [C]
              (0 : ChildIdx [C]) => F2)
          single (1 : F2)) := by
        rw [Fintype.sum_eq_single rest]
        · congr 1
          funext single'
          rw [firstChildCoefficientOutputConsZeroLinearEquiv_apply_pi_single]
          rw [hed]
          exact pi_single_prod_same_fst rest single single'
        · intro rest' hrest'
          have hφ :
              firstChildCoefficientOutputConsZeroLinearEquiv
                (n := n) (a := a) C cs ha
                (Pi.single
                  (M := fun _ :
                    RawNormal.NodeChildRootFieldDomain n a (C :: cs)
                      (0 : ChildIdx (C :: cs)) => F2)
                  d (1 : F2)) rest' = 0 := by
            funext single'
            rw [firstChildCoefficientOutputConsZeroLinearEquiv_apply_pi_single]
            rw [hed]
            have hp : (rest', single') ≠ (rest, single) := by
              intro hpair
              exact hrest' (congrArg Prod.fst hpair)
            simp [Pi.single_eq_of_ne hp]
          rw [hφ]
          simp
    _ =
      rootBoundaryChildMessageZeroDualSingleCoeff
        (n := n) (b := a) [C] (0 : ChildIdx [C])
        (fun rdSingle =>
          nodeRootFieldAssignmentConsChildPiLinearEquiv
            n a C cs S rest
