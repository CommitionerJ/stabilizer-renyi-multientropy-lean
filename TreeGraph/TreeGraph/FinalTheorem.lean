      ∑ φ : RawNormal.NodeChildRootFieldDomain n a cs i → F2,
        childOpenRootInternalKernelAt (n := n) (a := a) cs i φ := by
  classical
  refine Finset.sum_congr rfl ?_
  intro φ _
  have hφ :
      childBoundaryLinearFormAt (n := n) (a := a) cs R i φ = 0 := by
    have happly :=
      congrArg
        (fun L :
          (RawNormal.NodeChildRootFieldDomain n a cs i → F2) →ₗ[F2] F2 =>
