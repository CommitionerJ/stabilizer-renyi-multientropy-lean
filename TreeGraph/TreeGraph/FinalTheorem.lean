theorem twistedExternalChildInternalSum_eq_twoPow_of_closedGauge
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs)
    (hchildRoot : 0 < (childAt cs i).rootWeight)
    (hC : RawExpandedOpenRootSubtreeCert (childAt cs i))
    (hgauge :
      (∑ Aext :
        ChildExternalCoordinate n a cs i →
