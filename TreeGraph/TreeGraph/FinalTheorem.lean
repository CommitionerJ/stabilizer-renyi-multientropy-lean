          0 := by
  rw [childBoundaryCoefficientMap_mem_ker_iff_forall_context_fiberSum_cyclicPrevDiff
    (n := n) (b := b) ds hpos R]
  constructor
  · intro hprev j c
    apply
      (cyclicPrevDiff_eq_zero_iff_cyclicDiff_eq_zero
        (n := n) F2
        (RawLinearAlgebra.fiberSum
          (NonRootVertex.weight
            (RawNormal.childRootAtAsNonRootInNode (a := b) j)) n F2
          (fun x =>
            R (rootFieldDomainOfNonRootContextTuple
              (n := n) (T := RTree.node b ds)
              (RawNormal.childRootAtAsNonRootInNode (a := b) j) c x)))).1
    ext t
    exact hprev j c t
  · intro hdiff j c t
    have hprev :
        cyclicPrevDiff n F2
          (RawLinearAlgebra.fiberSum
            (NonRootVertex.weight
              (RawNormal.childRootAtAsNonRootInNode (a := b) j)) n F2
            (fun x =>
              R (rootFieldDomainOfNonRootContextTuple
                (n := n) (T := RTree.node b ds)
                (RawNormal.childRootAtAsNonRootInNode (a := b) j) c x))) =
          0 :=
      (cyclicPrevDiff_eq_zero_iff_cyclicDiff_eq_zero
        (n := n) F2
        (RawLinearAlgebra.fiberSum
