theorem childLinearizedContributionSumAt_leaf_child_eq_copyFactor_mul_boundaryZero_indicator
    {n a b : Nat} [NeZero n] {cs : List RTree}
    (R : RawNormal.NodeRootFieldAssignment n a cs)
    (i : ChildIdx cs)
    (ha : 0 < a) (hb : 0 < b)
    (hchild : childAt cs i = RTree.node b []) :
    childLinearizedContributionSumAt (n := n) (a := a) cs R i =
      RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopyFactorAt
        n a cs i *
        indicatorZ
          (childBoundaryLinearFormAt (n := n) (a := a) cs R i = 0) := by
  classical
  rw [childLinearizedContributionSumAt_leaf_child_eq_if_boundary_zero
    (R := R) (i := i) hchild]
  have hcard :
      ((Fintype.card
        (RawNormal.NodeChildRootFieldDomain n a cs i → F2) : Nat) : ℤ) =
        RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopyFactorAt
          n a cs i := by
    calc
      ((Fintype.card
        (RawNormal.NodeChildRootFieldDomain n a cs i → F2) : Nat) : ℤ) =
          (2 : ℤ) ^
            Fintype.card
              (RawNormal.NodeChildRootFieldDomain n a cs i) := by
            exact card_childRootFieldFunction_eq_two_pow_domain
              (n := n) (a := a) (cs := cs) i
      _ = (2 : ℤ) ^ (n ^ childExternalCoordinateExponentAt a cs i) := by
            rw [card_nodeChildRootFieldDomain_leaf_child
              (n := n) (a := a) (b := b) ha i hchild]
      _ =
          RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopyFactorAt
            n a cs i := by
            exact
              (childInternalCoordinateCopyFactorAt_leaf_child_closed
                (n := n) (a := a) (b := b) i hb hchild).symm
  by_cases hzero :
      childBoundaryLinearFormAt (n := n) (a := a) cs R i = 0
  · rw [if_pos hzero, indicatorZ_of_pos hzero, mul_one]
    exact hcard
  · rw [if_neg hzero, indicatorZ_of_neg hzero, mul_zero]

theorem boundaryInternalFactorization_of_leaf_child_boundaryZeroKernelCard
    {a : Nat} {cs : List RTree} {n : Nat} [NeZero n]
