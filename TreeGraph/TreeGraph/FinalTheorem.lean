theorem rootBoundaryChildMessageZeroDualLinearMap_consZero_apply
    {n a : Nat} [NeZero n] (C : RTree) (cs : List RTree)
    (ha : 0 < a)
    (S : RawNormal.NodeRootFieldAssignment n a (C :: cs))
    (φ :
      RawNormal.NodeChildRootFieldDomain n a (C :: cs)
        (0 : ChildIdx (C :: cs)) → F2) :
    rootBoundaryChildMessageZeroDualLinearMap
        (n := n) (b := a) (C :: cs) (0 : ChildIdx (C :: cs))
        S φ =
      ∑ rest : ChildVertexFieldDomainFamily n cs,
        rootBoundaryChildMessageZeroDualLinearMap
          (n := n) (b := a) [C] (0 : ChildIdx [C])
          (fun rdSingle =>
            nodeRootFieldAssignmentConsChildPiLinearEquiv
              n a C cs S rest
              (singletonNodeRootFieldDomainVertexEquiv n a C rdSingle))
          (firstChildCoefficientOutputConsZeroLinearEquiv
            (n := n) (a := a) C cs ha φ rest) := by
  classical
  let e := nodeRootFieldDomainConsChildPiEquiv n a C cs
  let se := singletonNodeRootFieldDomainVertexEquiv n a C
  calc
    rootBoundaryChildMessageZeroDualLinearMap
        (n := n) (b := a) (C :: cs) (0 : ChildIdx (C :: cs))
        S φ =
      ∑ rd : RawNormal.RootFieldDomain n (RTree.node a (C :: cs)),
        S rd *
          rootBoundaryChildMessageZeroLinearMap
            (n := n) (b := a) (C :: cs) (0 : ChildIdx (C :: cs))
            φ rd := by
        rw [rootBoundaryChildMessageZeroDualLinearMap_apply]
        rw [dotLinear_apply]
    _ =
      ∑ p : ChildVertexFieldDomainFamily n cs × VertexFieldDomain n C,
        S (e.symm p) *
          rootBoundaryChildMessageZeroLinearMap
            (n := n) (b := a) (C :: cs) (0 : ChildIdx (C :: cs))
            φ (e.symm p) := by
        exact
          (Equiv.sum_comp e.symm
            (fun rd : RawNormal.RootFieldDomain n (RTree.node a (C :: cs)) =>
              S rd *
                rootBoundaryChildMessageZeroLinearMap
                  (n := n) (b := a) (C :: cs)
                  (0 : ChildIdx (C :: cs)) φ rd)).symm
    _ =
      ∑ p : ChildVertexFieldDomainFamily n cs × VertexFieldDomain n C,
        nodeRootFieldAssignmentConsChildPiLinearEquiv
            n a C cs S p.1 p.2 *
          rootBoundaryChildMessageZeroLinearMap
            (n := n) (b := a) [C] (0 : ChildIdx [C])
            (firstChildCoefficientOutputConsZeroLinearEquiv
              (n := n) (a := a) C cs ha φ p.1)
            (se.symm p.2) := by
        refine Finset.sum_congr rfl ?_
        intro p _hp
        have hmsg :
            rootBoundaryChildMessageZeroLinearMap
                (n := n) (b := a) (C :: cs)
                (0 : ChildIdx (C :: cs)) φ (e.symm p) =
              rootBoundaryChildMessageZeroLinearMap
                (n := n) (b := a) [C] (0 : ChildIdx [C])
                (firstChildCoefficientOutputConsZeroLinearEquiv
                  (n := n) (a := a) C cs ha φ p.1)
                (se.symm p.2) := by
          simpa [e, se] using
            rootBoundaryChildMessageZeroLinearMap_consZero_eq_singleton
              (n := n) (a := a) C cs ha φ (e.symm p)
        have hS :
            S (e.symm p) =
              nodeRootFieldAssignmentConsChildPiLinearEquiv
                n a C cs S p.1 p.2 := by
          cases p with
          | mk rest first =>
              rfl
        rw [hmsg, hS]
    _ =
      ∑ rest : ChildVertexFieldDomainFamily n cs,
        ∑ first : VertexFieldDomain n C,
          nodeRootFieldAssignmentConsChildPiLinearEquiv
              n a C cs S rest first *
            rootBoundaryChildMessageZeroLinearMap
              (n := n) (b := a) [C] (0 : ChildIdx [C])
              (firstChildCoefficientOutputConsZeroLinearEquiv
                (n := n) (a := a) C cs ha φ rest)
              (se.symm first) := by
        rw [Fintype.sum_prod_type]
    _ =
      ∑ rest : ChildVertexFieldDomainFamily n cs,
        rootBoundaryChildMessageZeroDualLinearMap
          (n := n) (b := a) [C] (0 : ChildIdx [C])
          (fun rdSingle =>
            nodeRootFieldAssignmentConsChildPiLinearEquiv
              n a C cs S rest
              (singletonNodeRootFieldDomainVertexEquiv n a C rdSingle))
          (firstChildCoefficientOutputConsZeroLinearEquiv
            (n := n) (a := a) C cs ha φ rest) := by
        refine Finset.sum_congr rfl ?_
        intro rest _hrest
        rw [rootBoundaryChildMessageZeroDualLinearMap_apply]
        rw [dotLinear_apply]
        simpa [se] using
          (Equiv.sum_comp se.symm
            (fun rdSingle : RawNormal.RootFieldDomain n (RTree.node a [C]) =>
              nodeRootFieldAssignmentConsChildPiLinearEquiv
                  n a C cs S rest
                  (singletonNodeRootFieldDomainVertexEquiv n a C rdSingle) *
                rootBoundaryChildMessageZeroLinearMap
                  (n := n) (b := a) [C] (0 : ChildIdx [C])
                  (firstChildCoefficientOutputConsZeroLinearEquiv
                    (n := n) (a := a) C cs ha φ rest)
                  rdSingle))

