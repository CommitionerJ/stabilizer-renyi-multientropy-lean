noncomputable def cyclicNodeChildRootExternalFamilyEquiv
    (n b : Nat) [NeZero n] (ds : List RTree) :
    CyclicNodeChildRootFamily n b ds ≃
      CyclicNodeChildExternalRootFamily n b ds where
  toFun Φ j :=
    cyclicNodeChildRootFamilyAtExternalEquiv n b ds j (Φ j)
  invFun Φ j :=
    (cyclicNodeChildRootFamilyAtExternalEquiv n b ds j).symm (Φ j)
  left_inv Φ := by
    funext j
    exact (cyclicNodeChildRootFamilyAtExternalEquiv n b ds j).left_inv (Φ j)
  right_inv Φ := by
    funext j
    exact (cyclicNodeChildRootFamilyAtExternalEquiv n b ds j).right_inv (Φ j)

