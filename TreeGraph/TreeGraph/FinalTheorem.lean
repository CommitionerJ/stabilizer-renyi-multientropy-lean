theorem twistedExternalChildInternalSum_eq_twoPow_of_baseCyclic
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs)
    (hchildRoot : 0 < (childAt cs i).rootWeight)
    (W :
      (ZMod n → RawNormal.NormalAssignment n (childAt cs i)) → ℤ)
    (hfactor :
      ∀ Acyc :
        ChildExternalBaseCoordinate n a cs i →
          ZMod n → RawNormal.NormalAssignment n (childAt cs i),
        childParentEmbeddedInternalWeight
          (n := n) (a := a) (cs := cs) i hchildRoot
          ((externalAssignmentsEquivBaseCyclic
            (n := n) (a := a) (cs := cs) i).symm Acyc) =
          ∏ base : ChildExternalBaseCoordinate n a cs i, W (Acyc base))
    (hcyclic :
      (∑ B : ZMod n → RawNormal.NormalAssignment n (childAt cs i), W B) =
        (2 : ℤ) ^
          (Int.toNat (Xassign n (childAt cs i)) *
            Fintype.card (ZMod n))) :
    (∑ Aext :
      ChildExternalCoordinate n a cs i →
        RawNormal.NormalAssignment n (childAt cs i),
      childParentEmbeddedInternalWeight
        (n := n) (a := a) (cs := cs) i hchildRoot Aext) =
      (2 : ℤ) ^
        (Int.toNat (Xassign n (childAt cs i)) *
          Fintype.card (ChildExternalCoordinate n a cs i)) := by
  classical
  rw [twistedExternalChildInternalSum_eq_baseCyclicSum
    (n := n) (a := a) (cs := cs) i hchildRoot]
  let X : Nat := Int.toNat (Xassign n (childAt cs i))
  let Z : Nat := Fintype.card (ZMod n)
  let Bc : Nat := Fintype.card (ChildExternalBaseCoordinate n a cs i)
  have hcyclicXZ :
      (∑ B : ZMod n → RawNormal.NormalAssignment n (childAt cs i), W B) =
        (2 : ℤ) ^ (X * Z) := by
    simpa [X, Z] using hcyclic
  calc
    (∑ Acyc :
      ChildExternalBaseCoordinate n a cs i →
        ZMod n → RawNormal.NormalAssignment n (childAt cs i),
      childParentEmbeddedInternalWeight
        (n := n) (a := a) (cs := cs) i hchildRoot
        ((externalAssignmentsEquivBaseCyclic
          (n := n) (a := a) (cs := cs) i).symm Acyc)) =
        ∑ Acyc :
          ChildExternalBaseCoordinate n a cs i →
            ZMod n → RawNormal.NormalAssignment n (childAt cs i),
          ∏ base : ChildExternalBaseCoordinate n a cs i, W (Acyc base) := by
          refine Finset.sum_congr rfl ?_
          intro Acyc _
          exact hfactor Acyc
    _ =
        ∏ _base : ChildExternalBaseCoordinate n a cs i,
          ∑ B : ZMod n → RawNormal.NormalAssignment n (childAt cs i), W B := by
          simpa using
            (sum_pi_product
              (ι := ChildExternalBaseCoordinate n a cs i)
              (α := ZMod n → RawNormal.NormalAssignment n (childAt cs i))
              (R := ℤ)
              (fun _base B => W B))
    _ =
        ∏ _base : ChildExternalBaseCoordinate n a cs i, (2 : ℤ) ^ (X * Z) := by
          simp [hcyclicXZ]
    _ =
        ((2 : ℤ) ^ (X * Z)) ^ Bc := by
          simp [Bc]
    _ =
        (2 : ℤ) ^ ((X * Z) * Bc) := by
          simp only [← pow_mul]
    _ =
        (2 : ℤ) ^
          (Int.toNat (Xassign n (childAt cs i)) *
            Fintype.card (ChildExternalCoordinate n a cs i)) := by
          congr 1
          simp [X, Z, Bc, card_childExternalCoordinate_eq_base_mul_zmod]
          ac_rfl

theorem twistedExternalChildInternalSum_eq_twoPow_of_baseCyclicDependent
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs)
    (hchildRoot : 0 < (childAt cs i).rootWeight)
    (W :
