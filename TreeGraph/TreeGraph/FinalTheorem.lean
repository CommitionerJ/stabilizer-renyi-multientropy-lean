      cyclicRootTwistedWeightForBase
        (n := n) (a := a) (cs := cs) i hchildRoot base (Acyc base) := by
  classical
  unfold childParentEmbeddedInternalWeight cyclicRootTwistedWeightForBase
  rw [hphase]
  exact
    (prod_bitSign_eq_bitSign_sum Finset.univ
      (fun base : ChildExternalBaseCoordinate n a cs i =>
        cyclicRootTwistedPhaseForBase
          (n := n) (a := a) (cs := cs) i (Acyc base))).symm

theorem twistedExternalChildInternalSum_eq_twoPow_from_cyclicPhase
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs)
    (hchildRoot : 0 < (childAt cs i).rootWeight)
    (hphase :
      ∀ Acyc :
        ChildExternalBaseCoordinate n a cs i →
          ZMod n → RawNormal.NormalAssignment n (childAt cs i),
        childInternalPhaseGivenRootDataAt
          (n := n) (a := a) cs
          (0 : RawNormal.NodeRootFieldAssignment n a cs) i
          ((nodeChildDataAtStructuredEquivExternalNormalAssignments
            (n := n) (a := a) (cs := cs) i hchildRoot).symm
            ((externalAssignmentsEquivBaseCyclic
              (n := n) (a := a) (cs := cs) i).symm Acyc)) =
          ∑ base : ChildExternalBaseCoordinate n a cs i,
            cyclicRootTwistedPhaseForBase
              (n := n) (a := a) (cs := cs) i (Acyc base))
    (hcyclic :
      ∀ base : ChildExternalBaseCoordinate n a cs i,
        (∑ B : ZMod n → RawNormal.NormalAssignment n (childAt cs i),
          cyclicRootTwistedWeightForBase
            (n := n) (a := a) (cs := cs) i hchildRoot base B) =
          (2 : ℤ) ^
            (Int.toNat (Xassign n (childAt cs i)) *
              Fintype.card (ZMod n))) :
    (∑ Aext :
      ChildExternalCoordinate n a cs i →
        RawNormal.NormalAssignment n (childAt cs i),
      childParentEmbeddedInternalWeight
        (n := n) (a := a) (cs := cs) i hchildRoot Aext) =
      (2 : ℤ) ^
        (Int.toNat (Xassign n (childAt cs i)) *
          Fintype.card (ChildExternalCoordinate n a cs i)) :=
  twistedExternalChildInternalSum_eq_twoPow_of_baseCyclicDependent
    (n := n) (a := a) (cs := cs) i hchildRoot
    (W := fun base B =>
      cyclicRootTwistedWeightForBase
        (n := n) (a := a) (cs := cs) i hchildRoot base B)
    (fun Acyc =>
      childParentEmbeddedInternalWeight_eq_prod_base_cyclic_of_phase
        (n := n) (a := a) (cs := cs) i hchildRoot Acyc
        (hphase Acyc))
    hcyclic

