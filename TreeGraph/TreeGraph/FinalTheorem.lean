def RawAssignmentEdgePhaseNodeRule : Prop :=
  ∀ {a : Nat} {cs : List RTree},
    0 < a →
    (∀ C ∈ cs, RTree.PositiveWeights C) →
    ∀ (n : Nat) [NeZero n],
      (∑ Araw :
