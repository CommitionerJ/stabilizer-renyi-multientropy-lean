    (B : ZMod n → RawNormal.NormalAssignment n T)
    (d : ZMod n)
    (site : RawNormal.NormalSite n T)
    (u v : Vertex T) :
    cyclicTwistedEdgePhaseAt B d site (u.1, v.1) =
      cyclicTwistedKetAtVertex B d site u *
        cyclicTwistedKetAtVertex B d site v +
      cyclicTwistedBraAtVertex B d site u *
        cyclicTwistedBraAtVertex B d site v := by
  simp [cyclicTwistedEdgePhaseAt]

noncomputable def rootFieldTotalDiagonal
    {n : Nat} [NeZero n] {T : RTree}
    (rd : RawNormal.RootFieldDomain n T) : ZMod n :=
  ∑ v : NonRootVertex T,
    ∑ j : Fin (NonRootVertex.weight v), rd v j

noncomputable def nonRootFieldDomainTotalDiagonal
    {n : Nat} [NeZero n] {T : RTree}
    (v : NonRootVertex T)
    (dom : RawNormal.NonRootFieldDomain n T v) : ZMod n :=
  dom.diagonal +
    ∑ u : RawNormal.OtherNonRootVertex T v,
      ∑ j : Fin (NonRootVertex.weight u.1), dom.otherCoord u j

theorem nonRootFieldDomainTotalDiagonal_nonRootDomainOfSite
    {n : Nat} [NeZero n] {T : RTree}
    (site : RawNormal.NormalSite n T)
    (v : NonRootVertex T)
    (shift : ZMod n) :
    nonRootFieldDomainTotalDiagonal v
        (RawNormal.nonRootDomainOfSite site v shift) =
      rootFieldTotalDiagonal site.nonRootCoord + shift := by
  classical
  unfold nonRootFieldDomainTotalDiagonal rootFieldTotalDiagonal
    RawNormal.nonRootDomainOfSite RawNormal.diagonal
  have hsplit :
      (∑ w : NonRootVertex T,
          ∑ j : Fin (NonRootVertex.weight w),
            site.nonRootCoord w j) =
        (∑ j : Fin (NonRootVertex.weight v),
            site.nonRootCoord v j) +
          (∑ w ∈ ((Finset.univ : Finset (NonRootVertex T)) \ {v}),
            ∑ j : Fin (NonRootVertex.weight w),
              site.nonRootCoord w j) := by
    simpa using
      (Finset.sum_eq_add_sum_diff_singleton
        (s := (Finset.univ : Finset (NonRootVertex T)))
        (i := v)
        (f := fun w : NonRootVertex T =>
          ∑ j : Fin (NonRootVertex.weight w),
            site.nonRootCoord w j)
        (by simp))
  have hother :
      (∑ w ∈ ((Finset.univ : Finset (NonRootVertex T)) \ {v}),
          ∑ j : Fin (NonRootVertex.weight w),
            site.nonRootCoord w j) =
        ∑ u : RawNormal.OtherNonRootVertex T v,
          ∑ j : Fin (NonRootVertex.weight u.1),
            site.nonRootCoord u.1 j :=
    Finset.sum_subtype
      (s := ((Finset.univ : Finset (NonRootVertex T)) \ {v}))
      (p := fun w : NonRootVertex T => w.1.1 ≠ v.1.1)
      (f := fun w : NonRootVertex T =>
        ∑ j : Fin (NonRootVertex.weight w),
          site.nonRootCoord w j)
      (by
        intro w
        constructor
        · intro hw
          have hne : w ≠ v := by
            intro hwv
            exact (Finset.mem_sdiff.mp hw).2 (by simp [hwv])
          intro haddr
          exact hne (nonRootVertex_eq_of_addr_eq haddr)
        · intro haddr
          exact Finset.mem_sdiff.mpr ⟨by simp, by
            intro hwv_mem
            simp only [Finset.mem_singleton] at hwv_mem
            exact haddr
              (congrArg (fun x : NonRootVertex T => x.1.1) hwv_mem)⟩)
  rw [hsplit, hother]
  let diag : ZMod n :=
    ∑ j : Fin (NonRootVertex.weight v), site.nonRootCoord v j
  let other : ZMod n :=
    ∑ u : RawNormal.OtherNonRootVertex T v,
      ∑ j : Fin (NonRootVertex.weight u.1), site.nonRootCoord u.1 j
  change (diag + shift) + other = (diag + other) + shift
  ac_rfl

noncomputable def cyclicTimeShearNormalCopies
    {n : Nat} [NeZero n] {T : RTree}
    (B : ZMod n → RawNormal.NormalAssignment n T) :
    ZMod n → RawNormal.NormalAssignment n T :=
  fun c =>
    { rootField := fun rd =>
        (B (c - rootFieldTotalDiagonal rd)).rootField rd
      nodeField := fun v dom =>
        (B (c - nonRootFieldDomainTotalDiagonal v dom)).nodeField v dom }

theorem rawNormalNormalAssignment_ext
    {n : Nat} [NeZero n] {T : RTree}
    {A B : RawNormal.NormalAssignment n T}
    (hroot : A.rootField = B.rootField)
    (hnode : A.nodeField = B.nodeField) :
    A = B := by
  cases A
  cases B
  cases hroot
  cases hnode
  rfl

noncomputable def cyclicTimeShearNormalCopiesEquiv
    (n : Nat) [NeZero n] (T : RTree) :
    (ZMod n → RawNormal.NormalAssignment n T) ≃
      (ZMod n → RawNormal.NormalAssignment n T) where
  toFun B := cyclicTimeShearNormalCopies (n := n) (T := T) B
  invFun A := fun d =>
    { rootField := fun rd =>
        (A (d + rootFieldTotalDiagonal rd)).rootField rd
      nodeField := fun v dom =>
        (A (d + nonRootFieldDomainTotalDiagonal v dom)).nodeField v dom }
  left_inv B := by
    funext d
    apply rawNormalNormalAssignment_ext
    · funext rd
      simp [cyclicTimeShearNormalCopies, sub_eq_add_neg, add_assoc]
    · funext v dom
      simp [cyclicTimeShearNormalCopies, sub_eq_add_neg, add_assoc]
  right_inv A := by
    funext c
    apply rawNormalNormalAssignment_ext
    · funext rd
      simp [cyclicTimeShearNormalCopies, sub_eq_add_neg, add_assoc]
    · funext v dom
      simp [cyclicTimeShearNormalCopies, sub_eq_add_neg, add_assoc]

theorem cyclicTimeShearNormalCopies_ketAtVertex
    {n : Nat} [NeZero n] {T : RTree}
    (B : ZMod n → RawNormal.NormalAssignment n T)
    (c : ZMod n) (site : RawNormal.NormalSite n T)
    (v : Vertex T) :
    RawNormal.ketAtVertex (cyclicTimeShearNormalCopies B c) site v =
      cyclicTwistedKetAtVertex B
        (c - rootFieldTotalDiagonal site.nonRootCoord) site v := by
  classical
  by_cases hv : v.1 = []
  · simp [RawNormal.ketAtVertex, cyclicTwistedKetAtVertex,
      cyclicTimeShearNormalCopies, hv]
  · have htd :=
      nonRootFieldDomainTotalDiagonal_nonRootDomainOfSite
        (site := site) (v := ⟨v, hv⟩) (shift := (0 : ZMod n))
    simp [RawNormal.ketAtVertex, cyclicTwistedKetAtVertex,
      cyclicTimeShearNormalCopies, hv, htd]

theorem cyclicTimeShearNormalCopies_braAtVertex
    {n : Nat} [NeZero n] {T : RTree}
    (B : ZMod n → RawNormal.NormalAssignment n T)
    (c : ZMod n) (site : RawNormal.NormalSite n T)
    (v : Vertex T) :
    RawNormal.braAtVertex (cyclicTimeShearNormalCopies B c) site v =
      cyclicTwistedBraAtVertex B
        (c - rootFieldTotalDiagonal site.nonRootCoord - 1) site v := by
  classical
  by_cases hv : v.1 = []
  · simp [RawNormal.braAtVertex, cyclicTwistedBraAtVertex,
      cyclicTimeShearNormalCopies, hv, sub_eq_add_neg, add_assoc]
  · have htd :=
      nonRootFieldDomainTotalDiagonal_nonRootDomainOfSite
        (site := site) (v := ⟨v, hv⟩) (shift := (1 : ZMod n))
    have hidx :
        c - (rootFieldTotalDiagonal site.nonRootCoord + 1) =
          c - rootFieldTotalDiagonal site.nonRootCoord - 1 := by
      abel
    simp [RawNormal.braAtVertex, cyclicTwistedBraAtVertex,
      cyclicTimeShearNormalCopies, hv, htd, hidx]

theorem cyclicTimeShearNormalCopies_ketAtPath
    {n : Nat} [NeZero n] {T : RTree}
    (B : ZMod n → RawNormal.NormalAssignment n T)
    (c : ZMod n) (site : RawNormal.NormalSite n T)
    (p : List Nat) :
    RawNormal.ketAtPath (cyclicTimeShearNormalCopies B c) site p =
      cyclicTwistedKetAtPath B
        (c - rootFieldTotalDiagonal site.nonRootCoord) site p := by
  classical
  by_cases hp : p ∈ RTree.addresses T
  · simp [RawNormal.ketAtPath, cyclicTwistedKetAtPath, hp,
      cyclicTimeShearNormalCopies_ketAtVertex]
  · simp [RawNormal.ketAtPath, cyclicTwistedKetAtPath, hp]

theorem cyclicTimeShearNormalCopies_braAtPath
    {n : Nat} [NeZero n] {T : RTree}
    (B : ZMod n → RawNormal.NormalAssignment n T)
    (c : ZMod n) (site : RawNormal.NormalSite n T)
    (p : List Nat) :
    RawNormal.braAtPath (cyclicTimeShearNormalCopies B c) site p =
      cyclicTwistedBraAtPath B
        (c - rootFieldTotalDiagonal site.nonRootCoord - 1) site p := by
  classical
  by_cases hp : p ∈ RTree.addresses T
  · simp [RawNormal.braAtPath, cyclicTwistedBraAtPath, hp,
      cyclicTimeShearNormalCopies_braAtVertex]
  · simp [RawNormal.braAtPath, cyclicTwistedBraAtPath, hp]

theorem zmod_sum_sub_right
    {n : Nat} [NeZero n] {M : Type} [AddCommMonoid M]
    (c : ZMod n) (f : ZMod n → M) :
    (∑ d : ZMod n, f (d - c)) = ∑ d : ZMod n, f d := by
  refine Fintype.sum_equiv (Equiv.addRight (-c))
    (fun d : ZMod n => f (d - c)) f ?_
  intro d
  simp [sub_eq_add_neg]

theorem sum_cyclicTimeShear_edgePhaseAtSite_eq_sum_cyclicTwistedEdgePhaseAt
    {n : Nat} [NeZero n] {T : RTree}
    (B : ZMod n → RawNormal.NormalAssignment n T)
    (site : RawNormal.NormalSite n T)
    (e : List Nat × List Nat) :
    (∑ c : ZMod n,
      RawNormal.edgePhaseAtSite
        (cyclicTimeShearNormalCopies B c) site e) =
      ∑ d : ZMod n, cyclicTwistedEdgePhaseAt B d site e := by
  classical
  let L : ZMod n := rootFieldTotalDiagonal site.nonRootCoord
  have hket :
      (∑ c : ZMod n,
        cyclicTwistedKetAtPath B (c - L) site e.1 *
          cyclicTwistedKetAtPath B (c - L) site e.2) =
        ∑ d : ZMod n,
          cyclicTwistedKetAtPath B d site e.1 *
            cyclicTwistedKetAtPath B d site e.2 := by
    simpa using
      (zmod_sum_sub_right
        (n := n) (M := F2) L
        (fun d : ZMod n =>
          cyclicTwistedKetAtPath B d site e.1 *
            cyclicTwistedKetAtPath B d site e.2))
  have hbra :
      (∑ c : ZMod n,
        cyclicTwistedBraAtPath B (c - L - 1) site e.1 *
          cyclicTwistedBraAtPath B (c - L - 1) site e.2) =
        ∑ d : ZMod n,
          cyclicTwistedBraAtPath B d site e.1 *
            cyclicTwistedBraAtPath B d site e.2 := by
    have hidx :
        ∀ c : ZMod n, c - L - 1 = c - (L + 1) := by
      intro c
      abel
    calc
      (∑ c : ZMod n,
        cyclicTwistedBraAtPath B (c - L - 1) site e.1 *
          cyclicTwistedBraAtPath B (c - L - 1) site e.2) =
          ∑ c : ZMod n,
            cyclicTwistedBraAtPath B (c - (L + 1)) site e.1 *
              cyclicTwistedBraAtPath B (c - (L + 1)) site e.2 := by
            refine Finset.sum_congr rfl ?_
            intro c _
            rw [hidx c]
      _ =
          ∑ d : ZMod n,
            cyclicTwistedBraAtPath B d site e.1 *
              cyclicTwistedBraAtPath B d site e.2 := by
            simpa using
              (zmod_sum_sub_right
                (n := n) (M := F2) (L + 1)
                (fun d : ZMod n =>
                  cyclicTwistedBraAtPath B d site e.1 *
                    cyclicTwistedBraAtPath B d site e.2))
  calc
    (∑ c : ZMod n,
      RawNormal.edgePhaseAtSite
        (cyclicTimeShearNormalCopies B c) site e) =
        ∑ c : ZMod n,
          (cyclicTwistedKetAtPath B (c - L) site e.1 *
              cyclicTwistedKetAtPath B (c - L) site e.2 +
            cyclicTwistedBraAtPath B (c - L - 1) site e.1 *
              cyclicTwistedBraAtPath B (c - L - 1) site e.2) := by
          refine Finset.sum_congr rfl ?_
          intro c _
          simp [RawNormal.edgePhaseAtSite, L,
            cyclicTimeShearNormalCopies_ketAtPath,
            cyclicTimeShearNormalCopies_braAtPath]
    _ =
        (∑ c : ZMod n,
          cyclicTwistedKetAtPath B (c - L) site e.1 *
            cyclicTwistedKetAtPath B (c - L) site e.2) +
        (∑ c : ZMod n,
          cyclicTwistedBraAtPath B (c - L - 1) site e.1 *
            cyclicTwistedBraAtPath B (c - L - 1) site e.2) := by
          rw [Finset.sum_add_distrib]
    _ =
        (∑ d : ZMod n,
          cyclicTwistedKetAtPath B d site e.1 *
            cyclicTwistedKetAtPath B d site e.2) +
        (∑ d : ZMod n,
          cyclicTwistedBraAtPath B d site e.1 *
            cyclicTwistedBraAtPath B d site e.2) := by
          rw [hket, hbra]
    _ =
        ∑ d : ZMod n,
          (cyclicTwistedKetAtPath B d site e.1 *
              cyclicTwistedKetAtPath B d site e.2 +
            cyclicTwistedBraAtPath B d site e.1 *
              cyclicTwistedBraAtPath B d site e.2) := by
          rw [Finset.sum_add_distrib]
    _ = ∑ d : ZMod n, cyclicTwistedEdgePhaseAt B d site e := by
          refine Finset.sum_congr rfl ?_
          intro d _
          simp [cyclicTwistedEdgePhaseAt]

theorem sum_cyclicTimeShear_edgeListPhaseAtSite_eq_sum_cyclicTwistedEdgeListPhaseAtSite
    {n : Nat} [NeZero n] {T : RTree}
    (B : ZMod n → RawNormal.NormalAssignment n T)
    (site : RawNormal.NormalSite n T)
    (edges : List (List Nat × List Nat)) :
    (∑ c : ZMod n,
      (edges.map
        (RawNormal.edgePhaseAtSite
          (cyclicTimeShearNormalCopies B c) site)).sum) =
      ∑ d : ZMod n,
        (edges.map (cyclicTwistedEdgePhaseAt B d site)).sum := by
  classical
  induction edges with
  | nil =>
      simp
  | cons e es ih =>
      calc
        (∑ c : ZMod n,
          ((e :: es).map
            (RawNormal.edgePhaseAtSite
              (cyclicTimeShearNormalCopies B c) site)).sum) =
            ∑ c : ZMod n,
              (RawNormal.edgePhaseAtSite
                  (cyclicTimeShearNormalCopies B c) site e +
                (es.map
                  (RawNormal.edgePhaseAtSite
                    (cyclicTimeShearNormalCopies B c) site)).sum) := by
              refine Finset.sum_congr rfl ?_
              intro c _
              simp
        _ =
            (∑ c : ZMod n,
              RawNormal.edgePhaseAtSite
                (cyclicTimeShearNormalCopies B c) site e) +
            (∑ c : ZMod n,
              (es.map
                (RawNormal.edgePhaseAtSite
                  (cyclicTimeShearNormalCopies B c) site)).sum) := by
              rw [Finset.sum_add_distrib]
        _ =
            (∑ d : ZMod n, cyclicTwistedEdgePhaseAt B d site e) +
            (∑ d : ZMod n,
              (es.map (cyclicTwistedEdgePhaseAt B d site)).sum) := by
              rw [sum_cyclicTimeShear_edgePhaseAtSite_eq_sum_cyclicTwistedEdgePhaseAt,
                ih]
        _ =
            ∑ d : ZMod n,
              (cyclicTwistedEdgePhaseAt B d site e +
                (es.map (cyclicTwistedEdgePhaseAt B d site)).sum) := by
              rw [Finset.sum_add_distrib]
        _ =
            ∑ d : ZMod n,
              ((e :: es).map (cyclicTwistedEdgePhaseAt B d site)).sum := by
              refine Finset.sum_congr rfl ?_
              intro d _
              simp

noncomputable def cyclicTwistedPhase
    {n : Nat} [NeZero n] {T : RTree}
    (B : ZMod n → RawNormal.NormalAssignment n T) : F2 :=
  ∑ d : ZMod n,
    ∑ site : RawNormal.NormalSite n T,
      ((RTree.edgeList T).map
        (cyclicTwistedEdgePhaseAt B d site)).sum

theorem sum_cyclicTimeShear_totalPhase_eq_cyclicTwistedPhase
    {n : Nat} [NeZero n] {T : RTree}
    (B : ZMod n → RawNormal.NormalAssignment n T) :
    (∑ c : ZMod n,
      RawNormal.totalPhase T (cyclicTimeShearNormalCopies B c)) =
      cyclicTwistedPhase B := by
  classical
  calc
    (∑ c : ZMod n,
      RawNormal.totalPhase T (cyclicTimeShearNormalCopies B c)) =
        ∑ c : ZMod n,
          ∑ site : RawNormal.NormalSite n T,
            ((RTree.edgeList T).map
              (RawNormal.edgePhaseAtSite
                (cyclicTimeShearNormalCopies B c) site)).sum := by
          simp [RawNormal.totalPhase, RawNormal.phaseAtSite]
    _ =
        ∑ site : RawNormal.NormalSite n T,
          ∑ c : ZMod n,
            ((RTree.edgeList T).map
              (RawNormal.edgePhaseAtSite
                (cyclicTimeShearNormalCopies B c) site)).sum := by
          rw [Finset.sum_comm]
    _ =
        ∑ site : RawNormal.NormalSite n T,
          ∑ d : ZMod n,
            ((RTree.edgeList T).map
              (cyclicTwistedEdgePhaseAt B d site)).sum := by
          refine Finset.sum_congr rfl ?_
          intro site _
          exact
            sum_cyclicTimeShear_edgeListPhaseAtSite_eq_sum_cyclicTwistedEdgeListPhaseAtSite
              (B := B) site (RTree.edgeList T)
    _ =
        ∑ d : ZMod n,
          ∑ site : RawNormal.NormalSite n T,
            ((RTree.edgeList T).map
              (cyclicTwistedEdgePhaseAt B d site)).sum := by
          rw [Finset.sum_comm]
    _ = cyclicTwistedPhase B := rfl

theorem prod_cyclicTimeShear_weight_eq_bitSign_cyclicTwistedPhase
    {n : Nat} [NeZero n] {T : RTree}
    (B : ZMod n → RawNormal.NormalAssignment n T) :
    (∏ c : ZMod n,
      RawNormal.weight T (cyclicTimeShearNormalCopies B c)) =
      bitSign (cyclicTwistedPhase B) := by
  change
    (∏ c : ZMod n,
      bitSign
        (RawNormal.totalPhase T (cyclicTimeShearNormalCopies B c))) =
      bitSign (cyclicTwistedPhase B)
  rw [prod_bitSign_eq_bitSign_sum Finset.univ]
  rw [sum_cyclicTimeShear_totalPhase_eq_cyclicTwistedPhase]

theorem cyclicTwistedSum_eq_externalNormalCopiesProduct
    {n : Nat} [NeZero n] {T : RTree} :
    (∑ B : ZMod n → RawNormal.NormalAssignment n T,
      bitSign (cyclicTwistedPhase B)) =
      ∑ A : ZMod n → RawNormal.NormalAssignment n T,
        ∏ c : ZMod n, RawNormal.weight T (A c) := by
  classical
  refine
    Fintype.sum_equiv
      (cyclicTimeShearNormalCopiesEquiv n T)
      (fun B : ZMod n → RawNormal.NormalAssignment n T =>
        bitSign (cyclicTwistedPhase B))
      (fun A : ZMod n → RawNormal.NormalAssignment n T =>
        ∏ c : ZMod n, RawNormal.weight T (A c))
      ?_
  intro B
  exact (prod_cyclicTimeShear_weight_eq_bitSign_cyclicTwistedPhase B).symm

theorem cyclicTwistedSum_eq_rawExpandedPower_of_positiveWeights
    {n : Nat} [NeZero n] {T : RTree}
    (hT : RTree.PositiveWeights T) :
    (∑ B : ZMod n → RawNormal.NormalAssignment n T,
      bitSign (cyclicTwistedPhase B)) =
      (rawExpandedEdgeSignedSum n T) ^ Fintype.card (ZMod n) := by
  classical
  rw [cyclicTwistedSum_eq_externalNormalCopiesProduct]
  rw [← externalCopies_rawEdgePhaseSign_eq_normalWeight
    (n := n) (T := T) hT (ι := ZMod n)]
  rw [rawExpandedEdgePhaseSign_externalCopies_sum]

