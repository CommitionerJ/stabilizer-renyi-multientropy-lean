    (ChildExternalCoordinate n a cs i →
      RawNormal.NormalAssignment n (childAt cs i)) :=
  gaugeTransformExternalNormalAssignmentsWithEquiv
    (n := n) (a := a) (cs := cs) i
    (fun v => nonRootVertexDepthShift (n := n) v)

theorem closedExternalNormalSum_eq_rawExternalCopies
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs)
    (hC : RawExpandedOpenRootSubtreeCert (childAt cs i)) :
    (∑ Aext :
      ChildExternalCoordinate n a cs i →
        RawNormal.NormalAssignment n (childAt cs i),
      ∏ ext : ChildExternalCoordinate n a cs i,
        RawNormal.weight (childAt cs i) (Aext ext)) =
    (∑ ArawExt :
      ChildExternalCoordinate n a cs i →
        { Araw : RawAssignment n (childAt cs i) //
          RealizedByNormal (childAt cs i) Araw },
      ∏ ext : ChildExternalCoordinate n a cs i,
        rawEdgePhaseSign n (childAt cs i) (ArawExt ext)) := by
  classical
  exact
    (externalCopies_rawEdgePhaseSign_eq_normalWeight
      (n := n) (T := childAt cs i)
      (RawExpandedOpenRootSubtreeCert.positiveWeights hC)
      (ι := ChildExternalCoordinate n a cs i)).symm

theorem closedExternalRawCopies_eq_twoPow_Xassign
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs)
    (hC : RawExpandedOpenRootSubtreeCert (childAt cs i)) :
    (∑ ArawExt :
      ChildExternalCoordinate n a cs i →
        { Araw : RawAssignment n (childAt cs i) //
          RealizedByNormal (childAt cs i) Araw },
      ∏ ext : ChildExternalCoordinate n a cs i,
        rawEdgePhaseSign n (childAt cs i) (ArawExt ext)) =
    (2 : ℤ) ^
      (Int.toNat (Xassign n (childAt cs i)) *
        Fintype.card (ChildExternalCoordinate n a cs i)) := by
  classical
  have hX :=
    assignmentFactorProductExponent_eq_Xassign_of_positiveWeights
      (n := n) (RawExpandedOpenRootSubtreeCert.positiveWeights hC)
  simpa [hX] using
    (RawExpandedOpenRootSubtreeCert.externalCopiesFinalClosed_twoPow
      (T := childAt cs i) hC n
      (ι := ChildExternalCoordinate n a cs i))

theorem closedExternalNormalSum_eq_twoPow_Xassign
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs)
    (hC : RawExpandedOpenRootSubtreeCert (childAt cs i)) :
