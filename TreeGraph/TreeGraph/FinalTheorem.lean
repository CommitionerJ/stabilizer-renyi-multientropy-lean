theorem cyclicRootTwistedInternalPhaseForRootNode_node_eq_cyclicNodeInternalPhase
    {n a b : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs) {ds : List RTree}
    (hchild : childAt cs i = RTree.node b ds)
    (R : ZMod n → RawNormal.RootFieldAssignment n (childAt cs i))
    (N : ZMod n → RawNormal.NodeFieldAssignment n (childAt cs i)) :
    (∑ d : ZMod n,
      ∑ site : RawNormal.NormalSite n (childAt cs i),
        ((RTree.indexedChildInternalEdgesFrom [] 0 ds).map
          (cyclicRootTwistedEdgePhaseAt
            (n := n) (a := a) (cs := cs) i
            (fun d => { rootField := R d, nodeField := N d }) d site)).sum) =
