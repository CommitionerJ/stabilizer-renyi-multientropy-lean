theorem nodeChildRootFieldDomainDecompose_bijective
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs) :
    Function.Bijective
      (nodeChildRootFieldDomainDecompose
        (n := n) (a := a) (cs := cs) i) := by
  classical
  exact
    (Fintype.bijective_iff_injective_and_card
      (nodeChildRootFieldDomainDecompose
        (n := n) (a := a) (cs := cs) i)).2
      ⟨nodeChildRootFieldDomainDecompose_injective
          (n := n) (a := a) (cs := cs) i,
        card_nodeChildRootFieldDomain_eq_childExternal_mul_rootFieldDomain
          (n := n) (a := a) (cs := cs) i⟩

