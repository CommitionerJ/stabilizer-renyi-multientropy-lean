  Fintype.card_congr
    (boundaryZeroRootFieldSingleLeafForallEquivSingle n a b)

theorem boundaryZeroKernelCard_singleLeaf
    {a b n : Nat} [NeZero n] (ha : 0 < a) (hb : 0 < b) :
    Fintype.card
        { R : RawNormal.NodeRootFieldAssignment n a [RTree.node b []] //
          ∀ i : ChildIdx [RTree.node b []],
            childBoundaryLinearFormAt
              (n := n) (a := a) [RTree.node b []] R i = 0 } =
      Fintype.card (OpenRootMessageSpace n [RTree.node b []]) := by
  classical
  let cf :=
    RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopyFactorAt
      n a [RTree.node b []] (0 : ChildIdx [RTree.node b []])
  let Z :=
    { R : RawNormal.NodeRootFieldAssignment n a [RTree.node b []] //
      childBoundaryLinearFormAt
        (n := n) (a := a) [RTree.node b []] R
          (0 : ChildIdx [RTree.node b []]) = 0 }
  have hsum :=
    boundaryInternal_sum_singleLeaf_eq_copyFactor_mul_boundaryZeroCard
      (a := a) (b := b) (n := n) ha hb
  have hsigned :
      (∑ A : RawNormal.NormalAssignment n
          (RTree.node a [RTree.node b []]),
        bitSign (RawNormal.nodeBoundaryPhase a [RTree.node b []] A) *
          bitSign (RawNormal.nodeInternalPhase a [RTree.node b []] A)) =
        (2 : ℤ) ^ (n ^ a + n ^ b - (n - 1)) := by
    rw [← RawNormal.signedSum_node_eq_boundary_mul_internal_sum]
    exact signedSum_edge_closed ha hb
  have hzeroProduct :
      cf * (Fintype.card Z : ℤ) =
        (2 : ℤ) ^ (n ^ a + n ^ b - (n - 1)) := by
    have hsum' :
        (∑ A : RawNormal.NormalAssignment n
            (RTree.node a [RTree.node b []]),
          bitSign (RawNormal.nodeBoundaryPhase a [RTree.node b []] A) *
            bitSign (RawNormal.nodeInternalPhase a [RTree.node b []] A)) =
          cf * (Fintype.card Z : ℤ) := by
      exact hsum
    exact hsum'.symm.trans hsigned
  have hcf :
      cf = (2 : ℤ) ^ (n ^ a) := by
    have h :=
      childInternalCoordinateCopyFactorAt_leaf_child_closed
        (n := n) (a := a) (b := b)
        (cs := [RTree.node b []])
        (0 : ChildIdx [RTree.node b []]) hb rfl
    have hexp :
        childExternalCoordinateExponentAt a [RTree.node b []]
            (0 : ChildIdx [RTree.node b []]) = a := by
      rfl
    simpa [cf, hexp] using h
  have hopen :
      (Fintype.card (OpenRootMessageSpace n [RTree.node b []]) : ℤ) =
        (2 : ℤ) ^ (n ^ b - (n - 1)) := by
    rw [card_openRootMessageSpace_singleLeaf_closed n b]
    norm_num
  have hopenProduct :
      cf * (Fintype.card (OpenRootMessageSpace n [RTree.node b []]) : ℤ) =
        (2 : ℤ) ^ (n ^ a + n ^ b - (n - 1)) := by
    rw [hcf, hopen]
    rw [← Int.pow_add]
    congr 1
    have hn : 1 ≤ n := Nat.succ_le_of_lt (Nat.pos_of_neZero n)
    have hnb : n ≤ n ^ b := by
      simpa using le_self_pow hn (Nat.ne_of_gt hb)
    have hle : n - 1 ≤ n ^ b := le_trans (Nat.sub_le n 1) hnb
    omega
  have hcf_ne : cf ≠ 0 := by
    rw [hcf]
    exact pow_ne_zero _ (by norm_num : (2 : ℤ) ≠ 0)
  have hcast :
      (Fintype.card Z : ℤ) =
        (Fintype.card (OpenRootMessageSpace n [RTree.node b []]) : ℤ) := by
    exact mul_left_cancel₀ hcf_ne (hzeroProduct.trans hopenProduct.symm)
  have hsingle :
      Fintype.card Z =
        Fintype.card (OpenRootMessageSpace n [RTree.node b []]) := by
    exact_mod_cast hcast
  rw [card_boundaryZeroRootField_singleLeaf_forall_eq_single]
  simpa [Z] using hsingle

