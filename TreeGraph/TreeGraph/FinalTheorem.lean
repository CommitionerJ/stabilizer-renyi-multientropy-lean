          i0 hroot0 (singletonChildExternalBaseCoordinate n b ds) B) =
      cyclicNodeZeroBranchSum (n := n) (b := b) ds := by
    simpa [i0] using
      cyclicRootTwistedSum_node_child_eq_zeroBranch
        (n := n) (a := 1) (b := b) (cs := [RTree.node b ds])
        i0 (singletonChildExternalBaseCoordinate n b ds)
