            (n := n) (a := a) (cs := cs) i hchildRoot (ext, site))
          (RawNormal.childNonRootVertexAtInNode (a := a) i u) 1)
        (RawNormal.nonRootDomainOfSite site u 1)
        hdecomp

theorem edgePhaseAtSite_prefixEdge_childAt_baseCyclic_recompose
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs) (hchildRoot : 0 < (childAt cs i).rootWeight)
    (Acyc :
      ChildExternalBaseCoordinate n a cs i →
        ZMod n → RawNormal.NormalAssignment n (childAt cs i))
    (base : ChildExternalBaseCoordinate n a cs i) (d : ZMod n)
    (site : RawNormal.NormalSite n (childAt cs i))
    {e : List Nat × List Nat} (he : e ∈ RTree.edgeList (childAt cs i)) :
    let ext :=
      (childExternalCoordinateEquivBaseDiag
        (n := n) (a := a) (cs := cs) i).symm (base, d)
    let h :=
      ((nodeChildDataAtStructuredEquivExternalNormalAssignments
        (n := n) (a := a) (cs := cs) i hchildRoot).symm
        ((externalAssignmentsEquivBaseCyclic
          (n := n) (a := a) (cs := cs) i).symm Acyc))
    RawNormal.edgePhaseAtSite
        (RawNormal.assembleNodeAssignment
          (a := a) (cs := cs)
          (0 : RawNormal.NodeRootFieldAssignment n a cs)
          (RawNormal.nodeFieldFromChildDataFamily
            (n := n) (a := a) (cs := cs)
            (RawNormal.childDataFamilyWithAt
              (n := n) (a := a) (cs := cs) i h)))
        (nodeChildNormalSiteRecompose
          (n := n) (a := a) (cs := cs) i hchildRoot (ext, site))
        (RTree.prefixEdge [i.1] e) =
      cyclicRootTwistedEdgePhaseAt
        (n := n) (a := a) (cs := cs) i (Acyc base) d site e := by
  classical
  intro ext h
  rw [RawNormal.edgePhaseAtSite_prefixEdge_childAt
      (a := a) (cs := cs) i
      (RawNormal.assembleNodeAssignment
        (a := a) (cs := cs)
        (0 : RawNormal.NodeRootFieldAssignment n a cs)
        (RawNormal.nodeFieldFromChildDataFamily
          (n := n) (a := a) (cs := cs)
          (RawNormal.childDataFamilyWithAt
            (n := n) (a := a) (cs := cs) i h)))
      (nodeChildNormalSiteRecompose
        (n := n) (a := a) (cs := cs) i hchildRoot (ext, site))
      he]
  let u : Vertex (childAt cs i) :=
    ⟨e.1, RTree.edgeList_edge_left_mem_addresses (childAt cs i) he⟩
  let v : Vertex (childAt cs i) :=
    ⟨e.2, RTree.edgeList_edge_right_mem_addresses (childAt cs i) he⟩
  rw [cyclicRootTwistedEdgePhaseAt_vertices
    (n := n) (a := a) (cs := cs) i (Acyc base) d site u v]
  have hku :=
    ketAtVertex_childVertexAtInNode_baseCyclic_recompose
      (n := n) (a := a) (cs := cs) i hchildRoot Acyc base d site u
  have hkv :=
    ketAtVertex_childVertexAtInNode_baseCyclic_recompose
      (n := n) (a := a) (cs := cs) i hchildRoot Acyc base d site v
  have hbu :=
    braAtVertex_childVertexAtInNode_baseCyclic_recompose
      (n := n) (a := a) (cs := cs) i hchildRoot Acyc base d site u
  have hbv :=
    braAtVertex_childVertexAtInNode_baseCyclic_recompose
      (n := n) (a := a) (cs := cs) i hchildRoot Acyc base d site v
  simpa [u, v, ext, h] using congrArg₂ HAdd.hAdd
    (congrArg₂ HMul.hMul hku hkv) (congrArg₂ HMul.hMul hbu hbv)

theorem childInternalPhaseGivenRootDataAt_zero_eq_sum_base_cyclicPhase
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs) (hchildRoot : 0 < (childAt cs i).rootWeight)
    (Acyc :
      ChildExternalBaseCoordinate n a cs i →
        ZMod n → RawNormal.NormalAssignment n (childAt cs i)) :
    childInternalPhaseGivenRootDataAt
      (n := n) (a := a) cs
      (0 : RawNormal.NodeRootFieldAssignment n a cs) i
      ((nodeChildDataAtStructuredEquivExternalNormalAssignments
        (n := n) (a := a) (cs := cs) i hchildRoot).symm
        ((externalAssignmentsEquivBaseCyclic
          (n := n) (a := a) (cs := cs) i).symm Acyc)) =
      ∑ base : ChildExternalBaseCoordinate n a cs i,
        cyclicRootTwistedPhaseForBase
          (n := n) (a := a) (cs := cs) i (Acyc base) := by
  classical
  let h : RawNormal.NodeChildDataAt n a cs i :=
    ((nodeChildDataAtStructuredEquivExternalNormalAssignments
      (n := n) (a := a) (cs := cs) i hchildRoot).symm
      ((externalAssignmentsEquivBaseCyclic
        (n := n) (a := a) (cs := cs) i).symm Acyc))
  let A : RawNormal.NormalAssignment n (RTree.node a cs) :=
    RawNormal.assembleNodeAssignment
      (a := a) (cs := cs)
      (0 : RawNormal.NodeRootFieldAssignment n a cs)
      (RawNormal.nodeFieldFromChildDataFamily
        (n := n) (a := a) (cs := cs)
        (RawNormal.childDataFamilyWithAt
          (n := n) (a := a) (cs := cs) i h))
  change RawNormal.childInternalPhaseAt a cs i A =
    ∑ base : ChildExternalBaseCoordinate n a cs i,
      cyclicRootTwistedPhaseForBase
        (n := n) (a := a) (cs := cs) i (Acyc base)
  unfold RawNormal.childInternalPhaseAt RawNormal.indexedChildInternalPhaseAt
  simp only [List.nil_append, Nat.zero_add]
  rw [RawNormal.edgeListPhase_edgeListFrom_eq_sum_prefixed
    (parent := [i.1]) (C := childAt cs i) (A := A)]
  let F :
      ChildExternalCoordinate n a cs i ×
        RawNormal.NormalSite n (childAt cs i) → F2 :=
    fun x =>
      ((RTree.edgeList (childAt cs i)).map
        (fun e =>
          RawNormal.edgePhaseAtSite A
            (nodeChildNormalSiteRecompose
              (n := n) (a := a) (cs := cs) i hchildRoot x)
            (RTree.prefixEdge [i.1] e))).sum
  calc
    (∑ parentSite : RawNormal.NormalSite n (RTree.node a cs),
        ((RTree.edgeList (childAt cs i)).map
          (fun e =>
            RawNormal.edgePhaseAtSite A parentSite
              (RTree.prefixEdge [i.1] e))).sum) =
        ∑ x :
          ChildExternalCoordinate n a cs i ×
            RawNormal.NormalSite n (childAt cs i), F x := by
          refine Fintype.sum_equiv
            (nodeChildNormalSiteEquiv
              (n := n) (a := a) (cs := cs) i hchildRoot)
            (fun parentSite : RawNormal.NormalSite n (RTree.node a cs) =>
              ((RTree.edgeList (childAt cs i)).map
                (fun e =>
                  RawNormal.edgePhaseAtSite A parentSite
                    (RTree.prefixEdge [i.1] e))).sum)
            F
            ?_
          intro parentSite
          simp [F, nodeChildNormalSiteEquiv]
    _ =
        ∑ bd :
          ChildExternalBaseCoordinate n a cs i × ZMod n,
          ∑ site : RawNormal.NormalSite n (childAt cs i),
            ((RTree.edgeList (childAt cs i)).map
              (fun e =>
                RawNormal.edgePhaseAtSite A
                  (nodeChildNormalSiteRecompose
                    (n := n) (a := a) (cs := cs) i hchildRoot
                    ((childExternalCoordinateEquivBaseDiag
                      (n := n) (a := a) (cs := cs) i).symm bd, site))
                  (RTree.prefixEdge [i.1] e))).sum := by
          rw [Fintype.sum_prod_type]
          exact
            Fintype.sum_equiv
              (childExternalCoordinateEquivBaseDiag
                (n := n) (a := a) (cs := cs) i)
              (fun ext : ChildExternalCoordinate n a cs i =>
                ∑ site : RawNormal.NormalSite n (childAt cs i),
                  F (ext, site))
              (fun bd : ChildExternalBaseCoordinate n a cs i × ZMod n =>
                ∑ site : RawNormal.NormalSite n (childAt cs i),
                  ((RTree.edgeList (childAt cs i)).map
                    (fun e =>
                      RawNormal.edgePhaseAtSite A
                        (nodeChildNormalSiteRecompose
                          (n := n) (a := a) (cs := cs) i hchildRoot
                          ((childExternalCoordinateEquivBaseDiag
                            (n := n) (a := a) (cs := cs) i).symm bd, site))
                        (RTree.prefixEdge [i.1] e))).sum)
              (by
                intro ext
                simp [F])
    _ =
        ∑ base : ChildExternalBaseCoordinate n a cs i,
          ∑ d : ZMod n,
            ∑ site : RawNormal.NormalSite n (childAt cs i),
              ((RTree.edgeList (childAt cs i)).map
                (cyclicRootTwistedEdgePhaseAt
                  (n := n) (a := a) (cs := cs) i (Acyc base) d site)).sum := by
          rw [Fintype.sum_prod_type]
          refine Finset.sum_congr rfl ?_
          intro base _
          refine Finset.sum_congr rfl ?_
          intro d _
          refine Finset.sum_congr rfl ?_
          intro site _
          apply congrArg List.sum
          refine List.map_congr_left ?_
          intro e he
          simpa [A, h] using
            edgePhaseAtSite_prefixEdge_childAt_baseCyclic_recompose
              (n := n) (a := a) (cs := cs) i hchildRoot Acyc
              base d site he
    _ =
        ∑ base : ChildExternalBaseCoordinate n a cs i,
          cyclicRootTwistedPhaseForBase
            (n := n) (a := a) (cs := cs) i (Acyc base) := by
          rfl

noncomputable def nodeChildNonRootFieldDomainCardEquivExternalNonRootField
    {n a : Nat} [NeZero n] {cs : List RTree}
    (ha : 0 < a) (i : ChildIdx cs)
    (hchildRoot : 0 < (childAt cs i).rootWeight)
    (v : NonRootVertex (childAt cs i)) :
    RawNormal.NodeChildNonRootFieldDomain n a cs i v ≃
      Fin (n ^ childExternalCoordinateExponentAt a cs i) ×
        RawNormal.NonRootFieldDomain n (childAt cs i) v :=
  equivOfFintypeCardEq
    (card_nodeChildNonRootFieldDomain_eq_external_mul_nonRootFieldDomain
      (n := n) (a := a) (cs := cs) ha i hchildRoot v)

noncomputable def nodeChildDataAtCardEquivExternalNormalAssignments
    {n a : Nat} [NeZero n] {cs : List RTree}
    (ha : 0 < a) (i : ChildIdx cs)
    (hchildRoot : 0 < (childAt cs i).rootWeight) :
    RawNormal.NodeChildDataAt n a cs i ≃
      (Fin (n ^ childExternalCoordinateExponentAt a cs i) →
        RawNormal.NormalAssignment n (childAt cs i)) :=
  let ι := Fin (n ^ childExternalCoordinateExponentAt a cs i)
  let eroot :
      RawNormal.NodeChildRootFieldDomain n a cs i ≃
        ι × RawNormal.RootFieldDomain n (childAt cs i) :=
    nodeChildRootFieldDomainCardEquivExternalRootField
      (n := n) (a := a) (cs := cs) ha i
  let enon :
      (v : NonRootVertex (childAt cs i)) →
        RawNormal.NodeChildNonRootFieldDomain n a cs i v ≃
          ι × RawNormal.NonRootFieldDomain n (childAt cs i) v :=
    fun v =>
      nodeChildNonRootFieldDomainCardEquivExternalNonRootField
        (n := n) (a := a) (cs := cs) ha i hchildRoot v
  { toFun := fun h k =>
      { rootField := fun rd => h.1 (eroot.symm ⟨k, rd⟩)
        nodeField := fun v d => h.2 v ((enon v).symm ⟨k, d⟩) }
    invFun := fun A =>
      (fun d =>
        let p := eroot d
        (A p.1).rootField p.2,
       fun v d =>
        let p := enon v d
        (A p.1).nodeField v p.2)
    left_inv := by
      intro h
      cases h with
      | mk φ ψ =>
          apply Prod.ext
          · funext d
            simp
          · funext v d
            simp
    right_inv := by
      intro A
      funext k
      cases hAk : A k with
      | mk rootField nodeField =>
          simp [hAk] }

theorem card_nodeChildRootFieldDomain_leaf_child
    {n a b : Nat} [NeZero n] {cs : List RTree}
    (ha : 0 < a) (i : ChildIdx cs)
    (hchild : childAt cs i = RTree.node b []) :
    Fintype.card (RawNormal.NodeChildRootFieldDomain n a cs i) =
      n ^ childExternalCoordinateExponentAt a cs i := by
  rw [card_nonRootFieldDomain]
  simp
  have hweight :
      NonRootVertex.weight
          (RawNormal.childRootAtAsNonRootInNode (a := a) i) = b := by
    rw [RawNormal.childRootAtAsNonRootInNode_weight]
    rw [hchild]
    rfl
  have hcontext :
      nonRootContextExponent (RTree.node a cs)
          (RawNormal.childRootAtAsNonRootInNode (a := a) i) + 1 + b =
        a + (cs.map RTree.totalWeight).sum := by
    calc
      nonRootContextExponent (RTree.node a cs)
            (RawNormal.childRootAtAsNonRootInNode (a := a) i) + 1 + b =
          nonRootContextExponent (RTree.node a cs)
              (RawNormal.childRootAtAsNonRootInNode (a := a) i) + 1 +
            NonRootVertex.weight
              (RawNormal.childRootAtAsNonRootInNode (a := a) i) := by
            rw [hweight]
      _ =
          (RTree.node a cs).rootWeight +
            Fintype.card (RootFieldCoordinate (RTree.node a cs)) := by
            exact
              nonRootContextExponent_add_one_add_weight_eq_root_add_card_rootFieldCoordinate
                (RTree.node a cs)
                (RawNormal.childRootAtAsNonRootInNode (a := a) i)
                (by simpa [RTree.rootWeight] using ha)
      _ = a + (cs.map RTree.totalWeight).sum := by
            rw [card_rootFieldCoordinate_node_eq_sum_totalWeight]
            rfl
  have hexternal :=
    childExternalCoordinateExponentAt_add_childAt_totalWeight a cs i
  have hchildTotal : RTree.totalWeight (childAt cs i) = b := by
    rw [hchild]
    simp [RTree.totalWeight]
  have hexternal' :
      childExternalCoordinateExponentAt a cs i + b =
        a + (cs.map RTree.totalWeight).sum := by
    simpa [hchildTotal] using hexternal
  have hexp :
      nonRootContextExponent (RTree.node a cs)
          (RawNormal.childRootAtAsNonRootInNode (a := a) i) + 1 =
        childExternalCoordinateExponentAt a cs i := by
    omega
  change
    n ^
        (nonRootContextExponent (RTree.node a cs)
          (RawNormal.childRootAtAsNonRootInNode (a := a) i) + 1) =
      n ^ childExternalCoordinateExponentAt a cs i
  rw [hexp]

theorem card_nodeRootFieldAssignment_nil
    (n a : Nat) [NeZero n] :
    Fintype.card (RawNormal.NodeRootFieldAssignment n a []) = 2 := by
