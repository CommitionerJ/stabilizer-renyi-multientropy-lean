noncomputable def childExternalCoordinateShift
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs) (s : ZMod n) :
    ChildExternalCoordinate n a cs i ≃
      ChildExternalCoordinate n a cs i where
  toFun ext :=
    { rootCoord := ext.rootCoord
      childRootDiagonal := ext.childRootDiagonal + s
      siblingCoord := ext.siblingCoord }
  invFun ext :=
    { rootCoord := ext.rootCoord
      childRootDiagonal := ext.childRootDiagonal - s
      siblingCoord := ext.siblingCoord }
  left_inv := by
    intro ext
    cases ext
    simp [sub_eq_add_neg, add_assoc]
  right_inv := by
    intro ext
    cases ext
    simp [sub_eq_add_neg, add_assoc]

