                (n := n) (b := b) ds j rootCoord rd 0)) +
          (∑ j : ChildIdx ds,
            ∑ rootCoord :
                Fin ((RTree.node b ds).rootWeight - 1) → ZMod n,
              (H (d - 1) j).1
                (rootBoundarySelectedNodeChildRootFieldDomain
                  (n := n) (b := b) ds j rootCoord rd 1)) =
            0 := by
  constructor
  · intro h d rd
    simpa [cyclicNodeRootBoundaryLayer0_childDataFamily_selected,
      cyclicNodeRootBoundaryLayer1_childDataFamily_selected] using h d rd
  · intro h d rd
    simpa [cyclicNodeRootBoundaryLayer0_childDataFamily_selected,
      cyclicNodeRootBoundaryLayer1_childDataFamily_selected] using h d rd

