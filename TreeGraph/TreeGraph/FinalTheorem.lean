noncomputable def normalSiteEquivRootNonRoot
    {n : Nat} [NeZero n] (T : RTree) :
    RawNormal.NormalSite n T ≃
      ((Fin (T.rootWeight - 1) → ZMod n) ×
        RawNormal.RootFieldDomain n T) where
  toFun site := (site.rootCoord, site.nonRootCoord)
  invFun x := { rootCoord := x.1, nonRootCoord := x.2 }
  left_inv site := by
    cases site
    rfl
  right_inv x := by
    cases x
    rfl

theorem sum_normalSite_pi_single_nonRootCoord
    {n : Nat} [NeZero n] (T : RTree)
    (rd : RawNormal.RootFieldDomain n T)
    (F : RawNormal.NormalSite n T → F2) :
    (∑ site : RawNormal.NormalSite n T,
      Pi.single (M := fun _ : RawNormal.RootFieldDomain n T => F2)
        rd (1 : F2) site.nonRootCoord * F site) =
      ∑ rootCoord : Fin (T.rootWeight - 1) → ZMod n,
        F { rootCoord := rootCoord, nonRootCoord := rd } := by
  classical
  calc
    (∑ site : RawNormal.NormalSite n T,
      Pi.single (M := fun _ : RawNormal.RootFieldDomain n T => F2)
        rd (1 : F2) site.nonRootCoord * F site) =
        ∑ p : (Fin (T.rootWeight - 1) → ZMod n) ×
            RawNormal.RootFieldDomain n T,
          Pi.single (M := fun _ : RawNormal.RootFieldDomain n T => F2)
            rd (1 : F2) p.2 *
            F ((normalSiteEquivRootNonRoot (n := n) T).symm p) := by
          exact
            (Equiv.sum_comp
              (normalSiteEquivRootNonRoot (n := n) T).symm
              (fun site : RawNormal.NormalSite n T =>
                Pi.single
                    (M := fun _ : RawNormal.RootFieldDomain n T => F2)
                  rd (1 : F2) site.nonRootCoord * F site)).symm
    _ =
        ∑ rootCoord : Fin (T.rootWeight - 1) → ZMod n,
          ∑ rd' : RawNormal.RootFieldDomain n T,
            Pi.single (M := fun _ : RawNormal.RootFieldDomain n T => F2)
              rd (1 : F2) rd' *
              F { rootCoord := rootCoord, nonRootCoord := rd' } := by
          rw [Fintype.sum_prod_type]
          rfl
    _ =
        ∑ rootCoord : Fin (T.rootWeight - 1) → ZMod n,
          F { rootCoord := rootCoord, nonRootCoord := rd } := by
          refine Finset.sum_congr rfl ?_
          intro rootCoord _
          rw [Fintype.sum_eq_single rd]
          · simp
          · intro rd' hrd'
            simp [Pi.single_eq_of_ne, hrd']

noncomputable def rootBoundarySelectedNonRootContext
    {n : Nat} [NeZero n] {T : RTree}
    (v : NonRootVertex T)
    (rootCoord : Fin (T.rootWeight - 1) → ZMod n)
    (rd : RawNormal.RootFieldDomain n T) :
    NonRootContext n T v :=
  (rootCoord, fun u => rd u.1)

noncomputable def rootFieldDomainOfNonRootContextTuple
    {n : Nat} [NeZero n] {T : RTree}
    (v : NonRootVertex T)
    (c : NonRootContext n T v)
    (x : Fin (NonRootVertex.weight v) → ZMod n) :
    RawNormal.RootFieldDomain n T :=
  fun u j =>
    if h : u = v then
      x (Fin.cast (by rw [h]) j)
    else
      c.2 ⟨u, by
        intro haddr
        exact h (nonRootVertex_eq_of_addr_eq haddr)⟩ j

@[simp] theorem rootFieldDomainOfNonRootContextTuple_self
    {n : Nat} [NeZero n] {T : RTree}
    (v : NonRootVertex T)
    (c : NonRootContext n T v)
    (x : Fin (NonRootVertex.weight v) → ZMod n)
    (j : Fin (NonRootVertex.weight v)) :
    rootFieldDomainOfNonRootContextTuple
        (n := n) (T := T) v c x v j =
      x j := by
  simp [rootFieldDomainOfNonRootContextTuple]

@[simp] theorem rootFieldDomainOfNonRootContextTuple_other
    {n : Nat} [NeZero n] {T : RTree}
    (v : NonRootVertex T)
    (c : NonRootContext n T v)
    (x : Fin (NonRootVertex.weight v) → ZMod n)
    (u : RawNormal.OtherNonRootVertex T v)
    (j : Fin (NonRootVertex.weight u.1)) :
    rootFieldDomainOfNonRootContextTuple
        (n := n) (T := T) v c x u.1 j =
      c.2 u j := by
  have hne : u.1 ≠ v := by
    intro huv
    exact u.2 (congrArg (fun w : NonRootVertex T => w.1.1) huv)
  have hsub :
      (⟨u.1, by
        intro haddr
        exact hne (nonRootVertex_eq_of_addr_eq haddr)⟩ :
          RawNormal.OtherNonRootVertex T v) = u := by
    apply Subtype.ext
    rfl
  simp [rootFieldDomainOfNonRootContextTuple, hne, hsub]

@[simp] theorem rootBoundarySelectedNonRootContext_of_contextTuple
    {n : Nat} [NeZero n] {T : RTree}
    (v : NonRootVertex T)
    (c : NonRootContext n T v)
    (x : Fin (NonRootVertex.weight v) → ZMod n) :
    rootBoundarySelectedNonRootContext
        (n := n) (T := T) v c.1
        (rootFieldDomainOfNonRootContextTuple
          (n := n) (T := T) v c x) =
      c := by
  cases c with
  | mk rootCoord otherCoord =>
      apply Prod.ext
      · rfl
      · funext u j
        simp [rootBoundarySelectedNonRootContext]

@[simp] theorem rootFieldDomainOfNonRootContextTuple_selected
    {n : Nat} [NeZero n] {T : RTree}
    (v : NonRootVertex T)
    (rootCoord : Fin (T.rootWeight - 1) → ZMod n)
    (rd : RawNormal.RootFieldDomain n T) :
    rootFieldDomainOfNonRootContextTuple
        (n := n) (T := T) v
        (rootBoundarySelectedNonRootContext
          (n := n) (T := T) v rootCoord rd)
        (rd v) =
      rd := by
  funext u j
  by_cases h : u = v
  · subst u
    simp
  · simp [rootFieldDomainOfNonRootContextTuple,
      rootBoundarySelectedNonRootContext, h]

theorem rootFieldDomainOfNonRootContextTuple_selected_context_rootCoord_eq
    {n : Nat} [NeZero n] {T : RTree}
    (v : NonRootVertex T)
    (rootCoord rootCoord' : Fin (T.rootWeight - 1) → ZMod n)
    (rd : RawNormal.RootFieldDomain n T)
    (x : Fin (NonRootVertex.weight v) → ZMod n) :
    rootFieldDomainOfNonRootContextTuple
        (n := n) (T := T) v
        (rootBoundarySelectedNonRootContext
          (n := n) (T := T) v rootCoord rd) x =
      rootFieldDomainOfNonRootContextTuple
        (n := n) (T := T) v
        (rootBoundarySelectedNonRootContext
          (n := n) (T := T) v rootCoord' rd) x := by
  funext u j
  by_cases h : u = v
  · subst u
    simp
  · simp [rootFieldDomainOfNonRootContextTuple,
      rootBoundarySelectedNonRootContext, h]

noncomputable def rootFieldDomainEquivOtherTuple
    {n : Nat} [NeZero n] {T : RTree} (v : NonRootVertex T) :
    RawNormal.RootFieldDomain n T ≃
      (((u : RawNormal.OtherNonRootVertex T v) →
          Fin (NonRootVertex.weight u.1) → ZMod n) ×
        (Fin (NonRootVertex.weight v) → ZMod n)) where
  toFun rd := (fun u k => rd u.1 k, rd v)
  invFun p :=
    rootFieldDomainOfNonRootContextTuple
      (n := n) (T := T) v ((fun _ => 0), p.1) p.2
  left_inv rd := by
    funext u j
    by_cases h : u = v
    · subst u
      simp [rootFieldDomainOfNonRootContextTuple]
    · let uOther : RawNormal.OtherNonRootVertex T v :=
        ⟨u, by
          intro haddr
          exact h (nonRootVertex_eq_of_addr_eq haddr)⟩
      calc
        rootFieldDomainOfNonRootContextTuple
            (n := n) (T := T) v
            ((fun _ : Fin (T.rootWeight - 1) => 0),
              fun u : RawNormal.OtherNonRootVertex T v => rd u.1)
            (rd v) u j =
          rd uOther.1 j := by
            simpa [uOther] using
              rootFieldDomainOfNonRootContextTuple_other
                (n := n) (T := T) v
                ((fun _ : Fin (T.rootWeight - 1) => 0),
                  fun u : RawNormal.OtherNonRootVertex T v => rd u.1)
                (rd v) uOther j
        _ = rd u j := rfl
  right_inv p := by
    rcases p with ⟨otherCoord, x⟩
    apply Prod.ext
    · funext u j
      simpa using
        rootFieldDomainOfNonRootContextTuple_other
          (n := n) (T := T) v
          ((fun _ : Fin (T.rootWeight - 1) => 0), otherCoord)
          x u j
    · funext j
      simp [rootFieldDomainOfNonRootContextTuple]

@[simp] theorem rootFieldDomainEquivOtherTuple_apply_fst
    {n : Nat} [NeZero n] {T : RTree} (v : NonRootVertex T)
    (rd : RawNormal.RootFieldDomain n T)
    (u : RawNormal.OtherNonRootVertex T v)
    (j : Fin (NonRootVertex.weight u.1)) :
    (rootFieldDomainEquivOtherTuple (n := n) (T := T) v rd).1 u j =
      rd u.1 j := rfl

@[simp] theorem rootFieldDomainEquivOtherTuple_apply_snd
    {n : Nat} [NeZero n] {T : RTree} (v : NonRootVertex T)
    (rd : RawNormal.RootFieldDomain n T)
    (j : Fin (NonRootVertex.weight v)) :
    (rootFieldDomainEquivOtherTuple (n := n) (T := T) v rd).2 j =
      rd v j := rfl

@[simp] theorem rootFieldDomainEquivOtherTuple_symm_fst
    {n : Nat} [NeZero n] {T : RTree} (v : NonRootVertex T)
    (p :
      ((u : RawNormal.OtherNonRootVertex T v) →
          Fin (NonRootVertex.weight u.1) → ZMod n) ×
        (Fin (NonRootVertex.weight v) → ZMod n))
    (u : RawNormal.OtherNonRootVertex T v)
    (j : Fin (NonRootVertex.weight u.1)) :
    (rootFieldDomainEquivOtherTuple (n := n) (T := T) v).symm p u.1 j =
      p.1 u j := by
  simpa [rootFieldDomainEquivOtherTuple] using
    rootFieldDomainOfNonRootContextTuple_other
      (n := n) (T := T) v
      ((fun _ : Fin (T.rootWeight - 1) => 0), p.1) p.2 u j

@[simp] theorem rootFieldDomainEquivOtherTuple_symm_snd
    {n : Nat} [NeZero n] {T : RTree} (v : NonRootVertex T)
    (p :
      ((u : RawNormal.OtherNonRootVertex T v) →
          Fin (NonRootVertex.weight u.1) → ZMod n) ×
        (Fin (NonRootVertex.weight v) → ZMod n))
    (j : Fin (NonRootVertex.weight v)) :
    (rootFieldDomainEquivOtherTuple (n := n) (T := T) v).symm p v j =
      p.2 j := by
  simp [rootFieldDomainEquivOtherTuple]

abbrev RootFieldOtherCoord
    (n : Nat) [NeZero n] (T : RTree) (v : NonRootVertex T) :=
  (u : RawNormal.OtherNonRootVertex T v) →
    Fin (NonRootVertex.weight u.1) → ZMod n

theorem card_rootFieldOtherCoord
    {n : Nat} [NeZero n] (T : RTree) (v : NonRootVertex T) :
    Fintype.card (RootFieldOtherCoord n T v) =
      n ^ (∑ u : RawNormal.OtherNonRootVertex T v,
        NonRootVertex.weight u.1) := by
  classical
  unfold RootFieldOtherCoord
  rw [Fintype.card_pi]
  have hprod :
      (∏ u : RawNormal.OtherNonRootVertex T v,
          n ^ NonRootVertex.weight u.1) =
        n ^ (∑ u : RawNormal.OtherNonRootVertex T v,
          NonRootVertex.weight u.1) := by
    simpa using
      (Finset.prod_pow_eq_pow_sum
        (s := Finset.univ)
        (f := fun u : RawNormal.OtherNonRootVertex T v =>
          NonRootVertex.weight u.1)
        (a := n))
  refine hprod ▸ Finset.prod_congr rfl ?_
  intro u _
  rw [Fintype.card_fun]
  simp [ZMod.card]

noncomputable def prodFunctionCurryLinearEquiv
    (α β M : Type) [AddCommGroup M] [Module F2 M] :
    (α × β → M) ≃ₗ[F2] (α → β → M) where
  toFun f := fun a b => f (a, b)
  invFun f := fun p => f p.1 p.2
  left_inv f := by
    funext p
    cases p
    rfl
  right_inv f := by
    funext a b
    rfl
  map_add' f g := by
    funext a b
    rfl
  map_smul' r f := by
    funext a b
    rfl

@[simp] theorem prodFunctionCurryLinearEquiv_apply
    {α β M : Type} [AddCommGroup M] [Module F2 M]
    (f : α × β → M) (a : α) (b : β) :
    prodFunctionCurryLinearEquiv α β M f a b = f (a, b) := rfl

@[simp] theorem prodFunctionCurryLinearEquiv_symm_apply
    {α β M : Type} [AddCommGroup M] [Module F2 M]
    (f : α → β → M) (p : α × β) :
    (prodFunctionCurryLinearEquiv α β M).symm f p = f p.1 p.2 := rfl

noncomputable def nodeRootFieldAssignmentConsChildPiLinearEquiv
    (n : Nat) [NeZero n] (a : Nat) (C : RTree) (cs : List RTree) :
    RawNormal.NodeRootFieldAssignment n a (C :: cs) ≃ₗ[F2]
      (ChildVertexFieldDomainFamily n cs → VertexFieldDomain n C → F2) :=
  (nodeRootFieldAssignmentChildPiLinearEquiv n a (C :: cs)).trans
    ((functionDomainLinearEquiv
        (M := F2)
        (childVertexFieldDomainFamilyConsEquiv n C cs)).trans
      ((prodFunctionCurryLinearEquiv
          (VertexFieldDomain n C)
          (ChildVertexFieldDomainFamily n cs) F2).trans
        (functionFlipLinearEquiv
          (VertexFieldDomain n C)
          (ChildVertexFieldDomainFamily n cs) F2)))

@[simp] theorem nodeRootFieldAssignmentConsChildPiLinearEquiv_apply
    {n : Nat} [NeZero n] (a : Nat) (C : RTree) (cs : List RTree)
    (R : RawNormal.NodeRootFieldAssignment n a (C :: cs))
    (rest : ChildVertexFieldDomainFamily n cs)
    (first : VertexFieldDomain n C) :
    nodeRootFieldAssignmentConsChildPiLinearEquiv n a C cs R rest first =
      R ((nodeRootFieldDomainChildPiEquiv n a (C :: cs)).symm
        ((childVertexFieldDomainFamilyConsEquiv n C cs).symm
          (first, rest))) := rfl

@[simp] theorem nodeRootFieldAssignmentConsChildPiLinearEquiv_symm_apply
    {n : Nat} [NeZero n] (a : Nat) (C : RTree) (cs : List RTree)
    (F : ChildVertexFieldDomainFamily n cs → VertexFieldDomain n C → F2)
    (rd : RawNormal.RootFieldDomain n (RTree.node a (C :: cs))) :
    (nodeRootFieldAssignmentConsChildPiLinearEquiv n a C cs).symm F rd =
      F (childVertexFieldDomainFamilyConsEquiv n C cs
            (nodeRootFieldDomainChildPiEquiv n a (C :: cs) rd)).2
        (childVertexFieldDomainFamilyConsEquiv n C cs
            (nodeRootFieldDomainChildPiEquiv n a (C :: cs) rd)).1 := rfl

@[simp] theorem nodeRootFieldAssignmentConsChildPiLinearEquiv_symm_apply_domain
    {n : Nat} [NeZero n] (a : Nat) (C : RTree) (cs : List RTree)
    (F : ChildVertexFieldDomainFamily n cs → VertexFieldDomain n C → F2)
    (rd : RawNormal.RootFieldDomain n (RTree.node a (C :: cs))) :
    (nodeRootFieldAssignmentConsChildPiLinearEquiv n a C cs).symm F rd =
      F (nodeRootFieldDomainConsChildPiEquiv n a C cs rd).1
        (nodeRootFieldDomainConsChildPiEquiv n a C cs rd).2 := rfl

noncomputable def nodeChildRootFieldDomainConsZeroCardEquivRestSingleton
    {n a : Nat} [NeZero n] (C : RTree) (cs : List RTree)
    (ha : 0 < a) :
    RawNormal.NodeChildRootFieldDomain n a (C :: cs)
        (0 : ChildIdx (C :: cs)) ≃
      ChildVertexFieldDomainFamily n cs ×
        RawNormal.NodeChildRootFieldDomain n a [C] (0 : ChildIdx [C]) :=
  equivOfFintypeCardEq (by
    rw [Fintype.card_prod]
    exact
      card_nodeChildRootFieldDomain_cons_zero_eq_rest_mul_singleton
        (n := n) (a := a) C cs ha)

noncomputable def firstChildCoefficientOutputConsZeroLinearEquiv
    {n a : Nat} [NeZero n] (C : RTree) (cs : List RTree)
    (ha : 0 < a) :
    (RawNormal.NodeChildRootFieldDomain n a (C :: cs)
        (0 : ChildIdx (C :: cs)) → F2) ≃ₗ[F2]
      (ChildVertexFieldDomainFamily n cs →
        RawNormal.NodeChildRootFieldDomain n a [C]
          (0 : ChildIdx [C]) → F2) :=
  (functionDomainLinearEquiv
    (M := F2)
    (nodeChildRootFieldDomainConsZeroEquivRestSingleton
      (n := n) (a := a) C cs)).trans
    (prodFunctionCurryLinearEquiv
      (ChildVertexFieldDomainFamily n cs)
      (RawNormal.NodeChildRootFieldDomain n a [C] (0 : ChildIdx [C]))
      F2)

@[simp] theorem firstChildCoefficientOutputConsZeroLinearEquiv_apply
    {n a : Nat} [NeZero n] (C : RTree) (cs : List RTree)
    (ha : 0 < a)
    (f :
      RawNormal.NodeChildRootFieldDomain n a (C :: cs)
        (0 : ChildIdx (C :: cs)) → F2)
    (rest : ChildVertexFieldDomainFamily n cs)
    (single :
      RawNormal.NodeChildRootFieldDomain n a [C]
        (0 : ChildIdx [C])) :
    firstChildCoefficientOutputConsZeroLinearEquiv
        (n := n) (a := a) C cs ha f rest single =
      f ((nodeChildRootFieldDomainConsZeroEquivRestSingleton
        (n := n) (a := a) C cs).symm (rest, single)) := rfl

@[simp] theorem firstChildCoefficientOutputConsZeroLinearEquiv_apply_pi_single
    {n a : Nat} [NeZero n] (C : RTree) (cs : List RTree)
    (ha : 0 < a)
    (d :
      RawNormal.NodeChildRootFieldDomain n a (C :: cs)
        (0 : ChildIdx (C :: cs)))
    (rest : ChildVertexFieldDomainFamily n cs)
    (single :
      RawNormal.NodeChildRootFieldDomain n a [C]
        (0 : ChildIdx [C])) :
    firstChildCoefficientOutputConsZeroLinearEquiv
        (n := n) (a := a) C cs ha
        (Pi.single
          (M := fun _ :
            RawNormal.NodeChildRootFieldDomain n a (C :: cs)
              (0 : ChildIdx (C :: cs)) => F2)
          d (1 : F2)) rest single =
      Pi.single
        (M := fun _ :
          ChildVertexFieldDomainFamily n cs ×
            RawNormal.NodeChildRootFieldDomain n a [C]
              (0 : ChildIdx [C]) => F2)
        (nodeChildRootFieldDomainConsZeroEquivRestSingleton
          (n := n) (a := a) C cs d) (1 : F2) (rest, single) := by
  let e :=
    nodeChildRootFieldDomainConsZeroEquivRestSingleton
      (n := n) (a := a) C cs
  by_cases hp : (rest, single) = e d
  · have hpre : e.symm (rest, single) = d := by
      rw [hp]
      exact e.left_inv d
    rw [firstChildCoefficientOutputConsZeroLinearEquiv_apply]
    rw [hpre]
    rw [hp]
    simp [e]
  · have hpre :
        e.symm (rest, single) ≠ d := by
      intro h
      exact hp (by
        rw [← h]
        exact (e.apply_symm_apply (rest, single)).symm)
    simp [firstChildCoefficientOutputConsZeroLinearEquiv_apply, e, hp, hpre]

@[simp] theorem firstChildCoefficientOutputConsZeroLinearEquiv_symm_apply
    {n a : Nat} [NeZero n] (C : RTree) (cs : List RTree)
    (ha : 0 < a)
    (F :
      ChildVertexFieldDomainFamily n cs →
        RawNormal.NodeChildRootFieldDomain n a [C]
          (0 : ChildIdx [C]) → F2)
    (x :
      RawNormal.NodeChildRootFieldDomain n a (C :: cs)
        (0 : ChildIdx (C :: cs))) :
    (firstChildCoefficientOutputConsZeroLinearEquiv
        (n := n) (a := a) C cs ha).symm F x =
      F ((nodeChildRootFieldDomainConsZeroEquivRestSingleton
          (n := n) (a := a) C cs x).1)
        ((nodeChildRootFieldDomainConsZeroEquivRestSingleton
          (n := n) (a := a) C cs x).2) := rfl

noncomputable def paramLinearMap
    (β : Type) {V W : Type}
    [AddCommGroup V] [Module F2 V]
    [AddCommGroup W] [Module F2 W]
    (L : V →ₗ[F2] W) :
    (β → V) →ₗ[F2] (β → W) where
  toFun f := fun b => L (f b)
  map_add' f g := by
    funext b
    exact L.map_add (f b) (g b)
  map_smul' r f := by
    funext b
    exact L.map_smul r (f b)

@[simp] theorem paramLinearMap_apply
    (β : Type) {V W : Type}
    [AddCommGroup V] [Module F2 V]
    [AddCommGroup W] [Module F2 W]
    (L : V →ₗ[F2] W) (f : β → V) (b : β) :
    paramLinearMap β L f b = L (f b) := rfl

noncomputable def paramLinearMapKerEquiv
    (β : Type) {V W : Type}
    [AddCommGroup V] [Module F2 V]
    [AddCommGroup W] [Module F2 W]
    (L : V →ₗ[F2] W) :
    LinearMap.ker (paramLinearMap β L) ≃ₗ[F2]
      (β → LinearMap.ker L) where
  toFun f := fun b =>
    ⟨f.1 b, by
      have hzero := congrFun (LinearMap.mem_ker.mp f.2) b
      exact LinearMap.mem_ker.mpr hzero⟩
  invFun g :=
    ⟨fun b => (g b).1, by
      apply LinearMap.mem_ker.mpr
      funext b
      exact LinearMap.mem_ker.mp (g b).2⟩
  left_inv f := by
    apply Subtype.ext
    funext b
    rfl
  right_inv g := by
    funext b
    apply Subtype.ext
    rfl
  map_add' f g := by
    funext b
    apply Subtype.ext
    rfl
  map_smul' r f := by
    funext b
    apply Subtype.ext
    rfl

theorem finrank_ker_paramLinearMap
    (β : Type) [Fintype β] {V W : Type}
    [AddCommGroup V] [Module F2 V] [FiniteDimensional F2 V]
    [AddCommGroup W] [Module F2 W]
    (L : V →ₗ[F2] W) :
    Module.finrank F2 (LinearMap.ker (paramLinearMap β L)) =
      Fintype.card β * Module.finrank F2 (LinearMap.ker L) := by
  classical
  calc
    Module.finrank F2 (LinearMap.ker (paramLinearMap β L)) =
        Module.finrank F2 (β → LinearMap.ker L) :=
      LinearEquiv.finrank_eq (paramLinearMapKerEquiv β L)
    _ = ∑ _ : β, Module.finrank F2 (LinearMap.ker L) := by
      simpa using
        (Module.finrank_pi_fintype
          (R := F2) (M := fun _ : β => LinearMap.ker L))
    _ = Fintype.card β * Module.finrank F2 (LinearMap.ker L) := by
      simp

noncomputable def kerCompLinearEquiv
    {V V' W : Type}
    [AddCommGroup V] [Module F2 V]
    [AddCommGroup V'] [Module F2 V']
    [AddCommGroup W] [Module F2 W]
    (L : V →ₗ[F2] W) (e : V' ≃ₗ[F2] V) :
    LinearMap.ker (L.comp e.toLinearMap) ≃ₗ[F2] LinearMap.ker L where
  toFun x :=
    ⟨e x.1, by
      apply LinearMap.mem_ker.mpr
      exact LinearMap.mem_ker.mp x.2⟩
  invFun x :=
    ⟨e.symm x.1, by
      apply LinearMap.mem_ker.mpr
      simpa using LinearMap.mem_ker.mp x.2⟩
  left_inv x := by
    apply Subtype.ext
    simp
  right_inv x := by
    apply Subtype.ext
    simp
  map_add' x y := by
    apply Subtype.ext
    simp
  map_smul' r x := by
    apply Subtype.ext
    simp

theorem finrank_ker_comp_linearEquiv
    {V V' W : Type}
    [AddCommGroup V] [Module F2 V]
    [AddCommGroup V'] [Module F2 V']
    [AddCommGroup W] [Module F2 W]
    (L : V →ₗ[F2] W) (e : V' ≃ₗ[F2] V) :
    Module.finrank F2 (LinearMap.ker (L.comp e.toLinearMap)) =
      Module.finrank F2 (LinearMap.ker L) :=
  LinearEquiv.finrank_eq (kerCompLinearEquiv L e)

noncomputable def rootFieldAssignmentOtherTupleLinearEquiv
    {n : Nat} [NeZero n] {T : RTree} (v : NonRootVertex T) :
    RawNormal.RootFieldAssignment n T ≃ₗ[F2]
      (RootFieldOtherCoord n T v ×
        (Fin (NonRootVertex.weight v) → ZMod n) → F2) where
  toFun R := fun p =>
    R ((rootFieldDomainEquivOtherTuple (n := n) (T := T) v).symm p)
  invFun F := fun rd =>
    F ((rootFieldDomainEquivOtherTuple (n := n) (T := T) v) rd)
  left_inv R := by
    funext rd
    simp
  right_inv F := by
    funext p
    simp
  map_add' R S := by
    funext p
    rfl
  map_smul' r R := by
    funext p
    rfl

