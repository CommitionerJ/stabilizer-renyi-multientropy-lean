theorem exists_single_childBoundaryLinearFormAt_eq_one_of_ne_zero
    {n a : Nat} [NeZero n] (cs : List RTree)
    (R : RawNormal.NodeRootFieldAssignment n a cs)
    (i : ChildIdx cs)
    (hnonzero :
      childBoundaryLinearFormAt (n := n) (a := a) cs R i ≠ 0) :
    ∃ d : RawNormal.NodeChildRootFieldDomain n a cs i,
      childBoundaryLinearFormAt (n := n) (a := a) cs R i
          (Pi.single
            (M := fun _ : RawNormal.NodeChildRootFieldDomain n a cs i =>
              F2)
            d (1 : F2)) = 1 := by
  have hcoeff_ne :
      childBoundaryCoefficientAt (n := n) (a := a) cs R i ≠ 0 := by
    intro hcoeff
    exact hnonzero
      ((childBoundaryLinearFormAt_eq_zero_iff_coefficientAt_eq_zero
        (n := n) (a := a) (cs := cs) R i).2 hcoeff)
  have hcoeff_exists :
      ∃ d : RawNormal.NodeChildRootFieldDomain n a cs i,
        childBoundaryCoefficientAt (n := n) (a := a) cs R i d = 1 := by
    by_contra hnone
    have hcoeff_zero :
        childBoundaryCoefficientAt (n := n) (a := a) cs R i = 0 := by
      funext d
      by_contra hd_ne_zero
      have hd_one :
          childBoundaryCoefficientAt (n := n) (a := a) cs R i d = 1 := by
        generalize hval :
            childBoundaryCoefficientAt (n := n) (a := a) cs R i d = x
        fin_cases x
        · exact False.elim (hd_ne_zero hval)
        · rfl
      exact hnone ⟨d, hd_one⟩
    exact hcoeff_ne hcoeff_zero
  rcases hcoeff_exists with ⟨d, hd⟩
  exact
    ⟨d, by
      simpa [childBoundaryCoefficientAt, linearFunctionalCoeff] using hd⟩

