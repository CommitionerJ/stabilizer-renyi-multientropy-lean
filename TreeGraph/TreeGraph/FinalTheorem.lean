def RawExpandedRecursiveAssignmentFactorNodeRule : Prop :=
  ∀ {a : Nat} {cs : List RTree},
    0 < a →
    (∀ C ∈ cs, RawExpandedSubtreeClosedFormula C) →
    ∀ (n : Nat) [NeZero n],
      (∑ Araw :
        { Araw : RawAssignment n (RTree.node a cs) //
          RealizedByNormal (RTree.node a cs) Araw },
        bitSign
          (∑ site : RawNormal.NormalSite n (RTree.node a cs),
            ((RTree.edgeList (RTree.node a cs)).map
              (fun e =>
                let ketAt (p : List Nat) : F2 :=
                  if hp : p ∈ RTree.addresses (RTree.node a cs) then
                    Araw.1.ket ⟨p, hp⟩ site
                  else
                    0
                let braAt (p : List Nat) : F2 :=
                  if hp : p ∈ RTree.addresses (RTree.node a cs) then
                    Araw.1.bra ⟨p, hp⟩ site
                  else
                    0
                ketAt e.1 * ketAt e.2 + braAt e.1 * braAt e.2)).sum)) =
          (2 : ℤ) ^ Int.toNat
            ((((cs.map (fun C =>
              Int.toNat
                ((nZ n) ^ RTree.totalWeight C -
                  (tZ n) * Yassign n C))).prod : Nat) : ℤ) +
              childContribSumWith (Xassign n) n a cs 0)

