theorem rootFieldAssignmentNonRootConstraintLinearMap_mem_ker_iff_forall_context_fiberSum_constant_apply
    {n : Nat} [NeZero n] (T : RTree) (v : NonRootVertex T)
    (R : RawNormal.RootFieldAssignment n T) :
