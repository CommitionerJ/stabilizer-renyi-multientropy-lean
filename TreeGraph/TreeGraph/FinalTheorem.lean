theorem rootFactorKernelFinrank_cons_of_childCerts
    {n : Nat} [NeZero n] {C : RTree} {cs : List RTree}
    (_hC : RawExpandedOpenRootSubtreeCert C)
    (_hchildren : ∀ D ∈ cs, RawExpandedOpenRootSubtreeCert D) :
