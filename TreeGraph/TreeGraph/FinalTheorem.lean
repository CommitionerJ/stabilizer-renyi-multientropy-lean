@[simp] theorem nodeChildRootFieldDomainDecompose_childRootField
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs)
    (d : RawNormal.NodeChildRootFieldDomain n a cs i)
    (v : NonRootVertex (childAt cs i)) (j : Fin (NonRootVertex.weight v)) :
