  rw [Fintype.card_fun]
  have hdomain :
      Fintype.card (RawNormal.RootFieldDomain n (RTree.node a [])) = 1 := by
    rw [card_rootFieldDomain_node_eq_pow_sum_totalWeight]
    simp
  rw [hdomain]
  simp [F2]

noncomputable def boundaryZeroRootFieldNilEquivRootField
    (n a : Nat) [NeZero n] :
    { R : RawNormal.NodeRootFieldAssignment n a [] //
