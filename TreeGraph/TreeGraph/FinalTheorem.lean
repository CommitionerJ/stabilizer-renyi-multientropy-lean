    have hy :
        rootFieldDomainOfNonRootContextTuple
            (n := n) (T := RTree.node b ds)
            (RawNormal.childRootAtAsNonRootInNode (a := b) j) c y
            (RawNormal.childRootAtAsNonRootInNode (a := b) j) = y := by
