noncomputable def rootFieldAssignmentReducedNonRootConstraintLinearMap
    {n : Nat} [NeZero n] (T : RTree) (v : NonRootVertex T) :
    (RootFieldOtherCoord n T v →
        (Fin (NonRootVertex.weight v) → ZMod n) → F2) →ₗ[F2]
      (RootFieldOtherCoord n T v → ZMod n → F2) :=
  (RawLinearAlgebra.paramCyclicDiff
      (RootFieldOtherCoord n T v) n F2).comp
    (RawLinearAlgebra.paramFiberSum
      (RootFieldOtherCoord n T v)
      (NonRootVertex.weight v) n F2)

@[simp] theorem rootFieldAssignmentReducedNonRootConstraintLinearMap_apply
    {n : Nat} [NeZero n] (T : RTree) (v : NonRootVertex T)
