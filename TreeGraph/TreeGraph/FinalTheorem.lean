      a [RTree.node b [], RTree.node c []] :=
  openRootRawExpandedEdgeNodeCertificate_of_nodeStepCertificate
    (nodeStepCertificate_star a b c ha hb hc)

theorem openRootRawExpandedEdgeNodeStepRule_of_forall_certificate
    (hcert :
      ∀ {a : Nat} {cs : List RTree},
        0 < a →
        (∀ C ∈ cs, SubtreeModelCertificate C) →
        OpenRootRawExpandedEdgeNodeCertificate a cs) :
    OpenRootRawExpandedEdgeNodeStepRule := by
  intro a cs ha hchildren n _
  exact (hcert ha hchildren).rawExpandedEdgeOpenRoot n

theorem forall_certificate_of_openRootRawExpandedEdgeNodeStepRule
    (hopen : OpenRootRawExpandedEdgeNodeStepRule) :
    ∀ {a : Nat} {cs : List RTree},
      0 < a →
      (∀ C ∈ cs, SubtreeModelCertificate C) →
      OpenRootRawExpandedEdgeNodeCertificate a cs := by
  intro a cs ha hchildren
  exact
    { positiveRoot := ha
      children := hchildren
      rawExpandedEdgeOpenRoot := by
        intro n _
        exact hopen ha hchildren n }

theorem openRootRawExpandedEdgeNodeStepRule_iff_forall_certificate :
    OpenRootRawExpandedEdgeNodeStepRule ↔
      (∀ {a : Nat} {cs : List RTree},
        0 < a →
        (∀ C ∈ cs, SubtreeModelCertificate C) →
        OpenRootRawExpandedEdgeNodeCertificate a cs) :=
  ⟨forall_certificate_of_openRootRawExpandedEdgeNodeStepRule,
    openRootRawExpandedEdgeNodeStepRule_of_forall_certificate⟩

def RawExpandedOpenRootSubtreeCert : RTree → Prop
  | RTree.node a cs =>
      0 < a ∧
        (∀ C ∈ cs, RawExpandedOpenRootSubtreeCert C) ∧
        ∀ (n : Nat) [NeZero n],
          rawExpandedEdgeSignedSum n (RTree.node a cs) =
            (2 : ℤ) ^ Int.toNat (openRootNodeExponent n a cs)

namespace RawExpandedOpenRootSubtreeCert

theorem parts {a : Nat} {cs : List RTree}
    (h : RawExpandedOpenRootSubtreeCert (RTree.node a cs)) :
    0 < a ∧
      (∀ C ∈ cs, RawExpandedOpenRootSubtreeCert C) ∧
      ∀ (n : Nat) [NeZero n],
        rawExpandedEdgeSignedSum n (RTree.node a cs) =
          (2 : ℤ) ^ Int.toNat (openRootNodeExponent n a cs) := by
  simpa [RawExpandedOpenRootSubtreeCert] using h

theorem positiveRoot {a : Nat} {cs : List RTree}
    (h : RawExpandedOpenRootSubtreeCert (RTree.node a cs)) :
    0 < a :=
  (parts h).1

theorem children {a : Nat} {cs : List RTree}
    (h : RawExpandedOpenRootSubtreeCert (RTree.node a cs)) :
    ∀ C ∈ cs, RawExpandedOpenRootSubtreeCert C :=
  (parts h).2.1

theorem childAt_of_children {cs : List RTree}
    (hchildren : ∀ C ∈ cs, RawExpandedOpenRootSubtreeCert C)
    (i : ChildIdx cs) :
    RawExpandedOpenRootSubtreeCert (childAt cs i) :=
  hchildren (childAt cs i) (childAt_mem cs i)

theorem childAt {a : Nat} {cs : List RTree}
    (h : RawExpandedOpenRootSubtreeCert (RTree.node a cs))
    (i : ChildIdx cs) :
    RawExpandedOpenRootSubtreeCert (childAt cs i) :=
  childAt_of_children (children h) i

theorem rawExpandedEdgeOpenRoot {a : Nat} {cs : List RTree}
    (h : RawExpandedOpenRootSubtreeCert (RTree.node a cs))
    (n : Nat) [NeZero n] :
    rawExpandedEdgeSignedSum n (RTree.node a cs) =
      (2 : ℤ) ^ Int.toNat (openRootNodeExponent n a cs) :=
  (parts h).2.2 n

theorem mk_node {a : Nat} {cs : List RTree}
    (ha : 0 < a)
    (hchildren : ∀ C ∈ cs, RawExpandedOpenRootSubtreeCert C)
    (hraw :
      ∀ (n : Nat) [NeZero n],
        rawExpandedEdgeSignedSum n (RTree.node a cs) =
          (2 : ℤ) ^ Int.toNat (openRootNodeExponent n a cs)) :
    RawExpandedOpenRootSubtreeCert (RTree.node a cs) := by
  simpa [RawExpandedOpenRootSubtreeCert] using
    (show
      0 < a ∧
        (∀ C ∈ cs, RawExpandedOpenRootSubtreeCert C) ∧
        (∀ (n : Nat) [NeZero n],
          rawExpandedEdgeSignedSum n (RTree.node a cs) =
            (2 : ℤ) ^ Int.toNat (openRootNodeExponent n a cs)) from
      ⟨ha, hchildren, hraw⟩)

theorem subtreeModelCertificate :
    ∀ {T : RTree}, RawExpandedOpenRootSubtreeCert T →
      SubtreeModelCertificate T := by
  intro T hT
  induction T using rootedTerms.induct with
  | case1 a cs ih =>
      have ha : 0 < a :=
        positiveRoot hT
      have hchildCert :
          ∀ C ∈ cs, RawExpandedOpenRootSubtreeCert C :=
        children hT
      have hchildModel : ∀ C ∈ cs, SubtreeModelCertificate C := by
        intro C hC
        exact ih C hC (hchildCert C hC)
      have hnode : OpenRootRawExpandedEdgeNodeCertificate a cs :=
        { positiveRoot := ha
          children := hchildModel
          rawExpandedEdgeOpenRoot := by
            intro n _
            exact rawExpandedEdgeOpenRoot hT n }
      exact hnode.subtreeModelCertificate

theorem modelCertificate {T : RTree}
    (h : RawExpandedOpenRootSubtreeCert T) :
    ModelCertificate T :=
  SubtreeModelCertificate.root (subtreeModelCertificate h)

theorem positiveWeights {T : RTree}
    (h : RawExpandedOpenRootSubtreeCert T) :
    RTree.PositiveWeights T :=
  SubtreeModelCertificate.positiveWeights (subtreeModelCertificate h)

theorem nodeCertificate {a : Nat} {cs : List RTree}
    (h : RawExpandedOpenRootSubtreeCert (RTree.node a cs)) :
    OpenRootRawExpandedEdgeNodeCertificate a cs :=
  { positiveRoot := positiveRoot h
    children := by
      intro C hC
      exact subtreeModelCertificate (children h C hC)
    rawExpandedEdgeOpenRoot := by
      intro n _
      exact rawExpandedEdgeOpenRoot h n }

theorem rawBitStringOpenRoot {a : Nat} {cs : List RTree}
    (h : RawExpandedOpenRootSubtreeCert (RTree.node a cs))
    (n : Nat) [NeZero n] :
    rawBitStringSignedSum n (RTree.node a cs) =
      (2 : ℤ) ^ Int.toNat (openRootNodeExponent n a cs) :=
  (nodeCertificate h).rawBitStringOpenRoot n

theorem rawExpandedEdgeDelta {T : RTree}
    (h : RawExpandedOpenRootSubtreeCert T)
    (n : Nat) [NeZero n] :
    rawExpandedEdgeSignedSum n T = DeltaTreeModel n T := by
  cases T with
  | node a cs =>
      exact (nodeCertificate h).rawExpandedEdgeDelta n

theorem finalClosed {T : RTree}
    (h : RawExpandedOpenRootSubtreeCert T)
    (n : Nat) [NeZero n] :
    rawExpandedEdgeSignedSum n T =
      (2 : ℤ) ^ Int.toNat (assignmentFactorProductExponent n T) :=
  (rawExpandedEdgeDelta h n).trans
    (DeltaTreeModel_closed_assignmentFactorProductExponent
      (n := n) (SubtreeModelCertificate.positiveWeights
        (subtreeModelCertificate h)))

theorem externalCopiesFinalClosed {T : RTree}
    (h : RawExpandedOpenRootSubtreeCert T)
    (n : Nat) [NeZero n]
    {ι : Type} [Fintype ι] [DecidableEq ι] :
    (∑ Aext :
      ι → { Araw : RawAssignment n T // RealizedByNormal T Araw },
      ∏ i, rawEdgePhaseSign n T (Aext i)) =
      ((2 : ℤ) ^ Int.toNat
        (assignmentFactorProductExponent n T)) ^ Fintype.card ι := by
  exact
    rawExpandedEdgePhaseSign_externalCopies_closed
      (n := n) (T := T)
      (E := assignmentFactorProductExponent n T)
      (finalClosed h n)

theorem externalCopiesFinalClosed_twoPow {T : RTree}
    (h : RawExpandedOpenRootSubtreeCert T)
    (n : Nat) [NeZero n]
    {ι : Type} [Fintype ι] [DecidableEq ι] :
    (∑ Aext :
      ι → { Araw : RawAssignment n T // RealizedByNormal T Araw },
      ∏ i, rawEdgePhaseSign n T (Aext i)) =
      (2 : ℤ) ^
        (Int.toNat (assignmentFactorProductExponent n T) *
          Fintype.card ι) := by
  rw [externalCopiesFinalClosed (h := h) (n := n)]
  rw [int_two_pow_pow_toNat]

theorem externalBranchCopiesFinalClosed {T : RTree}
    (h : RawExpandedOpenRootSubtreeCert T)
    (n : Nat) [NeZero n] (external : List RTree) :
    (∑ Aext :
      BranchIndex n external →
        { Araw : RawAssignment n T // RealizedByNormal T Araw },
      ∏ i, rawEdgePhaseSign n T (Aext i)) =
      (2 : ℤ) ^
        (Int.toNat (assignmentFactorProductExponent n T) *
          independentBranchDimension n external) := by
  classical
  rw [externalCopiesFinalClosed_twoPow (h := h) (n := n)]
  rw [card_branchIndex]

theorem childExternalBranchCopiesFinalClosed {C : RTree}
    (hC : RawExpandedOpenRootSubtreeCert C)
    (n : Nat) [NeZero n] (left right : List RTree) :
    (∑ Aext :
      BranchIndex n (left ++ right) →
        { Araw : RawAssignment n C // RealizedByNormal C Araw },
      ∏ i, rawEdgePhaseSign n C (Aext i)) =
      (2 : ℤ) ^
        (Int.toNat (assignmentFactorProductExponent n C) *
          independentBranchDimension n (left ++ right)) :=
  externalBranchCopiesFinalClosed hC n (left ++ right)

theorem coordinateExternalCopiesFinalClosed {T : RTree}
    (h : RawExpandedOpenRootSubtreeCert T)
    (n : Nat) [NeZero n] (shift : Nat) :
    (∑ Aext :
      Fin (n ^ shift) →
        { Araw : RawAssignment n T // RealizedByNormal T Araw },
      ∏ i, rawEdgePhaseSign n T (Aext i)) =
      (2 : ℤ) ^
        (Int.toNat (assignmentFactorProductExponent n T) *
          n ^ shift) := by
  rw [externalCopiesFinalClosed_twoPow (h := h) (n := n)]
  rw [Fintype.card_fin]

theorem coordinateExternalCopiesFinalClosed_Xassign {T : RTree}
    (h : RawExpandedOpenRootSubtreeCert T)
    (n : Nat) [NeZero n] (shift : Nat) :
    (∑ Aext :
      Fin (n ^ shift) →
        { Araw : RawAssignment n T // RealizedByNormal T Araw },
      ∏ i, rawEdgePhaseSign n T (Aext i)) =
      (2 : ℤ) ^ (Int.toNat (Xassign n T) * n ^ shift) := by
  have hpos := RawExpandedOpenRootSubtreeCert.positiveWeights h
  have hX :=
    assignmentFactorProductExponent_eq_Xassign_of_positiveWeights
      (n := n) hpos
  simpa [hX] using coordinateExternalCopiesFinalClosed h n shift

theorem childPositionCoordinateExternalCopiesFinalClosed {C : RTree}
    (hC : RawExpandedOpenRootSubtreeCert C)
    (n : Nat) [NeZero n]
    (a : Nat) (left right : List RTree) :
    (∑ Aext :
      Fin (n ^
        (a + (left.map RTree.totalWeight).sum +
          (right.map RTree.totalWeight).sum)) →
        { Araw : RawAssignment n C // RealizedByNormal C Araw },
      ∏ i, rawEdgePhaseSign n C (Aext i)) =
      (2 : ℤ) ^
        (Int.toNat (Xassign n C) *
          n ^ (a + (left.map RTree.totalWeight).sum +
            (right.map RTree.totalWeight).sum)) :=
  coordinateExternalCopiesFinalClosed_Xassign hC n
    (a + (left.map RTree.totalWeight).sum +
      (right.map RTree.totalWeight).sum)

noncomputable def childInternalCoordinateExponentNat
    (n a : Nat) : List RTree → Nat → Nat
  | [], _ => 0
  | C :: rest, left =>
      Int.toNat (Xassign n C) *
          n ^ (a + left + (rest.map RTree.totalWeight).sum) +
        childInternalCoordinateExponentNat n a rest
          (left + RTree.totalWeight C)

noncomputable def childInternalCoordinateCopiesProduct
    (n : Nat) [NeZero n] (a : Nat) : List RTree → Nat → ℤ
  | [], _ => 1
  | C :: rest, left =>
      (∑ Aext :
        Fin (n ^ (a + left + (rest.map RTree.totalWeight).sum)) →
          { Araw : RawAssignment n C // RealizedByNormal C Araw },
        ∏ i, rawEdgePhaseSign n C (Aext i)) *
        childInternalCoordinateCopiesProduct n a rest
          (left + RTree.totalWeight C)

noncomputable def childInternalCoordinateCopyFactorAtWithLeft
    (n : Nat) [NeZero n] (a : Nat) :
    (cs : List RTree) → Nat → ChildIdx cs → ℤ
  | [], _left, i => Fin.elim0 i
  | C :: rest, left, ⟨0, _⟩ =>
      ∑ Aext :
        Fin (n ^ (a + left + (rest.map RTree.totalWeight).sum)) →
          { Araw : RawAssignment n C // RealizedByNormal C Araw },
        ∏ i, rawEdgePhaseSign n C (Aext i)
  | C :: rest, left, ⟨Nat.succ k, hk⟩ =>
      childInternalCoordinateCopyFactorAtWithLeft n a rest
        (left + RTree.totalWeight C)
        ⟨k, by
          simpa using Nat.lt_of_succ_lt_succ hk⟩

noncomputable def childInternalCoordinateCopyFactorAt
    (n : Nat) [NeZero n] (a : Nat) (cs : List RTree)
    (i : ChildIdx cs) : ℤ :=
  childInternalCoordinateCopyFactorAtWithLeft n a cs 0 i

@[simp] theorem childInternalCoordinateCopyFactorAtWithLeft_cons_zero
    (n : Nat) [NeZero n] (a : Nat) (C : RTree) (rest : List RTree)
    (left : Nat) :
    childInternalCoordinateCopyFactorAtWithLeft n a (C :: rest) left
        (0 : ChildIdx (C :: rest)) =
      (∑ Aext :
        Fin (n ^ (a + left + (rest.map RTree.totalWeight).sum)) →
          { Araw : RawAssignment n C // RealizedByNormal C Araw },
        ∏ i, rawEdgePhaseSign n C (Aext i)) := by
  rfl

@[simp] theorem childInternalCoordinateCopyFactorAtWithLeft_cons_succ
    (n : Nat) [NeZero n] (a : Nat) (C : RTree) (rest : List RTree)
    (left : Nat) (i : ChildIdx rest) :
    childInternalCoordinateCopyFactorAtWithLeft n a (C :: rest) left
        i.succ =
      childInternalCoordinateCopyFactorAtWithLeft n a rest
        (left + RTree.totalWeight C) i := by
  cases i with
  | mk k hk =>
      rfl

theorem childInternalCoordinateCopiesProduct_eq_prod_copyFactorAtWithLeft
    (n : Nat) [NeZero n] (a : Nat) :
    ∀ (cs : List RTree) (left : Nat),
      childInternalCoordinateCopiesProduct n a cs left =
        ∏ i : ChildIdx cs,
          childInternalCoordinateCopyFactorAtWithLeft n a cs left i
  | [], left => by
      change 1 =
        ∏ i : Fin 0,
          childInternalCoordinateCopyFactorAtWithLeft n a [] left i
      simp
  | C :: rest, left => by
      have htail :=
        childInternalCoordinateCopiesProduct_eq_prod_copyFactorAtWithLeft
          n a rest (left + RTree.totalWeight C)
      calc
        childInternalCoordinateCopiesProduct n a (C :: rest) left =
            (∑ Aext :
              Fin (n ^ (a + left + (rest.map RTree.totalWeight).sum)) →
                { Araw : RawAssignment n C // RealizedByNormal C Araw },
              ∏ i, rawEdgePhaseSign n C (Aext i)) *
              childInternalCoordinateCopiesProduct n a rest
                (left + RTree.totalWeight C) := by
              rfl
        _ =
            (∑ Aext :
              Fin (n ^ (a + left + (rest.map RTree.totalWeight).sum)) →
                { Araw : RawAssignment n C // RealizedByNormal C Araw },
              ∏ i, rawEdgePhaseSign n C (Aext i)) *
              ∏ i : ChildIdx rest,
                childInternalCoordinateCopyFactorAtWithLeft n a rest
                  (left + RTree.totalWeight C) i := by
              rw [htail]
        _ =
            ∏ i : ChildIdx (C :: rest),
              childInternalCoordinateCopyFactorAtWithLeft n a
                (C :: rest) left i := by
              change
                (∑ Aext :
                  Fin (n ^ (a + left +
                    (rest.map RTree.totalWeight).sum)) →
                    { Araw : RawAssignment n C //
                      RealizedByNormal C Araw },
                  ∏ i, rawEdgePhaseSign n C (Aext i)) *
                  ∏ i : ChildIdx rest,
                    childInternalCoordinateCopyFactorAtWithLeft n a rest
                      (left + RTree.totalWeight C) i =
                ∏ i : Fin (rest.length + 1),
                  childInternalCoordinateCopyFactorAtWithLeft n a
                    (C :: rest) left i
              rw [Fin.prod_univ_succ]
              rfl

theorem childInternalCoordinateCopiesProduct_eq_prod_copyFactorAt
    (n : Nat) [NeZero n] (a : Nat) (cs : List RTree) :
    childInternalCoordinateCopiesProduct n a cs 0 =
      ∏ i : ChildIdx cs, childInternalCoordinateCopyFactorAt n a cs i := by
  simpa [childInternalCoordinateCopyFactorAt] using
    childInternalCoordinateCopiesProduct_eq_prod_copyFactorAtWithLeft
      n a cs 0

theorem prod_copyFactorAt_eq_childInternalCoordinateCopiesProduct
    (n : Nat) [NeZero n] (a : Nat) (cs : List RTree) :
    (∏ i : ChildIdx cs, childInternalCoordinateCopyFactorAt n a cs i) =
      childInternalCoordinateCopiesProduct n a cs 0 :=
  (childInternalCoordinateCopiesProduct_eq_prod_copyFactorAt
    n a cs).symm

theorem childInternalCoordinateCopiesProduct_closed
    (n : Nat) [NeZero n] (a : Nat) :
    ∀ (cs : List RTree) (left : Nat),
      (∀ C ∈ cs, RawExpandedOpenRootSubtreeCert C) →
      childInternalCoordinateCopiesProduct n a cs left =
        (2 : ℤ) ^
          childInternalCoordinateExponentNat n a cs left
  | [], left, _ => by
      simp [childInternalCoordinateCopiesProduct,
        childInternalCoordinateExponentNat]
  | C :: rest, left, hchildren => by
      have hC : RawExpandedOpenRootSubtreeCert C :=
        hchildren C (by simp)
      have hrest : ∀ D ∈ rest, RawExpandedOpenRootSubtreeCert D := by
        intro D hD
        exact hchildren D (by simp [hD])
      have htail :=
        childInternalCoordinateCopiesProduct_closed n a rest
          (left + RTree.totalWeight C) hrest
      rw [childInternalCoordinateCopiesProduct,
        coordinateExternalCopiesFinalClosed_Xassign hC n
          (a + left + (rest.map RTree.totalWeight).sum),
        htail]
      rw [← pow_add]
      rfl

theorem Xassign_nonneg {T : RTree}
    (hT : RawExpandedOpenRootSubtreeCert T)
    (n : Nat) [NeZero n] :
    0 ≤ Xassign n T := by
  induction T using rootedTerms.induct with
  | case1 a cs ih =>
      have hpos : RTree.PositiveWeights (RTree.node a cs) :=
        positiveWeights hT
      have hYcast :
          ((Ydim n (RTree.node a cs) : Nat) : ℤ) =
            Yassign n (RTree.node a cs) :=
        Ydim_cast_eq_Yassign (n := n) hpos
      have hYnonneg :
          0 ≤ Yassign n (RTree.node a cs) := by
        rw [← hYcast]
        exact_mod_cast Nat.zero_le (Ydim n (RTree.node a cs))
      have hchildCert :
          ∀ C ∈ cs, RawExpandedOpenRootSubtreeCert C :=
        children hT
      have hchild :
          0 ≤ childContribSumWith (Xassign n) n a cs 0 := by
        have hgeneral :
            ∀ (ds : List RTree) (left : Nat),
              (∀ D ∈ ds, D ∈ cs) →
              0 ≤ childContribSumWith (Xassign n) n a ds left := by
          intro ds
          induction ds with
          | nil =>
              intro left _hsub
              simp [childContribSumWith]
          | cons C rest ihrest =>
              intro left hsub
              have hCmem : C ∈ cs :=
                hsub C (by simp)
              have hrestSub : ∀ D ∈ rest, D ∈ cs := by
                intro D hD
                exact hsub D (by simp [hD])
              have hCcert : RawExpandedOpenRootSubtreeCert C :=
                hchildCert C hCmem
              have hX : 0 ≤ Xassign n C :=
                ih C hCmem hCcert
              have hpow :
                  0 ≤ (nZ n) ^
                    (a + left + (rest.map RTree.totalWeight).sum) := by
                exact pow_nonneg (Int.natCast_nonneg n) _
              have hhead :
                  0 ≤
                    (nZ n) ^
                        (a + left +
                          (rest.map RTree.totalWeight).sum) *
                      Xassign n C :=
                mul_nonneg hpow hX
              have htail :
                  0 ≤ childContribSumWith (Xassign n) n a rest
                    (left + RTree.totalWeight C) :=
                ihrest (left + RTree.totalWeight C) hrestSub
              simpa [childContribSumWith] using
                add_nonneg hhead htail
        exact hgeneral cs 0 (by intro D hD; exact hD)
      rw [Xassign_node n a cs]
      rw [← childContribSumWith_Xassign n a cs 0]
      exact add_nonneg hYnonneg hchild

theorem childContribSumWith_nonneg_of_childCerts
    (n : Nat) [NeZero n] (a : Nat) :
    ∀ (cs : List RTree) (left : Nat),
      (∀ C ∈ cs, RawExpandedOpenRootSubtreeCert C) →
      0 ≤ childContribSumWith (Xassign n) n a cs left
  | [], _left, _hchildren => by
      simp [childContribSumWith]
  | C :: rest, left, hchildren => by
      have hC : RawExpandedOpenRootSubtreeCert C :=
        hchildren C (by simp)
      have hrest : ∀ D ∈ rest, RawExpandedOpenRootSubtreeCert D := by
        intro D hD
        exact hchildren D (by simp [hD])
      have hX : 0 ≤ Xassign n C :=
        Xassign_nonneg hC n
      have hpow :
          0 ≤ (nZ n) ^
            (a + left + (rest.map RTree.totalWeight).sum) := by
        exact pow_nonneg (Int.natCast_nonneg n) _
      have hhead :
          0 ≤
            (nZ n) ^
                (a + left + (rest.map RTree.totalWeight).sum) *
              Xassign n C :=
        mul_nonneg hpow hX
      have htail :
          0 ≤ childContribSumWith (Xassign n) n a rest
            (left + RTree.totalWeight C) :=
        childContribSumWith_nonneg_of_childCerts n a rest
          (left + RTree.totalWeight C) hrest
      simpa [childContribSumWith] using add_nonneg hhead htail

theorem childInternalCoordinateExponentNat_cast_eq_childContribSumWith
    (n : Nat) [NeZero n] (a : Nat) :
    ∀ (cs : List RTree) (left : Nat),
      (∀ C ∈ cs, RawExpandedOpenRootSubtreeCert C) →
      ((childInternalCoordinateExponentNat n a cs left : Nat) : ℤ) =
        childContribSumWith (Xassign n) n a cs left
  | [], _left, _hchildren => by
      simp [childInternalCoordinateExponentNat, childContribSumWith]
  | C :: rest, left, hchildren => by
      have hC : RawExpandedOpenRootSubtreeCert C :=
        hchildren C (by simp)
      have hrest : ∀ D ∈ rest, RawExpandedOpenRootSubtreeCert D := by
        intro D hD
        exact hchildren D (by simp [hD])
      have hX : 0 ≤ Xassign n C :=
        Xassign_nonneg hC n
      have htail :=
        childInternalCoordinateExponentNat_cast_eq_childContribSumWith
          n a rest (left + RTree.totalWeight C) hrest
      let shift := a + left + (rest.map RTree.totalWeight).sum
      have hpow : ((n ^ shift : Nat) : ℤ) = (nZ n) ^ shift := by
        simp [nZ]
      have hhead :
          ((Int.toNat (Xassign n C) * n ^ shift : Nat) : ℤ) =
            (nZ n) ^ shift * Xassign n C := by
        calc
          ((Int.toNat (Xassign n C) * n ^ shift : Nat) : ℤ)
              =
              ((Int.toNat (Xassign n C) : Nat) : ℤ) *
                ((n ^ shift : Nat) : ℤ) := by
                norm_num
          _ = Xassign n C * (nZ n) ^ shift := by
                rw [Int.toNat_of_nonneg hX, hpow]
          _ = (nZ n) ^ shift * Xassign n C := by
                rw [mul_comm]
      simp [childInternalCoordinateExponentNat, childContribSumWith,
        shift, hhead, htail]

theorem childInternalCoordinateCopiesProduct_closed_childContrib
    (n : Nat) [NeZero n] (a : Nat)
    (cs : List RTree) (left : Nat)
    (hchildren : ∀ C ∈ cs, RawExpandedOpenRootSubtreeCert C) :
    childInternalCoordinateCopiesProduct n a cs left =
      (2 : ℤ) ^
        Int.toNat
          (childContribSumWith (Xassign n) n a cs left) := by
  rw [childInternalCoordinateCopiesProduct_closed n a cs left hchildren]
  have hcast :=
    childInternalCoordinateExponentNat_cast_eq_childContribSumWith
      n a cs left hchildren
  have htoNat :
      Int.toNat (childContribSumWith (Xassign n) n a cs left) =
        childInternalCoordinateExponentNat n a cs left := by
    rw [← hcast]
    simp
  rw [htoNat]

theorem leaf {a : Nat} (ha : 0 < a) :
    RawExpandedOpenRootSubtreeCert (RTree.node a []) :=
  mk_node ha (by
    intro C hC
    cases hC) (by
    intro n _
    exact
      (openRootRawExpandedEdgeNodeCertificate_leaf
        ha).rawExpandedEdgeOpenRoot n)

theorem edge {a b : Nat} (ha : 0 < a) (hb : 0 < b) :
    RawExpandedOpenRootSubtreeCert (RTree.node a [RTree.node b []]) :=
  mk_node ha (by
    intro C hC
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hC
    rw [hC]
    exact leaf hb) (by
    intro n _
    exact
      (openRootRawExpandedEdgeNodeCertificate_edge
        ha hb).rawExpandedEdgeOpenRoot n)

theorem star {a b c : Nat} (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) :
    RawExpandedOpenRootSubtreeCert
      (RTree.node a [RTree.node b [], RTree.node c []]) :=
  mk_node ha (by
    intro C hC
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hC
    rcases hC with hC | hC
    · rw [hC]
      exact leaf hb
    · rw [hC]
      exact leaf hc) (by
    intro n _
    exact
      (openRootRawExpandedEdgeNodeCertificate_star
        ha hb hc).rawExpandedEdgeOpenRoot n)

end RawExpandedOpenRootSubtreeCert

theorem rawExpandedOpenRootSubtreeCert_of_verifiedShape
    {T : RTree} (hT : VerifiedShape T) :
    RawExpandedOpenRootSubtreeCert T := by
  cases hT with
  | leaf a ha =>
      exact RawExpandedOpenRootSubtreeCert.leaf ha
  | edge a b ha hb =>
      exact RawExpandedOpenRootSubtreeCert.edge ha hb
  | star a b c ha hb hc =>
      simpa [StarTree] using
        RawExpandedOpenRootSubtreeCert.star ha hb hc

theorem forall_pureSubtreeCert_of_openRootRawExpandedEdgeNodeStepRule
    (hopen : OpenRootRawExpandedEdgeNodeStepRule) :
    ∀ {T : RTree}, RTree.PositiveWeights T →
      RawExpandedOpenRootSubtreeCert T := by
  intro T hT
  induction T using rootedTerms.induct with
  | case1 a cs ih =>
      have hnode : 0 < a ∧ ∀ C ∈ cs, RTree.PositiveWeights C := by
        simpa [RTree.PositiveWeights] using hT
      have hchildCert :
          ∀ C ∈ cs, RawExpandedOpenRootSubtreeCert C := by
        intro C hC
        exact ih C hC (hnode.2 C hC)
      have hchildModel : ∀ C ∈ cs, SubtreeModelCertificate C := by
        intro C hC
        exact RawExpandedOpenRootSubtreeCert.subtreeModelCertificate
          (hchildCert C hC)
      exact RawExpandedOpenRootSubtreeCert.mk_node
        hnode.1 hchildCert (by
          intro n _
          exact hopen (a := a) (cs := cs) hnode.1 hchildModel n)

theorem openRootRawExpandedEdgeNodeStepRule_of_forall_pureSubtreeCert
    (hsub :
      ∀ {T : RTree}, RTree.PositiveWeights T →
        RawExpandedOpenRootSubtreeCert T) :
    OpenRootRawExpandedEdgeNodeStepRule := by
  intro a cs ha hchildren n _
  have hchildPos : ∀ C ∈ cs, RTree.PositiveWeights C := by
    intro C hC
    exact SubtreeModelCertificate.positiveWeights (hchildren C hC)
  have hpos : RTree.PositiveWeights (RTree.node a cs) := by
    have hnode : 0 < a ∧ ∀ C ∈ cs, RTree.PositiveWeights C :=
      ⟨ha, hchildPos⟩
    simpa [RTree.PositiveWeights] using hnode
  exact RawExpandedOpenRootSubtreeCert.rawExpandedEdgeOpenRoot
    (hsub (T := RTree.node a cs) hpos) n

theorem openRootRawExpandedEdgeNodeStepRule_iff_forall_pureSubtreeCert :
    OpenRootRawExpandedEdgeNodeStepRule ↔
      (∀ {T : RTree}, RTree.PositiveWeights T →
        RawExpandedOpenRootSubtreeCert T) :=
  ⟨forall_pureSubtreeCert_of_openRootRawExpandedEdgeNodeStepRule,
    openRootRawExpandedEdgeNodeStepRule_of_forall_pureSubtreeCert⟩

theorem forall_pureSubtreeCert_iff_openRootRawExpandedEdgeNodeStepRule :
    (∀ {T : RTree}, RTree.PositiveWeights T →
      RawExpandedOpenRootSubtreeCert T) ↔
      OpenRootRawExpandedEdgeNodeStepRule :=
  openRootRawExpandedEdgeNodeStepRule_iff_forall_pureSubtreeCert.symm

def PureRawExpandedOpenRootNodeStepRule : Prop :=
  ∀ {a : Nat} {cs : List RTree},
    0 < a →
    (∀ C ∈ cs, RawExpandedOpenRootSubtreeCert C) →
    ∀ (n : Nat) [NeZero n],
      rawExpandedEdgeSignedSum n (RTree.node a cs) =
        (2 : ℤ) ^ Int.toNat (openRootNodeExponent n a cs)

theorem pureNodeStepRule_of_openRootRawExpandedEdgeNodeStepRule
    (hopen : OpenRootRawExpandedEdgeNodeStepRule) :
    PureRawExpandedOpenRootNodeStepRule := by
  intro a cs ha hchildren n _
  have hchildModel : ∀ C ∈ cs, SubtreeModelCertificate C := by
    intro C hC
    exact RawExpandedOpenRootSubtreeCert.subtreeModelCertificate
      (hchildren C hC)
  exact hopen (a := a) (cs := cs) ha hchildModel n

theorem forall_pureSubtreeCert_of_pureNodeStepRule
    (hpure : PureRawExpandedOpenRootNodeStepRule) :
    ∀ {T : RTree}, RTree.PositiveWeights T →
      RawExpandedOpenRootSubtreeCert T := by
  intro T hT
  induction T using rootedTerms.induct with
  | case1 a cs ih =>
      have hnode : 0 < a ∧ ∀ C ∈ cs, RTree.PositiveWeights C := by
        simpa [RTree.PositiveWeights] using hT
      have hchildren :
          ∀ C ∈ cs, RawExpandedOpenRootSubtreeCert C := by
        intro C hC
        exact ih C hC (hnode.2 C hC)
      exact RawExpandedOpenRootSubtreeCert.mk_node
        hnode.1 hchildren (by
          intro n _
          exact hpure (a := a) (cs := cs) hnode.1 hchildren n)

theorem openRootRawExpandedEdgeNodeStepRule_of_pureNodeStepRule
    (hpure : PureRawExpandedOpenRootNodeStepRule) :
    OpenRootRawExpandedEdgeNodeStepRule :=
  openRootRawExpandedEdgeNodeStepRule_of_forall_pureSubtreeCert
    (forall_pureSubtreeCert_of_pureNodeStepRule hpure)

theorem pureNodeStepRule_iff_openRootRawExpandedEdgeNodeStepRule :
    PureRawExpandedOpenRootNodeStepRule ↔
      OpenRootRawExpandedEdgeNodeStepRule :=
  ⟨openRootRawExpandedEdgeNodeStepRule_of_pureNodeStepRule,
    pureNodeStepRule_of_openRootRawExpandedEdgeNodeStepRule⟩

theorem openRootRawExpandedEdgeNodeStepRule_iff_pureNodeStepRule :
    OpenRootRawExpandedEdgeNodeStepRule ↔
      PureRawExpandedOpenRootNodeStepRule :=
  pureNodeStepRule_iff_openRootRawExpandedEdgeNodeStepRule.symm

def PureRawExpandedFactorNodeRule : Prop :=
  ∀ {a : Nat} {cs : List RTree},
    0 < a →
    (∀ C ∈ cs, RawExpandedOpenRootSubtreeCert C) →
    ∀ (n : Nat) [NeZero n],
      rawExpandedEdgeSignedSum n (RTree.node a cs) =
        (2 : ℤ) ^ Int.toNat
          (assignmentFactorProductExponent n (RTree.node a cs))

structure PureRawExpandedFactorKernelAt
