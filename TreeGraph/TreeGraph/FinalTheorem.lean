def PrimitiveRawBitStringAssignmentFactorProductNodeRule : Prop :=
  ∀ {a : Nat} {cs : List RTree},
    0 < a →
    (∀ C ∈ cs, RTree.PositiveWeights C) →
    ∀ (n : Nat) [NeZero n],
      (∑ Araw : NormalFormRawAssignments n (RTree.node a cs),
        weight (RTree.node a cs) Araw.1) =
          (2 : ℤ) ^ Int.toNat
            ((((cs.map (fun C =>
              Int.toNat
                ((nZ n) ^ RTree.totalWeight C -
                  (tZ n) * Yassign n C))).prod : Nat) : ℤ) +
              childContribSumWith (Xassign n) n a cs 0)

theorem primitiveRawBitStringAssignmentFactorProductNodeRule_iff_assignmentFactorProductNodeRule :
    PrimitiveRawBitStringAssignmentFactorProductNodeRule ↔
      PositiveAssignmentFactorProductNodeRule := by
  constructor
  · intro hraw a cs ha hchildren n _
    simpa [rawBitStringSignedSum] using hraw ha hchildren n
  · intro hfactor a cs ha hchildren n _
