theorem cyclicChildRootBoundaryShiftedSliceKernelSpanSubspace_eq_iSup_map_base
    {n b : Nat} [NeZero n] (ds : List RTree) :
    cyclicChildRootBoundaryShiftedSliceKernelSpanSubspace
