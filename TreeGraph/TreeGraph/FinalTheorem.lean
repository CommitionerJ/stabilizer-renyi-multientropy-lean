              (cyclicRootTwistedEdgePhaseAt
                (n := n) (a := b) (cs := ds) j B (d + shift) site)).sum := by
          refine Finset.sum_congr rfl ?_
          intro d _
          refine Finset.sum_congr rfl ?_
          intro site _
          apply congrArg List.sum
          refine List.map_congr_left ?_
          intro e _he
          exact
            cyclicRootTwistedEdgePhaseAt_timeShift
              (n := n) (b := b) (ds := ds) j B shift d site e
    _ =
        ∑ d : ZMod n,
          ∑ site : RawNormal.NormalSite n (childAt ds j),
            ((RTree.edgeList (childAt ds j)).map
              (cyclicRootTwistedEdgePhaseAt
                (n := n) (a := b) (cs := ds) j B d site)).sum := by
          exact
            zmod_sum_add_right
              (n := n) shift
              (fun d : ZMod n =>
                ∑ site : RawNormal.NormalSite n (childAt ds j),
                  ((RTree.edgeList (childAt ds j)).map
