      (n := n) (b := b) ds hleaf ?_
  let S : Nat :=
    Module.finrank F2
      (↥(cyclicChildRootBoundaryShiftedSliceKernelSpanSubspace
        (n := n) (b := b) ds))
  let V : Nat :=
    Module.finrank F2 (CyclicNodeChildRootSliceFamily n b ds)
  let K : Nat :=
    Module.finrank F2
      (LinearMap.ker
        (cyclicChildRootBoundarySliceProjectionLinearMap
          (n := n) (b := b) ds))
  let R : Nat :=
    Fintype.card (RawNormal.RootFieldDomain n (RTree.node b ds))
  let C : Nat := Fintype.card (ZMod n)
  let X : Nat := Int.toNat (Xassign n (RTree.node b ds))
  have hS : S = V := by
    dsimp [S, V]
    rw [hspanTop]
    exact
      LinearEquiv.finrank_eq
        (Submodule.topEquiv :
          (↥(⊤ : Submodule F2 (CyclicNodeChildRootSliceFamily n b ds))) ≃ₗ[F2]
            CyclicNodeChildRootSliceFamily n b ds)
  have hKR : K + R = X := by
    simpa [K, R, X] using hbase
  have hmul : X * C = C * K + R * C := by
    calc
      X * C = (K + R) * C := by rw [← hKR]
      _ = K * C + R * C := by rw [Nat.add_mul]
      _ = C * K + R * C := by rw [Nat.mul_comm K C]
  change S + X * C = V + C * K + R * C
  rw [hS, hmul]
  omega

