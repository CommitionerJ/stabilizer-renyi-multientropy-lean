    (Equiv.sum_comp (Equiv.addRight (1 : ZMod n))
      (fun d : ZMod n => g d))

theorem cyclicPrevDiff_range_iff_sum_zero
    {n : Nat} [NeZero n] (M : Type)
    [AddCommGroup M] [Module F2 M] (g : ZMod n → M) :
    (∃ f : ZMod n → M, cyclicPrevDiff n M f = g) ↔
      (∑ d : ZMod n, g d) = 0 := by
  constructor
  · rintro ⟨f, rfl⟩
    exact cyclicPrevDiff_sum_zero M f
  · intro hsum
    have hshift :
        (∑ d : ZMod n,
          (zmodPredTimeLinearEquiv n M).symm g d) = 0 := by
      rw [zmodPredTimeLinearEquiv_symm_sum M g]
      exact hsum
    rcases
        (RawLinearAlgebra.cyclicDiff_range_iff_sum_zero M
          ((zmodPredTimeLinearEquiv n M).symm g)).2 hshift with
      ⟨f, hf⟩
    refine ⟨f, ?_⟩
    rw [cyclicPrevDiff_eq_predTime_comp_cyclicDiff]
    simp [hf]

theorem cyclicPrevDiff_fiber_nonempty_iff_sum_zero
    {n : Nat} [NeZero n] (M : Type)
    [AddCommGroup M] [Module F2 M] (g : ZMod n → M) :
    Nonempty { f : ZMod n → M // cyclicPrevDiff n M f = g } ↔
      (∑ d : ZMod n, g d) = 0 := by
  constructor
  · rintro ⟨⟨f, hf⟩⟩
    rw [← hf]
    exact cyclicPrevDiff_sum_zero M f
  · intro hsum
    rcases (cyclicPrevDiff_range_iff_sum_zero M g).2 hsum with
      ⟨f, hf⟩
    exact ⟨⟨f, hf⟩⟩

theorem card_cyclicPrevDiff_fiber_of_solution
    {n : Nat} [NeZero n] (M : Type)
    [AddCommGroup M] [Module F2 M] [FiniteDimensional F2 M]
    (g f0 : ZMod n → M) (hf0 : cyclicPrevDiff n M f0 = g) :
    Nat.card { f : ZMod n → M // cyclicPrevDiff n M f = g } =
      2 ^ Module.finrank F2 M := by
  calc
    Nat.card { f : ZMod n → M // cyclicPrevDiff n M f = g } =
        Nat.card (↥(LinearMap.ker (cyclicPrevDiff n M))) :=
      RawLinearAlgebra.card_linearMap_fiber_eq_card_ker_of_solution
        (cyclicPrevDiff n M) g f0 hf0
    _ = 2 ^ Module.finrank F2 M := card_ker_cyclicPrevDiff M

theorem card_cyclicPrevDiff_fiber_of_sum_zero
    {n : Nat} [NeZero n] (M : Type)
    [AddCommGroup M] [Module F2 M] [FiniteDimensional F2 M]
    (g : ZMod n → M) (hsum : (∑ d : ZMod n, g d) = 0) :
    Nat.card { f : ZMod n → M // cyclicPrevDiff n M f = g } =
