theorem cyclicPrevDiff_sum_zero
    {n : Nat} [NeZero n] (M : Type)
    [AddCommGroup M] [Module F2 M] (f : ZMod n → M) :
    (∑ d : ZMod n, cyclicPrevDiff n M f d) = 0 := by
  classical
  have hshift :
      (∑ d : ZMod n, f (d - 1)) = ∑ d : ZMod n, f d := by
    simpa [sub_eq_add_neg] using
      (Equiv.sum_comp (Equiv.addRight (-1 : ZMod n))
        (fun d : ZMod n => f d))
  calc
    (∑ d : ZMod n, cyclicPrevDiff n M f d) =
        ∑ d : ZMod n, (f d + f (d - 1)) := by rfl
    _ = (∑ d : ZMod n, f d) + ∑ d : ZMod n, f (d - 1) := by
      rw [Finset.sum_add_distrib]
    _ = (∑ d : ZMod n, f d) + ∑ d : ZMod n, f d := by
      rw [hshift]
    _ = 0 := by
      have htwo : (1 : F2) + (1 : F2) = 0 := by decide
      calc
        (∑ d : ZMod n, f d) + ∑ d : ZMod n, f d =
            (1 : F2) • (∑ d : ZMod n, f d) +
              (1 : F2) • (∑ d : ZMod n, f d) := by simp
        _ = ((1 : F2) + (1 : F2)) • (∑ d : ZMod n, f d) := by
          rw [add_smul]
        _ = 0 := by simp [htwo]

theorem zmodPredTimeLinearEquiv_symm_sum
    {n : Nat} [NeZero n] (M : Type)
    [AddCommGroup M] [Module F2 M] (g : ZMod n → M) :
    (∑ d : ZMod n, (zmodPredTimeLinearEquiv n M).symm g d) =
      ∑ d : ZMod n, g d := by
  classical
