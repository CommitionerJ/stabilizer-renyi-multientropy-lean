        (0 : ChildIdx [RTree.node b ds])) →
        ZMod n → RawNormal.NormalAssignment n (RTree.node b ds)) ≃
      (ZMod n → RawNormal.NormalAssignment n (RTree.node b ds)) where
  toFun A := A (singletonChildExternalBaseCoordinate n b ds)
  invFun B := fun _base => B
  left_inv A := by
    funext base d
    rw [singletonChildExternalBaseCoordinate_unique n b ds base]
  right_inv B := rfl

noncomputable def singletonChildExternalCoordinateEquivZMod
    (n b : Nat) [NeZero n] (ds : List RTree) :
    ChildExternalCoordinate n 1 [RTree.node b ds]
        (0 : ChildIdx [RTree.node b ds]) ≃
      ZMod n where
  toFun ext := ext.childRootDiagonal
  invFun d :=
    { rootCoord := fun j => Fin.elim0 j
      childRootDiagonal := d
      siblingCoord := fun p _j =>
        False.elim
          (p.2 (by
            apply Fin.ext
            simp)) }
  left_inv ext := by
    cases ext with
    | mk rootCoord childRootDiagonal siblingCoord =>
        rw [ChildExternalCoordinate.mk.injEq]
        constructor
        · funext j
          exact Fin.elim0 j
        constructor
        · rfl
        · funext p j
          exact
            False.elim
              (p.2 (by
                apply Fin.ext
                simp))
  right_inv d := rfl

