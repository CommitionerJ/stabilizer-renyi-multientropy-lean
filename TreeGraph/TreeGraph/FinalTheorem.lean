theorem localCombinatorialNodeExponent_eq_assignmentFactorProductExponent
    {n : Nat} [NeZero n] {a : Nat} {cs : List RTree}
    (hchildren : ∀ C ∈ cs, RawExpandedOpenRootSubtreeCert C) :
    localCombinatorialNodeExponent n a cs =
      assignmentFactorProductExponent n (RTree.node a cs) := by
  have hchildPos : ∀ C ∈ cs, RTree.PositiveWeights C := by
    intro C hC
    exact RawExpandedOpenRootSubtreeCert.positiveWeights
      (hchildren C hC)
  exact
    (localCombinatorialNodeExponent_eq_assignmentFactorProduct
      (n := n) (a := a) (cs := cs) hchildPos).trans
      (assignmentFactorProductExponent_node n a cs).symm

theorem rootFactorCard_mul_childInternalCopies_closed_localCombinatorial
    {n : Nat} [NeZero n] {a : Nat} {cs : List RTree}
    (hchildren : ∀ C ∈ cs, RawExpandedOpenRootSubtreeCert C) :
    ((Fintype.card (OpenRootMessageSpace n cs) : Nat) : ℤ) *
        RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopiesProduct
          n a cs 0 =
      (2 : ℤ) ^ Int.toNat (localCombinatorialNodeExponent n a cs) := by
  have hchildNonneg :
      0 ≤ childContribSumWith (Xassign n) n a cs 0 :=
    RawExpandedOpenRootSubtreeCert.childContribSumWith_nonneg_of_childCerts
      n a cs 0 hchildren
  have hchildClosed :=
    RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopiesProduct_closed_childContrib
      n a cs 0 hchildren
  rw [card_openRootMessageSpace, hchildClosed]
  have hlocalCast :
      (((independentBranchDimension n cs +
          Int.toNat (childContribSumWith (Xassign n) n a cs 0) : Nat) :
          ℤ)) =
        localCombinatorialNodeExponent n a cs := by
    unfold localCombinatorialNodeExponent
    rw [Nat.cast_add, Int.toNat_of_nonneg hchildNonneg]
  have hlocalNonneg :
      0 ≤ localCombinatorialNodeExponent n a cs := by
    rw [← hlocalCast]
    exact Int.natCast_nonneg _
  have hlocalToNat :
      Int.toNat (localCombinatorialNodeExponent n a cs) =
        independentBranchDimension n cs +
          Int.toNat (childContribSumWith (Xassign n) n a cs 0) := by
    have hcast :
        (((Int.toNat (localCombinatorialNodeExponent n a cs) : Nat) :
          ℤ)) =
          (((independentBranchDimension n cs +
            Int.toNat (childContribSumWith (Xassign n) n a cs 0) :
            Nat) : ℤ)) := by
      calc
        (((Int.toNat (localCombinatorialNodeExponent n a cs) : Nat) :
          ℤ))
            = localCombinatorialNodeExponent n a cs := by
              rw [Int.toNat_of_nonneg hlocalNonneg]
        _ =
          (((independentBranchDimension n cs +
            Int.toNat (childContribSumWith (Xassign n) n a cs 0) :
            Nat) : ℤ)) := hlocalCast.symm
    exact_mod_cast hcast
  change
    (2 : ℤ) ^ independentBranchDimension n cs *
        (2 : ℤ) ^
          Int.toNat (childContribSumWith (Xassign n) n a cs 0) =
      (2 : ℤ) ^ Int.toNat (localCombinatorialNodeExponent n a cs)
  rw [← pow_add, hlocalToNat]

