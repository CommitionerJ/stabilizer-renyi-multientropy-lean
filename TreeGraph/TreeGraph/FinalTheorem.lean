namespace ModelCertificate

theorem signedSum_closed_assignmentFactorProductExponent
    {T : RTree} (hT : ModelCertificate T)
    (n : Nat) [NeZero n] :
    RawNormal.signedSum n T =
      (2 : ℤ) ^ Int.toNat (assignmentFactorProductExponent n T) :=
  (hT.signedSum_eq_DeltaTreeModel n).trans
    (DeltaTreeModel_closed_assignmentFactorProductExponent
      (n := n) hT.positiveWeights)

theorem rawBitStringSignedSum_closed_assignmentFactorProductExponent
    {T : RTree} (hT : ModelCertificate T)
    (n : Nat) [NeZero n] :
    rawBitStringSignedSum n T =
      (2 : ℤ) ^ Int.toNat (assignmentFactorProductExponent n T) := by
  rw [rawBitStringSignedSum_eq_signedSum_of_positiveWeights
    (n := n) (T := T) hT.positiveWeights]
  exact hT.signedSum_closed_assignmentFactorProductExponent n

theorem normalFormSignedSum_closed_assignmentFactorProductExponent
    {T : RTree} (hT : ModelCertificate T)
    (n : Nat) [NeZero n] :
    normalFormSignedSum n T =
      (2 : ℤ) ^ Int.toNat (assignmentFactorProductExponent n T) := by
  rw [normalFormSignedSum_eq_signedSum_of_positiveWeights
    (n := n) (T := T) hT.positiveWeights]
  exact hT.signedSum_closed_assignmentFactorProductExponent n

theorem finalClosedFormulaFor
    {T : RTree} (hT : ModelCertificate T) :
    FinalClosedFormulaFor T where
  positiveWeights := hT.positiveWeights
  delta := by
    intro n _
    exact
      DeltaTreeModel_closed_assignmentFactorProductExponent
        (n := n) hT.positiveWeights
  signed := by
    intro n _
    exact hT.signedSum_closed_assignmentFactorProductExponent n
  raw := by
    intro n _
    exact hT.rawBitStringSignedSum_closed_assignmentFactorProductExponent n
  normal := by
    intro n _
    exact hT.normalFormSignedSum_closed_assignmentFactorProductExponent n

end ModelCertificate

