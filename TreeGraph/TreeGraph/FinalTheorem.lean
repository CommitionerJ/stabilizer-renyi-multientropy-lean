theorem nodeChildRootBranchFiberBoundaryMessageSum_eq_adjacentSliceProjection_single_of_odd_fiberCard
    {n b : Nat} [NeZero n] (ds : List RTree)
    (j : ChildIdx ds)
    (φ : RawNormal.NodeChildRootFieldDomain n b ds j → F2)
