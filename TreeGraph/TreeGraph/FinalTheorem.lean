    simp [i0]
  have hroot0 : 0 < (childAt [RTree.node b ds] i0).rootWeight := by
    simpa [i0, RTree.rootWeight] using hb
  have hchildCert :
      RawExpandedOpenRootSubtreeCert (childAt [RTree.node b ds] i0) := by
    simpa [i0] using hC
  have hcoordCard :
