theorem rootFactorKernelCard_cons_factorized_of_childCerts
    {n : Nat} [NeZero n] {C : RTree} {cs : List RTree}
    (_hC : RawExpandedOpenRootSubtreeCert C)
    (_hchildren : ∀ D ∈ cs, RawExpandedOpenRootSubtreeCert D) :
    Fintype.card (OpenRootMessageSpace n (C :: cs)) =
      (Fintype.card (OpenRootMessageSpace n cs)) ^ branchFactor n C :=
