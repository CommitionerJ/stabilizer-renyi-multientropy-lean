theorem rawExpandedEdgeNodeRule_of_positiveAssignmentFactorProductNodeRule
    (hfactor : PositiveAssignmentFactorProductNodeRule) :
    RawAssignmentExpandedEdgeNodeRule := by
  intro a cs ha hchildren n _
  have hphase :
      (∑ Araw :
        { Araw : RawAssignment n (RTree.node a cs) //
          RealizedByNormal (RTree.node a cs) Araw },
        bitSign
          (∑ site : RawNormal.NormalSite n (RTree.node a cs),
            ((RTree.edgeList (RTree.node a cs)).map
              (localEdgePhase Araw.1 site)).sum)) =
        (2 : ℤ) ^ Int.toNat
          ((((cs.map (fun C =>
            Int.toNat
              ((nZ n) ^ RTree.totalWeight C -
                (tZ n) * Yassign n C))).prod : Nat) : ℤ) +
            childContribSumWith (Xassign n) n a cs 0) := by
