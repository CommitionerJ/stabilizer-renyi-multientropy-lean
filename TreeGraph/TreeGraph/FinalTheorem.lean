      _ =
          2 ^
            Module.finrank F2
              (LinearMap.ker
                (childBoundaryCoefficientMap (n := n) (a := b) ds)) := by
            simp [F2]
  have hopen :
      Fintype.card (OpenRootMessageSpace n ds) =
        2 ^ independentBranchDimension n ds := by
    rw [← Nat.card_eq_fintype_card]
    exact natCard_openRootMessageSpace n ds
  have hpowers :
      2 ^
          Module.finrank F2
            (LinearMap.ker
              (childBoundaryCoefficientMap (n := n) (a := b) ds)) =
        2 ^ independentBranchDimension n ds :=
    hker.symm.trans (hcard.trans hopen)
  exact (Nat.pow_right_injective (by norm_num : 2 ≤ 2)) hpowers

