theorem tree_imbalance_raw_expanded_edge_sum_edge_closed
    {a b n : Nat} [NeZero n] (ha : 0 < a) (hb : 0 < b) :
    (∑ Araw :
      { Araw : RawAssignment n (RTree.node a [RTree.node b []]) //
        RealizedByNormal (RTree.node a [RTree.node b []]) Araw },
      bitSign
        (∑ site : RawNormal.NormalSite n (RTree.node a [RTree.node b []]),
          ((RTree.edgeList (RTree.node a [RTree.node b []])).map
            (fun e =>
              let ketAt (p : List Nat) : F2 :=
                if hp :
                    p ∈ RTree.addresses
                      (RTree.node a [RTree.node b []]) then
                  Araw.1.ket ⟨p, hp⟩ site
                else
                  0
              let braAt (p : List Nat) : F2 :=
                if hp :
                    p ∈ RTree.addresses
                      (RTree.node a [RTree.node b []]) then
                  Araw.1.bra ⟨p, hp⟩ site
                else
                  0
              ketAt e.1 * ketAt e.2 + braAt e.1 * braAt e.2)).sum)) =
      (2 : ℤ) ^ Int.toNat
        (assignmentFactorProductExponent n
          (RTree.node a [RTree.node b []])) := by
  classical
  have hT : RTree.PositiveWeights (RTree.node a [RTree.node b []]) := by
    simp [RTree.PositiveWeights, ha, hb]
  have hraw :
      rawBitStringSignedSum n (RTree.node a [RTree.node b []]) =
        (2 : ℤ) ^ Int.toNat
          (assignmentFactorProductExponent n
            (RTree.node a [RTree.node b []])) := by
    rw [rawBitStringSignedSum_eq_signedSum_of_positiveWeights
      (n := n) (T := RTree.node a [RTree.node b []]) hT]
    exact (signedSum_edge_eq_DeltaTreeModel
      (n := n) ha hb).trans
        (DeltaTreeModel_closed_assignmentFactorProductExponent
          (n := n) hT)
  have hlocal :
      (∑ Araw :
        { Araw : RawAssignment n (RTree.node a [RTree.node b []]) //
          RealizedByNormal (RTree.node a [RTree.node b []]) Araw },
        bitSign
          (∑ site : RawNormal.NormalSite n (RTree.node a [RTree.node b []]),
            ((RTree.edgeList (RTree.node a [RTree.node b []])).map
              (localEdgePhase Araw.1 site)).sum)) =
        (2 : ℤ) ^ Int.toNat
          (assignmentFactorProductExponent n
            (RTree.node a [RTree.node b []])) := by
    simpa [rawBitStringSignedSum, weight, totalPhase, phaseAtSite] using hraw
  exact
    (rawEdgePhaseSum_eq_expanded
      (n := n) (T := RTree.node a [RTree.node b []])).symm.trans hlocal

