theorem card_childExternalCoordinate_eq_pow
    {n a : Nat} [NeZero n] {cs : List RTree}
    (ha : 0 < a) (i : ChildIdx cs) :
    Fintype.card (ChildExternalCoordinate n a cs i) =
      n ^ childExternalCoordinateExponentAt a cs i := by
  classical
  have hprod :
      Fintype.card (ChildExternalCoordinate n a cs i) *
          Fintype.card (RawNormal.RootFieldDomain n (childAt cs i)) =
        n ^ childExternalCoordinateExponentAt a cs i *
          Fintype.card (RawNormal.RootFieldDomain n (childAt cs i)) := by
    have hcard :
        Fintype.card
            (ChildExternalCoordinate n a cs i ×
              RawNormal.RootFieldDomain n (childAt cs i)) =
          Fintype.card
            (Fin (n ^ childExternalCoordinateExponentAt a cs i) ×
              RawNormal.RootFieldDomain n (childAt cs i)) :=
      (card_nodeChildRootFieldDomain_eq_childExternal_mul_rootFieldDomain
          (n := n) (a := a) (cs := cs) i).symm.trans
        (card_nodeChildRootFieldDomain_eq_external_mul_rootFieldDomain
          (n := n) (a := a) (cs := cs) ha i)
    simpa [Fintype.card_prod] using hcard
  have hrootPos :
      0 < Fintype.card (RawNormal.RootFieldDomain n (childAt cs i)) :=
    Fintype.card_pos_iff.mpr ⟨fun _ _ => 0⟩
  exact Nat.eq_of_mul_eq_mul_right hrootPos hprod

