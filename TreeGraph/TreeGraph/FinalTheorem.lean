theorem childParentEmbeddedInternalWeight_eq_prod_base_cyclic_of_phase
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs)
    (hchildRoot : 0 < (childAt cs i).rootWeight)
    (Acyc :
