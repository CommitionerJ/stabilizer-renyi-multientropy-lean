theorem rootBoundarySelectedNodeChildRootFieldDomain_eq_iff
    {n b : Nat} [NeZero n] (ds : List RTree)
    (j : ChildIdx ds)
    (rootCoord : Fin (b - 1) → ZMod n)
    (rd : RawNormal.RootFieldDomain n (RTree.node b ds))
    (shift : ZMod n)
    (d : RawNormal.NodeChildRootFieldDomain n b ds j) :
    rootBoundarySelectedNodeChildRootFieldDomain
        (n := n) (b := b) ds j rootCoord rd shift = d ↔
      rootCoord = d.rootCoord ∧
        RawLinearAlgebra.diagSum
            (NonRootVertex.weight
              (RawNormal.childRootAtAsNonRootInNode (a := b) j))
            n
            (rd (RawNormal.childRootAtAsNonRootInNode (a := b) j)) +
          shift = d.diagonal ∧
        ∀ (u : RawNormal.OtherNonRootVertex (RTree.node b ds)
              (RawNormal.childRootAtAsNonRootInNode (a := b) j))
          (k : Fin (NonRootVertex.weight u.1)),
          rd u.1 k = d.otherCoord u k := by
  cases d
  unfold rootBoundarySelectedNodeChildRootFieldDomain
  rw [RawNormal.NonRootFieldDomain.mk.injEq]
  constructor
  · rintro ⟨hroot, hdiag, hother⟩
    refine ⟨hroot, hdiag, ?_⟩
    intro u k
    exact congrFun (congrFun hother u) k
  · rintro ⟨hroot, hdiag, hother⟩
    refine ⟨hroot, hdiag, ?_⟩
    funext u k
    exact hother u k

theorem pi_single_rootBoundarySelectedNodeChildRootFieldDomain_eq_if
    {n b : Nat} [NeZero n] (ds : List RTree)
    (j : ChildIdx ds)
    (rootCoord : Fin (b - 1) → ZMod n)
    (rd : RawNormal.RootFieldDomain n (RTree.node b ds))
    (shift : ZMod n)
    (d : RawNormal.NodeChildRootFieldDomain n b ds j) :
    Pi.single
        (M := fun _ : RawNormal.NodeChildRootFieldDomain n b ds j => F2)
        d (1 : F2)
        (rootBoundarySelectedNodeChildRootFieldDomain
          (n := n) (b := b) ds j rootCoord rd shift) =
      if rootCoord = d.rootCoord ∧
          RawLinearAlgebra.diagSum
              (NonRootVertex.weight
                (RawNormal.childRootAtAsNonRootInNode (a := b) j))
              n
              (rd (RawNormal.childRootAtAsNonRootInNode (a := b) j)) +
            shift = d.diagonal ∧
          ∀ (u : RawNormal.OtherNonRootVertex (RTree.node b ds)
                (RawNormal.childRootAtAsNonRootInNode (a := b) j))
            (k : Fin (NonRootVertex.weight u.1)),
            rd u.1 k = d.otherCoord u k
        then 1 else 0 := by
  by_cases hmatch :
      rootCoord = d.rootCoord ∧
        RawLinearAlgebra.diagSum
            (NonRootVertex.weight
              (RawNormal.childRootAtAsNonRootInNode (a := b) j))
            n
            (rd (RawNormal.childRootAtAsNonRootInNode (a := b) j)) +
          shift = d.diagonal ∧
        ∀ (u : RawNormal.OtherNonRootVertex (RTree.node b ds)
              (RawNormal.childRootAtAsNonRootInNode (a := b) j))
          (k : Fin (NonRootVertex.weight u.1)),
          rd u.1 k = d.otherCoord u k
  · rw [if_pos hmatch]
    have hsel :
        rootBoundarySelectedNodeChildRootFieldDomain
            (n := n) (b := b) ds j rootCoord rd shift = d :=
      (rootBoundarySelectedNodeChildRootFieldDomain_eq_iff
        (n := n) (b := b) ds j rootCoord rd shift d).2 hmatch
    rw [hsel]
    simp
  · rw [if_neg hmatch]
    have hsel_ne :
        rootBoundarySelectedNodeChildRootFieldDomain
            (n := n) (b := b) ds j rootCoord rd shift ≠ d := by
      intro hsel
      exact hmatch
        ((rootBoundarySelectedNodeChildRootFieldDomain_eq_iff
          (n := n) (b := b) ds j rootCoord rd shift d).1 hsel)
    simp [Pi.single_eq_of_ne hsel_ne]

theorem pi_single_rootBoundarySelectedNodeChildRootFieldDomain_eq_if_simplified
    {n b : Nat} [NeZero n] (ds : List RTree)
    (j : ChildIdx ds)
