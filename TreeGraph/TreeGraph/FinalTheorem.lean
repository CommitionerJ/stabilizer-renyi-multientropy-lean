    (nodeChildNormalSiteRecompose
      (n := n) (a := a) (cs := cs) i hchildRoot x).nonRootCoord
      (RawNormal.childRootAtAsNonRootInNode (a := a) i) j =
      ((fullCoordinateWithDiagonalEquivOfPos
        (childAt cs i).rootWeight n hchildRoot).symm
        (x.2.rootCoord, x.1.childRootDiagonal))
        (RawNormal.finCastEquivOfEq
          (RawNormal.childRootAtAsNonRootInNode_weight
            (a := a) i) j) := by
