      ∀ i : ChildIdx ds,
        ∃ c : Nat, 0 < c ∧ childAt ds i = RTree.node c [] := by
    intro i
    rcases hleaf i with ⟨c, hchild⟩
    have hchildCert : RawExpandedOpenRootSubtreeCert (childAt ds i) :=
      RawExpandedOpenRootSubtreeCert.childAt hC i
    have hleafCert : RawExpandedOpenRootSubtreeCert (RTree.node c []) := by
      simpa [hchild] using hchildCert
    exact ⟨c, RawExpandedOpenRootSubtreeCert.positiveRoot hleafCert, hchild⟩
  have hraw :
      rawExpandedEdgeSignedSum n (RTree.node b ds) =
        (2 : ℤ) ^ Int.toNat
          (assignmentFactorProductExponent n (RTree.node b ds)) := by
    have hopen :=
      RawExpandedOpenRootSubtreeCert.rawExpandedEdgeOpenRoot hC n
    have hpos : RTree.PositiveWeights (RTree.node b ds) :=
      RawExpandedOpenRootSubtreeCert.positiveWeights hC
    have hexp :
        openRootNodeExponent n b ds =
          assignmentFactorProductExponent n (RTree.node b ds) :=
      openRootNodeExponent_eq_assignmentFactorProductExponent_of_positiveWeights
        (n := n) (a := b) (cs := ds) hpos
    simpa [hexp] using hopen
  have hcard :
      Nat.card
          (LinearMap.ker
            (childBoundaryCoefficientMap (n := n) (a := b) ds)) =
        Fintype.card (OpenRootMessageSpace n ds) :=
    childBoundaryCoefficientKernelCard_of_leaf_children_and_rawExpandedClosed
      (n := n) (a := b) (cs := ds) hb hchildren hleafPos hraw
  have hker :
      Nat.card
          (LinearMap.ker
            (childBoundaryCoefficientMap (n := n) (a := b) ds)) =
        2 ^
          Module.finrank F2
            (LinearMap.ker
              (childBoundaryCoefficientMap (n := n) (a := b) ds)) := by
    calc
      Nat.card
          (LinearMap.ker
            (childBoundaryCoefficientMap (n := n) (a := b) ds)) =
          Nat.card F2 ^
            Module.finrank F2
              (LinearMap.ker
                (childBoundaryCoefficientMap (n := n) (a := b) ds)) := by
            exact Module.natCard_eq_pow_finrank
              (K := F2)
