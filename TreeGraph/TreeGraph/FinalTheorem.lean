    (a := a) (cs := cs) R i]
  rw [childLinearizedContributionSumAt_leaf_child_eq_if_boundary_zero
    (R := R) (i := i) hchild]
  by_cases hzero :
      childBoundaryLinearFormAt (n := n) (a := a) cs R i = 0
  · rw [if_pos hzero, hcard]
    rw [indicatorZ_of_pos (hzero_iff.mp hzero), mul_one]
  · rw [if_neg hzero]
    have hnot :
        ¬ ∃ M : OpenRootMessageSpace n cs,
          openRootMessageSpaceRootFieldEmbeddingOfNode n a cs M = R := by
      intro hM
      exact hzero (hzero_iff.mpr hM)
    rw [indicatorZ_of_neg hnot, mul_zero]

theorem childOpenRootFourierKernelCanonicalAt_leaf_child_of_boundary_character_closed
    {n a b : Nat} [NeZero n] {cs : List RTree}
    (R : RawNormal.NodeRootFieldAssignment n a cs)
    (i : ChildIdx cs)
    (hb : 0 < b)
    (hchild : childAt cs i = RTree.node b [])
