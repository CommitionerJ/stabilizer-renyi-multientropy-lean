theorem childBoundaryCoefficientKernelFinrank_of_leaf_children_and_openRootCert
    {n b : Nat} [NeZero n] (ds : List RTree)
    (hC : RawExpandedOpenRootSubtreeCert (RTree.node b ds))
    (hleaf :
      ∀ i : ChildIdx ds, ∃ c : Nat, childAt ds i = RTree.node c []) :
    Module.finrank F2
