      (CyclicNodeRootBoundaryDomain n b ds)
      (cyclicNodeRootBoundaryLinearFormProduct (n := n) (b := b) ds N)

theorem cyclicNodeRootBoundaryLinearForm_eq_zero_iff_forall_coefficient
    {n b : Nat} [NeZero n] (ds : List RTree)
    (N : ZMod n → RawNormal.NodeNonRootFieldAssignment n b ds) :
    cyclicNodeRootBoundaryLinearForm (n := n) (b := b) ds N = 0 ↔
      ∀ x : CyclicNodeRootBoundaryDomain n b ds,
        cyclicNodeRootBoundaryCoefficient (n := n) (b := b) ds N x = 0 :=
  (cyclicNodeRootBoundaryLinearForm_eq_zero_iff_coefficient
    (n := n) (b := b) ds N).trans
    (cyclicNodeRootBoundaryCoefficient_eq_zero_iff_forall
      (n := n) (b := b) ds N)

def castRootFieldAssignment
    {n : Nat} [NeZero n] {T U : RTree} (h : T = U)
    (R : RawNormal.RootFieldAssignment n T) :
    RawNormal.RootFieldAssignment n U :=
  match h with
  | rfl => R

def castNodeFieldAssignment
    {n : Nat} [NeZero n] {T U : RTree} (h : T = U)
    (N : RawNormal.NodeFieldAssignment n T) :
    RawNormal.NodeFieldAssignment n U :=
  match h with
  | rfl => N

noncomputable def castCyclicRootFieldFamilyEquiv
    {n : Nat} [NeZero n] {T U : RTree} (h : T = U) :
    (ZMod n → RawNormal.RootFieldAssignment n T) ≃
      (ZMod n → RawNormal.RootFieldAssignment n U) where
  toFun R := fun d => castRootFieldAssignment h (R d)
  invFun R := fun d => castRootFieldAssignment h.symm (R d)
  left_inv R := by
    cases h
    rfl
  right_inv R := by
    cases h
    rfl

noncomputable def castCyclicNodeFieldFamilyEquiv
    {n : Nat} [NeZero n] {T U : RTree} (h : T = U) :
    (ZMod n → RawNormal.NodeFieldAssignment n T) ≃
      (ZMod n → RawNormal.NodeFieldAssignment n U) where
  toFun N := fun d => castNodeFieldAssignment h (N d)
  invFun N := fun d => castNodeFieldAssignment h.symm (N d)
  left_inv N := by
    cases h
    rfl
  right_inv N := by
    cases h
    rfl

theorem cyclicBoundaryPhaseForEdges_eq_cast
    {n : Nat} [NeZero n] {T U : RTree}
    (h : T = U)
    (edges : List (List Nat × List Nat))
    (R : ZMod n → RawNormal.RootFieldAssignment n T)
    (N : ZMod n → RawNormal.NodeFieldAssignment n T) :
    cyclicBoundaryPhaseForEdges (n := n) (T := T) edges R N =
      cyclicBoundaryPhaseForEdges (n := n) (T := U) edges
        (fun d => castRootFieldAssignment h (R d))
        (fun d => castNodeFieldAssignment h (N d)) := by
  cases h
  simp [castRootFieldAssignment, castNodeFieldAssignment]

theorem edgeListFrom_singleton_left_ne_nil
    (start : Nat) (C : RTree) {e : List Nat × List Nat}
    (he : e ∈ RTree.edgeListFrom [start] C) :
    e.1 ≠ [] := by
  rw [RTree.edgeListFrom_eq_edgeList_map_prefix] at he
  rcases List.mem_map.mp he with ⟨e0, _he0, rfl⟩
  simp [RTree.prefixEdge]

theorem edgeListFrom_singleton_right_ne_nil
    (start : Nat) (C : RTree) {e : List Nat × List Nat}
    (he : e ∈ RTree.edgeListFrom [start] C) :
    e.2 ≠ [] := by
  rw [RTree.edgeListFrom_eq_edgeList_map_prefix] at he
  rcases List.mem_map.mp he with ⟨e0, _he0, rfl⟩
  simp [RTree.prefixEdge]

theorem indexedChildInternalEdgesFrom_nil_left_ne_nil
    (start : Nat) :
    ∀ (ds : List RTree) {e : List Nat × List Nat},
      e ∈ RTree.indexedChildInternalEdgesFrom [] start ds → e.1 ≠ []
  | [], _e, he => by
      simp at he
  | C :: rest, e, he => by
      simp [RTree.indexedChildInternalEdgesFrom] at he
      rcases he with he | he
      · exact edgeListFrom_singleton_left_ne_nil start C he
      · exact indexedChildInternalEdgesFrom_nil_left_ne_nil (start + 1)
          rest he

theorem indexedChildInternalEdgesFrom_nil_right_ne_nil
    (start : Nat) :
    ∀ (ds : List RTree) {e : List Nat × List Nat},
      e ∈ RTree.indexedChildInternalEdgesFrom [] start ds → e.2 ≠ []
  | [], _e, he => by
      simp at he
  | C :: rest, e, he => by
      simp [RTree.indexedChildInternalEdgesFrom] at he
      rcases he with he | he
      · exact edgeListFrom_singleton_right_ne_nil start C he
      · exact indexedChildInternalEdgesFrom_nil_right_ne_nil (start + 1)
          rest he

theorem cyclicTwistedKetAtPath_eq_of_ne_nil
    {n : Nat} [NeZero n] {T : RTree}
    (R R' : ZMod n → RawNormal.RootFieldAssignment n T)
    (N : ZMod n → RawNormal.NodeFieldAssignment n T)
    (d : ZMod n) (site : RawNormal.NormalSite n T)
    (p : List Nat) (hp : p ≠ []) :
    cyclicTwistedKetAtPath
        (fun d => { rootField := R d, nodeField := N d }) d site p =
      cyclicTwistedKetAtPath
        (fun d => { rootField := R' d, nodeField := N d }) d site p := by
  unfold cyclicTwistedKetAtPath
  by_cases hmem : p ∈ RTree.addresses T
  · simp [hmem, cyclicTwistedKetAtVertex, hp]
  · simp [hmem]

theorem cyclicTwistedBraAtPath_eq_of_ne_nil
    {n : Nat} [NeZero n] {T : RTree}
    (R R' : ZMod n → RawNormal.RootFieldAssignment n T)
