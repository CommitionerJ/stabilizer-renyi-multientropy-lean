        RawNormal.RootFieldDomain n (childAt cs i) :=
  fun d =>
    ({ rootCoord := d.rootCoord
       childRootDiagonal := d.diagonal
       siblingCoord := fun p j =>
        d.otherCoord (childSiblingVertexAsOtherRoot (a := a) i p)
          (by simpa using j) },
      fun v j =>
        d.otherCoord (childNonRootVertexAsOtherRoot (a := a) i v)
          (by simpa using j))

@[simp] theorem nodeChildRootFieldDomainDecompose_rootCoord
    {n a : Nat} [NeZero n] {cs : List RTree}
