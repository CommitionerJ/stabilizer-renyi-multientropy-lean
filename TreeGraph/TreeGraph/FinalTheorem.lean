theorem exists_mem_submodule_apply_eq_one_of_sup_ker_eq_top
    {V : Type} [AddCommGroup V] [Module F2 V]
    (L : V →ₗ[F2] F2) (S : Submodule F2 V)
    (hsup : S ⊔ LinearMap.ker L = ⊤)
    (hL : L ≠ 0) :
    ∃ v : V, v ∈ S ∧ L v = 1 := by
  rcases exists_apply_eq_one_of_linearMap_ne_zero L hL with
    ⟨x, hx⟩
  have hxmem : x ∈ S ⊔ LinearMap.ker L := by
    rw [hsup]
    exact Submodule.mem_top
  rcases Submodule.mem_sup.mp hxmem with ⟨s, hs, k, hk, hsum⟩
  refine ⟨s, hs, ?_⟩
  have happly := congrArg L hsum
  simpa [LinearMap.map_add, LinearMap.mem_ker.mp hk, hx] using happly

theorem add_self_eq_zero_of_module_F2
    {V : Type} [AddCommGroup V] [Module F2 V] (v : V) :
    v + v = 0 := by
  have htwo : (2 : F2) = 0 := by
    exact ZMod.natCast_self 2
  have h : (2 : F2) • v = (0 : V) := by
    rw [htwo]
    simp
  simpa [two_smul] using h

theorem submodule_span_singleton_sup_ker_eq_top_of_apply_eq_one
    {V : Type} [AddCommGroup V] [Module F2 V]
    (L : V →ₗ[F2] F2) {v : V} (hv : L v = 1) :
    Submodule.span F2 ({v} : Set V) ⊔ LinearMap.ker L = ⊤ := by
  ext x
  constructor
  · intro _hx
    exact Submodule.mem_top
  · intro _hx
    let s : V := (L x) • v
    let k : V := x + s
    have hv_mem : v ∈ Submodule.span F2 ({v} : Set V) :=
      Submodule.subset_span (by simp)
    have hs : s ∈ Submodule.span F2 ({v} : Set V) := by
      exact Submodule.smul_mem _ (L x) hv_mem
    have hk : k ∈ LinearMap.ker L := by
      apply LinearMap.mem_ker.mpr
      have hLs : L s = L x := by
        simp [s, hv]
      have hself : L x + L x = 0 :=
        add_self_eq_zero_of_module_F2 (L x)
      calc
        L k = L x + L s := by simp [k, LinearMap.map_add]
        _ = L x + L x := by rw [hLs]
        _ = 0 := hself
    refine Submodule.mem_sup.mpr ⟨s, hs, k, hk, ?_⟩
    have hself : s + s = 0 := add_self_eq_zero_of_module_F2 s
    calc
      s + k = s + (x + s) := rfl
      _ = x + (s + s) := by ac_rfl
      _ = x := by simp [hself]

theorem submodule_span_singleton_invariant_of_translate
    {V : Type} [AddCommGroup V] [Module F2 V]
    {K : V → ℤ} {v : V}
    (htranslate : ∀ x : V, K (x + v) = K x) :
    ∀ w : V, w ∈ Submodule.span F2 ({v} : Set V) →
      ∀ x : V, K (x + w) = K x := by
  intro w hw
  refine Submodule.span_induction (s := ({v} : Set V)) ?hmem ?hzero ?hadd ?hsmul hw
  · intro y hy x
    have hy_eq : y = v := by simpa using hy
    simpa [hy_eq] using htranslate x
  · intro x
    simp
  · intro y z _hy _hz hy_inv hz_inv x
    calc
      K (x + (y + z)) = K ((x + y) + z) := by
        congr 1
        ac_rfl
      _ = K (x + y) := hz_inv (x + y)
      _ = K x := hy_inv x
  · intro c y _hy hy_inv x
    by_cases hc : c = 0
    · rw [hc, zero_smul]
      simp
    · have hc1 : c = 1 := by
        fin_cases c
        · exact False.elim (hc rfl)
        · rfl
      rw [hc1, one_smul]
      exact hy_inv x

def ChildOpenRootInternalKernelInvariantSubmoduleAt
    (a : Nat) (cs : List RTree) (n : Nat) [NeZero n]
    (i : ChildIdx cs)
    (S :
      Submodule F2
        (RawNormal.NodeChildRootFieldDomain n a cs i → F2)) : Prop :=
  ∀ φ0 : RawNormal.NodeChildRootFieldDomain n a cs i → F2,
    φ0 ∈ S →
      ∀ φ : RawNormal.NodeChildRootFieldDomain n a cs i → F2,
        childOpenRootInternalKernelAt
            (n := n) (a := a) cs i (φ + φ0) =
          childOpenRootInternalKernelAt
            (n := n) (a := a) cs i φ

def ChildBoundaryLinearFormSeparatesSubmoduleAt
    (a : Nat) (cs : List RTree) (n : Nat) [NeZero n]
    (R : RawNormal.NodeRootFieldAssignment n a cs)
    (i : ChildIdx cs)
    (S :
      Submodule F2
        (RawNormal.NodeChildRootFieldDomain n a cs i → F2)) : Prop :=
  childBoundaryLinearFormAt (n := n) (a := a) cs R i ≠ 0 →
    ∃ φ0 : RawNormal.NodeChildRootFieldDomain n a cs i → F2,
      φ0 ∈ S ∧
        childBoundaryLinearFormAt (n := n) (a := a) cs R i φ0 = 1

def ChildBoundaryLinearFormSubmoduleSupKerAt
    (a : Nat) (cs : List RTree) (n : Nat) [NeZero n]
    (R : RawNormal.NodeRootFieldAssignment n a cs)
    (i : ChildIdx cs)
    (S :
      Submodule F2
        (RawNormal.NodeChildRootFieldDomain n a cs i → F2)) : Prop :=
  S ⊔
      LinearMap.ker
        (childBoundaryLinearFormAt (n := n) (a := a) cs R i) =
    ⊤

theorem childBoundaryLinearFormSeparatesSubmoduleAt_of_supKer
    {a : Nat} {cs : List RTree} {n : Nat} [NeZero n]
    (R : RawNormal.NodeRootFieldAssignment n a cs)
    (i : ChildIdx cs)
    (S :
      Submodule F2
        (RawNormal.NodeChildRootFieldDomain n a cs i → F2))
    (hsup :
      ChildBoundaryLinearFormSubmoduleSupKerAt a cs n R i S) :
    ChildBoundaryLinearFormSeparatesSubmoduleAt a cs n R i S := by
  intro hnonzero
  exact
    exists_mem_submodule_apply_eq_one_of_sup_ker_eq_top
      (childBoundaryLinearFormAt (n := n) (a := a) cs R i)
      S hsup hnonzero

theorem childOpenRootFourierKernelBoundaryWitnessShiftAt_of_invariantSubmodule
    {a : Nat} {cs : List RTree} {n : Nat} [NeZero n]
    (R : RawNormal.NodeRootFieldAssignment n a cs)
    (i : ChildIdx cs)
    (S :
      Submodule F2
        (RawNormal.NodeChildRootFieldDomain n a cs i → F2))
    (hinv :
      ChildOpenRootInternalKernelInvariantSubmoduleAt a cs n i S)
    (hsep :
      ChildBoundaryLinearFormSeparatesSubmoduleAt a cs n R i S) :
    ChildOpenRootFourierKernelBoundaryWitnessShiftAt a cs n R i := by
  intro hnonzero
  rcases hsep hnonzero with ⟨φ0, hφ0_mem, hφ0⟩
  exact ⟨φ0, hφ0, hinv φ0 hφ0_mem⟩

theorem childOpenRootFourierKernelBoundaryWitnessShiftAt_of_invariantSupKer
    {a : Nat} {cs : List RTree} {n : Nat} [NeZero n]
    (R : RawNormal.NodeRootFieldAssignment n a cs)
    (i : ChildIdx cs)
    (S :
      Submodule F2
        (RawNormal.NodeChildRootFieldDomain n a cs i → F2))
    (hinv :
      ChildOpenRootInternalKernelInvariantSubmoduleAt a cs n i S)
    (hsup :
      ChildBoundaryLinearFormSubmoduleSupKerAt a cs n R i S) :
    ChildOpenRootFourierKernelBoundaryWitnessShiftAt a cs n R i :=
  childOpenRootFourierKernelBoundaryWitnessShiftAt_of_invariantSubmodule
    (a := a) (cs := cs) (n := n) R i S hinv
    (childBoundaryLinearFormSeparatesSubmoduleAt_of_supKer
      (a := a) (cs := cs) (n := n) R i S hsup)

theorem childOpenRootFourierKernelBoundaryInvariantSupKerAt_of_witnessShift
    {a : Nat} {cs : List RTree} {n : Nat} [NeZero n]
    (R : RawNormal.NodeRootFieldAssignment n a cs)
    (i : ChildIdx cs)
    (hwitness :
      ChildOpenRootFourierKernelBoundaryWitnessShiftAt a cs n R i) :
    ∃ S :
      Submodule F2
        (RawNormal.NodeChildRootFieldDomain n a cs i → F2),
      ChildOpenRootInternalKernelInvariantSubmoduleAt a cs n i S ∧
        ChildBoundaryLinearFormSubmoduleSupKerAt a cs n R i S := by
  classical
  by_cases hzero :
      childBoundaryLinearFormAt (n := n) (a := a) cs R i = 0
  · refine ⟨⊥, ?_, ?_⟩
    · intro φ0 hφ0 φ
      have hφ0_zero : φ0 = 0 := by
        simpa using hφ0
      simp [hφ0_zero]
    · unfold ChildBoundaryLinearFormSubmoduleSupKerAt
      rw [hzero]
      simp
  · rcases hwitness hzero with ⟨φ0, hφ0, hshift⟩
    let S :
        Submodule F2
          (RawNormal.NodeChildRootFieldDomain n a cs i → F2) :=
      Submodule.span F2 ({φ0} :
        Set (RawNormal.NodeChildRootFieldDomain n a cs i → F2))
    refine ⟨S, ?_, ?_⟩
    · intro δ hδ φ
      exact
        submodule_span_singleton_invariant_of_translate
          (V := RawNormal.NodeChildRootFieldDomain n a cs i → F2)
          (K := fun ψ =>
            childOpenRootInternalKernelAt
              (n := n) (a := a) cs i ψ)
          (v := φ0) hshift δ hδ φ
    · unfold ChildBoundaryLinearFormSubmoduleSupKerAt
      exact
        submodule_span_singleton_sup_ker_eq_top_of_apply_eq_one
          (childBoundaryLinearFormAt (n := n) (a := a) cs R i) hφ0

