    have hdr := congrFun hd rd
    change cyclicChildRootBoundaryMap (n := n) (b := b) ds Φ d rd = 0
    rw [cyclicChildRootBoundaryMap_apply_eq_sliceProjection_twistedDiff]
    exact hdr

