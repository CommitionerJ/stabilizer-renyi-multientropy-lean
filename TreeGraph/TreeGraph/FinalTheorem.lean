structure RawExpandedEdgeCompleteFormalization : Prop where
  completeFormalization : CompleteFormalization
  rawAssignmentExpandedEdgeClosedFormula :
    RawAssignmentExpandedEdgeClosedFormula
  rawExpandedEdgeDeltaFormula : RawExpandedEdgeDeltaFormula
  globalRawExpandedEdgeSignedSumClosed :
    GlobalRawExpandedEdgeSignedSumClosed
  positiveLocalRawExpandedEdgeDeltaStepRule :
    PositiveLocalRawExpandedEdgeDeltaStepRule
  localRawExpandedEdgeDeltaStepRule : LocalRawExpandedEdgeDeltaStepRule
  openRootRawExpandedEdgeNodeStepRule : OpenRootRawExpandedEdgeNodeStepRule
  rawExpandedOpenRootSubtreeCert :
    ∀ {T : RTree}, RTree.PositiveWeights T →
      RawExpandedOpenRootSubtreeCert T
  pureRawExpandedOpenRootNodeStepRule :
    PureRawExpandedOpenRootNodeStepRule
  pureRawExpandedFactorNodeRule : PureRawExpandedFactorNodeRule
  pureRawExpandedFactorKernelAt :
    ∀ {a : Nat} {cs : List RTree} {n : Nat} [NeZero n],
      0 < a →
      (∀ C ∈ cs, RawExpandedOpenRootSubtreeCert C) →
      PureRawExpandedFactorKernelAt a cs n
  rawExpandedRecursiveDeltaNodeStepRule :
    RawExpandedRecursiveDeltaNodeStepRule
  rawExpandedRecursiveNodeStepRule : RawExpandedRecursiveNodeStepRule
  rawExpandedRecursiveAssignmentFactorNodeRule :
    RawExpandedRecursiveAssignmentFactorNodeRule
  rawExpandedEdgeSignedSum_delta :
    ∀ {T : RTree}, RTree.PositiveWeights T →
      ∀ (n : Nat) [NeZero n],
        rawExpandedEdgeSignedSum n T = DeltaTreeModel n T
  rawExpandedEdgeSignedSum_finalClosed :
    ∀ {T : RTree}, RTree.PositiveWeights T →
      ∀ (n : Nat) [NeZero n],
        rawExpandedEdgeSignedSum n T =
          (2 : ℤ) ^ Int.toNat (assignmentFactorProductExponent n T)

theorem rawExpandedEdgeCompleteFormalization_of_completeFormalization
    (h : CompleteFormalization) :
    RawExpandedEdgeCompleteFormalization where
  completeFormalization := h
  rawAssignmentExpandedEdgeClosedFormula :=
    (completeFormalization_iff_rawAssignmentExpandedEdgeClosedFormula.1 h)
  rawExpandedEdgeDeltaFormula :=
    (completeFormalization_iff_rawExpandedEdgeDeltaFormula.1 h)
  globalRawExpandedEdgeSignedSumClosed :=
    (completeFormalization_iff_globalRawExpandedEdgeSignedSumClosed.1
      h)
  positiveLocalRawExpandedEdgeDeltaStepRule :=
    (completeFormalization_iff_positiveLocalRawExpandedEdgeDeltaStepRule.1 h)
  localRawExpandedEdgeDeltaStepRule :=
    (completeFormalization_iff_localRawExpandedEdgeDeltaStepRule.1 h)
  openRootRawExpandedEdgeNodeStepRule :=
    (completeFormalization_iff_openRootRawExpandedEdgeNodeStepRule.1 h)
  rawExpandedOpenRootSubtreeCert :=
    (completeFormalization_iff_forall_pureSubtreeCert.1 h)
  pureRawExpandedOpenRootNodeStepRule :=
    (completeFormalization_iff_pureNodeStepRule.1 h)
  pureRawExpandedFactorNodeRule :=
    (completeFormalization_iff_pureFactorNodeRule.1 h)
  pureRawExpandedFactorKernelAt :=
    (completeFormalization_iff_forall_factorKernelAt.1 h)
  rawExpandedRecursiveDeltaNodeStepRule :=
    (completeFormalization_iff_rawExpandedRecursiveDeltaNodeStepRule.1 h)
  rawExpandedRecursiveNodeStepRule :=
    (completeFormalization_iff_rawExpandedRecursiveNodeStepRule.1 h)
  rawExpandedRecursiveAssignmentFactorNodeRule :=
    (completeFormalization_iff_rawExpandedRecursiveFactorNodeRule.1 h)
  rawExpandedEdgeSignedSum_delta := by
    intro T hT n _
    exact (completeFormalization_iff_rawExpandedEdgeDeltaFormula.1 h)
      hT n
  rawExpandedEdgeSignedSum_finalClosed := by
    intro T hT n _
    exact
      ((completeFormalization_iff_rawExpandedEdgeDeltaFormula.1 h)
        hT n).trans
        (DeltaTreeModel_closed_assignmentFactorProductExponent
          (n := n) hT)

