theorem ker_sup_ker_comp_linearEquiv_eq_top_iff_range_comp_symm_restrictKer
    {V W : Type} [AddCommGroup V] [Module F2 V]
    [AddCommGroup W] [Module F2 W]
    (L : V →ₗ[F2] W) (S : V ≃ₗ[F2] V) :
    LinearMap.ker L ⊔ LinearMap.ker (L.comp S.toLinearMap) = ⊤ ↔
      LinearMap.range (linearMapCompSymmRestrictKer L S) =
        LinearMap.range L := by
  constructor
  · intro hsup
    apply le_antisymm
    · rintro y ⟨k, rfl⟩
      exact ⟨S.symm k.1, rfl⟩
    · rintro y ⟨v, rfl⟩
      have hvtop :
          v ∈ LinearMap.ker L ⊔ LinearMap.ker (L.comp S.toLinearMap) := by
        rw [hsup]
        exact Submodule.mem_top
      rcases Submodule.mem_sup.mp hvtop with ⟨u, hu, w, hw, hsum⟩
      refine ⟨⟨S w, ?_⟩, ?_⟩
      · apply LinearMap.mem_ker.mpr
        simpa [LinearMap.comp_apply] using LinearMap.mem_ker.mp hw
      · have huv : L v = L w := by
          rw [← hsum, LinearMap.map_add, LinearMap.mem_ker.mp hu, zero_add]
        change L (S.symm (S w)) = L v
        simpa using huv.symm
  · intro hrange
    apply le_antisymm
    · exact le_top
    · intro v _hv
      have hv :
          L v ∈ LinearMap.range (linearMapCompSymmRestrictKer L S) := by
        rw [hrange]
        exact ⟨v, rfl⟩
      rcases hv with ⟨k, hk⟩
      refine Submodule.mem_sup.mpr ?_
      refine ⟨v + S.symm k.1, ?_, S.symm k.1, ?_, ?_⟩
      · apply LinearMap.mem_ker.mpr
        have hk' : L (S.symm k.1) = L v := by
          simpa [linearMapCompSymmRestrictKer] using hk
        calc
          L (v + S.symm k.1) = L v + L (S.symm k.1) := by
            rw [LinearMap.map_add]
          _ = L v + L v := by rw [hk']
          _ = 0 := add_self_eq_zero_of_module_F2 (L v)
      · apply LinearMap.mem_ker.mpr
        change L (S (S.symm k.1)) = 0
        simpa using LinearMap.mem_ker.mp k.2
      · have hself :
            S.symm k.1 + S.symm k.1 = 0 :=
          add_self_eq_zero_of_module_F2 (S.symm k.1)
        calc
          (v + S.symm k.1) + S.symm k.1 =
              v + (S.symm k.1 + S.symm k.1) := by
            ac_rfl
          _ = v := by simp [hself]

