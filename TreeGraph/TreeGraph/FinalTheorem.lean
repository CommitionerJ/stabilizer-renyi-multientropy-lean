theorem natCard_ker_childBoundaryCoefficientMap_singleton_rootDimension
    {n a : Nat} [NeZero n] (C : RTree)
    (hroot : 0 < RTree.rootWeight C) :
    Nat.card
        (LinearMap.ker
          (childBoundaryCoefficientMap (n := n) (a := a) [C])) =
