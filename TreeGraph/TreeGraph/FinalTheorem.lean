noncomputable def subtypeEmbeddingRangeEquiv
    {α β : Type} (e : α ↪ β) :
    α ≃ { b : β // ∃ a : α, e a = b } where
  toFun a := ⟨e a, ⟨a, rfl⟩⟩
  invFun b := Classical.choose b.2
  left_inv a := by
    apply e.injective
    exact Classical.choose_spec
      (show ∃ x : α, e x = e a from ⟨a, rfl⟩)
  right_inv b := by
    apply Subtype.ext
    exact Classical.choose_spec b.2

theorem card_subtype_embeddingRange
    {α β : Type} [Fintype α] [Fintype β] [DecidableEq β]
    (e : α ↪ β) :
    Fintype.card { b : β // ∃ a : α, e a = b } =
      Fintype.card α :=
  (Fintype.card_congr (subtypeEmbeddingRangeEquiv e)).symm

noncomputable def subtypeForallConstEquiv
    {α ι : Type} [Nonempty ι] (P : α → Prop) :
    { x : α // ∀ _ : ι, P x } ≃ { x : α // P x } where
  toFun x := ⟨x.1, x.2 (Classical.choice inferInstance)⟩
  invFun x := ⟨x.1, fun _ => x.2⟩
  left_inv x := by
    apply Subtype.ext
    rfl
  right_inv x := by
    apply Subtype.ext
    rfl

theorem card_subtype_forall_const
    {α ι : Type} [Fintype α] [Nonempty ι] (P : α → Prop)
    [∀ x, Decidable (P x)] [∀ x, Decidable (∀ _ : ι, P x)] :
    Fintype.card { x : α // ∀ _ : ι, P x } =
      Fintype.card { x : α // P x } :=
  Fintype.card_congr (subtypeForallConstEquiv (α := α) (ι := ι) P)

noncomputable def embeddingOfCardLE
    {α β : Type} [Fintype α] [Fintype β]
    (hcard : Fintype.card α ≤ Fintype.card β) :
    α ↪ β :=
  let eα : α ≃ Fin (Fintype.card α) :=
    Fintype.equivFinOfCardEq rfl
  let eβ : β ≃ Fin (Fintype.card β) :=
    Fintype.equivFinOfCardEq rfl
  { toFun := fun a => eβ.symm (Fin.castLE hcard (eα a))
    inj' := by
      intro x y hxy
      apply eα.injective
      have hfin :
          Fin.castLE hcard (eα x) =
            Fin.castLE hcard (eα y) :=
        eβ.symm.injective hxy
      exact Fin.castLE_injective hcard hfin }

noncomputable def functionSpaceEmbeddingOfDomainEmbedding
    {ι δ κ : Type} [Inhabited κ]
    (e : ι ↪ δ) :
    (ι → κ) ↪ (δ → κ) := by
  classical
  exact
    { toFun := fun f d =>
        if h : ∃ i : ι, e i = d then
          f (Classical.choose h)
        else
          default
      inj' := by
        intro f g hfg
        funext i
        have hi : ∃ j : ι, e j = e i := ⟨i, rfl⟩
        have hchoose : Classical.choose hi = i :=
          e.injective (Classical.choose_spec hi)
        have hpoint := congrFun hfg (e i)
        change
          (if h : ∃ j : ι, e j = e i then
            f (Classical.choose h)
          else
            default) =
          (if h : ∃ j : ι, e j = e i then
            g (Classical.choose h)
          else
            default) at hpoint
        rw [dif_pos hi, dif_pos hi] at hpoint
        simpa [hchoose] using hpoint }

noncomputable def functionSpaceEmbeddingOfDomainCardLE
    {ι δ κ : Type} [Fintype ι] [Fintype δ]
    [Inhabited κ]
    (hcard : Fintype.card ι ≤ Fintype.card δ) :
    (ι → κ) ↪ (δ → κ) :=
  functionSpaceEmbeddingOfDomainEmbedding (embeddingOfCardLE hcard)

noncomputable def openRootMessageSpaceRootFieldEmbeddingOfDomainEmbedding
    {a n : Nat} [NeZero n] {cs : List RTree}
    (e :
      BranchIndex n cs ↪
        RawNormal.RootFieldDomain n (RTree.node a cs)) :
    OpenRootMessageSpace n cs ↪
      RawNormal.NodeRootFieldAssignment n a cs :=
  functionSpaceEmbeddingOfDomainEmbedding (κ := F2) e

noncomputable def openRootMessageSpaceRootFieldEmbeddingOfDomainCardLE
    {a n : Nat} [NeZero n] {cs : List RTree}
    (hcard :
      Fintype.card (BranchIndex n cs) ≤
        Fintype.card
          (RawNormal.RootFieldDomain n (RTree.node a cs))) :
    OpenRootMessageSpace n cs ↪
      RawNormal.NodeRootFieldAssignment n a cs :=
  functionSpaceEmbeddingOfDomainCardLE (κ := F2) hcard

theorem sum_childIdx_totalWeight (cs : List RTree) :
    (∑ i : ChildIdx cs, RTree.totalWeight (childAt cs i)) =
      (cs.map RTree.totalWeight).sum := by
  induction cs with
  | nil =>
      simp [ChildIdx]
  | cons C rest ih =>
      simp only [ChildIdx, childAt, List.get_eq_getElem, List.length_cons,
        List.map_cons, List.sum_cons]
      change
        (∑ x : Fin (rest.length + 1),
          RTree.totalWeight ((C :: rest).get x)) =
        RTree.totalWeight C + (List.map RTree.totalWeight rest).sum
      rw [Fin.sum_univ_succ]
      simp [List.get_eq_getElem]

abbrev VertexCoordinate (T : RTree) :=
  Sigma fun v : Vertex T => Fin (Vertex.weight v)

abbrev VertexFieldDomain (n : Nat) [NeZero n] (T : RTree) :=
  VertexCoordinate T → ZMod n

abbrev ChildVertexFieldDomainFamily
    (n : Nat) [NeZero n] (cs : List RTree) :=
  (i : ChildIdx cs) → VertexFieldDomain n (childAt cs i)

noncomputable def childVertexFieldDomainFamilyConsEquiv
    (n : Nat) [NeZero n] (C : RTree) (cs : List RTree) :
    ChildVertexFieldDomainFamily n (C :: cs) ≃
      VertexFieldDomain n C × ChildVertexFieldDomainFamily n cs where
  toFun F :=
    (by
      simpa [ChildVertexFieldDomainFamily] using
        F (0 : ChildIdx (C :: cs)),
     fun i =>
      by
        simpa [ChildVertexFieldDomainFamily] using
          F i.succ)
  invFun p := fun i =>
    Fin.cases
      (motive := fun i : ChildIdx (C :: cs) =>
        VertexFieldDomain n (childAt (C :: cs) i))
      (by
        simpa [ChildVertexFieldDomainFamily] using p.1)
      (fun i =>
        by
          simpa [ChildVertexFieldDomainFamily] using p.2 i)
      i
  left_inv F := by
    funext i x
    cases i using Fin.cases with
    | zero =>
        exact rfl
    | succ i =>
        simp [ChildVertexFieldDomainFamily, childAt]
  right_inv p := by
    cases p with
    | mk first rest =>
        apply Prod.ext
        · funext x
          exact rfl
        · funext i x
          simp [ChildVertexFieldDomainFamily, childAt]

@[simp] theorem childVertexFieldDomainFamilyConsEquiv_apply_fst
    {n : Nat} [NeZero n] (C : RTree) (cs : List RTree)
    (F : ChildVertexFieldDomainFamily n (C :: cs)) :
    (childVertexFieldDomainFamilyConsEquiv n C cs F).1 =
      F (0 : ChildIdx (C :: cs)) := by
  rfl

@[simp] theorem childVertexFieldDomainFamilyConsEquiv_apply_snd
    {n : Nat} [NeZero n] (C : RTree) (cs : List RTree)
    (F : ChildVertexFieldDomainFamily n (C :: cs))
    (i : ChildIdx cs) :
    (childVertexFieldDomainFamilyConsEquiv n C cs F).2 i =
      F i.succ := by
  rfl

@[simp] theorem childVertexFieldDomainFamilyConsEquiv_symm_zero
    {n : Nat} [NeZero n] (C : RTree) (cs : List RTree)
    (p : VertexFieldDomain n C × ChildVertexFieldDomainFamily n cs) :
    (childVertexFieldDomainFamilyConsEquiv n C cs).symm p
        (0 : ChildIdx (C :: cs)) =
      p.1 := by
  funext x
  rfl

@[simp] theorem childVertexFieldDomainFamilyConsEquiv_symm_succ
    {n : Nat} [NeZero n] (C : RTree) (cs : List RTree)
    (p : VertexFieldDomain n C × ChildVertexFieldDomainFamily n cs)
    (i : ChildIdx cs) :
    (childVertexFieldDomainFamilyConsEquiv n C cs).symm p i.succ =
      p.2 i := by
  funext x
  rfl

noncomputable def childVertexFieldDomainFamilySingletonEquiv
    (n : Nat) [NeZero n] (C : RTree) :
    ChildVertexFieldDomainFamily n [C] ≃ VertexFieldDomain n C where
  toFun F :=
    by
      simpa [ChildVertexFieldDomainFamily] using
        F (0 : ChildIdx [C])
  invFun f := fun i =>
    Fin.cases
      (motive := fun i : ChildIdx [C] =>
        VertexFieldDomain n (childAt [C] i))
      (by
        simpa [ChildVertexFieldDomainFamily] using f)
      (fun i => Fin.elim0 i)
      i
  left_inv F := by
    funext i x
    cases i using Fin.cases with
    | zero =>
        exact rfl
    | succ i =>
        exact Fin.elim0 i
  right_inv f := by
    funext x
    exact rfl

@[simp] theorem childVertexFieldDomainFamilySingletonEquiv_apply
    {n : Nat} [NeZero n] (C : RTree)
    (F : ChildVertexFieldDomainFamily n [C]) :
    childVertexFieldDomainFamilySingletonEquiv n C F =
      F (0 : ChildIdx [C]) := by
  rfl

@[simp] theorem childVertexFieldDomainFamilySingletonEquiv_symm_apply
    {n : Nat} [NeZero n] (C : RTree)
    (f : VertexFieldDomain n C) :
    (childVertexFieldDomainFamilySingletonEquiv n C).symm f
        (0 : ChildIdx [C]) =
      f := by
  funext x
  rfl

abbrev RootFieldCoordinate (T : RTree) :=
  Sigma fun v : NonRootVertex T => Fin (NonRootVertex.weight v)

private theorem nonRootVertex_eq_of_addr_eq {T : RTree}
    {u v : NonRootVertex T} (h : u.1.1 = v.1.1) : u = v := by
  apply Subtype.ext
  apply Subtype.ext
  exact h

theorem card_rootFieldCoordinate_eq_weight_add_sum_other
    (T : RTree) (v : NonRootVertex T) :
    Fintype.card (RootFieldCoordinate T) =
      NonRootVertex.weight v +
        ∑ u : RawNormal.OtherNonRootVertex T v,
          NonRootVertex.weight u.1 := by
  classical
  change
    Fintype.card
        (Sigma fun w : NonRootVertex T => Fin (NonRootVertex.weight w)) =
      _
  rw [Fintype.card_sigma]
  simp only [Fintype.card_fin]
  have hsplit :
      (∑ w : NonRootVertex T, NonRootVertex.weight w) =
        NonRootVertex.weight v +
          (∑ w ∈ ((Finset.univ : Finset (NonRootVertex T)) \ {v}),
            NonRootVertex.weight w) := by
    simpa using
      (Finset.sum_eq_add_sum_diff_singleton
        (s := (Finset.univ : Finset (NonRootVertex T)))
        (i := v) (f := fun w => NonRootVertex.weight w)
        (by simp))
  rw [hsplit]
  congr 1
  exact
    Finset.sum_subtype
      (s := ((Finset.univ : Finset (NonRootVertex T)) \ {v}))
      (p := fun w : NonRootVertex T => w.1.1 ≠ v.1.1)
      (f := fun w : NonRootVertex T => NonRootVertex.weight w)
      (by
        intro w
        constructor
        · intro hw
          have hne : w ≠ v := by
            intro hwv
            exact (Finset.mem_sdiff.mp hw).2 (by simp [hwv])
          intro haddr
          exact hne (nonRootVertex_eq_of_addr_eq haddr)
        · intro haddr
          exact Finset.mem_sdiff.mpr ⟨by simp, by
            intro hwv_mem
            simp only [Finset.mem_singleton] at hwv_mem
            exact haddr
              (congrArg (fun x : NonRootVertex T => x.1.1) hwv_mem)⟩)

theorem nonRootContextExponent_add_one_add_weight_eq_root_add_card_rootFieldCoordinate
    (T : RTree) (v : NonRootVertex T) (hroot : 0 < T.rootWeight) :
    nonRootContextExponent T v + 1 + NonRootVertex.weight v =
      T.rootWeight + Fintype.card (RootFieldCoordinate T) := by
  rw [nonRootContextExponent]
  rw [card_rootFieldCoordinate_eq_weight_add_sum_other T v]
  have hsub : T.rootWeight - 1 + 1 = T.rootWeight :=
    Nat.sub_add_cancel hroot
  omega

noncomputable def rootFieldDomainSigmaEquiv
    (n : Nat) [NeZero n] (T : RTree) :
    RawNormal.RootFieldDomain n T ≃
      (RootFieldCoordinate T → ZMod n) where
  toFun f x := f x.1 x.2
  invFun g v j := g ⟨v, j⟩
  left_inv f := by
    funext v j
    rfl
  right_inv g := by
    funext x
    cases x
    rfl

theorem rootFieldDomain_apply_heq
    {n : Nat} [NeZero n] {T : RTree}
    (rd : RawNormal.RootFieldDomain n T)
    {u v : NonRootVertex T} (huv : u = v)
    {j : Fin (NonRootVertex.weight u)}
    {k : Fin (NonRootVertex.weight v)}
    (hjk : j ≍ k) :
    rd u j = rd v k := by
  subst v
  exact congrArg (rd u) (eq_of_heq hjk)

theorem card_rootFieldDomain_eq_pow_card_rootFieldCoordinate
    (n : Nat) [NeZero n] (T : RTree) :
    Fintype.card (RawNormal.RootFieldDomain n T) =
      n ^ Fintype.card (RootFieldCoordinate T) := by
  classical
  calc
    Fintype.card (RawNormal.RootFieldDomain n T) =
        Fintype.card (RootFieldCoordinate T → ZMod n) := by
          exact Fintype.card_congr (rootFieldDomainSigmaEquiv n T)
    _ = n ^ Fintype.card (RootFieldCoordinate T) := by
      rw [Fintype.card_fun, ZMod.card]

theorem card_vertexCoordinate_eq_root_add_rootFieldCoordinate
    (T : RTree) :
    Fintype.card (VertexCoordinate T) =
      T.rootWeight + Fintype.card (RootFieldCoordinate T) := by
  classical
  let e := (RawNormal.vertexEquivRootOrNonRoot T).symm
  have hcard :
      Fintype.card (VertexCoordinate T) =
        Fintype.card
          (Sigma fun x : RawNormal.VertexRootOrNonRoot T =>
            Fin (Vertex.weight (e x))) := by
    exact
      (Fintype.card_congr
        (Equiv.sigmaCongrLeft
          (β := fun v : Vertex T => Fin (Vertex.weight v)) e)).symm
  rw [hcard]
  rw [Fintype.card_sigma]
  change
    (∑ x : Unit ⊕ NonRootVertex T,
      Fintype.card (Fin (Vertex.weight (e x)))) = _
  simp only [Fintype.card_fin]
  simp [e, RawNormal.vertexEquivRootOrNonRoot, Vertex.root, Vertex.weight,
    RootFieldCoordinate]
  simp [NonRootVertex.weight, Vertex.weight]

theorem childVertexAtAsNonRootInNode_weight
    {a : Nat} {cs : List RTree}
    (p : RawNormal.NodeChildVertex cs) :
    NonRootVertex.weight
        (RawNormal.childVertexAtAsNonRootInNode (a := a) p) =
      Vertex.weight p.2 := by
  change
    Vertex.weight (RawNormal.childVertexAtInNode (a := a) p.1 p.2) =
      Vertex.weight p.2
  exact RawNormal.childVertexAtInNode_weight (a := a) p.1 p.2

theorem nonRootVertexNodeEquivChildVertex_weight
    {a : Nat} {cs : List RTree}
    (v : NonRootVertex (RTree.node a cs)) :
    NonRootVertex.weight v =
      Vertex.weight
        ((RawNormal.nonRootVertexNodeEquivChildVertex a cs v).2) := by
  let p := RawNormal.nonRootVertexNodeEquivChildVertex a cs v
  have hp :
      v.1 = RawNormal.childVertexAtInNode (a := a) p.1 p.2 := by
    simpa [RawNormal.nonRootVertexNodeEquivChildVertex, p] using
      Classical.choose_spec
        (RawNormal.nonRootVertex_node_exists_nodeChildVertex
          (a := a) (cs := cs) v)
  change Vertex.weight v.1 = Vertex.weight p.2
  rw [hp]
  exact RawNormal.childVertexAtInNode_weight (a := a) p.1 p.2

abbrev NodeChildVertexCoordinate (cs : List RTree) :=
  Sigma fun p : RawNormal.NodeChildVertex cs => Fin (Vertex.weight p.2)

noncomputable def nodeChildVertexCoordinateSigmaEquiv
    (cs : List RTree) :
    NodeChildVertexCoordinate cs ≃
      Sigma fun i : ChildIdx cs => VertexCoordinate (childAt cs i) where
  toFun x := ⟨x.1.1, ⟨x.1.2, x.2⟩⟩
  invFun x := ⟨⟨x.1, x.2.1⟩, x.2.2⟩
  left_inv x := by
    cases x with
    | mk p j =>
        cases p
        rfl
  right_inv x := by
    cases x with
    | mk i y =>
        cases y
        rfl

@[simp] theorem nodeChildVertexCoordinateSigmaEquiv_symm_apply
    {cs : List RTree} (i : ChildIdx cs)
    (x : VertexCoordinate (childAt cs i)) :
    (nodeChildVertexCoordinateSigmaEquiv cs).symm ⟨i, x⟩ =
      (⟨⟨i, x.1⟩, x.2⟩ : NodeChildVertexCoordinate cs) := rfl

theorem finCast_heq {m k : Nat} (h : m = k) (j : Fin m) :
    Fin.cast h j ≍ j := by
  cases h
  rfl

theorem card_nodeChildVertexCoordinate_eq_sum_vertexCoordinate
    (cs : List RTree) :
    Fintype.card (NodeChildVertexCoordinate cs) =
      ∑ i : ChildIdx cs,
        Fintype.card (VertexCoordinate (childAt cs i)) := by
  classical
  change
    Fintype.card
        (Sigma fun p : RawNormal.NodeChildVertex cs =>
          Fin (Vertex.weight p.2)) = _
  rw [Fintype.card_sigma]
  simp only [Fintype.card_fin]
  change
    (∑ p : Sigma fun i : ChildIdx cs => Vertex (childAt cs i),
      Vertex.weight p.2) = _
  conv_rhs =>
    congr
    · skip
    · simp [VertexCoordinate, Fintype.card_sigma]
  rw [← Finset.sum_sigma Finset.univ
    (fun i : ChildIdx cs => Finset.univ)
    (fun p : Sigma fun i : ChildIdx cs => Vertex (childAt cs i) =>
      Vertex.weight p.2)]
  simp

noncomputable def rootFieldCoordinateNodeEquivChildVertexCoordinate
    (a : Nat) (cs : List RTree) :
    RootFieldCoordinate (RTree.node a cs) ≃
      NodeChildVertexCoordinate cs :=
  (Equiv.sigmaCongrRight (fun v =>
      finCongr (nonRootVertexNodeEquivChildVertex_weight
        (a := a) (cs := cs) v))).trans
    (Equiv.sigmaCongrLeft
      (β := fun p : RawNormal.NodeChildVertex cs => Fin (Vertex.weight p.2))
      (RawNormal.nonRootVertexNodeEquivChildVertex a cs))

@[simp] theorem rootFieldCoordinateNodeEquivChildVertexCoordinate_symm_childVertex
    {a : Nat} {cs : List RTree}
    (i : ChildIdx cs) (x : VertexCoordinate (childAt cs i)) :
    (rootFieldCoordinateNodeEquivChildVertexCoordinate a cs).symm
        (⟨⟨i, x.1⟩, x.2⟩ : NodeChildVertexCoordinate cs) =
      (⟨RawNormal.childVertexAtAsNonRootInNode (a := a)
            (⟨i, x.1⟩ : RawNormal.NodeChildVertex cs),
          by simpa [childVertexAtAsNonRootInNode_weight] using x.2⟩ :
        RootFieldCoordinate (RTree.node a cs)) := by
  cases x with
  | mk v j =>
      apply (rootFieldCoordinateNodeEquivChildVertexCoordinate a cs).injective
      simp [rootFieldCoordinateNodeEquivChildVertexCoordinate]
      constructor
      · exact
          ((RawNormal.nonRootVertexNodeEquivChildVertex a cs).right_inv
            (⟨i, v⟩ : RawNormal.NodeChildVertex cs)).symm
      · exact ((finCast_heq _ _).trans (cast_heq _ _)).symm

noncomputable def nodeRootFieldDomainChildPiEquiv
    (n : Nat) [NeZero n] (a : Nat) (cs : List RTree) :
    RawNormal.RootFieldDomain n (RTree.node a cs) ≃
      ((i : ChildIdx cs) →
        VertexCoordinate (childAt cs i) → ZMod n) :=
  (rootFieldDomainSigmaEquiv n (RTree.node a cs)).trans
    ((functionDomainEquiv (M := ZMod n)
        (rootFieldCoordinateNodeEquivChildVertexCoordinate a cs)).trans
      ((functionDomainEquiv (M := ZMod n)
          (nodeChildVertexCoordinateSigmaEquiv cs)).trans
        (sigmaFunctionCurryEquiv
          (fun i : ChildIdx cs => VertexCoordinate (childAt cs i))
          (ZMod n))))

@[simp] theorem nodeRootFieldDomainChildPiEquiv_apply_childVertex
    {n a : Nat} [NeZero n] {cs : List RTree}
    (rd : RawNormal.RootFieldDomain n (RTree.node a cs))
    (i : ChildIdx cs) (x : VertexCoordinate (childAt cs i)) :
    nodeRootFieldDomainChildPiEquiv n a cs rd i x =
      rd (RawNormal.childVertexAtAsNonRootInNode (a := a)
            (⟨i, x.1⟩ : RawNormal.NodeChildVertex cs))
        (by simpa [childVertexAtAsNonRootInNode_weight] using x.2) := by
  cases x with
  | mk v j =>
      simp [nodeRootFieldDomainChildPiEquiv, sigmaFunctionCurryEquiv,
        functionDomainEquiv, rootFieldDomainSigmaEquiv]
      change rd ((rootFieldCoordinateNodeEquivChildVertexCoordinate a cs).symm
          (⟨⟨i, v⟩, j⟩ : NodeChildVertexCoordinate cs)).fst
        ((rootFieldCoordinateNodeEquivChildVertexCoordinate a cs).symm
          (⟨⟨i, v⟩, j⟩ : NodeChildVertexCoordinate cs)).snd =
        rd (RawNormal.childVertexAtAsNonRootInNode (a := a)
          (⟨i, v⟩ : RawNormal.NodeChildVertex cs))
        (by simpa [childVertexAtAsNonRootInNode_weight] using j)
      rw [rootFieldCoordinateNodeEquivChildVertexCoordinate_symm_childVertex
        (a := a) (cs := cs) i
        (⟨v, j⟩ : VertexCoordinate (childAt cs i))]

@[simp] theorem nodeRootFieldDomainChildPiEquiv_apply_childRoot
    {n a : Nat} [NeZero n] {cs : List RTree}
    (rd : RawNormal.RootFieldDomain n (RTree.node a cs))
    (i : ChildIdx cs) (j : Fin (childAt cs i).rootWeight) :
    nodeRootFieldDomainChildPiEquiv n a cs rd i
        (⟨Vertex.root (childAt cs i), j⟩ :
          VertexCoordinate (childAt cs i)) =
      rd (RawNormal.childRootAtAsNonRootInNode (a := a) i)
        (by simpa [RawNormal.childRootAtAsNonRootInNode_weight] using j) := by
  rw [nodeRootFieldDomainChildPiEquiv_apply_childVertex]
  apply rootFieldDomain_apply_heq rd
  · apply Subtype.ext
    rfl
  · rfl

noncomputable def singletonNodeRootFieldDomainVertexEquiv
    (n : Nat) [NeZero n] (a : Nat) (C : RTree) :
    RawNormal.RootFieldDomain n (RTree.node a [C]) ≃
      VertexFieldDomain n C :=
  (nodeRootFieldDomainChildPiEquiv n a [C]).trans
    (childVertexFieldDomainFamilySingletonEquiv n C)

@[simp] theorem singletonNodeRootFieldDomainVertexEquiv_apply
    {n : Nat} [NeZero n] (a : Nat) (C : RTree)
    (rd : RawNormal.RootFieldDomain n (RTree.node a [C])) :
    singletonNodeRootFieldDomainVertexEquiv n a C rd =
      childVertexFieldDomainFamilySingletonEquiv n C
        (nodeRootFieldDomainChildPiEquiv n a [C] rd) := rfl

@[simp] theorem singletonNodeRootFieldDomainVertexEquiv_apply_childRoot
    {n a : Nat} [NeZero n] (C : RTree)
    (rd : RawNormal.RootFieldDomain n (RTree.node a [C]))
    (j : Fin C.rootWeight) :
    singletonNodeRootFieldDomainVertexEquiv n a C rd
        (⟨Vertex.root C, j⟩ : VertexCoordinate C) =
      rd (RawNormal.childRootAtAsNonRootInNode (a := a)
          (0 : ChildIdx [C]))
        (by simpa [RawNormal.childRootAtAsNonRootInNode_weight] using j) := by
  rw [singletonNodeRootFieldDomainVertexEquiv_apply]
  rw [childVertexFieldDomainFamilySingletonEquiv_apply]
  simpa [childAt] using
    nodeRootFieldDomainChildPiEquiv_apply_childRoot
      (n := n) (a := a) (cs := [C]) rd
      (0 : ChildIdx [C]) j

@[simp] theorem childVertexAtAsNonRootInNode_root_eq_childRootAt
    {a : Nat} {cs : List RTree} (i : ChildIdx cs) :
    RawNormal.childVertexAtAsNonRootInNode (a := a)
        (⟨i, Vertex.root (childAt cs i)⟩ :
          RawNormal.NodeChildVertex cs) =
      RawNormal.childRootAtAsNonRootInNode (a := a) i := by
  apply Subtype.ext
  rfl

@[simp] theorem childVertexAtAsNonRootInNode_nonRoot_eq_childNonRootAt
    {a : Nat} {cs : List RTree} (i : ChildIdx cs)
    (v : NonRootVertex (childAt cs i)) :
    RawNormal.childVertexAtAsNonRootInNode (a := a)
        (⟨i, v.1⟩ : RawNormal.NodeChildVertex cs) =
      RawNormal.childNonRootVertexAtInNode (a := a) i v := by
  apply Subtype.ext
  rfl

@[simp] theorem singletonNodeRootFieldDomainVertexEquiv_symm_childVertex
    {n a : Nat} [NeZero n] (C : RTree)
    (F : VertexFieldDomain n C) (x : VertexCoordinate C) :
    (singletonNodeRootFieldDomainVertexEquiv n a C).symm F
      (RawNormal.childVertexAtAsNonRootInNode (a := a)
        (⟨(0 : ChildIdx [C]), x.1⟩ : RawNormal.NodeChildVertex [C]))
      (by simpa [childVertexAtAsNonRootInNode_weight] using x.2) =
    F x := by
  let rd := (singletonNodeRootFieldDomainVertexEquiv n a C).symm F
  have hright :
      singletonNodeRootFieldDomainVertexEquiv n a C rd = F :=
    (singletonNodeRootFieldDomainVertexEquiv n a C).right_inv F
  have hx := congrFun hright x
  change childVertexFieldDomainFamilySingletonEquiv n C
      (nodeRootFieldDomainChildPiEquiv n a [C] rd) x = F x at hx
  rw [childVertexFieldDomainFamilySingletonEquiv_apply] at hx
  have hcoord := nodeRootFieldDomainChildPiEquiv_apply_childVertex
    (n := n) (a := a) (cs := [C]) rd (0 : ChildIdx [C]) x
  exact hcoord.symm.trans hx

@[simp] theorem singletonNodeRootFieldDomainVertexEquiv_symm_childRoot
    {n a : Nat} [NeZero n] (C : RTree)
    (F : VertexFieldDomain n C) (j : Fin C.rootWeight) :
    (singletonNodeRootFieldDomainVertexEquiv n a C).symm F
      (RawNormal.childRootAtAsNonRootInNode (a := a)
        (0 : ChildIdx [C]))
      (by simpa [RawNormal.childRootAtAsNonRootInNode_weight] using j) =
    F ⟨Vertex.root C, j⟩ := by
  let rd := (singletonNodeRootFieldDomainVertexEquiv n a C).symm F
  let vtx : NonRootVertex (RTree.node a [C]) :=
    RawNormal.childVertexAtAsNonRootInNode (a := a)
      (⟨(0 : ChildIdx [C]), Vertex.root C⟩ :
        RawNormal.NodeChildVertex [C])
  have hroot :
      RawNormal.childRootAtAsNonRootInNode (a := a)
          (0 : ChildIdx [C]) = vtx := by
    apply Subtype.ext
    rfl
  have hmove :
      rd (RawNormal.childRootAtAsNonRootInNode (a := a)
            (0 : ChildIdx [C]))
          (by simpa [RawNormal.childRootAtAsNonRootInNode_weight] using j) =
        rd vtx (by simpa [vtx, childVertexAtAsNonRootInNode_weight] using j) := by
    apply rootFieldDomain_apply_heq rd hroot
    rfl
  change rd (RawNormal.childRootAtAsNonRootInNode (a := a)
          (0 : ChildIdx [C]))
        (by simpa [RawNormal.childRootAtAsNonRootInNode_weight] using j) =
      F ⟨Vertex.root C, j⟩
  rw [hmove]
  exact singletonNodeRootFieldDomainVertexEquiv_symm_childVertex
    (n := n) (a := a) C F
    (⟨Vertex.root C, j⟩ : VertexCoordinate C)

@[simp] theorem singletonNodeRootFieldDomainVertexEquiv_symm_childRoot_fun
    {n a : Nat} [NeZero n] (C : RTree)
    (F : VertexFieldDomain n C) :
    (singletonNodeRootFieldDomainVertexEquiv n a C).symm F
      (RawNormal.childRootAtAsNonRootInNode (a := a)
        (0 : ChildIdx [C])) =
      fun j =>
        F (⟨Vertex.root C,
          by
            simpa [RawNormal.childRootAtAsNonRootInNode_weight] using j⟩ :
          VertexCoordinate C) := by
  funext j
  exact singletonNodeRootFieldDomainVertexEquiv_symm_childRoot
    (n := n) (a := a) C F j

noncomputable def nodeRootFieldDomainConsChildPiEquiv
    (n : Nat) [NeZero n] (a : Nat) (C : RTree) (cs : List RTree) :
    RawNormal.RootFieldDomain n (RTree.node a (C :: cs)) ≃
      ChildVertexFieldDomainFamily n cs × VertexFieldDomain n C :=
  (nodeRootFieldDomainChildPiEquiv n a (C :: cs)).trans
    ((childVertexFieldDomainFamilyConsEquiv n C cs).trans
      (Equiv.prodComm (VertexFieldDomain n C)
        (ChildVertexFieldDomainFamily n cs)))

@[simp] theorem nodeRootFieldDomainConsChildPiEquiv_apply_fst
    {n : Nat} [NeZero n] (a : Nat) (C : RTree) (cs : List RTree)
    (rd : RawNormal.RootFieldDomain n (RTree.node a (C :: cs))) :
    (nodeRootFieldDomainConsChildPiEquiv n a C cs rd).1 =
      (childVertexFieldDomainFamilyConsEquiv n C cs
        (nodeRootFieldDomainChildPiEquiv n a (C :: cs) rd)).2 := rfl

@[simp] theorem nodeRootFieldDomainConsChildPiEquiv_apply_snd
    {n : Nat} [NeZero n] (a : Nat) (C : RTree) (cs : List RTree)
    (rd : RawNormal.RootFieldDomain n (RTree.node a (C :: cs))) :
    (nodeRootFieldDomainConsChildPiEquiv n a C cs rd).2 =
      (childVertexFieldDomainFamilyConsEquiv n C cs
        (nodeRootFieldDomainChildPiEquiv n a (C :: cs) rd)).1 := rfl

@[simp] theorem nodeRootFieldDomainConsChildPiEquiv_apply_snd_apply
    {n : Nat} [NeZero n] (a : Nat) (C : RTree) (cs : List RTree)
    (rd : RawNormal.RootFieldDomain n (RTree.node a (C :: cs)))
    (x : VertexCoordinate C) :
    (nodeRootFieldDomainConsChildPiEquiv n a C cs rd).2 x =
      rd (RawNormal.childVertexAtAsNonRootInNode (a := a)
            (⟨(0 : ChildIdx (C :: cs)), x.1⟩ :
              RawNormal.NodeChildVertex (C :: cs)))
        (by simpa [childVertexAtAsNonRootInNode_weight] using x.2) := by
  cases x with
  | mk v j =>
      change (nodeRootFieldDomainChildPiEquiv n a (C :: cs) rd)
          (0 : ChildIdx (C :: cs))
          (⟨v, j⟩ : VertexCoordinate (childAt (C :: cs)
            (0 : ChildIdx (C :: cs)))) = _
      rw [nodeRootFieldDomainChildPiEquiv_apply_childVertex]

@[simp] theorem nodeRootFieldDomainConsChildPiEquiv_symm_singleton_childRoot
    {n a : Nat} [NeZero n] (C : RTree) (cs : List RTree)
    (rest : ChildVertexFieldDomainFamily n cs)
    (rdSingle : RawNormal.RootFieldDomain n (RTree.node a [C]))
    (j : Fin C.rootWeight) :
    ((nodeRootFieldDomainConsChildPiEquiv n a C cs).symm
        (rest, singletonNodeRootFieldDomainVertexEquiv n a C rdSingle))
      (RawNormal.childRootAtAsNonRootInNode (a := a)
        (0 : ChildIdx (C :: cs)))
      (by simpa [RawNormal.childRootAtAsNonRootInNode_weight] using j) =
    rdSingle
      (RawNormal.childRootAtAsNonRootInNode (a := a)
        (0 : ChildIdx [C]))
      (by simpa [RawNormal.childRootAtAsNonRootInNode_weight] using j) := by
  let parentRd :=
    (nodeRootFieldDomainConsChildPiEquiv n a C cs).symm
      (rest, singletonNodeRootFieldDomainVertexEquiv n a C rdSingle)
  have hpair :
      nodeRootFieldDomainConsChildPiEquiv n a C cs parentRd =
        (rest, singletonNodeRootFieldDomainVertexEquiv n a C rdSingle) := by
    simp [parentRd]
  have h :=
    congrFun (congrArg Prod.snd hpair)
      (⟨Vertex.root C, j⟩ : VertexCoordinate C)
  change
    parentRd
      (RawNormal.childRootAtAsNonRootInNode (a := a)
        (0 : ChildIdx (C :: cs)))
      (by simpa [RawNormal.childRootAtAsNonRootInNode_weight] using j) =
    rdSingle
      (RawNormal.childRootAtAsNonRootInNode (a := a)
        (0 : ChildIdx [C]))
      (by simpa [RawNormal.childRootAtAsNonRootInNode_weight] using j)
  simpa [nodeRootFieldDomainConsChildPiEquiv_apply_snd_apply] using h

noncomputable def nodeRootFieldAssignmentChildPiLinearEquiv
    (n : Nat) [NeZero n] (a : Nat) (cs : List RTree) :
    RawNormal.NodeRootFieldAssignment n a cs ≃ₗ[F2]
      (((i : ChildIdx cs) →
        VertexCoordinate (childAt cs i) → ZMod n) → F2) :=
  functionDomainLinearEquiv
    (M := F2) (nodeRootFieldDomainChildPiEquiv n a cs)

noncomputable def singletonNodeRootFieldAssignmentVertexLinearEquiv
    (n : Nat) [NeZero n] (a : Nat) (C : RTree) :
    RawNormal.NodeRootFieldAssignment n a [C] ≃ₗ[F2]
      (VertexFieldDomain n C → F2) :=
  (nodeRootFieldAssignmentChildPiLinearEquiv n a [C]).trans
    (functionDomainLinearEquiv
      (M := F2) (childVertexFieldDomainFamilySingletonEquiv n C))

@[simp] theorem singletonNodeRootFieldAssignmentVertexLinearEquiv_apply
    {n : Nat} [NeZero n] (a : Nat) (C : RTree)
    (R : RawNormal.NodeRootFieldAssignment n a [C])
    (f : VertexFieldDomain n C) :
    singletonNodeRootFieldAssignmentVertexLinearEquiv n a C R f =
      R ((nodeRootFieldDomainChildPiEquiv n a [C]).symm
        ((childVertexFieldDomainFamilySingletonEquiv n C).symm f)) := rfl

@[simp] theorem singletonNodeRootFieldAssignmentVertexLinearEquiv_symm_apply
    {n : Nat} [NeZero n] (a : Nat) (C : RTree)
    (F : VertexFieldDomain n C → F2)
    (rd : RawNormal.RootFieldDomain n (RTree.node a [C])) :
    (singletonNodeRootFieldAssignmentVertexLinearEquiv n a C).symm F rd =
      F (childVertexFieldDomainFamilySingletonEquiv n C
          (nodeRootFieldDomainChildPiEquiv n a [C] rd)) := rfl

@[simp] theorem singletonNodeRootFieldAssignmentVertexLinearEquiv_symm_apply_domain
    {n : Nat} [NeZero n] (a : Nat) (C : RTree)
    (F : VertexFieldDomain n C → F2)
    (rd : RawNormal.RootFieldDomain n (RTree.node a [C])) :
    (singletonNodeRootFieldAssignmentVertexLinearEquiv n a C).symm F rd =
      F (singletonNodeRootFieldDomainVertexEquiv n a C rd) := rfl

theorem card_rootFieldCoordinate_node_eq_sum_vertexCoordinate
    (a : Nat) (cs : List RTree) :
    Fintype.card (RootFieldCoordinate (RTree.node a cs)) =
      ∑ i : ChildIdx cs,
        Fintype.card (VertexCoordinate (childAt cs i)) := by
  calc
    Fintype.card (RootFieldCoordinate (RTree.node a cs)) =
        Fintype.card (NodeChildVertexCoordinate cs) := by
          exact Fintype.card_congr
            (rootFieldCoordinateNodeEquivChildVertexCoordinate a cs)
    _ = ∑ i : ChildIdx cs,
          Fintype.card (VertexCoordinate (childAt cs i)) := by
      exact card_nodeChildVertexCoordinate_eq_sum_vertexCoordinate cs

theorem numVertices_le_sum_of_mem {T : RTree} {ts : List RTree}
    (h : T ∈ ts) :
    RTree.numVertices T ≤ (ts.map RTree.numVertices).sum := by
  induction ts with
  | nil =>
      cases h
  | cons U us ih =>
      simp only [List.mem_cons] at h
      rcases h with h | h
      · subst h
        simp
      · have hlt := ih h
        simp
        omega

theorem numVertices_lt_node_of_mem
    {C : RTree} {a : Nat} {cs : List RTree} (h : C ∈ cs) :
    RTree.numVertices C < RTree.numVertices (RTree.node a cs) := by
  have hle := numVertices_le_sum_of_mem h
  simp [RTree.numVertices]
  omega

theorem card_vertexCoordinate_eq_totalWeight :
    ∀ T : RTree, Fintype.card (VertexCoordinate T) = RTree.totalWeight T
  | RTree.node a cs => by
      have hroot :=
        card_vertexCoordinate_eq_root_add_rootFieldCoordinate
          (RTree.node a cs)
      have hrf := card_rootFieldCoordinate_node_eq_sum_vertexCoordinate a cs
      have hsum :
          (∑ i : ChildIdx cs,
            Fintype.card (VertexCoordinate (childAt cs i))) =
            ∑ i : ChildIdx cs, RTree.totalWeight (childAt cs i) := by
        refine Finset.sum_congr rfl ?_
        intro i _
        exact card_vertexCoordinate_eq_totalWeight (childAt cs i)
      calc
        Fintype.card (VertexCoordinate (RTree.node a cs)) =
            a + Fintype.card
              (RootFieldCoordinate (RTree.node a cs)) := by
          simpa [RTree.rootWeight] using hroot
        _ = a + ∑ i : ChildIdx cs,
              Fintype.card (VertexCoordinate (childAt cs i)) := by
          rw [hrf]
        _ = a + ∑ i : ChildIdx cs,
              RTree.totalWeight (childAt cs i) := by
          rw [hsum]
        _ = RTree.totalWeight (RTree.node a cs) := by
          rw [sum_childIdx_totalWeight]
          simp [RTree.totalWeight]
termination_by T => RTree.numVertices T
decreasing_by
  exact numVertices_lt_node_of_mem (childAt_mem cs i)

theorem card_vertexFieldDomain_eq_pow_totalWeight
    (n : Nat) [NeZero n] (T : RTree) :
    Fintype.card (VertexFieldDomain n T) =
      n ^ RTree.totalWeight T := by
  rw [Fintype.card_fun, ZMod.card, card_vertexCoordinate_eq_totalWeight]

theorem card_childVertexFieldDomainFamily_eq_pow_sum_totalWeight
    (n : Nat) [NeZero n] (cs : List RTree) :
    Fintype.card (ChildVertexFieldDomainFamily n cs) =
      n ^ (cs.map RTree.totalWeight).sum := by
  classical
  unfold ChildVertexFieldDomainFamily
  calc
    Fintype.card
        ((i : ChildIdx cs) → VertexFieldDomain n (childAt cs i)) =
        ∏ i : ChildIdx cs,
          Fintype.card (VertexFieldDomain n (childAt cs i)) := by
      rw [Fintype.card_pi]
    _ = ∏ i : ChildIdx cs,
          n ^ RTree.totalWeight (childAt cs i) := by
      refine Finset.prod_congr rfl ?_
      intro i _
      rw [card_vertexFieldDomain_eq_pow_totalWeight]
    _ = n ^ (∑ i : ChildIdx cs,
          RTree.totalWeight (childAt cs i)) := by
      simpa using
        (Finset.prod_pow_eq_pow_sum
          (s := Finset.univ)
          (f := fun i : ChildIdx cs =>
            RTree.totalWeight (childAt cs i))
          (a := n))
    _ = n ^ (cs.map RTree.totalWeight).sum := by
      rw [sum_childIdx_totalWeight]

theorem card_rootFieldCoordinate_node_eq_sum_totalWeight
    (a : Nat) (cs : List RTree) :
    Fintype.card (RootFieldCoordinate (RTree.node a cs)) =
      (cs.map RTree.totalWeight).sum := by
  rw [card_rootFieldCoordinate_node_eq_sum_vertexCoordinate]
  have hsum :
      (∑ i : ChildIdx cs,
        Fintype.card (VertexCoordinate (childAt cs i))) =
        ∑ i : ChildIdx cs, RTree.totalWeight (childAt cs i) := by
    refine Finset.sum_congr rfl ?_
    intro i _
    exact card_vertexCoordinate_eq_totalWeight (childAt cs i)
  rw [hsum, sum_childIdx_totalWeight]

theorem card_rootFieldDomain_node_eq_pow_sum_totalWeight
    (n : Nat) [NeZero n] (a : Nat) (cs : List RTree) :
    Fintype.card (RawNormal.RootFieldDomain n (RTree.node a cs)) =
      n ^ (cs.map RTree.totalWeight).sum := by
  rw [card_rootFieldDomain_eq_pow_card_rootFieldCoordinate,
    card_rootFieldCoordinate_node_eq_sum_totalWeight]

noncomputable def equivOfFintypeCardEq
    {α β : Type} [Fintype α] [Fintype β]
    (hcard : Fintype.card α = Fintype.card β) : α ≃ β :=
  (Fintype.equivFinOfCardEq (α := α) rfl).trans
    ((finCongr hcard).trans
      (Fintype.equivFinOfCardEq (α := β) rfl).symm)

noncomputable def boundaryZeroRootFieldEmbeddingOfCard
    {a : Nat} {cs : List RTree} {n : Nat} [NeZero n]
    (hcard :
      Fintype.card
          { R : RawNormal.NodeRootFieldAssignment n a cs //
            ∀ i : ChildIdx cs,
              childBoundaryLinearFormAt (n := n) (a := a) cs R i = 0 } =
        Fintype.card (OpenRootMessageSpace n cs)) :
    OpenRootMessageSpace n cs ↪
      RawNormal.NodeRootFieldAssignment n a cs where
  toFun M :=
    (equivOfFintypeCardEq hcard.symm M).1
  inj' M N hMN := by
    apply (equivOfFintypeCardEq hcard.symm).injective
    exact Subtype.ext hMN

theorem boundaryZeroRootFieldEmbeddingOfCard_range_iff
    {a : Nat} {cs : List RTree} {n : Nat} [NeZero n]
    (hcard :
      Fintype.card
          { R : RawNormal.NodeRootFieldAssignment n a cs //
            ∀ i : ChildIdx cs,
              childBoundaryLinearFormAt (n := n) (a := a) cs R i = 0 } =
        Fintype.card (OpenRootMessageSpace n cs))
    (R : RawNormal.NodeRootFieldAssignment n a cs) :
    (∃ M : OpenRootMessageSpace n cs,
        boundaryZeroRootFieldEmbeddingOfCard
          (a := a) (cs := cs) (n := n) hcard M = R) ↔
      ∀ i : ChildIdx cs,
        childBoundaryLinearFormAt (n := n) (a := a) cs R i = 0 := by
  classical
  constructor
  · rintro ⟨M, hM⟩
    subst R
    simpa [boundaryZeroRootFieldEmbeddingOfCard] using
      (equivOfFintypeCardEq hcard.symm M).2
  · intro hR
    refine
      ⟨(equivOfFintypeCardEq hcard.symm).symm ⟨R, hR⟩, ?_⟩
    simp [boundaryZeroRootFieldEmbeddingOfCard]

theorem childIdx_singleton_eq_zero {C : RTree}
    (i : ChildIdx [C]) :
    i = (0 : ChildIdx [C]) := by
  apply Fin.ext
  change i.1 = 0
  have hlt : i.1 < 1 := by
    simpa using i.2
  omega

theorem childIdx_singleton_eq {C : RTree}
    (i j : ChildIdx [C]) :
    i = j := by
  rw [childIdx_singleton_eq_zero i, childIdx_singleton_eq_zero j]

theorem boundaryZeroRootFieldEmbeddingOfCard_singleton_range_iff_at
    {a : Nat} {C : RTree} {n : Nat} [NeZero n]
    (hcard :
      Fintype.card
          { R : RawNormal.NodeRootFieldAssignment n a [C] //
            ∀ i : ChildIdx [C],
              childBoundaryLinearFormAt (n := n) (a := a) [C] R i = 0 } =
        Fintype.card (OpenRootMessageSpace n [C]))
    (R : RawNormal.NodeRootFieldAssignment n a [C])
    (i : ChildIdx [C]) :
    (∃ M : OpenRootMessageSpace n [C],
        boundaryZeroRootFieldEmbeddingOfCard
          (a := a) (cs := [C]) (n := n) hcard M = R) ↔
      childBoundaryLinearFormAt (n := n) (a := a) [C] R i = 0 := by
  constructor
  · intro hM
    exact
      (boundaryZeroRootFieldEmbeddingOfCard_range_iff
        (a := a) (cs := [C]) (n := n) hcard R).1 hM i
  · intro hi
    apply
      (boundaryZeroRootFieldEmbeddingOfCard_range_iff
        (a := a) (cs := [C]) (n := n) hcard R).2
    intro j
    rw [childIdx_singleton_eq j i]
    exact hi

noncomputable def fullCoordinateWithDiagonalEquiv
    (m n : Nat) [NeZero n] :
    (Fin (m + 1) → ZMod n) ≃ ((Fin m → ZMod n) × ZMod n) where
  toFun x := (Fin.init x, ∑ j, x j)
  invFun p := Fin.snoc p.1 (p.2 - ∑ j, p.1 j)
  left_inv := by
    intro x
    funext j
    refine Fin.lastCases ?last ?cast j
    · simp [Fin.snoc, Fin.sum_univ_castSucc, Fin.init, add_comm]
    · intro k
      simp [Fin.snoc, Fin.init]
  right_inv := by
    intro p
    ext j
    · simp [Fin.snoc, Fin.init]
    · simp [Fin.snoc, Fin.sum_univ_castSucc]

@[simp] theorem fullCoordinateWithDiagonalEquiv_symm_castSucc
    {m n : Nat} [NeZero n]
    (x : Fin m → ZMod n) (d : ZMod n) (j : Fin m) :
    ((fullCoordinateWithDiagonalEquiv m n).symm (x, d)) j.castSucc =
      x j := by
  simp [fullCoordinateWithDiagonalEquiv]

@[simp] theorem fullCoordinateWithDiagonalEquiv_symm_sum
    {m n : Nat} [NeZero n]
    (x : Fin m → ZMod n) (d : ZMod n) :
    (∑ j : Fin (m + 1),
        ((fullCoordinateWithDiagonalEquiv m n).symm (x, d)) j) = d := by
  simp [fullCoordinateWithDiagonalEquiv, Fin.snoc, Fin.sum_univ_castSucc]

noncomputable def fullCoordinateWithDiagonalEquivOfPos
    (b n : Nat) [NeZero n] (hb : 0 < b) :
    (Fin b → ZMod n) ≃ ((Fin (b - 1) → ZMod n) × ZMod n) := by
  cases b with
  | zero =>
      exact False.elim (by omega)
  | succ m =>
      simpa [Nat.succ_eq_add_one] using
        fullCoordinateWithDiagonalEquiv m n

@[simp] theorem fullCoordinateWithDiagonalEquivOfPos_snd
    (b n : Nat) [NeZero n] (hb : 0 < b)
    (x : Fin b → ZMod n) :
    (fullCoordinateWithDiagonalEquivOfPos b n hb x).2 =
      ∑ j : Fin b, x j := by
  cases b with
  | zero =>
      exact False.elim (by omega)
  | succ m =>
      rfl

@[simp] theorem fullCoordinateWithDiagonalEquivOfPos_symm_fst
    (b n : Nat) [NeZero n] (hb : 0 < b)
    (x : Fin (b - 1) → ZMod n) (d : ZMod n) :
    ((fullCoordinateWithDiagonalEquivOfPos b n hb).symm (x, d) |>
      fullCoordinateWithDiagonalEquivOfPos b n hb).1 = x := by
  exact congrArg Prod.fst
    ((fullCoordinateWithDiagonalEquivOfPos b n hb).right_inv (x, d))

@[simp] theorem fullCoordinateWithDiagonalEquivOfPos_symm_snd
    (b n : Nat) [NeZero n] (hb : 0 < b)
    (x : Fin (b - 1) → ZMod n) (d : ZMod n) :
    ((fullCoordinateWithDiagonalEquivOfPos b n hb).symm (x, d) |>
      fullCoordinateWithDiagonalEquivOfPos b n hb).2 = d := by
  exact congrArg Prod.snd
    ((fullCoordinateWithDiagonalEquivOfPos b n hb).right_inv (x, d))

abbrev ChildSiblingVertex (cs : List RTree) (i : ChildIdx cs) :=
  { p : RawNormal.NodeChildVertex cs // p.1 ≠ i }

noncomputable def childSiblingVertexConsZeroEquiv
    (C : RTree) (cs : List RTree) :
    ChildSiblingVertex (C :: cs) (0 : ChildIdx (C :: cs)) ≃
      RawNormal.NodeChildVertex cs where
  toFun := by
    intro p
    rcases p with ⟨⟨k, v⟩, hk⟩
    cases k using Fin.cases with
    | zero =>
        exact False.elim (hk rfl)
    | succ i =>
        exact ⟨i, by simpa [childAt] using v⟩
  invFun q :=
    ⟨⟨q.1.succ, by simpa [childAt] using q.2⟩, by
      intro h
      have hval := congrArg Fin.val h
      simp at hval⟩
  left_inv := by
    intro p
    rcases p with ⟨⟨k, v⟩, hk⟩
    cases k using Fin.cases with
    | zero =>
        exact False.elim (hk rfl)
    | succ i =>
        apply Subtype.ext
        rfl
  right_inv := by
    intro q
    rcases q with ⟨i, v⟩
    rfl

theorem childSiblingVertex_singleton_elim
    {C : RTree} (p : ChildSiblingVertex [C] (0 : ChildIdx [C])) :
    False :=
  p.2 (childIdx_singleton_eq_zero p.1.1)

theorem childSiblingVertexConsZeroEquiv_weight
    (C : RTree) (cs : List RTree)
    (p : ChildSiblingVertex (C :: cs) (0 : ChildIdx (C :: cs))) :
    Vertex.weight p.1.2 =
      Vertex.weight ((childSiblingVertexConsZeroEquiv C cs p).2) := by
  rcases p with ⟨⟨k, v⟩, hk⟩
  cases k using Fin.cases with
  | zero =>
      exact False.elim (hk rfl)
  | succ i =>
      rfl

structure ChildExternalCoordinate
    (n a : Nat) [NeZero n] (cs : List RTree) (i : ChildIdx cs) where
  rootCoord : Fin (a - 1) → ZMod n
  childRootDiagonal : ZMod n
  siblingCoord :
    (p : ChildSiblingVertex cs i) → Fin (Vertex.weight p.1.2) → ZMod n
  deriving DecidableEq, Fintype

noncomputable def childExternalConsZeroRestField
    {n a : Nat} [NeZero n] (C : RTree) (cs : List RTree)
    (ext :
      ChildExternalCoordinate n a (C :: cs)
        (0 : ChildIdx (C :: cs))) :
    ChildVertexFieldDomainFamily n cs :=
  fun i x =>
    let p : RawNormal.NodeChildVertex cs := ⟨i, x.1⟩
    ext.siblingCoord
      ((childSiblingVertexConsZeroEquiv C cs).symm p)
      (by
        simpa [childSiblingVertexConsZeroEquiv] using x.2)

def childExternalConsZeroSingleton
    {n a : Nat} [NeZero n] (C : RTree) (cs : List RTree)
    (ext :
      ChildExternalCoordinate n a (C :: cs)
        (0 : ChildIdx (C :: cs))) :
    ChildExternalCoordinate n a [C] (0 : ChildIdx [C]) where
  rootCoord := ext.rootCoord
  childRootDiagonal := ext.childRootDiagonal
  siblingCoord := fun p _ => False.elim (childSiblingVertex_singleton_elim p)

@[simp] theorem childExternalConsZeroSingleton_rootCoord
    {n a : Nat} [NeZero n] (C : RTree) (cs : List RTree)
    (ext :
      ChildExternalCoordinate n a (C :: cs)
        (0 : ChildIdx (C :: cs))) :
    (childExternalConsZeroSingleton C cs ext).rootCoord =
      ext.rootCoord := rfl

@[simp] theorem childExternalConsZeroSingleton_childRootDiagonal
    {n a : Nat} [NeZero n] (C : RTree) (cs : List RTree)
    (ext :
      ChildExternalCoordinate n a (C :: cs)
        (0 : ChildIdx (C :: cs))) :
    (childExternalConsZeroSingleton C cs ext).childRootDiagonal =
      ext.childRootDiagonal := rfl

noncomputable def childExternalConsZeroOfRestSingleton
    {n a : Nat} [NeZero n] (C : RTree) (cs : List RTree)
    (rest : ChildVertexFieldDomainFamily n cs)
    (single : ChildExternalCoordinate n a [C] (0 : ChildIdx [C])) :
    ChildExternalCoordinate n a (C :: cs)
      (0 : ChildIdx (C :: cs)) where
  rootCoord := single.rootCoord
  childRootDiagonal := single.childRootDiagonal
  siblingCoord := fun p j =>
    let q := childSiblingVertexConsZeroEquiv C cs p
    rest q.1
      ⟨q.2, Fin.cast
        (childSiblingVertexConsZeroEquiv_weight C cs p) j⟩

@[simp] theorem childExternalConsZeroOfRestSingleton_rootCoord
    {n a : Nat} [NeZero n] (C : RTree) (cs : List RTree)
    (rest : ChildVertexFieldDomainFamily n cs)
    (single : ChildExternalCoordinate n a [C] (0 : ChildIdx [C])) :
    (childExternalConsZeroOfRestSingleton C cs rest single).rootCoord =
      single.rootCoord := rfl

@[simp] theorem childExternalConsZeroOfRestSingleton_childRootDiagonal
    {n a : Nat} [NeZero n] (C : RTree) (cs : List RTree)
    (rest : ChildVertexFieldDomainFamily n cs)
    (single : ChildExternalCoordinate n a [C] (0 : ChildIdx [C])) :
    (childExternalConsZeroOfRestSingleton C cs rest single).childRootDiagonal =
      single.childRootDiagonal := rfl

@[simp] theorem childExternalConsZeroRestField_ofRestSingleton
    {n a : Nat} [NeZero n] (C : RTree) (cs : List RTree)
    (rest : ChildVertexFieldDomainFamily n cs)
    (single : ChildExternalCoordinate n a [C] (0 : ChildIdx [C])) :
    childExternalConsZeroRestField C cs
        (childExternalConsZeroOfRestSingleton C cs rest single) =
      rest := by
  funext i x
  dsimp [childExternalConsZeroRestField,
    childExternalConsZeroOfRestSingleton]
  have hp :
      childSiblingVertexConsZeroEquiv C cs
          ((childSiblingVertexConsZeroEquiv C cs).symm
            (⟨i, x.1⟩ : RawNormal.NodeChildVertex cs)) =
        (⟨i, x.1⟩ : RawNormal.NodeChildVertex cs) :=
    (childSiblingVertexConsZeroEquiv C cs).right_inv
      (⟨i, x.1⟩ : RawNormal.NodeChildVertex cs)
  cases hp
  rfl

@[simp] theorem childExternalConsZeroSingleton_ofRestSingleton
    {n a : Nat} [NeZero n] (C : RTree) (cs : List RTree)
    (rest : ChildVertexFieldDomainFamily n cs)
    (single : ChildExternalCoordinate n a [C] (0 : ChildIdx [C])) :
    childExternalConsZeroSingleton C cs
        (childExternalConsZeroOfRestSingleton C cs rest single) =
      single := by
  cases single with
  | mk root diag sibling =>
      change
        ({ rootCoord := root
           childRootDiagonal := diag
           siblingCoord :=
            fun p j => False.elim (childSiblingVertex_singleton_elim p) } :
          ChildExternalCoordinate n a [C] (0 : ChildIdx [C])) =
        { rootCoord := root
          childRootDiagonal := diag
          siblingCoord := sibling }
      have hsib :
          (fun p : ChildSiblingVertex [C] (0 : ChildIdx [C]) =>
              fun j : Fin (Vertex.weight p.1.2) =>
                False.elim (childSiblingVertex_singleton_elim p)) =
            sibling := by
        funext p
        exact False.elim (childSiblingVertex_singleton_elim p)
      cases hsib
      rfl

@[simp] theorem childExternalConsZeroOfRestSingleton_restField_singleton
    {n a : Nat} [NeZero n] (C : RTree) (cs : List RTree)
    (ext :
      ChildExternalCoordinate n a (C :: cs)
        (0 : ChildIdx (C :: cs))) :
    childExternalConsZeroOfRestSingleton C cs
        (childExternalConsZeroRestField C cs ext)
        (childExternalConsZeroSingleton C cs ext) =
      ext := by
  rw [ChildExternalCoordinate.mk.injEq]
  constructor
  · rfl
  constructor
  · rfl
  · funext p j
    rcases p with ⟨⟨k, v⟩, hk⟩
    cases k using Fin.cases with
    | zero =>
        exact False.elim (hk rfl)
    | succ i =>
        rfl

noncomputable def childExternalCoordinateConsZeroEquivRestSingleton
    {n a : Nat} [NeZero n] (C : RTree) (cs : List RTree) :
    ChildExternalCoordinate n a (C :: cs) (0 : ChildIdx (C :: cs)) ≃
      ChildVertexFieldDomainFamily n cs ×
        ChildExternalCoordinate n a [C] (0 : ChildIdx [C]) where
  toFun ext :=
    (childExternalConsZeroRestField C cs ext,
      childExternalConsZeroSingleton C cs ext)
  invFun p :=
    childExternalConsZeroOfRestSingleton C cs p.1 p.2
  left_inv :=
    childExternalConsZeroOfRestSingleton_restField_singleton C cs
  right_inv := by
    intro p
    cases p with
    | mk rest single =>
        apply Prod.ext
        · simp
        · simp

@[simp] theorem childExternalCoordinateConsZeroEquivRestSingleton_apply_fst
    {n a : Nat} [NeZero n] (C : RTree) (cs : List RTree)
    (ext :
      ChildExternalCoordinate n a (C :: cs)
        (0 : ChildIdx (C :: cs))) :
    (childExternalCoordinateConsZeroEquivRestSingleton
      (n := n) (a := a) C cs ext).1 =
      childExternalConsZeroRestField C cs ext := rfl

@[simp] theorem childExternalCoordinateConsZeroEquivRestSingleton_apply_snd
    {n a : Nat} [NeZero n] (C : RTree) (cs : List RTree)
    (ext :
      ChildExternalCoordinate n a (C :: cs)
        (0 : ChildIdx (C :: cs))) :
    (childExternalCoordinateConsZeroEquivRestSingleton
      (n := n) (a := a) C cs ext).2 =
      childExternalConsZeroSingleton C cs ext := rfl

@[simp] theorem childExternalCoordinateConsZeroEquivRestSingleton_symm_apply
    {n a : Nat} [NeZero n] (C : RTree) (cs : List RTree)
    (p :
      ChildVertexFieldDomainFamily n cs ×
        ChildExternalCoordinate n a [C] (0 : ChildIdx [C])) :
    (childExternalCoordinateConsZeroEquivRestSingleton
      (n := n) (a := a) C cs).symm p =
      childExternalConsZeroOfRestSingleton C cs p.1 p.2 := rfl

structure ChildExternalBaseCoordinate
    (n a : Nat) [NeZero n] (cs : List RTree) (i : ChildIdx cs) where
  rootCoord : Fin (a - 1) → ZMod n
  siblingCoord :
    (p : ChildSiblingVertex cs i) → Fin (Vertex.weight p.1.2) → ZMod n
  deriving DecidableEq, Fintype

noncomputable def childExternalCoordinateEquivBaseDiag
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs) :
    ChildExternalCoordinate n a cs i ≃
      ChildExternalBaseCoordinate n a cs i × ZMod n where
  toFun ext :=
    ({ rootCoord := ext.rootCoord
       siblingCoord := ext.siblingCoord },
     ext.childRootDiagonal)
  invFun bd :=
    { rootCoord := bd.1.rootCoord
      childRootDiagonal := bd.2
      siblingCoord := bd.1.siblingCoord }
  left_inv := by
    intro ext
    cases ext
    rfl
  right_inv := by
    intro bd
    cases bd with
    | mk base diagonal =>
        cases base
        rfl

@[simp] theorem childExternalCoordinateEquivBaseDiag_rootCoord
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs) (ext : ChildExternalCoordinate n a cs i) :
    ((childExternalCoordinateEquivBaseDiag
      (n := n) (a := a) (cs := cs) i ext).1).rootCoord =
      ext.rootCoord := rfl

@[simp] theorem childExternalCoordinateEquivBaseDiag_childRootDiagonal
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs) (ext : ChildExternalCoordinate n a cs i) :
    (childExternalCoordinateEquivBaseDiag
      (n := n) (a := a) (cs := cs) i ext).2 =
      ext.childRootDiagonal := rfl

@[simp] theorem childExternalCoordinateEquivBaseDiag_siblingCoord
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs) (ext : ChildExternalCoordinate n a cs i)
    (p : ChildSiblingVertex cs i) :
    ((childExternalCoordinateEquivBaseDiag
      (n := n) (a := a) (cs := cs) i ext).1).siblingCoord p =
      ext.siblingCoord p := rfl

@[simp] theorem childExternalCoordinateEquivBaseDiag_symm_rootCoord
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs)
    (base : ChildExternalBaseCoordinate n a cs i) (d : ZMod n) :
    ((childExternalCoordinateEquivBaseDiag
      (n := n) (a := a) (cs := cs) i).symm (base, d)).rootCoord =
      base.rootCoord := rfl

@[simp] theorem childExternalCoordinateEquivBaseDiag_symm_childRootDiagonal
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs)
    (base : ChildExternalBaseCoordinate n a cs i) (d : ZMod n) :
    ((childExternalCoordinateEquivBaseDiag
      (n := n) (a := a) (cs := cs) i).symm (base, d)).childRootDiagonal =
      d := rfl

@[simp] theorem childExternalCoordinateEquivBaseDiag_symm_siblingCoord
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs)
    (base : ChildExternalBaseCoordinate n a cs i) (d : ZMod n)
    (p : ChildSiblingVertex cs i) :
    ((childExternalCoordinateEquivBaseDiag
      (n := n) (a := a) (cs := cs) i).symm (base, d)).siblingCoord p =
      base.siblingCoord p := rfl

noncomputable def externalAssignmentsEquivBaseCyclic
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs) :
    (ChildExternalCoordinate n a cs i →
      RawNormal.NormalAssignment n (childAt cs i)) ≃
    (ChildExternalBaseCoordinate n a cs i →
      ZMod n → RawNormal.NormalAssignment n (childAt cs i)) where
  toFun A base d :=
    A ((childExternalCoordinateEquivBaseDiag
      (n := n) (a := a) (cs := cs) i).symm (base, d))
  invFun B ext :=
    let bd :=
      childExternalCoordinateEquivBaseDiag
        (n := n) (a := a) (cs := cs) i ext
    B bd.1 bd.2
  left_inv := by
    intro A
    funext ext
    exact congrArg A
      ((childExternalCoordinateEquivBaseDiag
        (n := n) (a := a) (cs := cs) i).left_inv ext)
  right_inv := by
    intro B
    funext base d
    have h :=
      (childExternalCoordinateEquivBaseDiag
        (n := n) (a := a) (cs := cs) i).right_inv (base, d)
    exact congrArg (fun bd => B bd.1 bd.2) h

@[simp] theorem externalAssignmentsEquivBaseCyclic_apply
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs)
    (A :
      ChildExternalCoordinate n a cs i →
        RawNormal.NormalAssignment n (childAt cs i))
    (base : ChildExternalBaseCoordinate n a cs i) (d : ZMod n) :
    externalAssignmentsEquivBaseCyclic
        (n := n) (a := a) (cs := cs) i A base d =
      A ((childExternalCoordinateEquivBaseDiag
        (n := n) (a := a) (cs := cs) i).symm (base, d)) := rfl

@[simp] theorem externalAssignmentsEquivBaseCyclic_symm_apply
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs)
    (B :
      ChildExternalBaseCoordinate n a cs i →
        ZMod n → RawNormal.NormalAssignment n (childAt cs i))
    (ext : ChildExternalCoordinate n a cs i) :
    (externalAssignmentsEquivBaseCyclic
        (n := n) (a := a) (cs := cs) i).symm B ext =
      B ((childExternalCoordinateEquivBaseDiag
        (n := n) (a := a) (cs := cs) i ext).1)
        ((childExternalCoordinateEquivBaseDiag
          (n := n) (a := a) (cs := cs) i ext).2) := rfl

@[simp] theorem card_childExternalCoordinate_eq_base_mul_zmod
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs) :
    Fintype.card (ChildExternalCoordinate n a cs i) =
      Fintype.card (ChildExternalBaseCoordinate n a cs i) *
        Fintype.card (ZMod n) := by
  classical
  rw [← Fintype.card_prod]
  exact Fintype.card_congr
    (childExternalCoordinateEquivBaseDiag
      (n := n) (a := a) (cs := cs) i)

def childSiblingVertexAsOtherRoot
    {a : Nat} {cs : List RTree} (i : ChildIdx cs)
    (p : ChildSiblingVertex cs i) :
    RawNormal.OtherNonRootVertex (RTree.node a cs)
      (RawNormal.childRootAtAsNonRootInNode (a := a) i) :=
  ⟨RawNormal.childVertexAtAsNonRootInNode (a := a) p.1, by
    intro haddr
    have haddr2 : p.1.1.1 :: p.1.2.1 = [i.1] := by
      simpa [RawNormal.childVertexAtAsNonRootInNode] using haddr
    have hidx : p.1.1.1 = i.1 := (List.cons.inj haddr2).1
    exact p.2 (Fin.ext hidx)⟩

@[simp] theorem childSiblingVertexAsOtherRoot_weight
    {a : Nat} {cs : List RTree} (i : ChildIdx cs)
    (p : ChildSiblingVertex cs i) :
    NonRootVertex.weight (childSiblingVertexAsOtherRoot (a := a) i p).1 =
      Vertex.weight p.1.2 := by
  simp [childSiblingVertexAsOtherRoot, childVertexAtAsNonRootInNode_weight]

def childNonRootVertexAsOtherRoot
    {a : Nat} {cs : List RTree} (i : ChildIdx cs)
    (v : NonRootVertex (childAt cs i)) :
    RawNormal.OtherNonRootVertex (RTree.node a cs)
      (RawNormal.childRootAtAsNonRootInNode (a := a) i) :=
  ⟨RawNormal.childNonRootVertexAtInNode (a := a) i v, by
    intro haddr
    have haddr2 : i.1 :: v.1.1 = [i.1] := by
      simpa using haddr
    have htail : v.1.1 = [] := (List.cons.inj haddr2).2
    exact v.2 htail⟩

@[simp] theorem childNonRootVertexAsOtherRoot_weight
    {a : Nat} {cs : List RTree} (i : ChildIdx cs)
    (v : NonRootVertex (childAt cs i)) :
    NonRootVertex.weight (childNonRootVertexAsOtherRoot (a := a) i v).1 =
      NonRootVertex.weight v := by
  simp [childNonRootVertexAsOtherRoot,
    RawNormal.childNonRootVertexAtInNode_weight]

@[simp] theorem nodeRootFieldDomainChildPiEquiv_apply_childNonRoot
    {n a : Nat} [NeZero n] {cs : List RTree}
    (rd : RawNormal.RootFieldDomain n (RTree.node a cs))
    (i : ChildIdx cs) (v : NonRootVertex (childAt cs i))
    (j : Fin (NonRootVertex.weight v)) :
    nodeRootFieldDomainChildPiEquiv n a cs rd i
        (⟨v.1, j⟩ : VertexCoordinate (childAt cs i)) =
      rd (childNonRootVertexAsOtherRoot (a := a) i v).1
        (by simpa [childNonRootVertexAsOtherRoot_weight] using j) := by
  rw [nodeRootFieldDomainChildPiEquiv_apply_childVertex]
  apply rootFieldDomain_apply_heq rd
  · apply Subtype.ext
    rfl
  · rfl

@[simp] theorem nodeRootFieldDomainChildPiEquiv_apply_childNonRootAtInNode
    {n a : Nat} [NeZero n] {cs : List RTree}
    (rd : RawNormal.RootFieldDomain n (RTree.node a cs))
    (i : ChildIdx cs) (v : NonRootVertex (childAt cs i))
    (j : Fin (NonRootVertex.weight v)) :
    nodeRootFieldDomainChildPiEquiv n a cs rd i
        (⟨v.1, j⟩ : VertexCoordinate (childAt cs i)) =
      rd (RawNormal.childNonRootVertexAtInNode (a := a) i v)
        (by simpa [RawNormal.childNonRootVertexAtInNode_weight] using j) := by
  simpa [childNonRootVertexAsOtherRoot] using
    nodeRootFieldDomainChildPiEquiv_apply_childNonRoot
      (n := n) (a := a) (cs := cs) rd i v j

@[simp] theorem singletonNodeRootFieldDomainVertexEquiv_apply_childNonRoot
    {n a : Nat} [NeZero n] (C : RTree)
    (rd : RawNormal.RootFieldDomain n (RTree.node a [C]))
    (v : NonRootVertex C) (j : Fin (NonRootVertex.weight v)) :
    singletonNodeRootFieldDomainVertexEquiv n a C rd
        (⟨v.1, j⟩ : VertexCoordinate C) =
      rd (RawNormal.childNonRootVertexAtInNode (a := a)
          (0 : ChildIdx [C]) v)
        (by simpa [RawNormal.childNonRootVertexAtInNode_weight] using j) := by
  rw [singletonNodeRootFieldDomainVertexEquiv_apply]
  rw [childVertexFieldDomainFamilySingletonEquiv_apply]
  simpa [childAt] using
    nodeRootFieldDomainChildPiEquiv_apply_childNonRootAtInNode
      (n := n) (a := a) (cs := [C]) rd
      (0 : ChildIdx [C]) v j

@[simp] theorem nodeRootFieldDomainConsChildPiEquiv_symm_singleton_childNonRoot
    {n a : Nat} [NeZero n] (C : RTree) (cs : List RTree)
    (rest : ChildVertexFieldDomainFamily n cs)
    (rdSingle : RawNormal.RootFieldDomain n (RTree.node a [C]))
    (v : NonRootVertex C) (j : Fin (NonRootVertex.weight v)) :
    ((nodeRootFieldDomainConsChildPiEquiv n a C cs).symm
        (rest, singletonNodeRootFieldDomainVertexEquiv n a C rdSingle))
      (RawNormal.childNonRootVertexAtInNode (a := a)
        (0 : ChildIdx (C :: cs)) v)
      (by simpa [RawNormal.childNonRootVertexAtInNode_weight] using j) =
    rdSingle
      (RawNormal.childNonRootVertexAtInNode (a := a)
        (0 : ChildIdx [C]) v)
      (by simpa [RawNormal.childNonRootVertexAtInNode_weight] using j) := by
  let parentRd :=
    (nodeRootFieldDomainConsChildPiEquiv n a C cs).symm
      (rest, singletonNodeRootFieldDomainVertexEquiv n a C rdSingle)
  have hpair :
      nodeRootFieldDomainConsChildPiEquiv n a C cs parentRd =
        (rest, singletonNodeRootFieldDomainVertexEquiv n a C rdSingle) := by
    simp [parentRd]
  have h :=
    congrFun (congrArg Prod.snd hpair)
      (⟨v.1, j⟩ : VertexCoordinate C)
  change
    parentRd
      (RawNormal.childNonRootVertexAtInNode (a := a)
        (0 : ChildIdx (C :: cs)) v)
      (by simpa [RawNormal.childNonRootVertexAtInNode_weight] using j) =
    rdSingle
      (RawNormal.childNonRootVertexAtInNode (a := a)
        (0 : ChildIdx [C]) v)
      (by simpa [RawNormal.childNonRootVertexAtInNode_weight] using j)
  simpa [nodeRootFieldDomainConsChildPiEquiv_apply_snd_apply,
    RawNormal.childVertexAtAsNonRootInNode,
    RawNormal.childNonRootVertexAtInNode] using h

@[simp] theorem singletonNodeRootFieldDomainVertexEquiv_symm_childNonRoot
    {n a : Nat} [NeZero n] (C : RTree)
    (F : VertexFieldDomain n C) (v : NonRootVertex C)
    (j : Fin (NonRootVertex.weight v)) :
    (singletonNodeRootFieldDomainVertexEquiv n a C).symm F
      (childNonRootVertexAsOtherRoot (a := a)
        (0 : ChildIdx [C]) v).1
      (by simpa [childNonRootVertexAsOtherRoot_weight] using j) =
    F (⟨v.1, j⟩ : VertexCoordinate C) := by
  let rd := (singletonNodeRootFieldDomainVertexEquiv n a C).symm F
  let vtx : NonRootVertex (RTree.node a [C]) :=
    RawNormal.childVertexAtAsNonRootInNode (a := a)
      (⟨(0 : ChildIdx [C]), v.1⟩ :
        RawNormal.NodeChildVertex [C])
  have hv :
      (childNonRootVertexAsOtherRoot (a := a)
        (0 : ChildIdx [C]) v).1 = vtx := by
    apply Subtype.ext
    rfl
  have hmove :
      rd (childNonRootVertexAsOtherRoot (a := a)
            (0 : ChildIdx [C]) v).1
          (by simpa [childNonRootVertexAsOtherRoot_weight] using j) =
        rd vtx (by simpa [vtx, childVertexAtAsNonRootInNode_weight] using j) := by
    apply rootFieldDomain_apply_heq rd hv
    rfl
  change rd (childNonRootVertexAsOtherRoot (a := a)
          (0 : ChildIdx [C]) v).1
        (by simpa [childNonRootVertexAsOtherRoot_weight] using j) =
      F (⟨v.1, j⟩ : VertexCoordinate C)
  rw [hmove]
  exact singletonNodeRootFieldDomainVertexEquiv_symm_childVertex
    (n := n) (a := a) C F
    (⟨v.1, j⟩ : VertexCoordinate C)

@[simp] theorem singletonNodeRootFieldDomainVertexEquiv_symm_childNonRootAtInNode
    {n a : Nat} [NeZero n] (C : RTree)
    (F : VertexFieldDomain n C) (v : NonRootVertex C)
    (j : Fin (NonRootVertex.weight v)) :
    (singletonNodeRootFieldDomainVertexEquiv n a C).symm F
      (RawNormal.childNonRootVertexAtInNode (a := a)
        (0 : ChildIdx [C]) v)
      (by simpa [RawNormal.childNonRootVertexAtInNode_weight] using j) =
    F (⟨v.1, j⟩ : VertexCoordinate C) := by
  simpa [childNonRootVertexAsOtherRoot] using
    singletonNodeRootFieldDomainVertexEquiv_symm_childNonRoot
      (n := n) (a := a) C F v j

@[simp] theorem nonRootVertexNodeEquivChildVertex_childVertexAtAsNonRootInNode
    {a : Nat} {cs : List RTree}
    (p : RawNormal.NodeChildVertex cs) :
    RawNormal.nonRootVertexNodeEquivChildVertex a cs
        (RawNormal.childVertexAtAsNonRootInNode (a := a) p) =
      p :=
  (RawNormal.nonRootVertexNodeEquivChildVertex a cs).right_inv p

@[simp] theorem nonRootVertexNodeEquivChildVertex_childSiblingVertexAsOtherRoot
    {a : Nat} {cs : List RTree} (i : ChildIdx cs)
    (p : ChildSiblingVertex cs i) :
    RawNormal.nonRootVertexNodeEquivChildVertex a cs
        (childSiblingVertexAsOtherRoot (a := a) i p).1 =
      p.1 := by
  change
    RawNormal.nonRootVertexNodeEquivChildVertex a cs
        (RawNormal.childVertexAtAsNonRootInNode (a := a) p.1) =
      p.1
  simp

@[simp] theorem nonRootVertexNodeEquivChildVertex_childNonRootVertexAsOtherRoot
    {a : Nat} {cs : List RTree} (i : ChildIdx cs)
    (v : NonRootVertex (childAt cs i)) :
    RawNormal.nonRootVertexNodeEquivChildVertex a cs
        (childNonRootVertexAsOtherRoot (a := a) i v).1 =
      (⟨i, v.1⟩ : RawNormal.NodeChildVertex cs) := by
  exact
    (RawNormal.nonRootVertexNodeEquivChildVertex a cs).right_inv
      (⟨i, v.1⟩ : RawNormal.NodeChildVertex cs)

@[simp] theorem nodeChildVertexEquivKind_apply_root
    {cs : List RTree} (i : ChildIdx cs) :
    RawNormal.nodeChildVertexEquivKind cs
        (⟨i, Vertex.root (childAt cs i)⟩ : RawNormal.NodeChildVertex cs) =
      (⟨i, Sum.inl ()⟩ : RawNormal.NodeChildVertexKind cs) := by
  apply (RawNormal.nodeChildVertexEquivKind cs).symm.injective
  simp

@[simp] theorem nodeChildVertexEquivKind_apply_nonRoot
    {cs : List RTree} (i : ChildIdx cs)
    (v : NonRootVertex (childAt cs i)) :
    RawNormal.nodeChildVertexEquivKind cs
        (⟨i, v.1⟩ : RawNormal.NodeChildVertex cs) =
      (⟨i, Sum.inr v⟩ : RawNormal.NodeChildVertexKind cs) := by
  apply (RawNormal.nodeChildVertexEquivKind cs).symm.injective
  simp

inductive ChildRootOtherSplit (cs : List RTree) (i : ChildIdx cs) where
  | sibling :
      ChildSiblingVertex cs i →
      ChildRootOtherSplit cs i
  | childNonRoot :
      NonRootVertex (childAt cs i) →
      ChildRootOtherSplit cs i

namespace ChildRootOtherSplit

def weight {cs : List RTree} {i : ChildIdx cs} :
    ChildRootOtherSplit cs i → Nat
  | sibling p => Vertex.weight p.1.2
  | childNonRoot v => NonRootVertex.weight v

@[simp] theorem weight_sibling
    {cs : List RTree} {i : ChildIdx cs}
    (p : ChildSiblingVertex cs i) :
    weight (sibling p) = Vertex.weight p.1.2 := rfl

@[simp] theorem weight_childNonRoot
    {cs : List RTree} {i : ChildIdx cs}
    (v : NonRootVertex (childAt cs i)) :
    weight (childNonRoot v) = NonRootVertex.weight v := rfl

end ChildRootOtherSplit

noncomputable def childRootOtherSplitToOtherNonRootVertex
    {a : Nat} {cs : List RTree} (i : ChildIdx cs) :
    ChildRootOtherSplit cs i →
      RawNormal.OtherNonRootVertex (RTree.node a cs)
        (RawNormal.childRootAtAsNonRootInNode (a := a) i)
  | ChildRootOtherSplit.sibling p =>
      childSiblingVertexAsOtherRoot (a := a) i p
  | ChildRootOtherSplit.childNonRoot v =>
      childNonRootVertexAsOtherRoot (a := a) i v

@[simp] theorem childRootOtherSplitToOtherNonRootVertex_weight
    {a : Nat} {cs : List RTree} (i : ChildIdx cs)
    (s : ChildRootOtherSplit cs i) :
    NonRootVertex.weight
        (childRootOtherSplitToOtherNonRootVertex
          (a := a) (cs := cs) i s).1 =
      ChildRootOtherSplit.weight s := by
  cases s with
  | sibling p =>
      simp [childRootOtherSplitToOtherNonRootVertex,
        ChildRootOtherSplit.weight]
  | childNonRoot v =>
      simp [childRootOtherSplitToOtherNonRootVertex,
        ChildRootOtherSplit.weight]

theorem childRootOther_not_root_kind_case_contradiction
    {a : Nat} {cs : List RTree} (i : ChildIdx cs)
    (u :
      RawNormal.OtherNonRootVertex (RTree.node a cs)
        (RawNormal.childRootAtAsNonRootInNode (a := a) i))
    (h :
      RawNormal.nonRootVertexNodeEquivChildVertex a cs u.1 =
        (⟨i, Vertex.root (childAt cs i)⟩ :
          RawNormal.NodeChildVertex cs)) :
    False := by
  have hu :
      u.1 = RawNormal.childRootAtAsNonRootInNode (a := a) i := by
    calc
      u.1 =
          (RawNormal.nonRootVertexNodeEquivChildVertex a cs).symm
            (RawNormal.nonRootVertexNodeEquivChildVertex a cs u.1) := by
        exact
          ((RawNormal.nonRootVertexNodeEquivChildVertex a cs).left_inv
            u.1).symm
      _ =
          (RawNormal.nonRootVertexNodeEquivChildVertex a cs).symm
            (⟨i, Vertex.root (childAt cs i)⟩ :
              RawNormal.NodeChildVertex cs) := by
        rw [h]
      _ = RawNormal.childRootAtAsNonRootInNode (a := a) i := by
        simpa using
          RawNormal.nonRootVertexNodeEquivChildVertex_symm_kind_root
            (a := a) (cs := cs) i
  exact u.2 (by
    simpa using congrArg (fun v : NonRootVertex (RTree.node a cs) => v.1.1) hu)

theorem childRootOtherSplitToOtherNonRootVertex_surjective
    {a : Nat} {cs : List RTree} (i : ChildIdx cs) :
    Function.Surjective
      (childRootOtherSplitToOtherNonRootVertex
        (a := a) (cs := cs) i) := by
  classical
  intro u
  match hp : RawNormal.nonRootVertexNodeEquivChildVertex a cs u.1 with
  | ⟨k, w⟩ =>
      by_cases hki : k = i
      · subst k
        by_cases hroot : w.1 = []
        · exact False.elim
            (childRootOther_not_root_kind_case_contradiction
              (a := a) (cs := cs) i u
              (by
                rw [hp]
                have hw : w = Vertex.root (childAt cs i) := by
                  apply Subtype.ext
                  exact hroot
                exact congrArg
                  (fun w : Vertex (childAt cs i) =>
                    (⟨i, w⟩ : RawNormal.NodeChildVertex cs)) hw))
        · refine ⟨ChildRootOtherSplit.childNonRoot ⟨w, hroot⟩, ?_⟩
          apply Subtype.ext
          apply (RawNormal.nonRootVertexNodeEquivChildVertex a cs).injective
          have hmap :=
            nonRootVertexNodeEquivChildVertex_childNonRootVertexAsOtherRoot
              (a := a) (cs := cs) i ⟨w, hroot⟩
          simpa [childRootOtherSplitToOtherNonRootVertex, hp] using hmap
      · refine ⟨ChildRootOtherSplit.sibling ⟨⟨k, w⟩, hki⟩, ?_⟩
        apply Subtype.ext
        apply (RawNormal.nonRootVertexNodeEquivChildVertex a cs).injective
        have hmap :=
          nonRootVertexNodeEquivChildVertex_childSiblingVertexAsOtherRoot
            (a := a) (cs := cs) i ⟨⟨k, w⟩, hki⟩
        simpa [childRootOtherSplitToOtherNonRootVertex, hp] using hmap

theorem childRootOtherSplitToOtherNonRootVertex_injective
    {a : Nat} {cs : List RTree} (i : ChildIdx cs) :
    Function.Injective
      (childRootOtherSplitToOtherNonRootVertex
        (a := a) (cs := cs) i) := by
  classical
  intro s t h
  cases s with
  | sibling p =>
      cases t with
      | sibling q =>
          have hmap :=
            congrArg
              (fun u =>
                RawNormal.nonRootVertexNodeEquivChildVertex a cs u.1)
              h
          rcases p with ⟨p, hp⟩
          rcases q with ⟨q, hq⟩
          simp [childRootOtherSplitToOtherNonRootVertex] at hmap
          cases hmap
          rfl
      | childNonRoot v =>
          have hmap :=
            congrArg
              (fun u =>
                RawNormal.nonRootVertexNodeEquivChildVertex a cs u.1)
              h
          rcases p with ⟨p, hp⟩
          simp [childRootOtherSplitToOtherNonRootVertex] at hmap
          have hidx : p.1 = i :=
            congrArg (fun x : RawNormal.NodeChildVertex cs => x.1) hmap
          exact False.elim (hp hidx)
  | childNonRoot v =>
      cases t with
      | sibling p =>
          have hmap :=
            congrArg
              (fun u =>
                RawNormal.nonRootVertexNodeEquivChildVertex a cs u.1)
              h
          rcases p with ⟨p, hp⟩
          simp [childRootOtherSplitToOtherNonRootVertex] at hmap
          have hidx : i = p.1 :=
            congrArg (fun x : RawNormal.NodeChildVertex cs => x.1) hmap
          exact False.elim (hp hidx.symm)
      | childNonRoot w =>
          have hmap :=
            congrArg
              (fun u =>
                RawNormal.nonRootVertexNodeEquivChildVertex a cs u.1)
              h
          simp [childRootOtherSplitToOtherNonRootVertex] at hmap
          have hvw : v = w := by
            exact Subtype.ext hmap
          cases hvw
          rfl

theorem childRootOther_cases
    {a : Nat} {cs : List RTree} (i : ChildIdx cs)
    (u :
      RawNormal.OtherNonRootVertex (RTree.node a cs)
        (RawNormal.childRootAtAsNonRootInNode (a := a) i))
    {P :
      RawNormal.OtherNonRootVertex (RTree.node a cs)
        (RawNormal.childRootAtAsNonRootInNode (a := a) i) → Prop}
    (hsib :
      ∀ p : ChildSiblingVertex cs i,
        P (childRootOtherSplitToOtherNonRootVertex
          (a := a) (cs := cs) i
          (ChildRootOtherSplit.sibling p)))
    (hnon :
      ∀ v : NonRootVertex (childAt cs i),
        P (childRootOtherSplitToOtherNonRootVertex
          (a := a) (cs := cs) i
          (ChildRootOtherSplit.childNonRoot v))) :
    P u := by
  rcases childRootOtherSplitToOtherNonRootVertex_surjective
      (a := a) (cs := cs) i u with ⟨s, rfl⟩
  cases s with
  | sibling p => exact hsib p
  | childNonRoot v => exact hnon v

noncomputable def otherRootSplitEquiv
    {a : Nat} {cs : List RTree} (i : ChildIdx cs) :
    RawNormal.OtherNonRootVertex
      (RTree.node a cs)
      (RawNormal.childRootAtAsNonRootInNode (a := a) i) ≃
    ChildRootOtherSplit cs i :=
  (Equiv.ofBijective
    (childRootOtherSplitToOtherNonRootVertex
      (a := a) (cs := cs) i)
    ⟨childRootOtherSplitToOtherNonRootVertex_injective
        (a := a) (cs := cs) i,
      childRootOtherSplitToOtherNonRootVertex_surjective
        (a := a) (cs := cs) i⟩).symm

@[simp] theorem otherRootSplitEquiv_apply_sibling
    {a : Nat} {cs : List RTree} (i : ChildIdx cs)
    (p : ChildSiblingVertex cs i) :
    otherRootSplitEquiv (a := a) (cs := cs) i
        (childSiblingVertexAsOtherRoot (a := a) i p) =
      ChildRootOtherSplit.sibling p := by
  change
    otherRootSplitEquiv (a := a) (cs := cs) i
        (childRootOtherSplitToOtherNonRootVertex
          (a := a) (cs := cs) i
          (ChildRootOtherSplit.sibling p)) =
      ChildRootOtherSplit.sibling p
  exact
    (otherRootSplitEquiv (a := a) (cs := cs) i).right_inv
      (ChildRootOtherSplit.sibling p)

@[simp] theorem otherRootSplitEquiv_apply_childNonRoot
    {a : Nat} {cs : List RTree} (i : ChildIdx cs)
    (v : NonRootVertex (childAt cs i)) :
    otherRootSplitEquiv (a := a) (cs := cs) i
        (childNonRootVertexAsOtherRoot (a := a) i v) =
      ChildRootOtherSplit.childNonRoot v := by
  change
    otherRootSplitEquiv (a := a) (cs := cs) i
        (childRootOtherSplitToOtherNonRootVertex
          (a := a) (cs := cs) i
          (ChildRootOtherSplit.childNonRoot v)) =
      ChildRootOtherSplit.childNonRoot v
  exact
    (otherRootSplitEquiv (a := a) (cs := cs) i).right_inv
      (ChildRootOtherSplit.childNonRoot v)

def childRootOtherCoordFromSplit
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs)
    (x :
      ChildExternalCoordinate n a cs i ×
        RawNormal.RootFieldDomain n (childAt cs i)) :
    (s : ChildRootOtherSplit cs i) →
      Fin (ChildRootOtherSplit.weight s) → ZMod n
  | ChildRootOtherSplit.sibling p, j => x.1.siblingCoord p j
  | ChildRootOtherSplit.childNonRoot v, j => x.2 v j

theorem weight_eq_split_weight_of_otherRootSplitEquiv
    {a : Nat} {cs : List RTree} (i : ChildIdx cs)
    (u :
      RawNormal.OtherNonRootVertex (RTree.node a cs)
        (RawNormal.childRootAtAsNonRootInNode (a := a) i)) :
    NonRootVertex.weight u.1 =
      ChildRootOtherSplit.weight
        (otherRootSplitEquiv (a := a) (cs := cs) i u) := by
  exact
    childRootOther_cases (a := a) (cs := cs) i u
      (P := fun u =>
        NonRootVertex.weight u.1 =
          ChildRootOtherSplit.weight
            (otherRootSplitEquiv (a := a) (cs := cs) i u))
      (by
        intro p
        simp [childRootOtherSplitToOtherNonRootVertex])
      (by
        intro v
        simp [childRootOtherSplitToOtherNonRootVertex])

