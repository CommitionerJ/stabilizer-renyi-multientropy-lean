theorem verifiedShape_node_leafChildren
    {a : Nat} {cs : List RTree}
    (hshape : VerifiedShape (RTree.node a cs)) :
    ∀ i : ChildIdx cs,
      ∃ b : Nat, 0 < b ∧ childAt cs i = RTree.node b [] := by
  cases hshape with
  | leaf a ha =>
      intro i
      exact Fin.elim0 i
  | edge a b ha hb =>
      intro i
      have hi0 : i = (0 : ChildIdx [RTree.node b []]) := by
        apply Fin.ext
        change i.1 = 0
        have hlt : i.1 < 1 := by
          simpa using i.2
        omega
      subst i
      exact ⟨b, hb, rfl⟩
  | star a b c ha hb hc =>
      intro i
      fin_cases i
      · exact ⟨b, hb, rfl⟩
      · exact ⟨c, hc, rfl⟩

