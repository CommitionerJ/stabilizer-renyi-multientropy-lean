noncomputable def boundaryZeroRootFieldEquivCoefficientKernel
    (n a : Nat) [NeZero n] (cs : List RTree) :
    { R : RawNormal.NodeRootFieldAssignment n a cs //
      ∀ i : ChildIdx cs,
        childBoundaryLinearFormAt (n := n) (a := a) cs R i = 0 } ≃
    LinearMap.ker (childBoundaryCoefficientMap (n := n) (a := a) cs) where
