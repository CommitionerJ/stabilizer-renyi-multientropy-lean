      simpa using hi
    exact
      (childBoundaryLinearFormAt_eq_zero_iff_coefficientAt_eq_zero
        (n := n) (a := a) (cs := cs) R i).2 hcoeff
  · intro hzero
    funext i d
    have hcoeff :
        childBoundaryCoefficientAt (n := n) (a := a) cs R i = 0 :=
      (childBoundaryLinearFormAt_eq_zero_iff_coefficientAt_eq_zero
        (n := n) (a := a) (cs := cs) R i).1 (hzero i)
