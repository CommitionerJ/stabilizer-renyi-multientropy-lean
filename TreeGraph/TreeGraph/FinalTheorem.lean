        ∃ M : OpenRootMessageSpace n cs,
          openRootMessageSpaceRootFieldEmbeddingOfNode n a cs M = R) :
    ChildOpenRootFourierKernelCanonicalAt a cs n R i := by
  classical
  refine
    childOpenRootFourierKernelCanonicalAt_leaf_child_of_boundary_character
      (R := R) (i := i) hchild ?_ hzero_iff
  calc
    ((Fintype.card
        (RawNormal.NodeChildRootFieldDomain n a cs i → F2) : Nat) : ℤ)
