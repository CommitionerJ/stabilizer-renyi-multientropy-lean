      ((childBoundaryCoefficientMapAt (n := n) (a := a) cs i).map_add R S)
      d
  map_smul' r R := by
    funext i d
    exact congrFun
      ((childBoundaryCoefficientMapAt (n := n) (a := a) cs i).map_smul r R)
      d

@[simp] theorem childBoundaryCoefficientMap_apply
    {n a : Nat} [NeZero n] {cs : List RTree}
    (R : RawNormal.NodeRootFieldAssignment n a cs) (i : ChildIdx cs) :
    childBoundaryCoefficientMap (n := n) (a := a) cs R i =
