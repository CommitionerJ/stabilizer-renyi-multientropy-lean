noncomputable def cyclicChildRootBoundaryAdjacentSliceProjectionLinearMap
    {n b : Nat} [NeZero n] (ds : List RTree) :
    CyclicNodeChildRootSliceFamily n b ds →ₗ[F2]
      (RawNormal.RootFieldDomain n (RTree.node b ds) → F2) :=
  (cyclicChildRootBoundarySliceProjectionLinearMap
    (n := n) (b := b) ds).comp
    ((LinearMap.id :
        CyclicNodeChildRootSliceFamily n b ds →ₗ[F2]
          CyclicNodeChildRootSliceFamily n b ds) +
      (cyclicChildRootSliceDiagonalShiftLinearEquiv
        (n := n) (b := b) ds (1 : ZMod n)).toLinearMap)

theorem cyclicChildRootBoundaryAdjacentSliceProjectionLinearMap_apply
    {n b : Nat} [NeZero n] (ds : List RTree)
    (Θ : CyclicNodeChildRootSliceFamily n b ds) :
    cyclicChildRootBoundaryAdjacentSliceProjectionLinearMap
        (n := n) (b := b) ds Θ =
      cyclicChildRootBoundarySliceProjectionLinearMap
        (n := n) (b := b) ds
        (Θ +
          cyclicChildRootSliceDiagonalShiftLinearEquiv
            (n := n) (b := b) ds (1 : ZMod n) Θ) := by
  rfl

theorem cyclicChildRootBoundaryAdjacentSliceProjectionLinearMap_apply_apply
    {n b : Nat} [NeZero n] (ds : List RTree)
    (Θ : CyclicNodeChildRootSliceFamily n b ds)
    (rd : RawNormal.RootFieldDomain n (RTree.node b ds)) :
    cyclicChildRootBoundaryAdjacentSliceProjectionLinearMap
        (n := n) (b := b) ds Θ rd =
      ∑ j : ChildIdx ds,
        (rootBoundaryChildMessageSumAt
            (n := n) (b := b) ds j (Θ j) rd 0 +
          rootBoundaryChildMessageSumAt
            (n := n) (b := b) ds j (Θ j) rd 1) := by
  classical
  rw [cyclicChildRootBoundaryAdjacentSliceProjectionLinearMap_apply]
  rw [cyclicChildRootBoundarySliceProjectionLinearMap_apply]
  refine Finset.sum_congr rfl ?_
  intro j _hj
  rw [rootBoundaryChildMessageZeroLinearMap_apply]
  change
    rootBoundaryChildMessageSumAt
        (n := n) (b := b) ds j
        (Θ j +
          (cyclicChildRootSliceDiagonalShiftLinearEquiv
            (n := n) (b := b) ds (1 : ZMod n) Θ) j) rd 0 =
      rootBoundaryChildMessageSumAt
          (n := n) (b := b) ds j (Θ j) rd 0 +
        rootBoundaryChildMessageSumAt
          (n := n) (b := b) ds j (Θ j) rd 1
  rw [rootBoundaryChildMessageSumAt_add_apply]
  change
    rootBoundaryChildMessageSumAt
        (n := n) (b := b) ds j (Θ j) rd 0 +
      rootBoundaryChildMessageSumAt
        (n := n) (b := b) ds j
        (nodeChildRootFieldFunctionDiagonalShiftLinearEquiv
          (n := n) (b := b) ds j (1 : ZMod n) (Θ j)) rd 0 =
      rootBoundaryChildMessageSumAt
          (n := n) (b := b) ds j (Θ j) rd 0 +
        rootBoundaryChildMessageSumAt
          (n := n) (b := b) ds j (Θ j) rd 1
  rw [← rootBoundaryChildMessageSumAt_one_eq_diagonalShift_zero
    (n := n) (b := b) ds j (Θ j) rd]

theorem dotLinear_root_adjacentSliceProjection_eq_sum_childBoundaryLinearFormAt
    {n b : Nat} [NeZero n] (ds : List RTree)
    (R : RawNormal.NodeRootFieldAssignment n b ds)
    (Θ : CyclicNodeChildRootSliceFamily n b ds) :
    dotLinear (RawNormal.RootFieldDomain n (RTree.node b ds))
        (cyclicChildRootBoundaryAdjacentSliceProjectionLinearMap
          (n := n) (b := b) ds Θ) R =
      ∑ j : ChildIdx ds,
        childBoundaryLinearFormAt (n := n) (a := b) ds R j (Θ j) := by
  classical
  calc
    dotLinear (RawNormal.RootFieldDomain n (RTree.node b ds))
        (cyclicChildRootBoundaryAdjacentSliceProjectionLinearMap
          (n := n) (b := b) ds Θ) R =
        ∑ rd : RawNormal.RootFieldDomain n (RTree.node b ds),
          R rd *
            (∑ j : ChildIdx ds,
              (rootBoundaryChildMessageSumAt
                  (n := n) (b := b) ds j (Θ j) rd 0 +
                rootBoundaryChildMessageSumAt
                  (n := n) (b := b) ds j (Θ j) rd 1)) := by
          simp [dotLinear,
            cyclicChildRootBoundaryAdjacentSliceProjectionLinearMap_apply_apply]
    _ =
        ∑ rd : RawNormal.RootFieldDomain n (RTree.node b ds),
          ∑ j : ChildIdx ds,
            R rd *
              (rootBoundaryChildMessageSumAt
                  (n := n) (b := b) ds j (Θ j) rd 0 +
                rootBoundaryChildMessageSumAt
                  (n := n) (b := b) ds j (Θ j) rd 1) := by
          refine Finset.sum_congr rfl ?_
          intro rd _hrd
          rw [Finset.mul_sum]
    _ =
        ∑ j : ChildIdx ds,
          ∑ rd : RawNormal.RootFieldDomain n (RTree.node b ds),
            R rd *
              (rootBoundaryChildMessageSumAt
                  (n := n) (b := b) ds j (Θ j) rd 0 +
                rootBoundaryChildMessageSumAt
                  (n := n) (b := b) ds j (Θ j) rd 1) := by
          rw [Finset.sum_comm]
    _ =
        ∑ j : ChildIdx ds,
          childBoundaryLinearFormAt (n := n) (a := b) ds R j (Θ j) := by
          refine Finset.sum_congr rfl ?_
          intro j _hj
          rw [childBoundaryLinearFormAt_eq_sum_rootBoundaryChildMessageSums
            (n := n) (b := b) ds R j (Θ j)]

theorem dotLinear_root_adjacentSliceProjection_single_eq_childBoundaryLinearFormAt
    {n b : Nat} [NeZero n] (ds : List RTree)
    (R : RawNormal.NodeRootFieldAssignment n b ds)
    (i : ChildIdx ds)
    (φ : RawNormal.NodeChildRootFieldDomain n b ds i → F2) :
    dotLinear (RawNormal.RootFieldDomain n (RTree.node b ds))
        (cyclicChildRootBoundaryAdjacentSliceProjectionLinearMap
          (n := n) (b := b) ds
          (Pi.single (M := fun j : ChildIdx ds =>
            RawNormal.NodeChildRootFieldDomain n b ds j → F2) i φ)) R =
      childBoundaryLinearFormAt (n := n) (a := b) ds R i φ := by
  rw [dotLinear_root_adjacentSliceProjection_eq_sum_childBoundaryLinearFormAt
    (n := n) (b := b) ds R
    (Pi.single (M := fun j : ChildIdx ds =>
      RawNormal.NodeChildRootFieldDomain n b ds j → F2) i φ)]
  rw [Fintype.sum_eq_single i]
  · simp [Pi.single_eq_same]
  · intro j hj
    simp [Pi.single_eq_of_ne hj]

theorem exists_childBoundaryLinearFormAt_apply_eq_one_iff_adjacentSliceProjection_single_ne_zero
    {n b : Nat} [NeZero n] (ds : List RTree)
    (i : ChildIdx ds)
    (φ : RawNormal.NodeChildRootFieldDomain n b ds i → F2) :
    (∃ R : RawNormal.NodeRootFieldAssignment n b ds,
      childBoundaryLinearFormAt (n := n) (a := b) ds R i φ = 1) ↔
      cyclicChildRootBoundaryAdjacentSliceProjectionLinearMap
          (n := n) (b := b) ds
          (Pi.single (M := fun j : ChildIdx ds =>
            RawNormal.NodeChildRootFieldDomain n b ds j → F2) i φ) ≠ 0 := by
  classical
  let P : RawNormal.RootFieldDomain n (RTree.node b ds) → F2 :=
    cyclicChildRootBoundaryAdjacentSliceProjectionLinearMap
      (n := n) (b := b) ds
      (Pi.single (M := fun j : ChildIdx ds =>
        RawNormal.NodeChildRootFieldDomain n b ds j → F2) i φ)
  constructor
  · rintro ⟨R, hR⟩ hP
    have hdot_zero :
        dotLinear (RawNormal.RootFieldDomain n (RTree.node b ds)) P R = 0 := by
      have hdot_map :
          dotLinear (RawNormal.RootFieldDomain n (RTree.node b ds)) P = 0 :=
        (dotLinear_eq_zero_iff
          (RawNormal.RootFieldDomain n (RTree.node b ds)) P).2 hP
      simpa using
        congrArg
          (fun L :
            (RawNormal.NodeRootFieldAssignment n b ds) →ₗ[F2] F2 =>
            L R) hdot_map
    have hdot_eq :
        dotLinear (RawNormal.RootFieldDomain n (RTree.node b ds)) P R =
          childBoundaryLinearFormAt (n := n) (a := b) ds R i φ := by
      simpa [P] using
        dotLinear_root_adjacentSliceProjection_single_eq_childBoundaryLinearFormAt
          (n := n) (b := b) ds R i φ
    have hone_zero : (1 : F2) = 0 := by
      exact hR.symm.trans (hdot_eq.symm.trans hdot_zero)
    exact one_ne_zero hone_zero
  · intro hP
    have hdot_ne :
        dotLinear (RawNormal.RootFieldDomain n (RTree.node b ds)) P ≠ 0 := by
      intro hdot_zero
      exact hP
        ((dotLinear_eq_zero_iff
          (RawNormal.RootFieldDomain n (RTree.node b ds)) P).1 hdot_zero)
    rcases exists_apply_eq_one_of_linearMap_ne_zero
        (dotLinear (RawNormal.RootFieldDomain n (RTree.node b ds)) P)
        hdot_ne with
      ⟨R, hR⟩
    refine ⟨R, ?_⟩
    have hdot_eq :
        dotLinear (RawNormal.RootFieldDomain n (RTree.node b ds)) P R =
          childBoundaryLinearFormAt (n := n) (a := b) ds R i φ := by
      simpa [P] using
        dotLinear_root_adjacentSliceProjection_single_eq_childBoundaryLinearFormAt
          (n := n) (b := b) ds R i φ
    exact hdot_eq.symm.trans hR

theorem exists_adjacentSliceProjection_single_single_ne_zero_of_childBoundaryLinearFormAt_ne_zero
    {n b : Nat} [NeZero n] (ds : List RTree)
    (R : RawNormal.NodeRootFieldAssignment n b ds)
    (i : ChildIdx ds)
    (hnonzero :
      childBoundaryLinearFormAt (n := n) (a := b) ds R i ≠ 0) :
    ∃ d : RawNormal.NodeChildRootFieldDomain n b ds i,
      cyclicChildRootBoundaryAdjacentSliceProjectionLinearMap
          (n := n) (b := b) ds
          (Pi.single (M := fun j : ChildIdx ds =>
            RawNormal.NodeChildRootFieldDomain n b ds j → F2) i
            (Pi.single
              (M := fun _ : RawNormal.NodeChildRootFieldDomain n b ds i =>
                F2)
              d (1 : F2))) ≠ 0 := by
  rcases
      exists_single_childBoundaryLinearFormAt_eq_one_of_ne_zero
        (n := n) (a := b) ds R i hnonzero with
    ⟨d, hd⟩
  refine ⟨d, ?_⟩
  exact
    (exists_childBoundaryLinearFormAt_apply_eq_one_iff_adjacentSliceProjection_single_ne_zero
      (n := n) (b := b) ds i
      (Pi.single
        (M := fun _ : RawNormal.NodeChildRootFieldDomain n b ds i => F2)
        d (1 : F2))).1
      ⟨R, hd⟩

theorem cyclicChildRootBoundaryAdjacentSliceProjectionLinearMap_pi_single
    {n b : Nat} [NeZero n] (ds : List RTree)
    (i : ChildIdx ds)
    (φ : RawNormal.NodeChildRootFieldDomain n b ds i → F2)
    (rd : RawNormal.RootFieldDomain n (RTree.node b ds)) :
    cyclicChildRootBoundaryAdjacentSliceProjectionLinearMap
        (n := n) (b := b) ds
        (Pi.single (M := fun j : ChildIdx ds =>
          RawNormal.NodeChildRootFieldDomain n b ds j → F2) i φ) rd =
      rootBoundaryChildMessageSumAt (n := n) (b := b) ds i φ rd 0 +
        rootBoundaryChildMessageSumAt (n := n) (b := b) ds i φ rd 1 := by
  rw [cyclicChildRootBoundaryAdjacentSliceProjectionLinearMap_apply_apply]
  rw [Fintype.sum_eq_single i]
  · simp [Pi.single_eq_same]
  · intro j hj
    simp [Pi.single_eq_of_ne hj, rootBoundaryChildMessageSumAt,
      nodeChildRootFieldAsMessage, nonRootFieldDomainFunctionAsMessage]

theorem cyclicChildRootBoundaryAdjacentSliceProjectionLinearMap_pi_single_eq_zeroSlices_firstCoordinateShift
    {n b : Nat} [NeZero n] (ds : List RTree)
