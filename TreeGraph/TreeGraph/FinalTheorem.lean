          intro Acyc _
          exact hfactor Acyc
    _ =
        ∏ base : ChildExternalBaseCoordinate n a cs i,
          ∑ B : ZMod n → RawNormal.NormalAssignment n (childAt cs i),
            W base B := by
          simpa using
            (sum_pi_product_dep
              (ι := ChildExternalBaseCoordinate n a cs i)
              (α := fun _base =>
                ZMod n → RawNormal.NormalAssignment n (childAt cs i))
              (R := ℤ)
              (fun base
                (B : ZMod n → RawNormal.NormalAssignment n (childAt cs i)) =>
                W base B))
    _ =
        ∏ _base : ChildExternalBaseCoordinate n a cs i,
          (2 : ℤ) ^ (X * Z) := by
          refine Finset.prod_congr rfl ?_
          intro base _
          simpa [X, Z] using hcyclic base
    _ =
        ((2 : ℤ) ^ (X * Z)) ^ Bc := by
          simp [Bc]
    _ =
        (2 : ℤ) ^ ((X * Z) * Bc) := by
          simp only [← pow_mul]
    _ =
        (2 : ℤ) ^
          (Int.toNat (Xassign n (childAt cs i)) *
            Fintype.card (ChildExternalCoordinate n a cs i)) := by
          congr 1
          simp [X, Z, Bc, card_childExternalCoordinate_eq_base_mul_zmod]
          ac_rfl

noncomputable def cyclicRootTwistedKetAtVertex
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs)
    (B :
      ZMod n → RawNormal.NormalAssignment n (childAt cs i))
    (d : ZMod n)
    (site : RawNormal.NormalSite n (childAt cs i))
    (v : Vertex (childAt cs i)) : F2 :=
  if hv : v.1 = [] then
    (B d).rootField site.nonRootCoord
  else
    (B d).nodeField ⟨v, hv⟩
      (RawNormal.nonRootDomainOfSite site ⟨v, hv⟩ 0)

