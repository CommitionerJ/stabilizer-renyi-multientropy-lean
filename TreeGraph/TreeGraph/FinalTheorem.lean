@[simp] theorem nodeChildNormalSiteRecompose_sibling_nonRootCoord
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs) (hchildRoot : 0 < (childAt cs i).rootWeight)
    (x :
      ChildExternalCoordinate n a cs i ×
        RawNormal.NormalSite n (childAt cs i))
    (p : ChildSiblingVertex cs i) (j : Fin (Vertex.weight p.1.2)) :
    (nodeChildNormalSiteRecompose
      (n := n) (a := a) (cs := cs) i hchildRoot x).nonRootCoord
      (RawNormal.childVertexAtAsNonRootInNode (a := a) p.1)
      (by
        simpa [childVertexAtAsNonRootInNode_weight] using j) =
      x.1.siblingCoord p j := by
  have hnot :
      ¬ ((p.1.1 : Nat) = (i : Nat) ∧ p.1.2.1 = []) := by
    intro h
    exact p.2 (Fin.ext h.1)
  have hbase :=
    nodeChildRootFieldDomainRecompose_siblingCoord
      (n := n) (a := a) (cs := cs) i
      (x := (x.1, x.2.nonRootCoord)) p j
  simpa [nodeChildNormalSiteRecompose, hnot, childSiblingVertexAsOtherRoot]
    using hbase

@[simp] theorem nodeChildNormalSiteRecompose_childNonRoot_nonRootCoord
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs) (hchildRoot : 0 < (childAt cs i).rootWeight)
