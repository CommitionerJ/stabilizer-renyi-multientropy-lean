    RawNormal.RootFieldAssignment n T ≃ₗ[F2]
      (RootFieldOtherCoord n T v →
        (Fin (NonRootVertex.weight v) → ZMod n) → F2) :=
  (rootFieldAssignmentOtherTupleLinearEquiv (n := n) (T := T) v).trans
    (prodFunctionCurryLinearEquiv
      (RootFieldOtherCoord n T v)
