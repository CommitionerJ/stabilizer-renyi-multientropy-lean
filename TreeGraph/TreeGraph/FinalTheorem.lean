theorem rawExpandedEdgeSignedSum_node_openRootExponent_of_rawBitString
    {a : Nat} {cs : List RTree} {n : Nat} [NeZero n]
    (hraw :
      rawBitStringSignedSum n (RTree.node a cs) =
        (2 : ℤ) ^ Int.toNat (openRootNodeExponent n a cs)) :
    rawExpandedEdgeSignedSum n (RTree.node a cs) =
      (2 : ℤ) ^ Int.toNat (openRootNodeExponent n a cs) := by
  have hphase :
      (∑ Araw :
        { Araw : RawAssignment n (RTree.node a cs) //
          RealizedByNormal (RTree.node a cs) Araw },
        bitSign
          (∑ site : RawNormal.NormalSite n (RTree.node a cs),
            ((RTree.edgeList (RTree.node a cs)).map
              (localEdgePhase Araw.1 site)).sum)) =
        (2 : ℤ) ^ Int.toNat (openRootNodeExponent n a cs) := by
    simpa [rawBitStringSignedSum, weight, totalPhase, phaseAtSite] using hraw
  exact
    (rawExpandedEdgeSignedSum_eq_edgePhaseSum
      (n := n) (T := RTree.node a cs)).trans hphase

theorem rawBitString_node_openRootExponent_of_rawExpandedEdgeSignedSum
    {a : Nat} {cs : List RTree} {n : Nat} [NeZero n]
    (hexpanded :
      rawExpandedEdgeSignedSum n (RTree.node a cs) =
        (2 : ℤ) ^ Int.toNat (openRootNodeExponent n a cs)) :
    rawBitStringSignedSum n (RTree.node a cs) =
      (2 : ℤ) ^ Int.toNat (openRootNodeExponent n a cs) := by
  have hphase :
      (∑ Araw :
        { Araw : RawAssignment n (RTree.node a cs) //
          RealizedByNormal (RTree.node a cs) Araw },
        bitSign
          (∑ site : RawNormal.NormalSite n (RTree.node a cs),
            ((RTree.edgeList (RTree.node a cs)).map
              (localEdgePhase Araw.1 site)).sum)) =
        (2 : ℤ) ^ Int.toNat (openRootNodeExponent n a cs) :=
    (rawExpandedEdgeSignedSum_eq_edgePhaseSum
      (n := n) (T := RTree.node a cs)).symm.trans hexpanded
  simpa [rawBitStringSignedSum, weight, totalPhase, phaseAtSite] using hphase

theorem rawExpandedEdgeSignedSum_node_openRootExponent_iff_rawBitString
    {a : Nat} {cs : List RTree} {n : Nat} [NeZero n] :
    rawExpandedEdgeSignedSum n (RTree.node a cs) =
        (2 : ℤ) ^ Int.toNat (openRootNodeExponent n a cs) ↔
      rawBitStringSignedSum n (RTree.node a cs) =
        (2 : ℤ) ^ Int.toNat (openRootNodeExponent n a cs) :=
  ⟨rawBitString_node_openRootExponent_of_rawExpandedEdgeSignedSum,
    rawExpandedEdgeSignedSum_node_openRootExponent_of_rawBitString⟩

def OpenRootRawExpandedEdgeNodeStepRule : Prop :=
  ∀ {a : Nat} {cs : List RTree},
    0 < a →
    (∀ C ∈ cs, SubtreeModelCertificate C) →
    ∀ (n : Nat) [NeZero n],
      rawExpandedEdgeSignedSum n (RTree.node a cs) =
        (2 : ℤ) ^ Int.toNat (openRootNodeExponent n a cs)

structure OpenRootRawExpandedEdgeNodeCertificate
    (a : Nat) (cs : List RTree) : Prop where
  positiveRoot : 0 < a
  children : ∀ C ∈ cs, SubtreeModelCertificate C
  rawExpandedEdgeOpenRoot :
    ∀ (n : Nat) [NeZero n],
      rawExpandedEdgeSignedSum n (RTree.node a cs) =
        (2 : ℤ) ^ Int.toNat (openRootNodeExponent n a cs)

namespace OpenRootRawExpandedEdgeNodeCertificate

theorem rawBitStringOpenRoot
    {a : Nat} {cs : List RTree}
    (h : OpenRootRawExpandedEdgeNodeCertificate a cs)
    (n : Nat) [NeZero n] :
    rawBitStringSignedSum n (RTree.node a cs) =
      (2 : ℤ) ^ Int.toNat (openRootNodeExponent n a cs) :=
  rawBitString_node_openRootExponent_of_rawExpandedEdgeSignedSum
    (h.rawExpandedEdgeOpenRoot n)

theorem modelCertificate
    {a : Nat} {cs : List RTree}
    (h : OpenRootRawExpandedEdgeNodeCertificate a cs) :
    ModelCertificate (RTree.node a cs) :=
  modelCertificate_of_openRootRawBitStringNodeStep
    h.positiveRoot h.children
    (fun n => h.rawBitStringOpenRoot n)

theorem nodeStepCertificate
    {a : Nat} {cs : List RTree}
    (h : OpenRootRawExpandedEdgeNodeCertificate a cs) :
    NodeStepCertificate a cs where
  positiveRoot := h.positiveRoot
  children := h.children
  signedSum_eq_DeltaTreeModel := by
    intro n _
    exact h.modelCertificate.signedSum_eq_DeltaTreeModel n

theorem subtreeModelCertificate
    {a : Nat} {cs : List RTree}
    (h : OpenRootRawExpandedEdgeNodeCertificate a cs) :
    SubtreeModelCertificate (RTree.node a cs) :=
  subtreeModelCertificate_node_of_step h.nodeStepCertificate

theorem rawExpandedEdgeDelta
    {a : Nat} {cs : List RTree}
    (h : OpenRootRawExpandedEdgeNodeCertificate a cs)
    (n : Nat) [NeZero n] :
    rawExpandedEdgeSignedSum n (RTree.node a cs) =
      DeltaTreeModel n (RTree.node a cs) := by
  have hopen := h.rawExpandedEdgeOpenRoot n
  have hdelta :=
    DeltaTreeModel_node_eq_openRootNodeExponent_of_children
      (n := n) h.positiveRoot h.children
  exact hopen.trans hdelta.symm

end OpenRootRawExpandedEdgeNodeCertificate

theorem openRootRawExpandedEdgeNodeCertificate_of_nodeStepCertificate
    {a : Nat} {cs : List RTree}
    (hnode : NodeStepCertificate a cs) :
    OpenRootRawExpandedEdgeNodeCertificate a cs where
  positiveRoot := hnode.positiveRoot
  children := hnode.children
  rawExpandedEdgeOpenRoot := by
    intro n _
    exact rawExpandedEdgeSignedSum_node_openRootExponent_of_rawBitString
      (openRootRawBitStringNodeStep_of_modelCertificate
        hnode.modelCertificate hnode.positiveRoot hnode.children n)

theorem nodeStepCertificate_of_openRootRawExpandedEdgeNodeCertificate
    {a : Nat} {cs : List RTree}
    (h : OpenRootRawExpandedEdgeNodeCertificate a cs) :
    NodeStepCertificate a cs :=
  h.nodeStepCertificate

theorem openRootRawExpandedEdgeNodeCertificate_iff_nodeStepCertificate
    {a : Nat} {cs : List RTree} :
    OpenRootRawExpandedEdgeNodeCertificate a cs ↔
      NodeStepCertificate a cs :=
  ⟨nodeStepCertificate_of_openRootRawExpandedEdgeNodeCertificate,
    openRootRawExpandedEdgeNodeCertificate_of_nodeStepCertificate⟩

theorem nodeStepCertificate_iff_openRootRawExpandedEdgeNodeCertificate
    {a : Nat} {cs : List RTree} :
    NodeStepCertificate a cs ↔
      OpenRootRawExpandedEdgeNodeCertificate a cs :=
  openRootRawExpandedEdgeNodeCertificate_iff_nodeStepCertificate.symm

theorem openRootRawExpandedEdgeNodeCertificate_leaf
    {a : Nat} (ha : 0 < a) :
    OpenRootRawExpandedEdgeNodeCertificate a [] :=
  openRootRawExpandedEdgeNodeCertificate_of_nodeStepCertificate
    (nodeStepCertificate_leaf a ha)

theorem openRootRawExpandedEdgeNodeCertificate_edge
    {a b : Nat} (ha : 0 < a) (hb : 0 < b) :
    OpenRootRawExpandedEdgeNodeCertificate a [RTree.node b []] :=
