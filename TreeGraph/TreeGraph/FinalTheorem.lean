theorem boundaryZeroKernelCard_twoLeaves
    {a b c n : Nat} [NeZero n]
    (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) :
    Fintype.card
        { R : RawNormal.NodeRootFieldAssignment n a
            [RTree.node b [], RTree.node c []] //
          ∀ i : ChildIdx [RTree.node b [], RTree.node c []],
            childBoundaryLinearFormAt
              (n := n) (a := a) [RTree.node b [], RTree.node c []] R i = 0 } =
