theorem childInternalPhaseGivenRootFieldsAt_independent_root
    {n a : Nat} [NeZero n] {cs : List RTree}
    (R R' : RawNormal.NodeRootFieldAssignment n a cs)
    (i : ChildIdx cs)
    (φ : RawNormal.NodeChildRootFieldDomain n a cs i → F2)
    (ψ :
      (v : NonRootVertex (childAt cs i)) →
        RawNormal.NodeChildNonRootFieldDomain n a cs i v → F2) :
    childInternalPhaseGivenRootFieldsAt
        (n := n) (a := a) cs R i φ ψ =
      childInternalPhaseGivenRootFieldsAt
        (n := n) (a := a) cs R' i φ ψ := by
  classical
  unfold childInternalPhaseGivenRootFieldsAt
    childInternalPhaseGivenRootDataAt
    RawNormal.childInternalPhaseAt
    RawNormal.indexedChildInternalPhaseAt
  simp only [List.nil_append, Nat.zero_add]
  rw [RawNormal.edgeListPhase_edgeListFrom_eq_sum_prefixed,
    RawNormal.edgeListPhase_edgeListFrom_eq_sum_prefixed]
  refine Finset.sum_congr rfl ?_
  intro site _
  apply congrArg List.sum
  refine List.map_congr_left ?_
  intro e he
  rw [RawNormal.edgePhaseAtSite_prefixEdge_childAt
      (a := a) (cs := cs) i (site := site) (he := he),
    RawNormal.edgePhaseAtSite_prefixEdge_childAt
      (a := a) (cs := cs) i (site := site) (he := he)]
  let u : Vertex (childAt cs i) :=
    ⟨e.1, RTree.edgeList_edge_left_mem_addresses (childAt cs i) he⟩
  let v : Vertex (childAt cs i) :=
    ⟨e.2, RTree.edgeList_edge_right_mem_addresses (childAt cs i) he⟩
  have hku :=
    ketAtVertex_childVertexAtInNode_independent_root
      (a := a) R R' i φ ψ site u
  have hkv :=
    ketAtVertex_childVertexAtInNode_independent_root
      (a := a) R R' i φ ψ site v
  have hbu :=
    braAtVertex_childVertexAtInNode_independent_root
      (a := a) R R' i φ ψ site u
  have hbv :=
    braAtVertex_childVertexAtInNode_independent_root
      (a := a) R R' i φ ψ site v
  simpa [u, v] using congrArg₂ HAdd.hAdd
    (congrArg₂ HMul.hMul hku hkv) (congrArg₂ HMul.hMul hbu hbv)

theorem childLinearizedContributionSumAt_eq_sum_root_nonRootFields
    {n a : Nat} [NeZero n] {cs : List RTree}
