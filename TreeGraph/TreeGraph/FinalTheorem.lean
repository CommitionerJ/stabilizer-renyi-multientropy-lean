@[simp] theorem nodeChildNormalSiteDecompose_childRootDiagonal_eq_diagonal
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs) (hchildRoot : 0 < (childAt cs i).rootWeight)
    (site : RawNormal.NormalSite n (RTree.node a cs)) :
    (nodeChildNormalSiteDecompose
      (n := n) (a := a) (cs := cs) i hchildRoot site).1.childRootDiagonal =
      RawNormal.diagonal site
        (RawNormal.childRootAtAsNonRootInNode (a := a) i) := by
  classical
  rw [nodeChildNormalSiteDecompose_childRootDiagonal]
  rw [fullCoordinateWithDiagonalEquivOfPos_snd]
  unfold RawNormal.diagonal
  refine Fintype.sum_equiv
    (RawNormal.finCastEquivOfEq
      (RawNormal.childRootAtAsNonRootInNode_weight
        (a := a) i).symm)
    (fun j : Fin (childAt cs i).rootWeight =>
      site.nonRootCoord
        (RawNormal.childRootAtAsNonRootInNode (a := a) i)
        (by
          simpa using
            (RawNormal.childRootFullCoordInNode
              (a := a) (idx := i.1) (cs := cs)
              (C := childAt cs i) (childAt_get?_eq_some cs i) j)))
    (fun j : Fin (NonRootVertex.weight
        (RawNormal.childRootAtAsNonRootInNode (a := a) i)) =>
      site.nonRootCoord
        (RawNormal.childRootAtAsNonRootInNode (a := a) i) j)
    ?_
  intro j
  congr 1

