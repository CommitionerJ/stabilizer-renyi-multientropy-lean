theorem rootFactorKernelCard_eq_factorProduct_of_childCerts
    {n : Nat} [NeZero n] {cs : List RTree}
    (hchildren : ∀ C ∈ cs, RawExpandedOpenRootSubtreeCert C) :
    Fintype.card (OpenRootMessageSpace n cs) =
      2 ^ (cs.map (fun C =>
        Int.toNat
          ((nZ n) ^ RTree.totalWeight C - (tZ n) * Yassign n C))).prod := by
  have hchildPos : ∀ C ∈ cs, RTree.PositiveWeights C := by
    intro C hC
    exact RawExpandedOpenRootSubtreeCert.positiveWeights
      (hchildren C hC)
  exact card_openRootMessageSpace_eq_two_pow_assignmentFactorProduct
