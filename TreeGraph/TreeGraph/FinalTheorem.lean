theorem card_nodeChildRootFieldDomain_eq_external_mul_rootFieldDomain
    {n a : Nat} [NeZero n] {cs : List RTree}
    (ha : 0 < a) (i : ChildIdx cs) :
    Fintype.card (RawNormal.NodeChildRootFieldDomain n a cs i) =
      Fintype.card
        (Fin (n ^ childExternalCoordinateExponentAt a cs i) ×
          RawNormal.RootFieldDomain n (childAt cs i)) := by
  classical
  have hparent :
      nonRootContextExponent (RTree.node a cs)
          (RawNormal.childRootAtAsNonRootInNode (a := a) i) + 1 +
          (childAt cs i).rootWeight =
        a + (cs.map RTree.totalWeight).sum := by
    calc
      nonRootContextExponent (RTree.node a cs)
            (RawNormal.childRootAtAsNonRootInNode (a := a) i) + 1 +
            (childAt cs i).rootWeight =
          nonRootContextExponent (RTree.node a cs)
              (RawNormal.childRootAtAsNonRootInNode (a := a) i) + 1 +
            NonRootVertex.weight
              (RawNormal.childRootAtAsNonRootInNode (a := a) i) := by
            rw [RawNormal.childRootAtAsNonRootInNode_weight]
      _ =
          (RTree.node a cs).rootWeight +
            Fintype.card (RootFieldCoordinate (RTree.node a cs)) := by
            exact
              nonRootContextExponent_add_one_add_weight_eq_root_add_card_rootFieldCoordinate
                (RTree.node a cs)
                (RawNormal.childRootAtAsNonRootInNode (a := a) i)
                (by simpa [RTree.rootWeight] using ha)
      _ = a + (cs.map RTree.totalWeight).sum := by
            rw [card_rootFieldCoordinate_node_eq_sum_totalWeight]
            rfl
  have hchildTotal :
      RTree.totalWeight (childAt cs i) =
        (childAt cs i).rootWeight +
          Fintype.card (RootFieldCoordinate (childAt cs i)) := by
    rw [← card_vertexCoordinate_eq_totalWeight]
    exact card_vertexCoordinate_eq_root_add_rootFieldCoordinate (childAt cs i)
  have hexternal :=
    childExternalCoordinateExponentAt_add_childAt_totalWeight a cs i
  have hexp :
      nonRootContextExponent (RTree.node a cs)
          (RawNormal.childRootAtAsNonRootInNode (a := a) i) + 1 =
        childExternalCoordinateExponentAt a cs i +
          Fintype.card (RootFieldCoordinate (childAt cs i)) := by
    rw [hchildTotal] at hexternal
    omega
  calc
    Fintype.card (RawNormal.NodeChildRootFieldDomain n a cs i) =
        n ^
          (nonRootContextExponent (RTree.node a cs)
            (RawNormal.childRootAtAsNonRootInNode (a := a) i) + 1) := by
          change
            Fintype.card
                (RawNormal.NonRootFieldDomain n (RTree.node a cs)
                  (RawNormal.childRootAtAsNonRootInNode (a := a) i)) =
              n ^
                (nonRootContextExponent (RTree.node a cs)
                  (RawNormal.childRootAtAsNonRootInNode (a := a) i) + 1)
          rw [card_nonRootFieldDomain]
    _ = n ^
          (childExternalCoordinateExponentAt a cs i +
            Fintype.card (RootFieldCoordinate (childAt cs i))) := by
          rw [hexp]
    _ =
        Fintype.card
          (Fin (n ^ childExternalCoordinateExponentAt a cs i) ×
            RawNormal.RootFieldDomain n (childAt cs i)) := by
          rw [Fintype.card_prod, Fintype.card_fin,
            card_rootFieldDomain_eq_pow_card_rootFieldCoordinate,
            Nat.pow_add]

theorem card_nodeChildNonRootFieldDomain_eq_external_mul_nonRootFieldDomain
    {n a : Nat} [NeZero n] {cs : List RTree}
    (ha : 0 < a) (i : ChildIdx cs)
    (hchildRoot : 0 < (childAt cs i).rootWeight)
    (v : NonRootVertex (childAt cs i)) :
    Fintype.card (RawNormal.NodeChildNonRootFieldDomain n a cs i v) =
      Fintype.card
        (Fin (n ^ childExternalCoordinateExponentAt a cs i) ×
          RawNormal.NonRootFieldDomain n (childAt cs i) v) := by
  classical
  have hparent :
      nonRootContextExponent (RTree.node a cs)
          (RawNormal.childNonRootVertexAtInNode (a := a) i v) + 1 +
          NonRootVertex.weight v =
        a + (cs.map RTree.totalWeight).sum := by
    calc
      nonRootContextExponent (RTree.node a cs)
            (RawNormal.childNonRootVertexAtInNode (a := a) i v) + 1 +
            NonRootVertex.weight v =
          nonRootContextExponent (RTree.node a cs)
              (RawNormal.childNonRootVertexAtInNode (a := a) i v) + 1 +
            NonRootVertex.weight
              (RawNormal.childNonRootVertexAtInNode (a := a) i v) := by
            rw [RawNormal.childNonRootVertexAtInNode_weight]
      _ =
          (RTree.node a cs).rootWeight +
            Fintype.card (RootFieldCoordinate (RTree.node a cs)) := by
            exact
              nonRootContextExponent_add_one_add_weight_eq_root_add_card_rootFieldCoordinate
                (RTree.node a cs)
                (RawNormal.childNonRootVertexAtInNode (a := a) i v)
                (by simpa [RTree.rootWeight] using ha)
      _ = a + (cs.map RTree.totalWeight).sum := by
            rw [card_rootFieldCoordinate_node_eq_sum_totalWeight]
            rfl
  have hchild :
      nonRootContextExponent (childAt cs i) v + 1 +
          NonRootVertex.weight v =
        RTree.totalWeight (childAt cs i) := by
    calc
      nonRootContextExponent (childAt cs i) v + 1 +
          NonRootVertex.weight v =
        (childAt cs i).rootWeight +
          Fintype.card (RootFieldCoordinate (childAt cs i)) := by
          exact
            nonRootContextExponent_add_one_add_weight_eq_root_add_card_rootFieldCoordinate
              (childAt cs i) v hchildRoot
      _ = Fintype.card (VertexCoordinate (childAt cs i)) := by
          exact (card_vertexCoordinate_eq_root_add_rootFieldCoordinate
            (childAt cs i)).symm
      _ = RTree.totalWeight (childAt cs i) := by
          exact card_vertexCoordinate_eq_totalWeight (childAt cs i)
  have hexternal :=
    childExternalCoordinateExponentAt_add_childAt_totalWeight a cs i
  have hexp :
      nonRootContextExponent (RTree.node a cs)
          (RawNormal.childNonRootVertexAtInNode (a := a) i v) + 1 =
        childExternalCoordinateExponentAt a cs i +
          (nonRootContextExponent (childAt cs i) v + 1) := by
    omega
  calc
    Fintype.card (RawNormal.NodeChildNonRootFieldDomain n a cs i v) =
        n ^
          (nonRootContextExponent (RTree.node a cs)
            (RawNormal.childNonRootVertexAtInNode (a := a) i v) + 1) := by
          change
            Fintype.card
                (RawNormal.NonRootFieldDomain n (RTree.node a cs)
                  (RawNormal.childNonRootVertexAtInNode (a := a) i v)) =
              n ^
                (nonRootContextExponent (RTree.node a cs)
                  (RawNormal.childNonRootVertexAtInNode (a := a) i v) + 1)
          rw [card_nonRootFieldDomain]
    _ = n ^
          (childExternalCoordinateExponentAt a cs i +
            (nonRootContextExponent (childAt cs i) v + 1)) := by
          rw [hexp]
    _ =
        Fintype.card
          (Fin (n ^ childExternalCoordinateExponentAt a cs i) ×
            RawNormal.NonRootFieldDomain n (childAt cs i) v) := by
          rw [Fintype.card_prod, Fintype.card_fin,
            card_nonRootFieldDomain, Nat.pow_add]

noncomputable def nodeChildRootFieldDomainCardEquivExternalRootField
    {n a : Nat} [NeZero n] {cs : List RTree}
    (ha : 0 < a) (i : ChildIdx cs) :
    RawNormal.NodeChildRootFieldDomain n a cs i ≃
      Fin (n ^ childExternalCoordinateExponentAt a cs i) ×
        RawNormal.RootFieldDomain n (childAt cs i) :=
  equivOfFintypeCardEq
    (card_nodeChildRootFieldDomain_eq_external_mul_rootFieldDomain
      (n := n) (a := a) (cs := cs) ha i)

theorem childExternalCoordinateExponentAt_cons_zero
    (a : Nat) (C : RTree) (cs : List RTree) :
    childExternalCoordinateExponentAt a (C :: cs)
        (0 : ChildIdx (C :: cs)) =
      a + (cs.map RTree.totalWeight).sum := by
  rfl

theorem childExternalCoordinateExponentAt_singleton_zero
    (a : Nat) (C : RTree) :
    childExternalCoordinateExponentAt a [C] (0 : ChildIdx [C]) = a := by
  rfl

theorem card_nodeChildRootFieldDomain_cons_zero_eq_rest_mul_singleton
    {n a : Nat} [NeZero n] (C : RTree) (cs : List RTree)
    (ha : 0 < a) :
    Fintype.card
        (RawNormal.NodeChildRootFieldDomain n a (C :: cs)
          (0 : ChildIdx (C :: cs))) =
      Fintype.card (ChildVertexFieldDomainFamily n cs) *
        Fintype.card
          (RawNormal.NodeChildRootFieldDomain n a [C]
            (0 : ChildIdx [C])) := by
  rw [card_nodeChildRootFieldDomain_eq_external_mul_rootFieldDomain
        (n := n) (a := a) (cs := C :: cs) ha
        (0 : ChildIdx (C :: cs))]
  rw [card_nodeChildRootFieldDomain_eq_external_mul_rootFieldDomain
        (n := n) (a := a) (cs := [C]) ha
        (0 : ChildIdx [C])]
  rw [card_childVertexFieldDomainFamily_eq_pow_sum_totalWeight]
  simp [childExternalCoordinateExponentAt_cons_zero,
    childExternalCoordinateExponentAt_singleton_zero, Nat.pow_add,
    Nat.mul_assoc, Nat.mul_left_comm, Nat.mul_comm]

def childSiblingVertexAsOtherNonRoot
    {a : Nat} {cs : List RTree} (i : ChildIdx cs)
    (v : NonRootVertex (childAt cs i))
    (p : ChildSiblingVertex cs i) :
    RawNormal.OtherNonRootVertex (RTree.node a cs)
      (RawNormal.childNonRootVertexAtInNode (a := a) i v) :=
  ⟨RawNormal.childVertexAtAsNonRootInNode (a := a) p.1, by
    intro haddr
    have hidx : p.1.1.1 = i.1 := (List.cons.inj haddr).1
    exact p.2 (Fin.ext hidx)⟩

@[simp] theorem childSiblingVertexAsOtherNonRoot_weight
    {a : Nat} {cs : List RTree} (i : ChildIdx cs)
    (v : NonRootVertex (childAt cs i))
    (p : ChildSiblingVertex cs i) :
    NonRootVertex.weight (childSiblingVertexAsOtherNonRoot (a := a) i v p).1 =
      Vertex.weight p.1.2 := by
  simp [childSiblingVertexAsOtherNonRoot, childVertexAtAsNonRootInNode_weight]

def childRootAsOtherNonRoot
    {a : Nat} {cs : List RTree} (i : ChildIdx cs)
    (v : NonRootVertex (childAt cs i)) :
    RawNormal.OtherNonRootVertex (RTree.node a cs)
      (RawNormal.childNonRootVertexAtInNode (a := a) i v) :=
  ⟨RawNormal.childRootAtAsNonRootInNode (a := a) i, by
    intro haddr
    have htail : [] = v.1.1 := (List.cons.inj haddr).2
    exact v.2 htail.symm⟩

@[simp] theorem childRootAsOtherNonRoot_weight
    {a : Nat} {cs : List RTree} (i : ChildIdx cs)
    (v : NonRootVertex (childAt cs i)) :
    NonRootVertex.weight (childRootAsOtherNonRoot (a := a) i v).1 =
      (childAt cs i).rootWeight := by
  simp [childRootAsOtherNonRoot,
    RawNormal.childRootAtAsNonRootInNode_weight]

def childNonRootOtherAsOtherNonRoot
    {a : Nat} {cs : List RTree} (i : ChildIdx cs)
    (v : NonRootVertex (childAt cs i))
    (u : RawNormal.OtherNonRootVertex (childAt cs i) v) :
    RawNormal.OtherNonRootVertex (RTree.node a cs)
      (RawNormal.childNonRootVertexAtInNode (a := a) i v) :=
  ⟨RawNormal.childNonRootVertexAtInNode (a := a) i u.1, by
    intro haddr
    exact u.2 ((List.cons.inj haddr).2)⟩

@[simp] theorem childNonRootOtherAsOtherNonRoot_weight
    {a : Nat} {cs : List RTree} (i : ChildIdx cs)
    (v : NonRootVertex (childAt cs i))
    (u : RawNormal.OtherNonRootVertex (childAt cs i) v) :
    NonRootVertex.weight
        (childNonRootOtherAsOtherNonRoot (a := a) i v u).1 =
      NonRootVertex.weight u.1 := by
  simp [childNonRootOtherAsOtherNonRoot,
    RawNormal.childNonRootVertexAtInNode_weight]

@[simp] theorem nonRootVertexNodeEquivChildVertex_childSiblingVertexAsOtherNonRoot
    {a : Nat} {cs : List RTree} (i : ChildIdx cs)
    (v : NonRootVertex (childAt cs i))
    (p : ChildSiblingVertex cs i) :
    RawNormal.nonRootVertexNodeEquivChildVertex a cs
        (childSiblingVertexAsOtherNonRoot (a := a) i v p).1 =
      p.1 := by
  exact nonRootVertexNodeEquivChildVertex_childVertexAtAsNonRootInNode p.1

@[simp] theorem nonRootVertexNodeEquivChildVertex_childRootAsOtherNonRoot
    {a : Nat} {cs : List RTree} (i : ChildIdx cs)
    (v : NonRootVertex (childAt cs i)) :
    RawNormal.nonRootVertexNodeEquivChildVertex a cs
        (childRootAsOtherNonRoot (a := a) i v).1 =
      ⟨i, Vertex.root (childAt cs i)⟩ := by
  change
    RawNormal.nonRootVertexNodeEquivChildVertex a cs
        (RawNormal.childRootAtAsNonRootInNode (a := a) i) =
      ⟨i, Vertex.root (childAt cs i)⟩
  have h :=
    (RawNormal.nonRootVertexNodeEquivChildVertex a cs).right_inv
      (⟨i, Vertex.root (childAt cs i)⟩ :
        RawNormal.NodeChildVertex cs)
  exact h

@[simp] theorem nonRootVertexNodeEquivChildVertex_childNonRootOtherAsOtherNonRoot
    {a : Nat} {cs : List RTree} (i : ChildIdx cs)
    (v : NonRootVertex (childAt cs i))
    (u : RawNormal.OtherNonRootVertex (childAt cs i) v) :
    RawNormal.nonRootVertexNodeEquivChildVertex a cs
        (childNonRootOtherAsOtherNonRoot (a := a) i v u).1 =
      (⟨i, u.1.1⟩ : RawNormal.NodeChildVertex cs) := by
  change
    RawNormal.nonRootVertexNodeEquivChildVertex a cs
        (RawNormal.childNonRootVertexAtInNode (a := a) i u.1) =
      (⟨i, u.1.1⟩ : RawNormal.NodeChildVertex cs)
  exact
    nonRootVertexNodeEquivChildVertex_childNonRootVertexAsOtherRoot
      (a := a) (cs := cs) i u.1

inductive ChildNonRootOtherSplit
    (cs : List RTree) (i : ChildIdx cs)
    (v : NonRootVertex (childAt cs i)) where
  | sibling :
      ChildSiblingVertex cs i →
      ChildNonRootOtherSplit cs i v
  | childRoot :
      ChildNonRootOtherSplit cs i v
  | childNonRoot :
      RawNormal.OtherNonRootVertex (childAt cs i) v →
      ChildNonRootOtherSplit cs i v

namespace ChildNonRootOtherSplit

def weight {cs : List RTree} {i : ChildIdx cs}
    {v : NonRootVertex (childAt cs i)} :
    ChildNonRootOtherSplit cs i v → Nat
  | sibling p => Vertex.weight p.1.2
  | childRoot => (childAt cs i).rootWeight
  | childNonRoot u => NonRootVertex.weight u.1

@[simp] theorem weight_sibling
    {cs : List RTree} {i : ChildIdx cs}
    {v : NonRootVertex (childAt cs i)}
    (p : ChildSiblingVertex cs i) :
    weight (sibling (v := v) p) = Vertex.weight p.1.2 := rfl

@[simp] theorem weight_childRoot
    {cs : List RTree} {i : ChildIdx cs}
    {v : NonRootVertex (childAt cs i)} :
    weight (childRoot (v := v)) = (childAt cs i).rootWeight := rfl

@[simp] theorem weight_childNonRoot
    {cs : List RTree} {i : ChildIdx cs}
    {v : NonRootVertex (childAt cs i)}
    (u : RawNormal.OtherNonRootVertex (childAt cs i) v) :
    weight (childNonRoot u) = NonRootVertex.weight u.1 := rfl

end ChildNonRootOtherSplit

noncomputable def childNonRootOtherSplitToOtherNonRootVertex
    {a : Nat} {cs : List RTree} (i : ChildIdx cs)
    (v : NonRootVertex (childAt cs i)) :
    ChildNonRootOtherSplit cs i v →
      RawNormal.OtherNonRootVertex (RTree.node a cs)
        (RawNormal.childNonRootVertexAtInNode (a := a) i v)
  | ChildNonRootOtherSplit.sibling p =>
      childSiblingVertexAsOtherNonRoot (a := a) i v p
  | ChildNonRootOtherSplit.childRoot =>
      childRootAsOtherNonRoot (a := a) i v
  | ChildNonRootOtherSplit.childNonRoot u =>
      childNonRootOtherAsOtherNonRoot (a := a) i v u

@[simp] theorem childNonRootOtherSplitToOtherNonRootVertex_weight
    {a : Nat} {cs : List RTree} (i : ChildIdx cs)
    (v : NonRootVertex (childAt cs i))
    (s : ChildNonRootOtherSplit cs i v) :
    NonRootVertex.weight
        (childNonRootOtherSplitToOtherNonRootVertex
          (a := a) (cs := cs) i v s).1 =
      ChildNonRootOtherSplit.weight s := by
  cases s with
  | sibling p =>
      simp [childNonRootOtherSplitToOtherNonRootVertex,
        ChildNonRootOtherSplit.weight]
  | childRoot =>
      simp [childNonRootOtherSplitToOtherNonRootVertex,
        ChildNonRootOtherSplit.weight]
  | childNonRoot u =>
      simp [childNonRootOtherSplitToOtherNonRootVertex,
        ChildNonRootOtherSplit.weight]

theorem childNonRootOther_same_child_nonRoot_contradiction
    {a : Nat} {cs : List RTree} (i : ChildIdx cs)
    (v : NonRootVertex (childAt cs i))
    (u :
      RawNormal.OtherNonRootVertex (RTree.node a cs)
        (RawNormal.childNonRootVertexAtInNode (a := a) i v))
    (w : Vertex (childAt cs i))
    (hp :
      RawNormal.nonRootVertexNodeEquivChildVertex a cs u.1 =
        (⟨i, w⟩ : RawNormal.NodeChildVertex cs))
    (hw : w.1 = v.1.1) :
    False := by
  have hwv : w = v.1 := by
    apply Subtype.ext
    exact hw
  have hu :
      u.1 = RawNormal.childNonRootVertexAtInNode (a := a) i v := by
    apply (RawNormal.nonRootVertexNodeEquivChildVertex a cs).injective
    rw [hp]
    rw [hwv]
    exact
      (nonRootVertexNodeEquivChildVertex_childNonRootVertexAsOtherRoot
        (a := a) (cs := cs) i v).symm
  exact u.2 (by
    simpa using congrArg (fun x : NonRootVertex (RTree.node a cs) => x.1.1) hu)

theorem childNonRootOtherSplitToOtherNonRootVertex_surjective
    {a : Nat} {cs : List RTree} (i : ChildIdx cs)
    (v : NonRootVertex (childAt cs i)) :
    Function.Surjective
      (childNonRootOtherSplitToOtherNonRootVertex
        (a := a) (cs := cs) i v) := by
  classical
  intro u
  match hp : RawNormal.nonRootVertexNodeEquivChildVertex a cs u.1 with
  | ⟨k, w⟩ =>
      by_cases hki : k = i
      · subst k
        by_cases hroot : w.1 = []
        · have hw : w = Vertex.root (childAt cs i) := by
            apply Subtype.ext
            exact hroot
          refine ⟨ChildNonRootOtherSplit.childRoot, ?_⟩
          apply Subtype.ext
          apply (RawNormal.nonRootVertexNodeEquivChildVertex a cs).injective
          have hmap :=
            nonRootVertexNodeEquivChildVertex_childRootAsOtherNonRoot
              (a := a) (cs := cs) i v
          simpa [childNonRootOtherSplitToOtherNonRootVertex, hp, hw] using hmap
        · by_cases hwv : w.1 = v.1.1
          · exact False.elim
              (childNonRootOther_same_child_nonRoot_contradiction
                (a := a) (cs := cs) i v u w hp hwv)
          · refine
              ⟨ChildNonRootOtherSplit.childNonRoot ⟨⟨w, hroot⟩, hwv⟩, ?_⟩
            apply Subtype.ext
            apply (RawNormal.nonRootVertexNodeEquivChildVertex a cs).injective
            have hmap :=
              nonRootVertexNodeEquivChildVertex_childNonRootOtherAsOtherNonRoot
                (a := a) (cs := cs) i v ⟨⟨w, hroot⟩, hwv⟩
            simpa [childNonRootOtherSplitToOtherNonRootVertex, hp] using hmap
      · refine ⟨ChildNonRootOtherSplit.sibling ⟨⟨k, w⟩, hki⟩, ?_⟩
        apply Subtype.ext
        apply (RawNormal.nonRootVertexNodeEquivChildVertex a cs).injective
        have hmap :=
          nonRootVertexNodeEquivChildVertex_childSiblingVertexAsOtherNonRoot
            (a := a) (cs := cs) i v ⟨⟨k, w⟩, hki⟩
        simpa [childNonRootOtherSplitToOtherNonRootVertex, hp] using hmap

theorem childNonRootOtherSplitToOtherNonRootVertex_injective
    {a : Nat} {cs : List RTree} (i : ChildIdx cs)
    (v : NonRootVertex (childAt cs i)) :
    Function.Injective
      (childNonRootOtherSplitToOtherNonRootVertex
        (a := a) (cs := cs) i v) := by
  classical
  intro s t h
  cases s with
  | sibling p =>
      cases t with
      | sibling q =>
          have hmap :=
            congrArg
              (fun u =>
                RawNormal.nonRootVertexNodeEquivChildVertex a cs u.1)
              h
          rcases p with ⟨p, hp⟩
          rcases q with ⟨q, hq⟩
          simp [childNonRootOtherSplitToOtherNonRootVertex] at hmap
          cases hmap
          rfl
      | childRoot =>
          have hmap :=
            congrArg
              (fun u =>
                RawNormal.nonRootVertexNodeEquivChildVertex a cs u.1)
              h
          rcases p with ⟨p, hp⟩
          simp [childNonRootOtherSplitToOtherNonRootVertex] at hmap
          have hidx : p.1 = i :=
            congrArg (fun x : RawNormal.NodeChildVertex cs => x.1) hmap
          exact False.elim (hp hidx)
      | childNonRoot u =>
          have hmap :=
            congrArg
              (fun u =>
                RawNormal.nonRootVertexNodeEquivChildVertex a cs u.1)
              h
          rcases p with ⟨p, hp⟩
          simp [childNonRootOtherSplitToOtherNonRootVertex] at hmap
          have hidx : p.1 = i :=
            congrArg (fun x : RawNormal.NodeChildVertex cs => x.1) hmap
          exact False.elim (hp hidx)
  | childRoot =>
      cases t with
      | sibling p =>
          have hmap :=
            congrArg
              (fun u =>
                RawNormal.nonRootVertexNodeEquivChildVertex a cs u.1)
              h
          rcases p with ⟨p, hp⟩
          simp [childNonRootOtherSplitToOtherNonRootVertex] at hmap
          have hidx : i = p.1 :=
            congrArg (fun x : RawNormal.NodeChildVertex cs => x.1) hmap
          exact False.elim (hp hidx.symm)
      | childRoot =>
          rfl
      | childNonRoot u =>
          have hmap :=
            congrArg
              (fun u =>
                RawNormal.nonRootVertexNodeEquivChildVertex a cs u.1)
              h
          simp [childNonRootOtherSplitToOtherNonRootVertex] at hmap
          have haddr : [] = u.1.1.1 :=
            congrArg (fun x : Vertex (childAt cs i) => x.1) hmap
          exact False.elim (u.1.2 haddr.symm)
  | childNonRoot u =>
      cases t with
      | sibling p =>
          have hmap :=
            congrArg
              (fun u =>
                RawNormal.nonRootVertexNodeEquivChildVertex a cs u.1)
              h
          rcases p with ⟨p, hp⟩
          simp [childNonRootOtherSplitToOtherNonRootVertex] at hmap
          have hidx : i = p.1 :=
            congrArg (fun x : RawNormal.NodeChildVertex cs => x.1) hmap
          exact False.elim (hp hidx.symm)
      | childRoot =>
          have hmap :=
            congrArg
              (fun u =>
                RawNormal.nonRootVertexNodeEquivChildVertex a cs u.1)
              h
          simp [childNonRootOtherSplitToOtherNonRootVertex] at hmap
          have haddr : u.1.1.1 = [] :=
            congrArg (fun x : Vertex (childAt cs i) => x.1) hmap
          exact False.elim (u.1.2 haddr)
      | childNonRoot w =>
          have hmap :=
            congrArg
              (fun u =>
                RawNormal.nonRootVertexNodeEquivChildVertex a cs u.1)
              h
          simp [childNonRootOtherSplitToOtherNonRootVertex] at hmap
          have huw : u = w := by
            exact Subtype.ext (Subtype.ext hmap)
          cases huw
          rfl

theorem childNonRootOther_cases
    {a : Nat} {cs : List RTree} (i : ChildIdx cs)
    (v : NonRootVertex (childAt cs i))
    (u :
      RawNormal.OtherNonRootVertex (RTree.node a cs)
        (RawNormal.childNonRootVertexAtInNode (a := a) i v))
    {P :
      RawNormal.OtherNonRootVertex (RTree.node a cs)
        (RawNormal.childNonRootVertexAtInNode (a := a) i v) → Prop}
    (hsib :
      ∀ p : ChildSiblingVertex cs i,
        P (childNonRootOtherSplitToOtherNonRootVertex
          (a := a) (cs := cs) i v
          (ChildNonRootOtherSplit.sibling p)))
    (hroot :
      P (childNonRootOtherSplitToOtherNonRootVertex
        (a := a) (cs := cs) i v
        ChildNonRootOtherSplit.childRoot))
    (hnon :
      ∀ u : RawNormal.OtherNonRootVertex (childAt cs i) v,
        P (childNonRootOtherSplitToOtherNonRootVertex
          (a := a) (cs := cs) i v
          (ChildNonRootOtherSplit.childNonRoot u))) :
    P u := by
  rcases childNonRootOtherSplitToOtherNonRootVertex_surjective
      (a := a) (cs := cs) i v u with ⟨s, rfl⟩
  cases s with
  | sibling p => exact hsib p
  | childRoot => exact hroot
  | childNonRoot u => exact hnon u

noncomputable def otherNonRootSplitEquiv
    {a : Nat} {cs : List RTree} (i : ChildIdx cs)
    (v : NonRootVertex (childAt cs i)) :
    RawNormal.OtherNonRootVertex
      (RTree.node a cs)
      (RawNormal.childNonRootVertexAtInNode (a := a) i v) ≃
    ChildNonRootOtherSplit cs i v :=
  (Equiv.ofBijective
    (childNonRootOtherSplitToOtherNonRootVertex
      (a := a) (cs := cs) i v)
    ⟨childNonRootOtherSplitToOtherNonRootVertex_injective
        (a := a) (cs := cs) i v,
      childNonRootOtherSplitToOtherNonRootVertex_surjective
        (a := a) (cs := cs) i v⟩).symm

@[simp] theorem otherNonRootSplitEquiv_apply_sibling
    {a : Nat} {cs : List RTree} (i : ChildIdx cs)
    (v : NonRootVertex (childAt cs i))
    (p : ChildSiblingVertex cs i) :
    otherNonRootSplitEquiv (a := a) (cs := cs) i v
        (childSiblingVertexAsOtherNonRoot (a := a) i v p) =
      ChildNonRootOtherSplit.sibling p := by
  change
    otherNonRootSplitEquiv (a := a) (cs := cs) i v
        (childNonRootOtherSplitToOtherNonRootVertex
          (a := a) (cs := cs) i v
          (ChildNonRootOtherSplit.sibling p)) =
      ChildNonRootOtherSplit.sibling p
  exact
    (otherNonRootSplitEquiv (a := a) (cs := cs) i v).right_inv
      (ChildNonRootOtherSplit.sibling p)

@[simp] theorem otherNonRootSplitEquiv_apply_childRoot
    {a : Nat} {cs : List RTree} (i : ChildIdx cs)
    (v : NonRootVertex (childAt cs i)) :
    otherNonRootSplitEquiv (a := a) (cs := cs) i v
        (childRootAsOtherNonRoot (a := a) i v) =
      ChildNonRootOtherSplit.childRoot := by
  change
    otherNonRootSplitEquiv (a := a) (cs := cs) i v
        (childNonRootOtherSplitToOtherNonRootVertex
          (a := a) (cs := cs) i v
          ChildNonRootOtherSplit.childRoot) =
      ChildNonRootOtherSplit.childRoot
  exact
    (otherNonRootSplitEquiv (a := a) (cs := cs) i v).right_inv
      ChildNonRootOtherSplit.childRoot

@[simp] theorem otherNonRootSplitEquiv_apply_childNonRoot
    {a : Nat} {cs : List RTree} (i : ChildIdx cs)
    (v : NonRootVertex (childAt cs i))
    (u : RawNormal.OtherNonRootVertex (childAt cs i) v) :
    otherNonRootSplitEquiv (a := a) (cs := cs) i v
        (childNonRootOtherAsOtherNonRoot (a := a) i v u) =
      ChildNonRootOtherSplit.childNonRoot u := by
  change
    otherNonRootSplitEquiv (a := a) (cs := cs) i v
        (childNonRootOtherSplitToOtherNonRootVertex
          (a := a) (cs := cs) i v
          (ChildNonRootOtherSplit.childNonRoot u)) =
      ChildNonRootOtherSplit.childNonRoot u
  exact
    (otherNonRootSplitEquiv (a := a) (cs := cs) i v).right_inv
      (ChildNonRootOtherSplit.childNonRoot u)

noncomputable def nodeChildNonRootFieldDomainDecompose
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs) (hchildRoot : 0 < (childAt cs i).rootWeight)
    (v : NonRootVertex (childAt cs i)) :
    RawNormal.NodeChildNonRootFieldDomain n a cs i v →
      ChildExternalCoordinate n a cs i ×
        RawNormal.NonRootFieldDomain n (childAt cs i) v :=
  fun d =>
    let rootFull : Fin (childAt cs i).rootWeight → ZMod n :=
      fun j =>
        d.otherCoord (childRootAsOtherNonRoot (a := a) i v)
          (by simpa using j)
    let rootSplit :=
      fullCoordinateWithDiagonalEquivOfPos
        (childAt cs i).rootWeight n hchildRoot rootFull
    ({ rootCoord := d.rootCoord
       childRootDiagonal := rootSplit.2
       siblingCoord := fun p j =>
        d.otherCoord (childSiblingVertexAsOtherNonRoot (a := a) i v p)
          (by simpa using j) },
      { rootCoord := rootSplit.1
        diagonal := d.diagonal
        otherCoord := fun u j =>
