theorem cyclicRootTwistedBoundaryPhaseForRootNode_node_eq_cyclicNodeBoundaryPhase
    {n a b : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs) {ds : List RTree}
    (hchild : childAt cs i = RTree.node b ds)
    (R : ZMod n → RawNormal.RootFieldAssignment n (childAt cs i))
    (N : ZMod n → RawNormal.NodeFieldAssignment n (childAt cs i)) :
    (∑ d : ZMod n,
      ∑ site : RawNormal.NormalSite n (childAt cs i),
        ((RTree.indexedChildBoundaryEdgesFrom [] 0 ds).map
          (cyclicRootTwistedEdgePhaseAt
            (n := n) (a := a) (cs := cs) i
            (fun d => { rootField := R d, nodeField := N d }) d site)).sum) =
      cyclicNodeBoundaryPhase (n := n) (b := b) ds
        (fun d => castRootFieldAssignment hchild (R d))
        (fun d => castNodeFieldAssignment hchild (N d)) := by
  calc
    (∑ d : ZMod n,
      ∑ site : RawNormal.NormalSite n (childAt cs i),
        ((RTree.indexedChildBoundaryEdgesFrom [] 0 ds).map
          (cyclicRootTwistedEdgePhaseAt
            (n := n) (a := a) (cs := cs) i
            (fun d => { rootField := R d, nodeField := N d }) d site)).sum) =
        ∑ d : ZMod n,
          ∑ site : RawNormal.NormalSite n (childAt cs i),
            ((RTree.indexedChildBoundaryEdgesFrom [] 0 ds).map
              (cyclicTwistedEdgePhaseAt
                (fun d => { rootField := R d, nodeField := N d })
                d site)).sum := by
          refine Finset.sum_congr rfl ?_
          intro d _
          refine Finset.sum_congr rfl ?_
          intro site _
          congr 1
    _ =
        cyclicBoundaryPhaseForEdges
          (n := n) (T := childAt cs i)
          (RTree.indexedChildBoundaryEdgesFrom [] 0 ds) R N := by
          rfl
    _ =
        cyclicBoundaryPhaseForEdges
          (n := n) (T := RTree.node b ds)
          (RTree.indexedChildBoundaryEdgesFrom [] 0 ds)
          (fun d => castRootFieldAssignment hchild (R d))
          (fun d => castNodeFieldAssignment hchild (N d)) :=
          cyclicBoundaryPhaseForEdges_eq_cast
            (n := n) hchild
            (RTree.indexedChildBoundaryEdgesFrom [] 0 ds) R N
    _ =
      cyclicNodeBoundaryPhase (n := n) (b := b) ds
        (fun d => castRootFieldAssignment hchild (R d))
        (fun d => castNodeFieldAssignment hchild (N d)) := by
          rfl

theorem cyclicRootTwistedBoundaryPhaseForRootNode_node_eq_linearForm_apply
    {n a b : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs) {ds : List RTree}
