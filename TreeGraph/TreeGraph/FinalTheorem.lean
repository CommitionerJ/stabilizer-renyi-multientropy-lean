        ∀ (u : RawNormal.OtherNonRootVertex (RTree.node b ds)
              (RawNormal.childRootAtAsNonRootInNode (a := b) j))
          (k : Fin (NonRootVertex.weight u.1)),
          rd u.1 k = d.otherCoord u k) := by
      intro hshort
      apply hlong
      refine ⟨rfl, ?_, hshort.2⟩
