    rw [if_neg hshort]

noncomputable def nodeChildRootFieldDomainDiagonalShift
    {n b : Nat} [NeZero n] (ds : List RTree)
    (j : ChildIdx ds) (shift : ZMod n) :
    RawNormal.NodeChildRootFieldDomain n b ds j ≃
      RawNormal.NodeChildRootFieldDomain n b ds j where
  toFun x :=
    { rootCoord := x.rootCoord
      diagonal := x.diagonal + shift
      otherCoord := x.otherCoord }
  invFun x :=
    { rootCoord := x.rootCoord
      diagonal := x.diagonal - shift
      otherCoord := x.otherCoord }
  left_inv x := by
    cases x
    simp
  right_inv x := by
    cases x
    simp

