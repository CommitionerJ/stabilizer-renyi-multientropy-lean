theorem cyclicTwistedEdgePhaseAt_prefixEdge_childAt_childDataFamilyWithAt
    {n b : Nat} [NeZero n] {ds : List RTree}
    (H : ZMod n → RawNormal.NodeChildDataFamily n b ds)
    (i : ChildIdx ds)
    (d : ZMod n)
    (site : RawNormal.NormalSite n (RTree.node b ds))
    {e : List Nat × List Nat}
    (he : e ∈ RTree.edgeList (childAt ds i)) :
    cyclicTwistedEdgePhaseAt
        (fun d =>
          { rootField := (0 : RawNormal.NodeRootFieldAssignment n b ds),
            nodeField :=
              RawNormal.nodeFieldFromChildDataFamily
                (n := n) (a := b) (cs := ds) (H d) })
        d site (RTree.prefixEdge [i.1] e) =
      cyclicTwistedEdgePhaseAt
        (fun d =>
          { rootField := (0 : RawNormal.NodeRootFieldAssignment n b ds),
            nodeField :=
              RawNormal.nodeFieldFromChildDataFamily
                (n := n) (a := b) (cs := ds)
                (RawNormal.childDataFamilyWithAt
                  (n := n) (a := b) (cs := ds) i (H d i)) })
        d site (RTree.prefixEdge [i.1] e) := by
  classical
  let u : Vertex (childAt ds i) :=
    ⟨e.1, RTree.edgeList_edge_left_mem_addresses (childAt ds i) he⟩
  let v : Vertex (childAt ds i) :=
    ⟨e.2, RTree.edgeList_edge_right_mem_addresses (childAt ds i) he⟩
  change
    cyclicTwistedEdgePhaseAt
        (fun d =>
          { rootField := (0 : RawNormal.NodeRootFieldAssignment n b ds),
            nodeField :=
              RawNormal.nodeFieldFromChildDataFamily
                (n := n) (a := b) (cs := ds) (H d) })
        d site
        ((RawNormal.childVertexAtInNode (a := b) i u).1,
          (RawNormal.childVertexAtInNode (a := b) i v).1) =
      cyclicTwistedEdgePhaseAt
        (fun d =>
          { rootField := (0 : RawNormal.NodeRootFieldAssignment n b ds),
            nodeField :=
              RawNormal.nodeFieldFromChildDataFamily
                (n := n) (a := b) (cs := ds)
                (RawNormal.childDataFamilyWithAt
                  (n := n) (a := b) (cs := ds) i (H d i)) })
        d site
        ((RawNormal.childVertexAtInNode (a := b) i u).1,
          (RawNormal.childVertexAtInNode (a := b) i v).1)
  rw [cyclicTwistedEdgePhaseAt_vertices, cyclicTwistedEdgePhaseAt_vertices]
  have hku :=
    cyclicTwistedKetAtVertex_childVertexAtInNode_childDataFamilyWithAt
      (n := n) (b := b) H i d site u
  have hkv :=
    cyclicTwistedKetAtVertex_childVertexAtInNode_childDataFamilyWithAt
      (n := n) (b := b) H i d site v
  have hbu :=
    cyclicTwistedBraAtVertex_childVertexAtInNode_childDataFamilyWithAt
      (n := n) (b := b) H i d site u
  have hbv :=
    cyclicTwistedBraAtVertex_childVertexAtInNode_childDataFamilyWithAt
      (n := n) (b := b) H i d site v
  simpa [u, v] using congrArg₂ HAdd.hAdd
    (congrArg₂ HMul.hMul hku hkv) (congrArg₂ HMul.hMul hbu hbv)

theorem cyclicNodeChildInternalPhaseAt_childDataFamilyWithAt
    {n b : Nat} [NeZero n] {ds : List RTree}
