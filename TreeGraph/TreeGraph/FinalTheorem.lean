            (2 : ℤ) ^
              (Fintype.card
                (RawNormal.RootFieldDomain n (RTree.node b ds)) *
                Fintype.card (ZMod n))
          else 0) := by
  classical
  rw [cyclicNodeZeroBranchSum_eq_sum_childRootFamily_kernel_product_nonRootSumAt
    (n := n) (b := b) ds]
  refine Fintype.sum_equiv
    (cyclicNodeChildRootExternalFamilyEquiv n b ds)
    (fun Φ : CyclicNodeChildRootFamily n b ds =>
      (∏ i : ChildIdx ds,
        cyclicNodeChildNonRootSumAtRootFamily
          (n := n) (b := b) ds i (Φ i)) *
        (if
          cyclicChildRootBoundaryMap (n := n) (b := b) ds Φ = 0 then
          (2 : ℤ) ^
            (Fintype.card
              (RawNormal.RootFieldDomain n (RTree.node b ds)) *
              Fintype.card (ZMod n))
        else 0))
    (fun Φext : CyclicNodeChildExternalRootFamily n b ds =>
      (∏ i : ChildIdx ds,
        cyclicNodeChildNonRootSumAtRootFamily
          (n := n) (b := b) ds i
          ((cyclicNodeChildRootFamilyAtExternalEquiv
            n b ds i).symm (Φext i))) *
