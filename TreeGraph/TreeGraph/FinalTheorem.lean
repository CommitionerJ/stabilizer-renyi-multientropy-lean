                RawNormal.nodeFieldFromChildDataFamily
                  (n := n) (a := b) (cs := ds)
                  (RawNormal.childDataFamilyWithAt
                    (n := n) (a := b) (cs := ds) i (H d i)) })
          d site (RawNormal.childRootAtAsNonRootInNode (a := b) i).1
    simp
  · let u : NonRootVertex (childAt ds i) := ⟨v, hroot⟩
    change
      cyclicTwistedKetAtVertex
          (fun d =>
            { rootField := (0 : RawNormal.NodeRootFieldAssignment n b ds),
