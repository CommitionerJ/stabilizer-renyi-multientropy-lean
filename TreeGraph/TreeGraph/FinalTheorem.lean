  let base : ChildExternalBaseCoordinate n 1 cs i0 :=
    singletonChildExternalBaseCoordinate n b ds
  have hchild : childAt cs i0 = RTree.node b ds := by
    simp [cs, i0]
  have hb : 0 < b := by
    have hpos := RawExpandedOpenRootSubtreeCert.positiveWeights hC
    have hparts : 0 < b ∧ ∀ C ∈ ds, RTree.PositiveWeights C := by
      simpa [RTree.PositiveWeights] using hpos
    exact hparts.1
  have hchildRoot : 0 < (childAt cs i0).rootWeight := by
    simpa [hchild, RTree.rootWeight] using hb
  have hcert : RawExpandedOpenRootSubtreeCert (childAt cs i0) := by
    simpa [hchild] using hC
  have hsum :=
    hcyclic (n := n) (a := 1) (cs := cs) i0 base hchildRoot hcert
  have hzero :=
    cyclicRootTwistedSum_node_child_eq_zeroBranch
      (n := n) (a := 1) (b := b) (cs := cs) i0 base
      hchildRoot hchild
  rw [hzero] at hsum
  simpa using hsum

