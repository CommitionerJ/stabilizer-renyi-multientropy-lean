@[simp] theorem cyclicTwistedEdgePhaseAt_boundary_childRootAt
    {n b : Nat} [NeZero n] {ds : List RTree}
    (B : ZMod n → RawNormal.NormalAssignment n (RTree.node b ds))
    (d : ZMod n)
    (site : RawNormal.NormalSite n (RTree.node b ds))
