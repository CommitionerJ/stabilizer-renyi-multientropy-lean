          (cyclicChildRootBoundaryConjugatedLinearMap
            (n := n) (b := b) ds))) :=
  Nat.card_congr
    (cyclicChildRootBoundaryKerEquivConjugatedKer
      (n := n) (b := b) ds).toEquiv

noncomputable def cyclicChildRootBoundaryConjugatedRangeKernelSubspace
    {n b : Nat} [NeZero n] (ds : List RTree) : Submodule F2
      (ZMod n → CyclicNodeChildRootSliceFamily n b ds) :=
  LinearMap.range
      (cyclicPrevDiff n (CyclicNodeChildRootSliceFamily n b ds)) ⊓
    LinearMap.ker
      (cyclicChildRootBoundaryShiftedTimeProjectionLinearMap
        (n := n) (b := b) ds)

theorem cyclicChildRootBoundaryConjugatedRangeKernelSubspace_eq_totalSum_inf_ker
    {n b : Nat} [NeZero n] (ds : List RTree) :
    cyclicChildRootBoundaryConjugatedRangeKernelSubspace
        (n := n) (b := b) ds =
      LinearMap.ker
          (RawLinearAlgebra.totalSumLinear n
            (CyclicNodeChildRootSliceFamily n b ds)) ⊓
        LinearMap.ker
          (cyclicChildRootBoundaryShiftedTimeProjectionLinearMap
            (n := n) (b := b) ds) := by
  rw [cyclicChildRootBoundaryConjugatedRangeKernelSubspace,
    cyclicPrevDiff_range_eq_totalSum_ker]

theorem cyclicChildRootBoundaryConjugatedRangeKernelSubspace_mem_iff
    {n b : Nat} [NeZero n] (ds : List RTree)
    (Ξ : ZMod n → CyclicNodeChildRootSliceFamily n b ds) :
    Ξ ∈ cyclicChildRootBoundaryConjugatedRangeKernelSubspace
        (n := n) (b := b) ds ↔
      RawLinearAlgebra.totalSumLinear n
          (CyclicNodeChildRootSliceFamily n b ds) Ξ = 0 ∧
        ∀ (d : ZMod n)
          (rd : RawNormal.RootFieldDomain n (RTree.node b ds)),
          (∑ j : ChildIdx ds,
            rootBoundaryChildMessageSumAt
              (n := n) (b := b) ds j (Ξ d j) rd d) = 0 := by
  rw [cyclicChildRootBoundaryConjugatedRangeKernelSubspace_eq_totalSum_inf_ker
    (n := n) (b := b) ds]
  constructor
  · intro hΞ
    have htotal :
        Ξ ∈ LinearMap.ker
          (RawLinearAlgebra.totalSumLinear n
            (CyclicNodeChildRootSliceFamily n b ds)) :=
      (Submodule.mem_inf.mp hΞ).1
    have hboundary :
        Ξ ∈ LinearMap.ker
          (cyclicChildRootBoundaryShiftedTimeProjectionLinearMap
            (n := n) (b := b) ds) :=
      (Submodule.mem_inf.mp hΞ).2
    exact
      ⟨LinearMap.mem_ker.mp htotal,
        (cyclicChildRootBoundaryShiftedTimeProjectionLinearMap_eq_zero_iff
          (n := n) (b := b) ds Ξ).1
          (LinearMap.mem_ker.mp hboundary)⟩
  · rintro ⟨htotal, hboundary⟩
    exact
      Submodule.mem_inf.mpr
        ⟨LinearMap.mem_ker.mpr htotal,
          LinearMap.mem_ker.mpr
            ((cyclicChildRootBoundaryShiftedTimeProjectionLinearMap_eq_zero_iff
              (n := n) (b := b) ds Ξ).2 hboundary)⟩

noncomputable def cyclicChildRootBoundaryShiftedTimeKernelTotalSumLinearMap
    {n b : Nat} [NeZero n] (ds : List RTree) :
    LinearMap.ker
        (cyclicChildRootBoundaryShiftedTimeProjectionLinearMap
          (n := n) (b := b) ds) →ₗ[F2]
      CyclicNodeChildRootSliceFamily n b ds where
  toFun := fun Ξ =>
    RawLinearAlgebra.totalSumLinear n
      (CyclicNodeChildRootSliceFamily n b ds) Ξ.1
  map_add' Ξ Η := by
    exact
      (RawLinearAlgebra.totalSumLinear n
        (CyclicNodeChildRootSliceFamily n b ds)).map_add Ξ.1 Η.1
  map_smul' r Ξ := by
    exact
      (RawLinearAlgebra.totalSumLinear n
        (CyclicNodeChildRootSliceFamily n b ds)).map_smul r Ξ.1

noncomputable def cyclicChildRootBoundaryShiftedSliceKernelSpanSubspace
    {n b : Nat} [NeZero n] (ds : List RTree) :
    Submodule F2 (CyclicNodeChildRootSliceFamily n b ds) :=
