noncomputable def externalNormalAssignmentsEquivRaw
    {n : Nat} [NeZero n] {T : RTree}
    (hT : RTree.PositiveWeights T) (ι : Type) :
    (ι → RawNormal.NormalAssignment n T) ≃
      (ι → { Araw : RawAssignment n T // RealizedByNormal T Araw }) where
  toFun A i := normalEquivNormalFormRawOfPositiveWeights (n := n) hT (A i)
  invFun Araw i :=
    (normalEquivNormalFormRawOfPositiveWeights (n := n) hT).symm
      (Araw i)
  left_inv A := by
    funext i
    exact (normalEquivNormalFormRawOfPositiveWeights (n := n) hT).left_inv
      (A i)
  right_inv Araw := by
    funext i
    exact (normalEquivNormalFormRawOfPositiveWeights (n := n) hT).right_inv
