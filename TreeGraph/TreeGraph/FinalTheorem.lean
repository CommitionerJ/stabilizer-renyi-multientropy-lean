theorem rootFieldAssignmentNonRootConstraintLinearMap_mem_ker_iff_reduced
    {n : Nat} [NeZero n] (T : RTree) (v : NonRootVertex T)
    (R : RawNormal.RootFieldAssignment n T) :
    R ∈ LinearMap.ker
        (rootFieldAssignmentNonRootConstraintLinearMap (n := n) T v) ↔
      rootFieldAssignmentOtherCurriedLinearEquiv
          (n := n) (T := T) v R ∈
        LinearMap.ker
          (rootFieldAssignmentReducedNonRootConstraintLinearMap
            (n := n) T v) := by
  constructor
  · intro hR
    apply LinearMap.mem_ker.mpr
    funext otherCoord t
    have hcoord :=
      congrFun
        (congrFun (LinearMap.mem_ker.mp hR)
          (((fun _ : Fin (T.rootWeight - 1) => 0), otherCoord) :
            NonRootContext n T v)) t
    simpa [rootFieldAssignmentReducedNonRootConstraintLinearMap] using hcoord
  · intro hR
    apply LinearMap.mem_ker.mpr
    funext c t
    rcases c with ⟨rootCoord, otherCoord⟩
    have hcoord :=
      congrFun (congrFun (LinearMap.mem_ker.mp hR) otherCoord) t
    simpa [rootFieldAssignmentReducedNonRootConstraintLinearMap] using hcoord

noncomputable def rootFieldAssignmentNonRootConstraintKerEquivReducedKer
    {n : Nat} [NeZero n] (T : RTree) (v : NonRootVertex T) :
    LinearMap.ker
        (rootFieldAssignmentNonRootConstraintLinearMap (n := n) T v) ≃ₗ[F2]
      LinearMap.ker
        (rootFieldAssignmentReducedNonRootConstraintLinearMap
          (n := n) T v) where
  toFun R :=
    ⟨rootFieldAssignmentOtherCurriedLinearEquiv
        (n := n) (T := T) v R.1, by
      exact
        (rootFieldAssignmentNonRootConstraintLinearMap_mem_ker_iff_reduced
          (n := n) T v R.1).1 R.2⟩
  invFun F :=
    ⟨(rootFieldAssignmentOtherCurriedLinearEquiv
        (n := n) (T := T) v).symm F.1, by
      apply
        (rootFieldAssignmentNonRootConstraintLinearMap_mem_ker_iff_reduced
          (n := n) T v
          ((rootFieldAssignmentOtherCurriedLinearEquiv
            (n := n) (T := T) v).symm F.1)).2
      simpa using F.2⟩
  left_inv R := by
    apply Subtype.ext
    simp
  right_inv F := by
    apply Subtype.ext
    simp
  map_add' R S := by
    apply Subtype.ext
    rfl
  map_smul' r R := by
    apply Subtype.ext
    rfl

theorem finrank_ker_rootFieldAssignmentNonRootConstraintLinearMap
    {n : Nat} [NeZero n] (T : RTree) (v : NonRootVertex T)
    (hvpos : 0 < NonRootVertex.weight v) :
    Module.finrank F2
        (LinearMap.ker
          (rootFieldAssignmentNonRootConstraintLinearMap (n := n) T v)) =
      Fintype.card (RootFieldOtherCoord n T v) *
          (n ^ NonRootVertex.weight v * Module.finrank F2 F2) -
        Fintype.card (RootFieldOtherCoord n T v) *
          ((n - 1) * Module.finrank F2 F2) := by
  classical
  calc
    Module.finrank F2
        (LinearMap.ker
          (rootFieldAssignmentNonRootConstraintLinearMap (n := n) T v)) =
        Module.finrank F2
          (LinearMap.ker
            (rootFieldAssignmentReducedNonRootConstraintLinearMap
              (n := n) T v)) :=
      LinearEquiv.finrank_eq
        (rootFieldAssignmentNonRootConstraintKerEquivReducedKer
          (n := n) T v)
    _ =
      Fintype.card (RootFieldOtherCoord n T v) *
          (n ^ NonRootVertex.weight v * Module.finrank F2 F2) -
        Fintype.card (RootFieldOtherCoord n T v) *
          ((n - 1) * Module.finrank F2 F2) := by
      simpa [rootFieldAssignmentReducedNonRootConstraintLinearMap] using
        (RawLinearAlgebra.finrank_ker_paramCyclicDiff_comp_paramFiberSum
          (RootFieldOtherCoord n T v)
          (a := NonRootVertex.weight v) (n := n) hvpos F2)

theorem finrank_ker_rootFieldAssignmentNonRootConstraintLinearMap_closed
    {n : Nat} [NeZero n] (T : RTree) (v : NonRootVertex T)
    (hvpos : 0 < NonRootVertex.weight v) :
    Module.finrank F2
        (LinearMap.ker
          (rootFieldAssignmentNonRootConstraintLinearMap (n := n) T v)) =
      n ^ ((∑ u : RawNormal.OtherNonRootVertex T v,
            NonRootVertex.weight u.1) +
          NonRootVertex.weight v) -
        n ^ (∑ u : RawNormal.OtherNonRootVertex T v,
            NonRootVertex.weight u.1) * (n - 1) := by
  classical
  rw [finrank_ker_rootFieldAssignmentNonRootConstraintLinearMap
    (n := n) T v hvpos]
  rw [card_rootFieldOtherCoord (n := n) T v]
  simp [F2, Nat.pow_add, Nat.mul_assoc]

theorem finrank_ker_param_rootFieldAssignmentNonRootConstraintLinearMap_closed
    (β : Type) [Fintype β]
    {n : Nat} [NeZero n] (T : RTree) (v : NonRootVertex T)
    (hvpos : 0 < NonRootVertex.weight v) :
    Module.finrank F2
        (LinearMap.ker
          (paramLinearMap β
            (rootFieldAssignmentNonRootConstraintLinearMap (n := n) T v))) =
      Fintype.card β *
        (n ^ ((∑ u : RawNormal.OtherNonRootVertex T v,
              NonRootVertex.weight u.1) +
            NonRootVertex.weight v) -
          n ^ (∑ u : RawNormal.OtherNonRootVertex T v,
              NonRootVertex.weight u.1) *
            (n - 1)) := by
  rw [finrank_ker_paramLinearMap]
  rw [finrank_ker_rootFieldAssignmentNonRootConstraintLinearMap_closed
    (n := n) T v hvpos]

theorem childBoundaryCoefficientMap_mem_ker_iff_forall_childRoot_nonRootConstraint
    {n b : Nat} [NeZero n] (ds : List RTree)
    (hpos :
      ∀ j : ChildIdx ds,
        0 < NonRootVertex.weight
          (RawNormal.childRootAtAsNonRootInNode (a := b) j))
    (R : RawNormal.NodeRootFieldAssignment n b ds) :
    R ∈ LinearMap.ker
        (childBoundaryCoefficientMap (n := n) (a := b) ds) ↔
      ∀ j : ChildIdx ds,
        rootFieldAssignmentNonRootConstraintLinearMap
          (n := n) (RTree.node b ds)
          (RawNormal.childRootAtAsNonRootInNode (a := b) j) R = 0 := by
  rw [childBoundaryCoefficientMap_mem_ker_iff_forall_context_fiberSum_cyclicDiff
    (n := n) (b := b) ds hpos R]
  constructor
  · intro hdiff j
    funext c t
    exact congrFun (hdiff j c) t
  · intro hmaps j c
    funext t
    have hmap := hmaps j
    exact congrFun (congrFun hmap c) t

noncomputable def childRootNonRootConstraintFamilyLinearMap
    {n b : Nat} [NeZero n] (ds : List RTree) :
    RawNormal.NodeRootFieldAssignment n b ds →ₗ[F2]
      ((j : ChildIdx ds) →
        NonRootContext n (RTree.node b ds)
          (RawNormal.childRootAtAsNonRootInNode (a := b) j) →
        ZMod n → F2) where
  toFun R := fun j =>
    rootFieldAssignmentNonRootConstraintLinearMap
      (n := n) (RTree.node b ds)
      (RawNormal.childRootAtAsNonRootInNode (a := b) j) R
  map_add' R S := by
    funext j c t
    exact congrFun
      (congrFun
        ((rootFieldAssignmentNonRootConstraintLinearMap
          (n := n) (RTree.node b ds)
          (RawNormal.childRootAtAsNonRootInNode (a := b) j)).map_add R S)
        c) t
  map_smul' r R := by
    funext j c t
    exact congrFun
      (congrFun
        ((rootFieldAssignmentNonRootConstraintLinearMap
          (n := n) (RTree.node b ds)
          (RawNormal.childRootAtAsNonRootInNode (a := b) j)).map_smul r R)
        c) t

@[simp] theorem childRootNonRootConstraintFamilyLinearMap_apply
    {n b : Nat} [NeZero n] (ds : List RTree)
    (R : RawNormal.NodeRootFieldAssignment n b ds)
    (j : ChildIdx ds)
    (c : NonRootContext n (RTree.node b ds)
      (RawNormal.childRootAtAsNonRootInNode (a := b) j))
    (t : ZMod n) :
    childRootNonRootConstraintFamilyLinearMap
        (n := n) (b := b) ds R j c t =
      rootFieldAssignmentNonRootConstraintLinearMap
        (n := n) (RTree.node b ds)
        (RawNormal.childRootAtAsNonRootInNode (a := b) j) R c t := rfl

theorem childRootNonRootConstraintFamilyLinearMap_ker_eq_coefficientMap_ker
    {n b : Nat} [NeZero n] (ds : List RTree)
    (hpos :
      ∀ j : ChildIdx ds,
        0 < NonRootVertex.weight
          (RawNormal.childRootAtAsNonRootInNode (a := b) j)) :
    LinearMap.ker
        (childRootNonRootConstraintFamilyLinearMap
          (n := n) (b := b) ds) =
      LinearMap.ker
        (childBoundaryCoefficientMap (n := n) (a := b) ds) := by
  ext R
  rw [childBoundaryCoefficientMap_mem_ker_iff_forall_childRoot_nonRootConstraint
    (n := n) (b := b) ds hpos R]
  constructor
  · intro hR j
    funext c t
    exact congrFun (congrFun (congrFun (LinearMap.mem_ker.mp hR) j) c) t
  · intro hR
    apply LinearMap.mem_ker.mpr
    funext j c t
    exact congrFun (congrFun (hR j) c) t

def singletonChildIdx (C : RTree) : ChildIdx [C] :=
  ⟨0, by simp [ChildIdx]⟩

theorem childBoundaryCoefficientMapAt_singleton_zero_ker_eq_coefficientMap_ker
    {n a : Nat} [NeZero n] (C : RTree) :
    LinearMap.ker
        (childBoundaryCoefficientMapAt
          (n := n) (a := a) [C] (0 : ChildIdx [C])) =
      LinearMap.ker
        (childBoundaryCoefficientMap (n := n) (a := a) [C]) := by
  ext R
  constructor
  · intro hR
    apply LinearMap.mem_ker.mpr
    funext i d
    have hi : i = (0 : ChildIdx [C]) := childIdx_singleton_eq_zero i
    subst i
    exact congrFun (LinearMap.mem_ker.mp hR) d
  · intro hR
    apply LinearMap.mem_ker.mpr
    exact congrFun (LinearMap.mem_ker.mp hR) (0 : ChildIdx [C])

theorem childBoundaryCoefficientMap_singleton_ker_eq_rootFieldAssignmentNonRootConstraintLinearMap
    {n a : Nat} [NeZero n] (C : RTree)
    (hpos0 :
      0 < NonRootVertex.weight
        (RawNormal.childRootAtAsNonRootInNode
          (a := a) (singletonChildIdx C))) :
    LinearMap.ker
        (childBoundaryCoefficientMap (n := n) (a := a) [C]) =
      LinearMap.ker
        (rootFieldAssignmentNonRootConstraintLinearMap
          (n := n) (RTree.node a [C])
          (RawNormal.childRootAtAsNonRootInNode
            (a := a) (singletonChildIdx C))) := by
  have hpos :
      ∀ j : ChildIdx [C],
        0 < NonRootVertex.weight
          (RawNormal.childRootAtAsNonRootInNode (a := a) j) := by
    intro j
    have hj : j = singletonChildIdx C := by
      apply Fin.ext
      have hlt : j.1 < 1 := by
        simpa [ChildIdx] using j.2
      change j.1 = 0
      exact Nat.eq_zero_of_le_zero (Nat.le_of_lt_succ hlt)
    subst j
    exact hpos0
  ext R
  rw [childBoundaryCoefficientMap_mem_ker_iff_forall_childRoot_nonRootConstraint
    (n := n) (b := a) [C] hpos R]
  constructor
  · intro hR
    apply LinearMap.mem_ker.mpr
    exact hR (singletonChildIdx C)
  · intro hR j
    have hj : j = singletonChildIdx C := by
      apply Fin.ext
      have hlt : j.1 < 1 := by
        simpa [ChildIdx] using j.2
      change j.1 = 0
      exact Nat.eq_zero_of_le_zero (Nat.le_of_lt_succ hlt)
    subst j
    exact LinearMap.mem_ker.mp hR

theorem finrank_ker_childBoundaryCoefficientMap_singleton_closed
    {n a : Nat} [NeZero n] (C : RTree)
    (hpos0 :
      0 < NonRootVertex.weight
        (RawNormal.childRootAtAsNonRootInNode
          (a := a) (singletonChildIdx C))) :
    Module.finrank F2
        (LinearMap.ker
          (childBoundaryCoefficientMap (n := n) (a := a) [C])) =
      n ^ ((∑ u : RawNormal.OtherNonRootVertex (RTree.node a [C])
              (RawNormal.childRootAtAsNonRootInNode
                (a := a) (singletonChildIdx C)),
            NonRootVertex.weight u.1) +
          NonRootVertex.weight
            (RawNormal.childRootAtAsNonRootInNode
              (a := a) (singletonChildIdx C))) -
        n ^ (∑ u : RawNormal.OtherNonRootVertex (RTree.node a [C])
              (RawNormal.childRootAtAsNonRootInNode
                (a := a) (singletonChildIdx C)),
            NonRootVertex.weight u.1) *
          (n - 1) := by
  rw [childBoundaryCoefficientMap_singleton_ker_eq_rootFieldAssignmentNonRootConstraintLinearMap
    (n := n) (a := a) C hpos0]
  exact
    finrank_ker_rootFieldAssignmentNonRootConstraintLinearMap_closed
      (n := n) (RTree.node a [C])
      (RawNormal.childRootAtAsNonRootInNode
        (a := a) (singletonChildIdx C)) hpos0

def childBoundaryRootFactor (n : Nat) (C : RTree) : Nat :=
  n ^ RTree.totalWeight C -
    n ^ (RTree.totalWeight C - RTree.rootWeight C) * (n - 1)

def childBoundaryRootDimension (n : Nat) (cs : List RTree) : Nat :=
  (cs.map (childBoundaryRootFactor n)).prod

@[simp] theorem childBoundaryRootDimension_nil (n : Nat) :
    childBoundaryRootDimension n [] = 1 := by
  simp [childBoundaryRootDimension]

@[simp] theorem childBoundaryRootDimension_cons
    (n : Nat) (C : RTree) (cs : List RTree) :
    childBoundaryRootDimension n (C :: cs) =
      childBoundaryRootFactor n C * childBoundaryRootDimension n cs := by
  simp [childBoundaryRootDimension]

@[simp] theorem childBoundaryRootDimension_singleton
    (n : Nat) (C : RTree) :
    childBoundaryRootDimension n [C] = childBoundaryRootFactor n C := by
  simp [childBoundaryRootDimension]

theorem childBoundaryRootFactor_leaf_eq_branchFactor
    (n b : Nat) :
    childBoundaryRootFactor n (RTree.node b []) =
      branchFactor n (RTree.node b []) := by
  simp [childBoundaryRootFactor, branchFactor, branchConstraintExponent,
    Ydim, RTree.totalWeight, RTree.rootWeight]

theorem sum_other_childRoot_singleton_eq_totalWeight_sub_rootWeight
    (a : Nat) (C : RTree) :
    (∑ u : RawNormal.OtherNonRootVertex (RTree.node a [C])
        (RawNormal.childRootAtAsNonRootInNode
          (a := a) (singletonChildIdx C)),
      NonRootVertex.weight u.1) =
      RTree.totalWeight C - RTree.rootWeight C := by
  let v : NonRootVertex (RTree.node a [C]) :=
    RawNormal.childRootAtAsNonRootInNode (a := a) (singletonChildIdx C)
  have hsplit :=
    card_rootFieldCoordinate_eq_weight_add_sum_other
      (RTree.node a [C]) v
  have hcard :
      Fintype.card (RootFieldCoordinate (RTree.node a [C])) =
        RTree.totalWeight C := by
    simpa using
      (card_rootFieldCoordinate_node_eq_sum_totalWeight a [C])
  have hweight : NonRootVertex.weight v = RTree.rootWeight C := by
    change
      NonRootVertex.weight
        (RawNormal.childRootAtAsNonRootInNode
          (a := a) (singletonChildIdx C)) =
        RTree.rootWeight C
    rw [RawNormal.childRootAtAsNonRootInNode_weight]
    simp [singletonChildIdx, childAt]
  change
    (∑ u : RawNormal.OtherNonRootVertex (RTree.node a [C]) v,
      NonRootVertex.weight u.1) =
      RTree.totalWeight C - RTree.rootWeight C
  omega

theorem finrank_ker_childBoundaryCoefficientMap_singleton_rootFactor
    {n a : Nat} [NeZero n] (C : RTree)
    (hroot : 0 < RTree.rootWeight C) :
    Module.finrank F2
        (LinearMap.ker
          (childBoundaryCoefficientMap (n := n) (a := a) [C])) =
      childBoundaryRootFactor n C := by
  have hpos0 :
      0 < NonRootVertex.weight
        (RawNormal.childRootAtAsNonRootInNode
          (a := a) (singletonChildIdx C)) := by
    rw [RawNormal.childRootAtAsNonRootInNode_weight]
    simpa [singletonChildIdx, childAt] using hroot
  rw [finrank_ker_childBoundaryCoefficientMap_singleton_closed
    (n := n) (a := a) C hpos0]
  rw [sum_other_childRoot_singleton_eq_totalWeight_sub_rootWeight a C]
  rw [RawNormal.childRootAtAsNonRootInNode_weight]
  simp only [singletonChildIdx, childAt]
  have hle : RTree.rootWeight C ≤ RTree.totalWeight C := by
    cases C
    simp [RTree.rootWeight, RTree.totalWeight]
  simp [childBoundaryRootFactor, Nat.sub_add_cancel hle]

theorem finrank_ker_childBoundaryCoefficientMap_singleton_rootDimension
