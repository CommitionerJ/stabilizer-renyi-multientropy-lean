theorem rawEdgePhaseSum_eq_expanded
    {n : Nat} [NeZero n] {T : RTree} :
    (∑ Araw : { Araw : RawAssignment n T // RealizedByNormal T Araw },
      bitSign
        (∑ site : RawNormal.NormalSite n T,
          ((RTree.edgeList T).map
            (localEdgePhase Araw.1 site)).sum)) =
    (∑ Araw : { Araw : RawAssignment n T // RealizedByNormal T Araw },
      bitSign
        (∑ site : RawNormal.NormalSite n T,
          ((RTree.edgeList T).map
            (fun e =>
              let ketAt (p : List Nat) : F2 :=
                if hp : p ∈ RTree.addresses T then
                  Araw.1.ket ⟨p, hp⟩ site
                else
                  0
              let braAt (p : List Nat) : F2 :=
                if hp : p ∈ RTree.addresses T then
                  Araw.1.bra ⟨p, hp⟩ site
                else
                  0
              ketAt e.1 * ketAt e.2 + braAt e.1 * braAt e.2)).sum)) := by
  refine Finset.sum_congr rfl ?_
  intro Araw _
  apply congrArg bitSign
  refine Finset.sum_congr rfl ?_
  intro site _
  exact
    congrArg (fun xs : List F2 => xs.sum)
      (List.map_congr_left
        (l := RTree.edgeList T)
        (f := localEdgePhase Araw.1 site)
        (g := fun e =>
          let ketAt (p : List Nat) : F2 :=
            if hp : p ∈ RTree.addresses T then
              Araw.1.ket ⟨p, hp⟩ site
            else
              0
          let braAt (p : List Nat) : F2 :=
            if hp : p ∈ RTree.addresses T then
              Araw.1.bra ⟨p, hp⟩ site
            else
              0
          ketAt e.1 * ketAt e.2 + braAt e.1 * braAt e.2)
        (by
          intro e _
          rfl))

