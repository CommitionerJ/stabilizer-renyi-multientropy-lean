@[simp] theorem nodeChildNormalSiteRecompose_decompose
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs) (hchildRoot : 0 < (childAt cs i).rootWeight)
    (site : RawNormal.NormalSite n (RTree.node a cs)) :
    nodeChildNormalSiteRecompose
      (n := n) (a := a) (cs := cs) i hchildRoot
      (nodeChildNormalSiteDecompose
        (n := n) (a := a) (cs := cs) i hchildRoot site) = site := by
  classical
  cases site with
  | mk siteRoot siteNonRoot =>
  rw [RawNormal.NormalSite.mk.injEq]
  constructor
  · simp [nodeChildNormalSiteDecompose]
  · funext v j
    rcases RawNormal.nonRootVertex_node_exists_nodeChildVertex
        (a := a) (cs := cs) v with ⟨p, hp⟩
    rcases p with ⟨k, w⟩
    by_cases hki : k = i
    · subst k
      by_cases hroot : w.1 = []
      · have hw : w = Vertex.root (childAt cs i) := by
          apply Subtype.ext
          exact hroot
        subst w
        have hvroot :
            v = RawNormal.childRootAtAsNonRootInNode (a := a) i := by
          apply Subtype.ext
          exact hp
        subst v
        let E :=
          fullCoordinateWithDiagonalEquivOfPos
            (childAt cs i).rootWeight n hchildRoot
        let full :
            Fin (childAt cs i).rootWeight → ZMod n :=
          fun k =>
            siteNonRoot
              (RawNormal.childRootAtAsNonRootInNode (a := a) i)
              (by
                simpa using
                  (RawNormal.childRootFullCoordInNode
                    (a := a) (idx := i.1) (cs := cs)
                    (C := childAt cs i) (childAt_get?_eq_some cs i) k))
        have hfull : E.symm (E full) = full := E.left_inv full
        rw [nodeChildNormalSiteRecompose_childRoot_nonRootCoord]
        have hdecompPair :
            ((nodeChildNormalSiteDecompose
                (n := n) (a := a) (cs := cs) i hchildRoot
                { rootCoord := siteRoot, nonRootCoord := siteNonRoot }).2.rootCoord,
              (nodeChildNormalSiteDecompose
                (n := n) (a := a) (cs := cs) i hchildRoot
                { rootCoord := siteRoot, nonRootCoord := siteNonRoot }).1.childRootDiagonal) =
              E full := by
          ext <;> simp [nodeChildNormalSiteDecompose, E, full]
        rw [hdecompPair]
        calc
          (E.symm (E full))
              (RawNormal.finCastEquivOfEq
                (RawNormal.childRootAtAsNonRootInNode_weight
                  (a := a) i) j) =
              full
                (RawNormal.finCastEquivOfEq
                  (RawNormal.childRootAtAsNonRootInNode_weight
                    (a := a) i) j) := by
            exact congrFun hfull
              (RawNormal.finCastEquivOfEq
                (RawNormal.childRootAtAsNonRootInNode_weight
                  (a := a) i) j)
          _ = siteNonRoot
              (RawNormal.childRootAtAsNonRootInNode (a := a) i) j := by
            have hcoord :
                RawNormal.childRootFullCoordInNode
                    (a := a) (idx := i.1) (cs := cs)
                    (C := childAt cs i) (childAt_get?_eq_some cs i)
                    (RawNormal.finCastEquivOfEq
                      (RawNormal.childRootAtAsNonRootInNode_weight
                        (a := a) i) j) = j := by
              let e :=
                RawNormal.finCastEquivOfEq
                  (RawNormal.childRootAtAsNonRootInNode_weight
                    (a := a) i)
              change e.symm (e j) = j
              exact e.left_inv j
            simpa [full, hcoord]
      · let u : NonRootVertex (childAt cs i) := ⟨w, hroot⟩
        have hvnon :
            v = RawNormal.childNonRootVertexAtInNode (a := a) i u := by
          apply Subtype.ext
          exact hp
        subst v
        have hbase :=
          nodeChildNormalSiteRecompose_childNonRoot_nonRootCoord
            (n := n) (a := a) (cs := cs) i hchildRoot
            (nodeChildNormalSiteDecompose
              (n := n) (a := a) (cs := cs) i hchildRoot
              { rootCoord := siteRoot, nonRootCoord := siteNonRoot })
            u
            (by
              simpa [RawNormal.childNonRootVertexAtInNode_weight] using j)
        simpa [nodeChildNormalSiteDecompose,
          RawNormal.childNonRootVertexAtInNode_weight] using hbase
    · let p : ChildSiblingVertex cs i := ⟨⟨k, w⟩, hki⟩
      have hvsib :
          v = RawNormal.childVertexAtAsNonRootInNode (a := a) p.1 := by
        apply Subtype.ext
        exact hp
      subst v
      have hbase :=
        nodeChildNormalSiteRecompose_sibling_nonRootCoord
          (n := n) (a := a) (cs := cs) i hchildRoot
          (nodeChildNormalSiteDecompose
            (n := n) (a := a) (cs := cs) i hchildRoot
            { rootCoord := siteRoot, nonRootCoord := siteNonRoot })
          p
          (by
            simpa [childVertexAtAsNonRootInNode_weight] using j)
      simpa [nodeChildNormalSiteDecompose,
        childVertexAtAsNonRootInNode_weight] using hbase

