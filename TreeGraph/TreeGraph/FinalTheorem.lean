theorem cyclicChildRootBoundaryMessageCoeff_eq_sum_rootCoord
    {n b : Nat} [NeZero n] (ds : List RTree)
    (j : ChildIdx ds)
    (Φ : ZMod n → RawNormal.NodeChildRootFieldDomain n b ds j → F2)
    (d : ZMod n)
    (rd : RawNormal.RootFieldDomain n (RTree.node b ds)) :
    cyclicChildRootBoundaryMessageCoeff
        (n := n) (b := b) ds j Φ d rd =
      ∑ rootCoord : Fin ((RTree.node b ds).rootWeight - 1) → ZMod n,
        (nodeChildRootFieldAsMessage
            (n := n) (b := b) ds j (Φ d)
            (rootBoundarySelectedNonRootContext
              (n := n) (T := RTree.node b ds)
              (RawNormal.childRootAtAsNonRootInNode (a := b) j)
              rootCoord rd)
            (RawLinearAlgebra.diagSum
                (NonRootVertex.weight
                  (RawNormal.childRootAtAsNonRootInNode (a := b) j))
                n
                (rd (RawNormal.childRootAtAsNonRootInNode (a := b) j))) +
          nodeChildRootFieldAsMessage
            (n := n) (b := b) ds j (Φ (d - 1))
            (rootBoundarySelectedNonRootContext
              (n := n) (T := RTree.node b ds)
              (RawNormal.childRootAtAsNonRootInNode (a := b) j)
              rootCoord rd)
            (RawLinearAlgebra.diagSum
                (NonRootVertex.weight
                  (RawNormal.childRootAtAsNonRootInNode (a := b) j))
                n
                (rd (RawNormal.childRootAtAsNonRootInNode (a := b) j)) +
              1)) := by
  unfold cyclicChildRootBoundaryMessageCoeff
  simpa using
    rootBoundaryChildMessageSumAt_add
      (n := n) (b := b) ds j (Φ d) (Φ (d - 1)) rd
      (0 : ZMod n) (1 : ZMod n)

