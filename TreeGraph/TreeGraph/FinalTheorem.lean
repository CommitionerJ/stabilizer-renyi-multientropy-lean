theorem cyclicTwistedEdgePhaseAt_eq_of_endpoints_ne_nil
    {n : Nat} [NeZero n] {T : RTree}
    (R R' : ZMod n → RawNormal.RootFieldAssignment n T)
    (N : ZMod n → RawNormal.NodeFieldAssignment n T)
    (d : ZMod n) (site : RawNormal.NormalSite n T)
    (e : List Nat × List Nat)
    (hleft : e.1 ≠ []) (hright : e.2 ≠ []) :
    cyclicTwistedEdgePhaseAt
        (fun d => { rootField := R d, nodeField := N d }) d site e =
      cyclicTwistedEdgePhaseAt
        (fun d => { rootField := R' d, nodeField := N d }) d site e := by
  unfold cyclicTwistedEdgePhaseAt
  rw [cyclicTwistedKetAtPath_eq_of_ne_nil R R' N d site e.1 hleft]
  rw [cyclicTwistedKetAtPath_eq_of_ne_nil R R' N d site e.2 hright]
  rw [cyclicTwistedBraAtPath_eq_of_ne_nil R R' N d site e.1 hleft]
  rw [cyclicTwistedBraAtPath_eq_of_ne_nil R R' N d site e.2 hright]

theorem cyclicBoundaryPhaseForEdges_eq_of_edges_ne_nil
    {n : Nat} [NeZero n] {T : RTree}
    (edges : List (List Nat × List Nat))
    (hedges :
      ∀ e ∈ edges, e.1 ≠ [] ∧ e.2 ≠ [])
    (R R' : ZMod n → RawNormal.RootFieldAssignment n T)
    (N : ZMod n → RawNormal.NodeFieldAssignment n T) :
    cyclicBoundaryPhaseForEdges (n := n) (T := T) edges R N =
      cyclicBoundaryPhaseForEdges (n := n) (T := T) edges R' N := by
  classical
  unfold cyclicBoundaryPhaseForEdges
  refine Finset.sum_congr rfl ?_
  intro d _
  refine Finset.sum_congr rfl ?_
  intro site _
  apply congrArg List.sum
  refine List.map_congr_left ?_
  intro e he
  exact cyclicTwistedEdgePhaseAt_eq_of_endpoints_ne_nil
    (n := n) (T := T) R R' N d site e
    (hedges e he).1 (hedges e he).2

noncomputable def cyclicNodeInternalPhase
    {n b : Nat} [NeZero n] (ds : List RTree)
    (N : ZMod n → RawNormal.NodeNonRootFieldAssignment n b ds) : F2 :=
  cyclicBoundaryPhaseForEdges
    (n := n) (T := RTree.node b ds)
    (RTree.indexedChildInternalEdgesFrom [] 0 ds)
    (fun _ => 0) N

noncomputable def cyclicNodeChildInternalPhaseAt
    {n b : Nat} [NeZero n] (ds : List RTree)
    (i : ChildIdx ds)
    (N : ZMod n → RawNormal.NodeNonRootFieldAssignment n b ds) : F2 :=
  cyclicBoundaryPhaseForEdges
    (n := n) (T := RTree.node b ds)
    (RTree.edgeListFrom [i.1] (childAt ds i))
    (fun _ => 0) N

theorem cyclicNodeInternalPhase_eq_sum_childInternal
    {n b : Nat} [NeZero n] (ds : List RTree)
    (N : ZMod n → RawNormal.NodeNonRootFieldAssignment n b ds) :
    cyclicNodeInternalPhase (n := n) (b := b) ds N =
      ∑ i : ChildIdx ds,
        cyclicNodeChildInternalPhaseAt (n := n) (b := b) ds i N := by
  classical
  unfold cyclicNodeInternalPhase cyclicNodeChildInternalPhaseAt
    cyclicBoundaryPhaseForEdges
  calc
    (∑ d : ZMod n,
      ∑ site : RawNormal.NormalSite n (RTree.node b ds),
        ((RTree.indexedChildInternalEdgesFrom [] 0 ds).map
          (cyclicTwistedEdgePhaseAt
            (fun d => { rootField := (fun _ => 0) d, nodeField := N d })
            d site)).sum) =
        ∑ d : ZMod n,
          ∑ site : RawNormal.NormalSite n (RTree.node b ds),
            ∑ i : ChildIdx ds,
              ((RTree.edgeListFrom [i.1] (childAt ds i)).map
                (cyclicTwistedEdgePhaseAt
                  (fun d => { rootField := (fun _ => 0) d, nodeField := N d })
                  d site)).sum := by
          refine Finset.sum_congr rfl ?_
          intro d _
          refine Finset.sum_congr rfl ?_
          intro site _
          simpa using
            (RTree.indexedChildInternalEdgesFrom_map_sum_eq_sum_fin
              (fun e =>
                cyclicTwistedEdgePhaseAt
                  (fun d => { rootField := (fun _ => 0) d, nodeField := N d })
                  d site e)
              [] 0 ds)
    _ =
        ∑ d : ZMod n,
          ∑ i : ChildIdx ds,
            ∑ site : RawNormal.NormalSite n (RTree.node b ds),
              ((RTree.edgeListFrom [i.1] (childAt ds i)).map
                (cyclicTwistedEdgePhaseAt
                  (fun d => { rootField := (fun _ => 0) d, nodeField := N d })
                  d site)).sum := by
          refine Finset.sum_congr rfl ?_
          intro d _
          rw [Finset.sum_comm]
    _ =
        ∑ i : ChildIdx ds,
          ∑ d : ZMod n,
            ∑ site : RawNormal.NormalSite n (RTree.node b ds),
              ((RTree.edgeListFrom [i.1] (childAt ds i)).map
                (cyclicTwistedEdgePhaseAt
                  (fun d => { rootField := (fun _ => 0) d, nodeField := N d })
                  d site)).sum := by
          rw [Finset.sum_comm]

theorem cyclicNodeInternalPhase_independent_root
    {n b : Nat} [NeZero n] (ds : List RTree)
    (R : ZMod n → RawNormal.NodeRootFieldAssignment n b ds)
    (N : ZMod n → RawNormal.NodeNonRootFieldAssignment n b ds) :
    cyclicBoundaryPhaseForEdges
        (n := n) (T := RTree.node b ds)
        (RTree.indexedChildInternalEdgesFrom [] 0 ds) R N =
      cyclicNodeInternalPhase (n := n) (b := b) ds N := by
