    (hchild : childAt cs i = RTree.node b [])
    (hcard :
      (Fintype.card
          (RawNormal.NodeChildRootFieldDomain n a cs i → F2) : ℤ) =
        RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopyFactorAt
          n a cs i)
    (hzero_iff :
      childBoundaryLinearFormAt (n := n) (a := a) cs R i = 0 ↔
        ∃ M : OpenRootMessageSpace n cs,
          openRootMessageSpaceRootFieldEmbeddingOfNode n a cs M = R) :
    ChildOpenRootFourierKernelCanonicalAt a cs n R i := by
