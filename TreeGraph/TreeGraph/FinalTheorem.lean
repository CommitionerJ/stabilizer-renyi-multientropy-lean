noncomputable def functionDomainEquiv
    {α β M : Type} (e : α ≃ β) :
    (α → M) ≃ (β → M) where
  toFun f := fun b => f (e.symm b)
  invFun g := fun a => g (e a)
  left_inv f := by
    funext a
    simp
  right_inv g := by
    funext b
    simp

@[simp] theorem functionDomainEquiv_apply
    {α β M : Type} (e : α ≃ β) (f : α → M) (b : β) :
    functionDomainEquiv (M := M) e f b = f (e.symm b) := rfl

@[simp] theorem functionDomainEquiv_symm_apply
    {α β M : Type} (e : α ≃ β) (g : β → M) (a : α) :
    (functionDomainEquiv (M := M) e).symm g a = g (e a) := rfl

noncomputable def functionDomainLinearEquiv
    {α β M : Type} [AddCommGroup M] [Module F2 M]
    (e : α ≃ β) :
    (α → M) ≃ₗ[F2] (β → M) where
  toFun f := fun b => f (e.symm b)
  invFun g := fun a => g (e a)
  left_inv f := by
    funext a
    simp
  right_inv g := by
    funext b
    simp
  map_add' f g := by
    funext b
    rfl
  map_smul' r f := by
    funext b
    rfl

@[simp] theorem functionDomainLinearEquiv_apply
    {α β M : Type} [AddCommGroup M] [Module F2 M]
    (e : α ≃ β) (f : α → M) (b : β) :
    functionDomainLinearEquiv (M := M) e f b = f (e.symm b) := rfl

@[simp] theorem functionDomainLinearEquiv_symm_apply
    {α β M : Type} [AddCommGroup M] [Module F2 M]
    (e : α ≃ β) (g : β → M) (a : α) :
    (functionDomainLinearEquiv (M := M) e).symm g a = g (e a) := rfl

noncomputable def sigmaFunctionCurryEquiv
    {ι : Type} (α : ι → Type) (M : Type) :
    ((Sigma α) → M) ≃ ((i : ι) → α i → M) where
  toFun f := fun i x => f ⟨i, x⟩
  invFun f := fun x => f x.1 x.2
  left_inv f := by
    funext x
    cases x
    rfl
  right_inv f := by
    funext i x
    rfl

@[simp] theorem sigmaFunctionCurryEquiv_apply
    {ι : Type} {α : ι → Type} {M : Type}
    (f : (Sigma α) → M) (i : ι) (x : α i) :
    sigmaFunctionCurryEquiv α M f i x = f ⟨i, x⟩ := rfl

@[simp] theorem sigmaFunctionCurryEquiv_symm_apply
    {ι : Type} {α : ι → Type} {M : Type}
    (f : (i : ι) → α i → M) (x : Sigma α) :
    (sigmaFunctionCurryEquiv α M).symm f x = f x.1 x.2 := rfl

noncomputable def sigmaFunctionCurryLinearEquiv
    {ι : Type} (α : ι → Type) (M : Type)
    [AddCommGroup M] [Module F2 M] :
    ((Sigma α) → M) ≃ₗ[F2] ((i : ι) → α i → M) where
  toFun f := fun i x => f ⟨i, x⟩
  invFun f := fun x => f x.1 x.2
  left_inv f := by
    funext x
    cases x
    rfl
  right_inv f := by
    funext i x
    rfl
  map_add' f g := by
    funext i x
    rfl
  map_smul' r f := by
    funext i x
    rfl

@[simp] theorem sigmaFunctionCurryLinearEquiv_apply
    {ι : Type} {α : ι → Type} {M : Type}
    [AddCommGroup M] [Module F2 M]
    (f : (Sigma α) → M) (i : ι) (x : α i) :
    sigmaFunctionCurryLinearEquiv α M f i x = f ⟨i, x⟩ := rfl

@[simp] theorem sigmaFunctionCurryLinearEquiv_symm_apply
    {ι : Type} {α : ι → Type} {M : Type}
    [AddCommGroup M] [Module F2 M]
    (f : (i : ι) → α i → M) (x : Sigma α) :
    (sigmaFunctionCurryLinearEquiv α M).symm f x = f x.1 x.2 := rfl

noncomputable def functionFlipLinearEquiv
    (α β M : Type) [AddCommGroup M] [Module F2 M] :
    (α → β → M) ≃ₗ[F2] (β → α → M) where
  toFun f := fun b a => f a b
  invFun f := fun a b => f b a
  left_inv f := by
    funext a b
    rfl
  right_inv f := by
    funext b a
    rfl
  map_add' f g := by
    funext b a
    rfl
  map_smul' r f := by
    funext b a
    rfl

@[simp] theorem functionFlipLinearEquiv_apply
    {α β M : Type} [AddCommGroup M] [Module F2 M]
    (f : α → β → M) (b : β) (a : α) :
    functionFlipLinearEquiv α β M f b a = f a b := rfl

@[simp] theorem functionFlipLinearEquiv_symm_apply
    {α β M : Type} [AddCommGroup M] [Module F2 M]
    (f : β → α → M) (a : α) (b : β) :
    (functionFlipLinearEquiv α β M).symm f a b = f b a := rfl

structure FinalClosedFormula : Prop where
  delta :
    ∀ {T : RTree}, RTree.PositiveWeights T →
      ∀ (n : Nat) [NeZero n],
        DeltaTreeModel n T =
          (2 : ℤ) ^ Int.toNat (assignmentFactorProductExponent n T)
  signed :
    ∀ {T : RTree}, RTree.PositiveWeights T →
      ∀ (n : Nat) [NeZero n],
        RawNormal.signedSum n T =
          (2 : ℤ) ^ Int.toNat (assignmentFactorProductExponent n T)
  raw :
    ∀ {T : RTree}, RTree.PositiveWeights T →
      ∀ (n : Nat) [NeZero n],
        rawBitStringSignedSum n T =
          (2 : ℤ) ^ Int.toNat (assignmentFactorProductExponent n T)
  normal :
    ∀ {T : RTree}, RTree.PositiveWeights T →
      ∀ (n : Nat) [NeZero n],
        normalFormSignedSum n T =
          (2 : ℤ) ^ Int.toNat (assignmentFactorProductExponent n T)

theorem finalClosedFormula_of_completeFormalization
    (h : CompleteFormalization) :
    FinalClosedFormula where
  delta := by
    intro T hT n _
    exact DeltaTreeModel_closed_assignmentFactorProductExponent hT
  signed := by
    intro T hT n _
    exact
      signedSum_closed_assignmentFactorProductExponent_of_completeFormalization
        h hT n
  raw := by
    intro T hT n _
    exact
      rawBitStringSignedSum_closed_assignmentFactorProductExponent_of_completeFormalization
        h hT n
  normal := by
    intro T hT n _
    exact
      normalFormSignedSum_closed_assignmentFactorProductExponent_of_completeFormalization
        h hT n

theorem completeFormalization_of_finalClosedFormula
    (h : FinalClosedFormula) :
    CompleteFormalization :=
  completeFormalization_of_globalRawBitStringClosedAssignmentFactorProduct
    (by
      intro T hT n _
      exact h.raw hT n)

theorem completeFormalization_iff_finalClosedFormula :
    CompleteFormalization ↔ FinalClosedFormula :=
  ⟨finalClosedFormula_of_completeFormalization,
    completeFormalization_of_finalClosedFormula⟩

theorem finalClosedFormula_iff_completeFormalization :
    FinalClosedFormula ↔ CompleteFormalization :=
  completeFormalization_iff_finalClosedFormula.symm

theorem finalClosedFormula_of_positiveAssignmentRecursionWitness
    (hwitness : PositiveAssignmentRecursionWitness) :
