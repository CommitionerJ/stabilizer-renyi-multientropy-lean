noncomputable def childExternalCoordinateExponentAtWithLeft
    (a : Nat) : (cs : List RTree) → Nat → ChildIdx cs → Nat
  | [], _left, i => Fin.elim0 i
  | _C :: rest, left, ⟨0, _⟩ =>
      a + left + (rest.map RTree.totalWeight).sum
  | C :: rest, left, ⟨Nat.succ k, hk⟩ =>
      childExternalCoordinateExponentAtWithLeft a rest
        (left + RTree.totalWeight C)
        ⟨k, by simpa using Nat.lt_of_succ_lt_succ hk⟩

noncomputable def childExternalCoordinateExponentAt
    (a : Nat) (cs : List RTree) (i : ChildIdx cs) : Nat :=
  childExternalCoordinateExponentAtWithLeft a cs 0 i

theorem childInternalCoordinateExponentNat_eq_sum_pow_childExternalCoordinateExponentAtWithLeft_leaf_children
    {n a : Nat} :
    ∀ (cs : List RTree) (left : Nat),
      (∀ i : ChildIdx cs, ∃ c : Nat, childAt cs i = RTree.node c []) →
        RawExpandedOpenRootSubtreeCert.childInternalCoordinateExponentNat
          n a cs left =
          ∑ i : ChildIdx cs,
            n ^ childExternalCoordinateExponentAtWithLeft a cs left i
  | [], _left, _hleaf => by
      simp [ChildIdx,
        RawExpandedOpenRootSubtreeCert.childInternalCoordinateExponentNat]
  | C :: rest, left, hleaf => by
      rcases hleaf ⟨0, by simp⟩ with ⟨c, hC⟩
      have htail :
          ∀ i : ChildIdx rest,
            ∃ c : Nat, childAt rest i = RTree.node c [] := by
        intro i
        rcases
            hleaf ⟨Nat.succ i.1, by simpa using Nat.succ_lt_succ i.2⟩ with
          ⟨d, hd⟩
        exact ⟨d, by simpa [childAt] using hd⟩
      have hrec :=
        childInternalCoordinateExponentNat_eq_sum_pow_childExternalCoordinateExponentAtWithLeft_leaf_children
          (n := n) (a := a) rest (left + RTree.totalWeight C) htail
      have hCX : Int.toNat (Xassign n C) = 1 := by
        have hCnode : C = RTree.node c [] := by
          simpa [childAt] using hC
        rw [hCnode]
        simp [Xassign]
      have hsum :
          (∑ i : ChildIdx (C :: rest),
            n ^ childExternalCoordinateExponentAtWithLeft a (C :: rest) left i) =
            n ^ (a + left + (rest.map RTree.totalWeight).sum) +
              ∑ i : ChildIdx rest,
                n ^ childExternalCoordinateExponentAtWithLeft
                  a rest (left + RTree.totalWeight C) i := by
        change
          (∑ i : Fin (rest.length + 1),
            n ^ childExternalCoordinateExponentAtWithLeft a (C :: rest) left i) =
            n ^ (a + left + (rest.map RTree.totalWeight).sum) +
              ∑ i : Fin rest.length,
                n ^ childExternalCoordinateExponentAtWithLeft
                  a rest (left + RTree.totalWeight C) i
        rw [Fin.sum_univ_succ]
        rfl
      rw [hsum]
      simp [RawExpandedOpenRootSubtreeCert.childInternalCoordinateExponentNat,
        hCX, hrec]

theorem childExternalCoordinateExponentAtWithLeft_add_childAt_totalWeight
    (a : Nat) :
    ∀ (cs : List RTree) (left : Nat) (i : ChildIdx cs),
      childExternalCoordinateExponentAtWithLeft a cs left i +
          RTree.totalWeight (childAt cs i) =
        a + left + (cs.map RTree.totalWeight).sum
  | [], _left, i => Fin.elim0 i
  | C :: rest, left, ⟨0, _⟩ => by
      simp [childExternalCoordinateExponentAtWithLeft, childAt]
      omega
  | C :: rest, left, ⟨Nat.succ k, hk⟩ => by
      have ih :=
        childExternalCoordinateExponentAtWithLeft_add_childAt_totalWeight
          a rest (left + RTree.totalWeight C)
          ⟨k, by simpa using Nat.lt_of_succ_lt_succ hk⟩
      simpa [childExternalCoordinateExponentAtWithLeft, childAt,
        List.map_cons, List.sum_cons, Nat.add_assoc,
        Nat.add_comm, Nat.add_left_comm] using ih

theorem childExternalCoordinateExponentAt_add_childAt_totalWeight
    (a : Nat) (cs : List RTree) (i : ChildIdx cs) :
    childExternalCoordinateExponentAt a cs i +
        RTree.totalWeight (childAt cs i) =
      a + (cs.map RTree.totalWeight).sum := by
  simpa [childExternalCoordinateExponentAt] using
    childExternalCoordinateExponentAtWithLeft_add_childAt_totalWeight
      a cs 0 i

theorem childInternalCoordinateCopyFactorAtWithLeft_eq_externalCopies
    {n a : Nat} [NeZero n] :
    ∀ (cs : List RTree) (left : Nat) (i : ChildIdx cs),
      RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopyFactorAtWithLeft
          n a cs left i =
        (∑ Aext :
          Fin (n ^ childExternalCoordinateExponentAtWithLeft a cs left i) →
            { Araw : RawAssignment n (childAt cs i) //
              RealizedByNormal (childAt cs i) Araw },
          ∏ e, rawEdgePhaseSign n (childAt cs i) (Aext e))
  | [], _left, i => Fin.elim0 i
  | C :: rest, left, ⟨0, _⟩ => by
      simp [RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopyFactorAtWithLeft,
        childExternalCoordinateExponentAtWithLeft, childAt]
      rfl
  | C :: rest, left, ⟨Nat.succ k, hk⟩ => by
      have ih :=
        childInternalCoordinateCopyFactorAtWithLeft_eq_externalCopies
          (n := n) (a := a) rest
          (left + RTree.totalWeight C)
          ⟨k, by simpa using Nat.lt_of_succ_lt_succ hk⟩
      simpa [RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopyFactorAtWithLeft,
        childExternalCoordinateExponentAtWithLeft, childAt] using ih

theorem childInternalCoordinateCopyFactorAt_eq_externalCopies
    {n a : Nat} [NeZero n] (cs : List RTree) (i : ChildIdx cs) :
    RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopyFactorAt
        n a cs i =
      (∑ Aext :
        Fin (n ^ childExternalCoordinateExponentAt a cs i) →
          { Araw : RawAssignment n (childAt cs i) //
            RealizedByNormal (childAt cs i) Araw },
        ∏ e, rawEdgePhaseSign n (childAt cs i) (Aext e)) := by
  simpa [RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopyFactorAt,
    childExternalCoordinateExponentAt] using
    childInternalCoordinateCopyFactorAtWithLeft_eq_externalCopies
      (n := n) (a := a) cs 0 i

theorem childInternalCoordinateCopyFactorAt_closed_of_childCert
    {n a : Nat} [NeZero n] {cs : List RTree} (i : ChildIdx cs)
    (hchild : RawExpandedOpenRootSubtreeCert (childAt cs i)) :
    RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopyFactorAt
        n a cs i =
      (2 : ℤ) ^
        (Int.toNat (Xassign n (childAt cs i)) *
          n ^ childExternalCoordinateExponentAt a cs i) := by
  rw [childInternalCoordinateCopyFactorAt_eq_externalCopies]
  exact
    RawExpandedOpenRootSubtreeCert.coordinateExternalCopiesFinalClosed_Xassign
      hchild n (childExternalCoordinateExponentAt a cs i)

theorem childInternalCoordinateCopyFactorAtWithLeft_leaf_child_closed
    {n a b left : Nat} [NeZero n] (hb : 0 < b) :
    ∀ {cs : List RTree} (i : ChildIdx cs),
      childAt cs i = RTree.node b [] →
      RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopyFactorAtWithLeft
          n a cs left i =
        (2 : ℤ) ^
          (n ^ childExternalCoordinateExponentAtWithLeft a cs left i)
  | [], i, _hchild => Fin.elim0 i
  | C :: rest, ⟨0, _⟩, hchild => by
      have hC : C = RTree.node b [] := by
        simpa [childAt] using hchild
      subst C
      change
        (∑ Aext :
          Fin (n ^ (a + left + (rest.map RTree.totalWeight).sum)) →
            { Araw : RawAssignment n (RTree.node b []) //
              RealizedByNormal (RTree.node b []) Araw },
          ∏ i, rawEdgePhaseSign n (RTree.node b []) (Aext i)) =
        (2 : ℤ) ^ (n ^ (a + left + (rest.map RTree.totalWeight).sum))
      rw [RawExpandedOpenRootSubtreeCert.coordinateExternalCopiesFinalClosed_Xassign
        (T := RTree.node b [])
        (RawExpandedOpenRootSubtreeCert.leaf hb) n
        (a + left + (rest.map RTree.totalWeight).sum)]
      simp [childExternalCoordinateExponentAtWithLeft, Xassign]
  | C :: rest, ⟨Nat.succ k, hk⟩, hchild => by
      have htail :
          childAt rest ⟨k, by
            simpa using Nat.lt_of_succ_lt_succ hk⟩ =
            RTree.node b [] := by
        simpa [childAt] using hchild
      exact
        childInternalCoordinateCopyFactorAtWithLeft_leaf_child_closed
          (n := n) (a := a) (b := b)
          (left := left + RTree.totalWeight C) hb
          ⟨k, by simpa using Nat.lt_of_succ_lt_succ hk⟩ htail

theorem childInternalCoordinateCopyFactorAt_leaf_child_closed
    {n a b : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs) (hb : 0 < b)
    (hchild : childAt cs i = RTree.node b []) :
    RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopyFactorAt
        n a cs i =
      (2 : ℤ) ^ (n ^ childExternalCoordinateExponentAt a cs i) := by
  simpa [RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopyFactorAt,
    childExternalCoordinateExponentAt] using
    childInternalCoordinateCopyFactorAtWithLeft_leaf_child_closed
      (n := n) (a := a) (b := b) (left := 0) hb i hchild

theorem card_childRootFieldFunction_eq_two_pow_domain
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs) :
    ((Fintype.card
      (RawNormal.NodeChildRootFieldDomain n a cs i → F2) : Nat) : ℤ) =
      (2 : ℤ) ^
        Fintype.card (RawNormal.NodeChildRootFieldDomain n a cs i) := by
  classical
  rw [Fintype.card_fun]
  simp [F2]

theorem childLocalContributionSum_eq_sum_linearized_root_nonRootFields
    {n a : Nat} [NeZero n] {cs : List RTree}
    (R : RawNormal.NodeRootFieldAssignment n a cs)
    (i : ChildIdx cs) :
    (∑ h : RawNormal.NodeChildDataAt n a cs i,
      RawNormal.childBoundaryInternalContributionGivenRootDataAt
        (n := n) (a := a) cs R i h) =
      ∑ φ : RawNormal.NodeChildRootFieldDomain n a cs i → F2,
        ∑ ψ :
          (v : NonRootVertex (childAt cs i)) →
            RawNormal.NodeChildNonRootFieldDomain n a cs i v → F2,
          bitSign
              (childBoundaryLinearFormAt (n := n) (a := a) cs R i φ) *
            bitSign
              (childInternalPhaseGivenRootFieldsAt
                (n := n) (a := a) cs R i φ ψ) := by
  rw [childLocalContributionSum_eq_linearizedContributionSumAt,
    childLinearizedContributionSumAt_eq_sum_root_nonRootFields]

structure ChildLocalCopyFactorSemanticIndicatorCertificate
    (a : Nat) (cs : List RTree) (n : Nat) [NeZero n] where
  Q :
    RawNormal.NodeRootFieldAssignment n a cs →
      (i : ChildIdx cs) → Prop
  decidableQ :
    ∀ (R : RawNormal.NodeRootFieldAssignment n a cs)
      (i : ChildIdx cs), Decidable (Q R i)
  childSums :
    ∀ (R : RawNormal.NodeRootFieldAssignment n a cs)
      (i : ChildIdx cs),
      (∑ h : RawNormal.NodeChildDataAt n a cs i,
        RawNormal.childBoundaryInternalContributionGivenRootDataAt
          (n := n) (a := a) cs R i h) =
        RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopyFactorAt
          n a cs i * @indicatorZ (Q R i) (decidableQ R i)
  card :
    letI : ∀ (R : RawNormal.NodeRootFieldAssignment n a cs)
        (i : ChildIdx cs), Decidable (Q R i) := decidableQ
    Fintype.card
        { R : RawNormal.NodeRootFieldAssignment n a cs // ∀ i, Q R i } =
      Fintype.card (OpenRootMessageSpace n cs)

structure ChildLocalCopyFactorLinearizedIndicatorCertificate
    (a : Nat) (cs : List RTree) (n : Nat) [NeZero n] where
  Q :
    RawNormal.NodeRootFieldAssignment n a cs →
      (i : ChildIdx cs) → Prop
  decidableQ :
    ∀ (R : RawNormal.NodeRootFieldAssignment n a cs)
      (i : ChildIdx cs), Decidable (Q R i)
  childSums :
    ∀ (R : RawNormal.NodeRootFieldAssignment n a cs)
      (i : ChildIdx cs),
      childLinearizedContributionSumAt
        (n := n) (a := a) cs R i =
        RawExpandedOpenRootSubtreeCert.childInternalCoordinateCopyFactorAt
          n a cs i * @indicatorZ (Q R i) (decidableQ R i)
  card :
    letI : ∀ (R : RawNormal.NodeRootFieldAssignment n a cs)
        (i : ChildIdx cs), Decidable (Q R i) := decidableQ
    Fintype.card
        { R : RawNormal.NodeRootFieldAssignment n a cs // ∀ i, Q R i } =
      Fintype.card (OpenRootMessageSpace n cs)

noncomputable def childLocalCopyFactorSemanticIndicatorCertificate_of_linearized
    {a : Nat} {cs : List RTree} {n : Nat} [NeZero n]
    (cert :
      ChildLocalCopyFactorLinearizedIndicatorCertificate a cs n) :
    ChildLocalCopyFactorSemanticIndicatorCertificate a cs n := by
  classical
  refine
    { Q := cert.Q
      decidableQ := cert.decidableQ
      childSums := ?_
      card := ?_ }
  · intro R i
    rw [childLocalContributionSum_eq_linearizedContributionSumAt]
    exact cert.childSums R i
  · exact cert.card

theorem boundaryInternalFactorization_of_childLocalCopyFactorSemanticIndicator
    {a : Nat} {cs : List RTree} {n : Nat} [NeZero n]
    (hchildren : ∀ C ∈ cs, RawExpandedOpenRootSubtreeCert C)
    (cert :
      ChildLocalCopyFactorSemanticIndicatorCertificate a cs n) :
    (∑ A : RawNormal.NormalAssignment n (RTree.node a cs),
      bitSign (RawNormal.nodeBoundaryPhase a cs A) *
        bitSign (RawNormal.nodeInternalPhase a cs A)) =
      (2 : ℤ) ^ Int.toNat
        (localCombinatorialNodeExponent n a cs) := by
  classical
  let Q :
      RawNormal.NodeRootFieldAssignment n a cs →
        (i : ChildIdx cs) → Prop :=
    cert.Q
  letI : ∀ (R : RawNormal.NodeRootFieldAssignment n a cs)
      (i : ChildIdx cs), Decidable (Q R i) :=
    cert.decidableQ
  exact
    boundaryInternalFactorization_of_childLocalCopyFactorIndicators
      (n := n) (a := a) (cs := cs) hchildren Q
      (by
        intro R i
        simpa [Q] using cert.childSums R i)
      (by
        simpa [Q] using cert.card)

theorem pureRawExpandedFactorKernelAt_of_childLocalCopyFactorSemanticIndicator
    {a : Nat} {cs : List RTree} {n : Nat} [NeZero n]
