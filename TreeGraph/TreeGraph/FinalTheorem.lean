def ChildOpenRootInternalCyclicTwoPowRule : Prop :=
  ∀ {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs)
    (base : ChildExternalBaseCoordinate n a cs i)
    (hchildRoot : 0 < (childAt cs i).rootWeight)
    (_hC : RawExpandedOpenRootSubtreeCert (childAt cs i)),
      (∑ B : ZMod n → RawNormal.NormalAssignment n (childAt cs i),
        cyclicRootTwistedWeightForBase
          (n := n) (a := a) (cs := cs) i hchildRoot base B) =
        (2 : ℤ) ^
          (Int.toNat (Xassign n (childAt cs i)) *
            Fintype.card (ZMod n))

theorem cyclicRootTwistedSum_leaf_child_eq_twoPow
    {n a b : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs)
    (base : ChildExternalBaseCoordinate n a cs i)
    (hchildRoot : 0 < (childAt cs i).rootWeight)
    (hchild : childAt cs i = RTree.node b []) :
      (∑ B : ZMod n → RawNormal.NormalAssignment n (childAt cs i),
        cyclicRootTwistedWeightForBase
          (n := n) (a := a) (cs := cs) i hchildRoot base B) =
        (2 : ℤ) ^
          (Int.toNat (Xassign n (childAt cs i)) *
            Fintype.card (ZMod n)) := by
  classical
  have hphase :
      ∀ B : ZMod n → RawNormal.NormalAssignment n (childAt cs i),
        cyclicRootTwistedPhaseForBase
          (n := n) (a := a) (cs := cs) i B = 0 := by
    intro B
    simp [cyclicRootTwistedPhaseForBase, hchild]
  have hcard :
      Fintype.card
          (ZMod n → RawNormal.NormalAssignment n (childAt cs i)) =
        2 ^ Fintype.card (ZMod n) := by
    rw [Fintype.card_fun]
    rw [hchild]
    rw [RawNormal.card_normalAssignment_leaf]
  have hX :
      Int.toNat (Xassign n (childAt cs i)) = 1 := by
    rw [hchild]
    simp [Xassign]
  calc
    (∑ B : ZMod n → RawNormal.NormalAssignment n (childAt cs i),
      cyclicRootTwistedWeightForBase
        (n := n) (a := a) (cs := cs) i hchildRoot base B) =
        ∑ _B : ZMod n → RawNormal.NormalAssignment n (childAt cs i),
          (1 : ℤ) := by
          refine Finset.sum_congr rfl ?_
          intro B _
          simp [cyclicRootTwistedWeightForBase, hphase B]
    _ =
        (Fintype.card
          (ZMod n → RawNormal.NormalAssignment n (childAt cs i)) : ℤ) := by
          simp
    _ = ((2 ^ Fintype.card (ZMod n) : Nat) : ℤ) := by
          exact congrArg Nat.cast hcard
    _ = (2 : ℤ) ^ Fintype.card (ZMod n) := by
          norm_num
    _ =
        (2 : ℤ) ^
          (Int.toNat (Xassign n (childAt cs i)) *
            Fintype.card (ZMod n)) := by
          rw [hX]
          simp

theorem cyclicRootTwistedPhaseForBase_node_eq_boundary_add_internal
    {n a b : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs) {ds : List RTree}
    (hchild : childAt cs i = RTree.node b ds)
    (B : ZMod n → RawNormal.NormalAssignment n (childAt cs i)) :
    cyclicRootTwistedPhaseForBase
        (n := n) (a := a) (cs := cs) i B =
      (∑ d : ZMod n,
        ∑ site : RawNormal.NormalSite n (childAt cs i),
          ((RTree.indexedChildBoundaryEdgesFrom [] 0 ds).map
            (cyclicRootTwistedEdgePhaseAt
              (n := n) (a := a) (cs := cs) i B d site)).sum) +
      (∑ d : ZMod n,
        ∑ site : RawNormal.NormalSite n (childAt cs i),
          ((RTree.indexedChildInternalEdgesFrom [] 0 ds).map
            (cyclicRootTwistedEdgePhaseAt
              (n := n) (a := a) (cs := cs) i B d site)).sum) := by
  classical
  unfold cyclicRootTwistedPhaseForBase
  calc
    (∑ d : ZMod n,
      ∑ site : RawNormal.NormalSite n (childAt cs i),
        ((RTree.edgeList (childAt cs i)).map
          (cyclicRootTwistedEdgePhaseAt
            (n := n) (a := a) (cs := cs) i B d site)).sum) =
        ∑ d : ZMod n,
          ∑ site : RawNormal.NormalSite n (childAt cs i),
            (((RTree.indexedChildBoundaryEdgesFrom [] 0 ds).map
              (cyclicRootTwistedEdgePhaseAt
                (n := n) (a := a) (cs := cs) i B d site)).sum +
            ((RTree.indexedChildInternalEdgesFrom [] 0 ds).map
              (cyclicRootTwistedEdgePhaseAt
                (n := n) (a := a) (cs := cs) i B d site)).sum) := by
          refine Finset.sum_congr rfl ?_
          intro d _
          refine Finset.sum_congr rfl ?_
          intro site _
          simpa [hchild] using
            (RTree.edgeList_node_map_sum_eq_boundary_add_internal
              (fun e =>
                cyclicRootTwistedEdgePhaseAt
                  (n := n) (a := a) (cs := cs) i B d site e)
              b ds)
    _ =
      (∑ d : ZMod n,
        ∑ site : RawNormal.NormalSite n (childAt cs i),
          ((RTree.indexedChildBoundaryEdgesFrom [] 0 ds).map
            (cyclicRootTwistedEdgePhaseAt
              (n := n) (a := a) (cs := cs) i B d site)).sum) +
      (∑ d : ZMod n,
        ∑ site : RawNormal.NormalSite n (childAt cs i),
          ((RTree.indexedChildInternalEdgesFrom [] 0 ds).map
            (cyclicRootTwistedEdgePhaseAt
              (n := n) (a := a) (cs := cs) i B d site)).sum) := by
          simp [Finset.sum_add_distrib]

noncomputable def cyclicNormalAssignmentsEquivRootNodeFields
    (n : Nat) [NeZero n] (T : RTree) :
    (ZMod n → RawNormal.NormalAssignment n T) ≃
      (ZMod n → RawNormal.RootFieldAssignment n T) ×
        (ZMod n → RawNormal.NodeFieldAssignment n T) where
  toFun B := (fun d => (B d).rootField, fun d => (B d).nodeField)
  invFun RN := fun d => { rootField := RN.1 d, nodeField := RN.2 d }
  left_inv B := by
    funext d
    cases hB : B d
    simp [hB]
  right_inv RN := by
    cases RN with
    | mk R N =>
        rfl

noncomputable def cyclicRootTwistedPhaseForRootNode
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs)
    (R : ZMod n → RawNormal.RootFieldAssignment n (childAt cs i))
    (N : ZMod n → RawNormal.NodeFieldAssignment n (childAt cs i)) : F2 :=
  cyclicRootTwistedPhaseForBase
    (n := n) (a := a) (cs := cs) i
    (fun d => { rootField := R d, nodeField := N d })

theorem cyclicRootTwistedSum_eq_sum_root_node
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs)
    (base : ChildExternalBaseCoordinate n a cs i)
    (hchildRoot : 0 < (childAt cs i).rootWeight) :
      (∑ B : ZMod n → RawNormal.NormalAssignment n (childAt cs i),
        cyclicRootTwistedWeightForBase
          (n := n) (a := a) (cs := cs) i hchildRoot base B) =
        ∑ RN :
          (ZMod n → RawNormal.RootFieldAssignment n (childAt cs i)) ×
            (ZMod n → RawNormal.NodeFieldAssignment n (childAt cs i)),
          bitSign
            (cyclicRootTwistedPhaseForRootNode
              (n := n) (a := a) (cs := cs) i RN.1 RN.2) := by
  classical
  refine Fintype.sum_equiv
    (cyclicNormalAssignmentsEquivRootNodeFields n (childAt cs i))
    (fun B : ZMod n → RawNormal.NormalAssignment n (childAt cs i) =>
      cyclicRootTwistedWeightForBase
        (n := n) (a := a) (cs := cs) i hchildRoot base B)
    (fun RN :
      (ZMod n → RawNormal.RootFieldAssignment n (childAt cs i)) ×
        (ZMod n → RawNormal.NodeFieldAssignment n (childAt cs i)) =>
      bitSign
        (cyclicRootTwistedPhaseForRootNode
          (n := n) (a := a) (cs := cs) i RN.1 RN.2))
    ?_
  intro B
  simp [cyclicRootTwistedWeightForBase, cyclicRootTwistedPhaseForRootNode,
    cyclicNormalAssignmentsEquivRootNodeFields]

theorem cyclicRootTwistedSum_eq_sum_node_root
    {n a : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs)
    (base : ChildExternalBaseCoordinate n a cs i)
    (hchildRoot : 0 < (childAt cs i).rootWeight) :
      (∑ B : ZMod n → RawNormal.NormalAssignment n (childAt cs i),
        cyclicRootTwistedWeightForBase
          (n := n) (a := a) (cs := cs) i hchildRoot base B) =
        ∑ N : ZMod n →
            RawNormal.NodeFieldAssignment n (childAt cs i),
          ∑ R : ZMod n →
              RawNormal.RootFieldAssignment n (childAt cs i),
            bitSign
              (cyclicRootTwistedPhaseForRootNode
                (n := n) (a := a) (cs := cs) i R N) := by
  classical
  rw [cyclicRootTwistedSum_eq_sum_root_node
    (n := n) (a := a) (cs := cs) i base hchildRoot]
  rw [Fintype.sum_prod_type]
  rw [Finset.sum_comm]

theorem cyclicRootTwistedPhaseForRootNode_node_eq_boundary_add_internal
    {n a b : Nat} [NeZero n] {cs : List RTree}
    (i : ChildIdx cs) {ds : List RTree}
    (hchild : childAt cs i = RTree.node b ds)
    (R : ZMod n → RawNormal.RootFieldAssignment n (childAt cs i))
    (N : ZMod n → RawNormal.NodeFieldAssignment n (childAt cs i)) :
    cyclicRootTwistedPhaseForRootNode
        (n := n) (a := a) (cs := cs) i R N =
      (∑ d : ZMod n,
        ∑ site : RawNormal.NormalSite n (childAt cs i),
          ((RTree.indexedChildBoundaryEdgesFrom [] 0 ds).map
            (cyclicRootTwistedEdgePhaseAt
              (n := n) (a := a) (cs := cs) i
              (fun d => { rootField := R d, nodeField := N d }) d site)).sum) +
      (∑ d : ZMod n,
        ∑ site : RawNormal.NormalSite n (childAt cs i),
          ((RTree.indexedChildInternalEdgesFrom [] 0 ds).map
            (cyclicRootTwistedEdgePhaseAt
              (n := n) (a := a) (cs := cs) i
              (fun d => { rootField := R d, nodeField := N d }) d site)).sum) := by
  simpa [cyclicRootTwistedPhaseForRootNode] using
    cyclicRootTwistedPhaseForBase_node_eq_boundary_add_internal
      (n := n) (a := a) (b := b) (cs := cs) i hchild
      (fun d => { rootField := R d, nodeField := N d })

noncomputable def cyclicRootFieldFamilyEvalLinear
    {n : Nat} [NeZero n] {T : RTree}
    (d : ZMod n) (x : RawNormal.RootFieldDomain n T) :
    (ZMod n → RawNormal.RootFieldAssignment n T) →ₗ[F2] F2 where
  toFun R := R d x
  map_add' R S := rfl
  map_smul' r R := rfl

@[simp] theorem cyclicRootFieldFamilyEvalLinear_apply
    {n : Nat} [NeZero n] {T : RTree}
    (d : ZMod n) (x : RawNormal.RootFieldDomain n T)
    (R : ZMod n → RawNormal.RootFieldAssignment n T) :
    cyclicRootFieldFamilyEvalLinear (n := n) (T := T) d x R = R d x := rfl

noncomputable def cyclicNodeRootBoundaryLinearForm
    {n b : Nat} [NeZero n] (ds : List RTree)
    (N : ZMod n → RawNormal.NodeNonRootFieldAssignment n b ds) :
    (ZMod n → RawNormal.NodeRootFieldAssignment n b ds) →ₗ[F2] F2 :=
  ∑ d : ZMod n,
    ∑ site : RawNormal.NormalSite n (RTree.node b ds),
      ∑ j : ChildIdx ds,
        (((N d (RawNormal.childRootAtAsNonRootInNode (a := b) j)
            (RawNormal.nonRootDomainOfSite site
              (RawNormal.childRootAtAsNonRootInNode (a := b) j) 0)) •
          cyclicRootFieldFamilyEvalLinear
            (n := n) (T := RTree.node b ds) d site.nonRootCoord) +
        ((N d (RawNormal.childRootAtAsNonRootInNode (a := b) j)
            (RawNormal.nonRootDomainOfSite site
              (RawNormal.childRootAtAsNonRootInNode (a := b) j) 1)) •
          cyclicRootFieldFamilyEvalLinear
            (n := n) (T := RTree.node b ds) (d + 1) site.nonRootCoord))

theorem cyclicNodeRootBoundaryLinearForm_apply
    {n b : Nat} [NeZero n] (ds : List RTree)
    (N : ZMod n → RawNormal.NodeNonRootFieldAssignment n b ds)
    (R : ZMod n → RawNormal.NodeRootFieldAssignment n b ds) :
    cyclicNodeRootBoundaryLinearForm (n := n) (b := b) ds N R =
      ∑ d : ZMod n,
        ∑ site : RawNormal.NormalSite n (RTree.node b ds),
          ∑ j : ChildIdx ds,
            (R d site.nonRootCoord *
                N d (RawNormal.childRootAtAsNonRootInNode (a := b) j)
                  (RawNormal.nonRootDomainOfSite site
                    (RawNormal.childRootAtAsNonRootInNode (a := b) j) 0) +
              R (d + 1) site.nonRootCoord *
                N d (RawNormal.childRootAtAsNonRootInNode (a := b) j)
                  (RawNormal.nonRootDomainOfSite site
                    (RawNormal.childRootAtAsNonRootInNode (a := b) j) 1)) := by
  simp [cyclicNodeRootBoundaryLinearForm, Finset.sum_apply, smul_eq_mul,
    mul_comm, mul_left_comm, mul_assoc]

noncomputable def cyclicBoundaryPhaseForEdges
    {n : Nat} [NeZero n] {T : RTree}
    (edges : List (List Nat × List Nat))
    (R : ZMod n → RawNormal.RootFieldAssignment n T)
    (N : ZMod n → RawNormal.NodeFieldAssignment n T) : F2 :=
  ∑ d : ZMod n,
    ∑ site : RawNormal.NormalSite n T,
      (edges.map
        (cyclicTwistedEdgePhaseAt
          (fun d => { rootField := R d, nodeField := N d }) d site)).sum

noncomputable def cyclicNodeBoundaryPhase
    {n b : Nat} [NeZero n] (ds : List RTree)
    (R : ZMod n → RawNormal.NodeRootFieldAssignment n b ds)
    (N : ZMod n → RawNormal.NodeNonRootFieldAssignment n b ds) : F2 :=
  cyclicBoundaryPhaseForEdges
    (n := n) (T := RTree.node b ds)
    (RTree.indexedChildBoundaryEdgesFrom [] 0 ds) R N

theorem cyclicNodeBoundaryPhase_eq_linearForm_apply
    {n b : Nat} [NeZero n] (ds : List RTree)
    (R : ZMod n → RawNormal.NodeRootFieldAssignment n b ds)
    (N : ZMod n → RawNormal.NodeNonRootFieldAssignment n b ds) :
    cyclicNodeBoundaryPhase (n := n) (b := b) ds R N =
      cyclicNodeRootBoundaryLinearForm (n := n) (b := b) ds N R := by
  classical
  rw [cyclicNodeBoundaryPhase, cyclicBoundaryPhaseForEdges,
    cyclicNodeRootBoundaryLinearForm_apply (n := n) (b := b) ds N R]
  refine Finset.sum_congr rfl ?_
  intro d _
  refine Finset.sum_congr rfl ?_
  intro site _
  rw [RTree.indexedChildBoundaryEdgesFrom_map_sum_eq_sum_fin]
  refine Finset.sum_congr rfl ?_
  intro j _
  simp [mul_comm, mul_left_comm, mul_assoc]

theorem zmod_sum_add_right
    {n : Nat} [NeZero n] {M : Type} [AddCommMonoid M]
    (c : ZMod n) (f : ZMod n → M) :
    (∑ d : ZMod n, f (d + c)) = ∑ d : ZMod n, f d := by
  refine Fintype.sum_equiv (Equiv.addRight c)
    (fun d : ZMod n => f (d + c)) f ?_
  intro d
  rfl

abbrev CyclicNodeRootBoundaryDomain
    (n b : Nat) [NeZero n] (ds : List RTree) :=
  ZMod n × RawNormal.RootFieldDomain n (RTree.node b ds)

noncomputable def cyclicNodeRootBoundaryLinearFormProduct
    {n b : Nat} [NeZero n] (ds : List RTree)
    (N : ZMod n → RawNormal.NodeNonRootFieldAssignment n b ds) :
    (CyclicNodeRootBoundaryDomain n b ds → F2) →ₗ[F2] F2 where
  toFun R :=
    cyclicNodeRootBoundaryLinearForm (n := n) (b := b) ds N
      (fun d rd => R (d, rd))
  map_add' R S := by
    have h :
        (fun d rd => (R + S) (d, rd)) =
          (fun d rd => R (d, rd)) + (fun d rd => S (d, rd)) := by
      ext d rd
      rfl
    rw [h, (cyclicNodeRootBoundaryLinearForm
      (n := n) (b := b) ds N).map_add]
  map_smul' r R := by
    have h :
        (fun d rd => (r • R) (d, rd)) =
          r • (fun d rd => R (d, rd)) := by
      ext d rd
      rfl
    rw [h, (cyclicNodeRootBoundaryLinearForm
      (n := n) (b := b) ds N).map_smul]
    simp

@[simp] theorem cyclicNodeRootBoundaryLinearFormProduct_apply
    {n b : Nat} [NeZero n] (ds : List RTree)
    (N : ZMod n → RawNormal.NodeNonRootFieldAssignment n b ds)
    (R : CyclicNodeRootBoundaryDomain n b ds → F2) :
    cyclicNodeRootBoundaryLinearFormProduct (n := n) (b := b) ds N R =
      cyclicNodeRootBoundaryLinearForm (n := n) (b := b) ds N
        (fun d rd => R (d, rd)) := rfl

theorem cyclicNodeRootBoundaryLinearForm_eq_zero_iff_product
    {n b : Nat} [NeZero n] (ds : List RTree)
    (N : ZMod n → RawNormal.NodeNonRootFieldAssignment n b ds) :
    cyclicNodeRootBoundaryLinearForm (n := n) (b := b) ds N = 0 ↔
      cyclicNodeRootBoundaryLinearFormProduct (n := n) (b := b) ds N = 0 := by
  constructor
  · intro h
    apply LinearMap.ext
    intro R
    exact congrArg
      (fun L :
        (ZMod n → RawNormal.NodeRootFieldAssignment n b ds) →ₗ[F2] F2 =>
          L (fun d rd => R (d, rd))) h
  · intro h
    apply LinearMap.ext
    intro R
    have hR :=
      congrArg
        (fun L :
          (CyclicNodeRootBoundaryDomain n b ds → F2) →ₗ[F2] F2 =>
            L (fun x : CyclicNodeRootBoundaryDomain n b ds => R x.1 x.2)) h
    simpa [cyclicNodeRootBoundaryLinearFormProduct] using hR

noncomputable def cyclicNodeRootBoundaryCoefficient
    {n b : Nat} [NeZero n] (ds : List RTree)
    (N : ZMod n → RawNormal.NodeNonRootFieldAssignment n b ds) :
    CyclicNodeRootBoundaryDomain n b ds → F2 :=
  linearFunctionalCoeff (CyclicNodeRootBoundaryDomain n b ds)
    (cyclicNodeRootBoundaryLinearFormProduct (n := n) (b := b) ds N)

theorem cyclicNodeRootBoundaryCoefficient_apply
    {n b : Nat} [NeZero n] (ds : List RTree)
    (N : ZMod n → RawNormal.NodeNonRootFieldAssignment n b ds)
    (x : CyclicNodeRootBoundaryDomain n b ds) :
    cyclicNodeRootBoundaryCoefficient (n := n) (b := b) ds N x =
      cyclicNodeRootBoundaryLinearForm (n := n) (b := b) ds N
        (fun d rd =>
          Pi.single (M := fun _ : CyclicNodeRootBoundaryDomain n b ds => F2)
            x (1 : F2) (d, rd)) := rfl

theorem cyclicNodeRootBoundaryCoefficient_eq_sum
    {n b : Nat} [NeZero n] (ds : List RTree)
    (N : ZMod n → RawNormal.NodeNonRootFieldAssignment n b ds)
    (x : CyclicNodeRootBoundaryDomain n b ds) :
    cyclicNodeRootBoundaryCoefficient (n := n) (b := b) ds N x =
      ∑ d : ZMod n,
        ∑ site : RawNormal.NormalSite n (RTree.node b ds),
          ∑ j : ChildIdx ds,
            (Pi.single
                (M := fun _ : CyclicNodeRootBoundaryDomain n b ds => F2)
                x (1 : F2) (d, site.nonRootCoord) *
              N d (RawNormal.childRootAtAsNonRootInNode (a := b) j)
                (RawNormal.nonRootDomainOfSite site
                  (RawNormal.childRootAtAsNonRootInNode (a := b) j) 0) +
            Pi.single
                (M := fun _ : CyclicNodeRootBoundaryDomain n b ds => F2)
                x (1 : F2) (d + 1, site.nonRootCoord) *
              N d (RawNormal.childRootAtAsNonRootInNode (a := b) j)
                (RawNormal.nonRootDomainOfSite site
                  (RawNormal.childRootAtAsNonRootInNode (a := b) j) 1)) := by
  rw [cyclicNodeRootBoundaryCoefficient_apply,
    cyclicNodeRootBoundaryLinearForm_apply]

theorem pi_single_prod_same_fst
    {α β : Type} [DecidableEq α] [DecidableEq β]
    (a : α) (b b' : β) :
    Pi.single (M := fun _ : α × β => F2) (a, b) (1 : F2) (a, b') =
      Pi.single (M := fun _ : β => F2) b (1 : F2) b' := by
  by_cases h : b' = b
  · subst b'
    simp
  · have hp : (a, b') ≠ (a, b) := by
      intro hpair
      exact h (congrArg Prod.snd hpair)
    simp [Pi.single_eq_of_ne, h, hp]

theorem zmod_sum_pair_single_current
    {n b : Nat} [NeZero n] (ds : List RTree)
    (d0 : ZMod n)
    (rd : RawNormal.RootFieldDomain n (RTree.node b ds))
    (F :
      (d : ZMod n) → RawNormal.NormalSite n (RTree.node b ds) →
        ChildIdx ds → F2) :
    (∑ d : ZMod n,
      ∑ site : RawNormal.NormalSite n (RTree.node b ds),
        ∑ j : ChildIdx ds,
          Pi.single
              (M := fun _ : CyclicNodeRootBoundaryDomain n b ds => F2)
              (d0, rd) (1 : F2) (d, site.nonRootCoord) *
            F d site j) =
      ∑ site : RawNormal.NormalSite n (RTree.node b ds),
        ∑ j : ChildIdx ds,
          Pi.single
              (M := fun _ : RawNormal.RootFieldDomain n (RTree.node b ds) =>
                F2)
              rd (1 : F2) site.nonRootCoord *
            F d0 site j := by
  rw [Fintype.sum_eq_single d0]
  · refine Finset.sum_congr rfl ?_
    intro site _
    refine Finset.sum_congr rfl ?_
    intro j _
    rw [pi_single_prod_same_fst]
  · intro d hd
    refine Finset.sum_eq_zero ?_
    intro site _
    refine Finset.sum_eq_zero ?_
    intro j _
    have hp : (d, site.nonRootCoord) ≠ (d0, rd) := by
      intro hpair
      exact hd (congrArg Prod.fst hpair)
    simp [Pi.single_eq_of_ne, hp]

theorem zmod_sum_pair_single_next
    {n b : Nat} [NeZero n] (ds : List RTree)
    (d0 : ZMod n)
    (rd : RawNormal.RootFieldDomain n (RTree.node b ds))
    (F :
      (d : ZMod n) → RawNormal.NormalSite n (RTree.node b ds) →
        ChildIdx ds → F2) :
    (∑ d : ZMod n,
      ∑ site : RawNormal.NormalSite n (RTree.node b ds),
        ∑ j : ChildIdx ds,
          Pi.single
              (M := fun _ : CyclicNodeRootBoundaryDomain n b ds => F2)
              (d0, rd) (1 : F2) (d + 1, site.nonRootCoord) *
            F d site j) =
      ∑ site : RawNormal.NormalSite n (RTree.node b ds),
        ∑ j : ChildIdx ds,
          Pi.single
              (M := fun _ : RawNormal.RootFieldDomain n (RTree.node b ds) =>
                F2)
              rd (1 : F2) site.nonRootCoord *
            F (d0 - 1) site j := by
  rw [Fintype.sum_eq_single (d0 - 1)]
  · have hshift : (d0 - 1) + 1 = d0 := by
      simp [sub_eq_add_neg, add_assoc]
    refine Finset.sum_congr rfl ?_
    intro site _
    refine Finset.sum_congr rfl ?_
    intro j _
    rw [hshift, pi_single_prod_same_fst]
  · intro d hd
    refine Finset.sum_eq_zero ?_
    intro site _
    refine Finset.sum_eq_zero ?_
    intro j _
    have hp : (d + 1, site.nonRootCoord) ≠ (d0, rd) := by
      intro hpair
      apply hd
      have hfst : d + 1 = d0 := congrArg Prod.fst hpair
      calc
        d = (d + 1) - 1 := by
          simp [sub_eq_add_neg, add_assoc]
        _ = d0 - 1 := by
          rw [hfst]
    simp [Pi.single_eq_of_ne, hp]

theorem cyclicNodeRootBoundaryCoefficient_eq_current_previous
    {n b : Nat} [NeZero n] (ds : List RTree)
    (N : ZMod n → RawNormal.NodeNonRootFieldAssignment n b ds)
    (d0 : ZMod n)
    (rd : RawNormal.RootFieldDomain n (RTree.node b ds)) :
    cyclicNodeRootBoundaryCoefficient (n := n) (b := b) ds N (d0, rd) =
      (∑ site : RawNormal.NormalSite n (RTree.node b ds),
        ∑ j : ChildIdx ds,
          Pi.single
              (M := fun _ : RawNormal.RootFieldDomain n (RTree.node b ds) =>
                F2)
              rd (1 : F2) site.nonRootCoord *
            N d0 (RawNormal.childRootAtAsNonRootInNode (a := b) j)
              (RawNormal.nonRootDomainOfSite site
                (RawNormal.childRootAtAsNonRootInNode (a := b) j) 0)) +
      (∑ site : RawNormal.NormalSite n (RTree.node b ds),
        ∑ j : ChildIdx ds,
          Pi.single
              (M := fun _ : RawNormal.RootFieldDomain n (RTree.node b ds) =>
                F2)
              rd (1 : F2) site.nonRootCoord *
            N (d0 - 1) (RawNormal.childRootAtAsNonRootInNode (a := b) j)
              (RawNormal.nonRootDomainOfSite site
                (RawNormal.childRootAtAsNonRootInNode (a := b) j) 1)) := by
  rw [cyclicNodeRootBoundaryCoefficient_eq_sum]
  simp_rw [Finset.sum_add_distrib]
  rw [zmod_sum_pair_single_current
    (n := n) (b := b) ds d0 rd
    (fun d site j =>
      N d (RawNormal.childRootAtAsNonRootInNode (a := b) j)
        (RawNormal.nonRootDomainOfSite site
          (RawNormal.childRootAtAsNonRootInNode (a := b) j) 0))]
  rw [zmod_sum_pair_single_next
    (n := n) (b := b) ds d0 rd
    (fun d site j =>
      N d (RawNormal.childRootAtAsNonRootInNode (a := b) j)
        (RawNormal.nonRootDomainOfSite site
          (RawNormal.childRootAtAsNonRootInNode (a := b) j) 1))]

