theorem independentBranchDimension_le_pow_sum_totalWeight
    (n : Nat) :
    ∀ cs : List RTree,
      independentBranchDimension n cs ≤
        n ^ (cs.map RTree.totalWeight).sum
  | [] => by
      simp [independentBranchDimension]
  | C :: rest => by
      have hhead := branchFactor_le_pow_totalWeight n C
      have htail := independentBranchDimension_le_pow_sum_totalWeight n rest
      have hmul := Nat.mul_le_mul hhead htail
      simpa [independentBranchDimension_cons, Nat.pow_add, Nat.mul_assoc]
        using hmul

